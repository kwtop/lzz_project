---
import Layout from '../../layouts/Layout.astro';
import ResourceLinks from '../../components/ResourceLinks.astro';
import Arrow from '../../components/Arrow.astro';
import {retouchedProducts} from '../../data/refinedImages';
import Gallery from '../../components/Gallery';
import ProductCard from '../../components/ProductCard.astro';
import {productTitle} from '../../data/presentation';
import {productSummary} from '../../data/productSummaries';
import {productDetail} from '../../data/productDetails';
import {productManufacturing} from '../../data/manufacturing';
import {productTags} from '../../data/productTags';
import {productDecision,relatedPartDecisions} from '../../data/productDecisions';
import {caseForCapability} from '../../data/cases';
import catalog from '../../data/catalog.json';
import {inquiryHref} from '../../lib/inquiryContext';
import ReferenceGallery from '../../components/ReferenceGallery.astro';
import {productReferences} from '../../data/productReferences';
export function getStaticPaths(){return catalog.products.map(product=>({params:{slug:product.slug},props:{product}}));}
const {product}=Astro.props;
const quoteHref=inquiryHref({id:product.slug,title:productTitle(product),legacyName:product.name,path:'/products/'+product.slug+'/',kind:'product'});
const preview=retouchedProducts[product.slug];
if(!preview)throw new Error(`Missing refined product image for ${product.slug}`);
const overview=productSummary(product);
const engineering=productDetail(product);
const manufacturing=productManufacturing(product);
const tags=productTags(product);
const processCaseSlugs=[...new Set(tags.map(key=>catalog.categories.find(category=>category.key===key)?.slug).filter(Boolean))];
const processCases=[...new Map(processCaseSlugs.flatMap(slug=>caseForCapability(slug!)).map(item=>[item.slug,item])).values()].slice(0,2);
const decision=productDecision(product.slug);
const related=relatedPartDecisions(product,catalog.products);
const notes=[['Materials',overview.material],['Machining',overview.process],['Finish options & requirements',manufacturing.finishes],['Applications',manufacturing.applications]];
---
<Layout title={productTitle(product)} description={overview.purpose} closingTitle="Need a similar part?" closingHref={quoteHref} closingLabel="Request a quote for your part">
 <div class="container">
  <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/products/">Part Examples</a><span>/</span><span aria-current="page">{productTitle(product)}</span></nav>
  <section class="product-detail">
   <header class="product-heading">
    <h1>{productTitle(product)}</h1>

   </header>
   <Gallery preview={preview} name={productTitle(product)}/>
   <div class="product-summary">
    <p>{overview.purpose}</p>
    <p class="part-selection-focus">{decision.selectionFocus}</p>
    <a class="button" href={quoteHref}>Request a quote <Arrow/></a>
    <p class="part-example-boundary"><strong>From 1 piece · 7–14 business days</strong><br/>From drawing and order confirmation, including surface finishing; transit is additional.</p>
    <a class="part-spec-link" href="#part-information">Materials &amp; manufacturing</a>
   </div>
   <dl class="part-decision-notes"><div><dt>Part features</dt><dd>{overview.features}</dd></div><div><dt>Made to order</dt><dd>Made to your approved drawing and quotation, including the material, dimensions and acceptance criteria. Not a stock item.</dd></div></dl>
  </section>
 </div>
 {productReferences[product.slug]&&<div class="container"><ReferenceGallery ids={productReferences[product.slug]} title="More views of the part geometry" description="Reference views for comparing shape, interfaces and surface features. Confirm the geometry and requirements of your own part with a controlled drawing."/></div>}
 <section class="specification-band" id="part-information">
  <div class="container specification section">
   <aside class="specification-sidebar">
    <h2>Materials & manufacturing</h2>
    <a class="text-link" href="/quality/">Quality and inspection <Arrow size={17}/></a>
   </aside>
   <div class="part-information"><h3>About this example</h3><p class="spec-options-note">Use the photo to compare the shape and features with your part. It does not specify the alloy, dimensions or inspection results.</p><h3>Materials and finish options</h3><p class="spec-options-note">Choose the material and finish for your application. The options below are available for custom orders; they are not confirmed specifications of the photographed part.</p>
    <ul class="manufacturing-highlights">{manufacturing.highlights.map(text=><li>{text}</li>)}</ul>
    <dl class="part-facts">{notes.map(([label,value])=><div><dt>{label}</dt><dd>{value}</dd></div>)}</dl>
    <nav class="category-links" aria-label="Related machining capabilities">{tags.map(c=><a href={'/capabilities/'+c.toLowerCase()+'/'}>{c.replaceAll('-',' ')}</a>)}</nav>
   </div>
  </div>
 </section>
 <section class="container section engineering-guidance" aria-labelledby="engineering-review">
  <h2 id="engineering-review">Drawing &amp; inspection checklist</h2>
  <div class="prose"><p>{engineering.scope}</p><p>{overview.inspection}</p></div>
  <div class="engineering-grid">
   <div class="prose"><h3>Drawing details</h3><p>{engineering.drawing}</p></div>
   <div class="prose"><h3>Inspection checks</h3><p>{engineering.inspection}</p></div>
   <div class="prose"><h3>Requesting a quote</h3><p>{engineering.rfq}</p></div>
  </div>
  {engineering.considerations&&<div class="engineering-depth">{engineering.considerations.map(note=><div class="prose"><h3>{note.title}</h3><p>{note.body}</p></div>)}</div>}
  <ResourceLinks label="Part inquiry resources"/>
 </section>
 {processCases.length>0&&<section class="container section part-process-links"><div class="section-heading"><h2>Related machining processes</h2></div><div>{processCases.map(item=><a href={'/cases/'+item.slug+'/'}>{item.title} <Arrow size={18}/></a>)}</div></section>}
 {related.length>0&&<section class="section container"><div class="section-heading"><h2>Compare related part requirements</h2><a class="text-link" href="/products/">All parts <Arrow/></a></div><div class="product-grid">{related.map(({product,reason})=><ProductCard product={product} reason={reason}/>)}</div></section>}
</Layout>
<style>
 .product-summary>.part-selection-focus{font-size:16px;line-height:1.65;margin-block:16px 24px;max-width:60ch}
 .spec-options-note{font-size:14px;line-height:1.6;margin-bottom:24px;color:var(--muted)}
 .manufacturing-highlights{padding:0 0 1.5rem 1.25rem;margin:0;font-size:1.0625rem;line-height:1.75}.manufacturing-highlights li+li{margin-top:14px}
 .engineering-grid{display:grid;gap:0;margin-block:40px}
 .engineering-grid>.prose{display:grid;grid-template-columns:220px minmax(0,1fr);gap:48px;max-width:none;border-top:1px solid var(--border);padding-block:28px}
 .engineering-grid>.prose>p{margin:0;max-width:68ch}
 .engineering-depth{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:2rem;border-top:1px solid var(--line,#d6d9d9);padding-top:2rem}
 .engineering-guidance h3{font-size:1.3rem;line-height:1.25}
 :global(body.brand-site .product-detail){grid-template-areas:'gallery heading' 'gallery summary' 'gallery quick';grid-template-rows:auto auto 1fr}.part-decision-notes{grid-area:quick;margin:22px 0 24px;border-top:1px solid var(--border)}.part-decision-notes>div{display:grid;grid-template-columns:118px minmax(0,1fr);gap:12px;padding:13px 0;border-bottom:1px solid var(--border)}.part-decision-notes dt{font-size:14px;line-height:1.5;font-weight:600;color:var(--ink);letter-spacing:0}.part-decision-notes dd{margin:0;font-size:14px;line-height:1.55}.product-summary>.part-example-boundary{font-size:14px!important;line-height:1.6!important;color:var(--muted);margin:18px 0 8px!important}.engineering-guidance>h2{font-size:clamp(27px,3vw,39px);line-height:1.15;margin-bottom:22px}.engineering-guidance>.prose{max-width:880px}
 @media(min-width:761px) and (max-width:1100px){:global(body.brand-site .product-detail){grid-template-areas:'heading heading' 'gallery summary' 'quick quick';grid-template-rows:auto auto auto;gap:24px 32px}:global(body.brand-site .product-heading h1){font-size:40px;max-width:25ch;text-wrap:initial}:global(body.brand-site .product-summary>p:first-child){margin-top:0}}
 @media(max-width:760px){:global(body.brand-site .product-detail){grid-template-areas:'heading' 'gallery' 'summary' 'quick';grid-template-columns:minmax(0,1fr);grid-template-rows:auto}}
 @media(max-width:600px){.part-decision-notes>div{grid-template-columns:1fr;gap:4px}.part-decision-notes dd{font-size:14px}}
 @media(max-width:800px){.engineering-grid,.engineering-depth{grid-template-columns:1fr;gap:1.5rem}.engineering-grid>.prose{grid-template-columns:1fr;gap:16px;padding-block:24px}}
 .part-process-links{border-top:1px solid var(--border)}.part-process-links>div:last-child{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}.part-process-links a{display:flex;justify-content:space-between;align-items:center;gap:20px;border-top:1px solid var(--border);padding:20px 0;font-size:20px;font-weight:600}.part-process-links a:hover{color:var(--red)}@media(max-width:760px){.part-process-links>div:last-child{grid-template-columns:1fr}}
</style>
