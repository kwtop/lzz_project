0;color:#242e35}.ag-review>div{display:grid;grid-template-columns:180px 1fr;gap:26px;border-top:1px solid var(--ag-line);padding:20px 0}.ag-review>div:last-child{border-bottom:1px solid var(--ag-line)}.ag-review dt{font-size:16px;font-weight:600}.ag-review dd{font-size:15px;color:var(--ag-muted);line-height:1.7}.ag-band{background:#f2f4f5}.ag-columns{display:grid;grid-template-columns:1fr 1fr;gap:30px;margin-top:30px}.ag-columns ul{list-style:none;padding:0;margin:12px 0 0}.ag-columns li{border-top:1px solid #d2dade;padding:12px 0;font-size:15px;line-height:1.65;color:var(--ag-muted)}.ag-change{grid-column:1/-1;padding-left:117px;color:#253139!important;font-weight:500}.ag-planning{padding-left:44px;border-left:1px solid var(--ag-line)}.ag-planning dl>div+div{border-top:1px solid var(--ag-line);margin-top:24px;padding-top:19px}.ag-planning dt{font-size:15px}.ag-planning dd{font-size:35px;line-height:1.2;font-weight:550;letter-spacing:-.04em;margin-top:5px}.ag-planning p{margin-top:14px}.ag-actions{display:flex;align-items:center;gap:20px;flex-wrap:wrap;margin-top:23px}.approval-guide .ag-button{display:inline-flex;align-items:center;justify-content:center;background:#c9212d;color:white;padding:14px 22px;min-height:52px;font-size:15px;font-weight:600}.approval-guide .ag-button:hover{background:#a81824}.approval-guide .ag-link{display:inline-flex;align-items:center;gap:12px;min-height:44px;font-size:15px}.ag-link :global(svg),.ag-related :global(svg){flex-shrink:0}.ag-rfq{grid-column:1/-1;padding:26px 32px;background:#f5f6f7}.ag-rfq h3{font-size:19px;letter-spacing:-.015em}.ag-rfq p{margin-top:12px}.ag-rfq a{color:#b51b27;text-decoration:underline;text-underline-offset:3px}.ag-suppliers{padding-block:4px 40px}.ag-suppliers>p{margin-top:18px;max-width:1000px}.ag-suppliers>div{display:grid;grid-template-columns:repeat(4,1fr);gap:27px;margin-top:28px}.ag-suppliers>div>section{border-left:1px solid var(--ag-line);padding-left:20px}.ag-suppliers>div>section:first-child{border:0;padding:0}.ag-suppliers h3{font-size:17px;line-height:1.4;letter-spacing:-.015em}.ag-suppliers section p{font-size:15px;margin-top:12px}.ag-related{display:grid;grid-template-columns:1fr 1fr;gap:70px;border-top:1px solid var(--ag-line);padding-block:32px 20px}.ag-related p{margin-top:17px;max-width:480px}.ag-related>div:last-child{display:grid;align-content:start;gap:10px}.ag-related a{display:flex;align-items:center;justify-content:space-between;gap:20px;border-bottom:1px solid var(--ag-line);min-height:54px;padding-block:12px;color:#195579;font-size:16px;font-weight:500}.ag-bottom{display:flex;justify-content:space-between;gap:25px;padding-block:10px 38px}.ag-bottom a{border-bottom:1px solid var(--ag-line)}
 @media(max-width:1050px){.ag-wrap{width:calc(100% - 64px)}.ag-hero{gap:30px}.ag-hero img{height:auto}.ag-chapter{gap:35px}.ag-intro{grid-template-columns:65px 1fr;gap:16px}.ag-number{font-size:51px}.ag-review>div{grid-template-columns:1fr;gap:10px}.ag-change{padding-left:81px}.ag-planning{padding-left:28px}.ag-planning dd{font-size:30px}.ag-stages{gap:30px}.ag-suppliers>div{grid-template-columns:1fr 1fr;gap:25px}}
 @media(max-width:760px){.ag-wrap{width:calc(100% - 40px)}.ag-hero{grid-template-columns:1fr;gap:26px;padding-block:24px}.ag-crumb{margin:0 0 25px;font-size:12px}.approval-guide h1{font-size:36px}.ag-hero h1+p{margin-top:22px}.ag-hero img{height:auto;aspect-ratio:1.45}.ag-stages{grid-template-columns:1fr;gap:20px;padding-block:12px 32px}.ag-stages h2{font-size:25px}.ag-stages p{font-size:15px;margin-top:4px}.ag-chapter{grid-template-columns:1fr;gap:28px;padding-block:38px}.ag-intro{grid-template-columns:54px 1fr;gap:15px}.ag-number{font-size:43px}.approval-guide h2{font-size:29px}.ag-intro h2 br{display:none}.ag-intro p{margin-top:17px}.ag-review>div{grid-template-columns:1fr;gap:9px;padding-block:17px}.ag-review dd{font-size:16px}.ag-columns{grid-template-columns:1fr;gap:24px;margin-top:24px}.ag-columns li{font-size:16px}.ag-change{padding-left:0;font-size:16px}.ag-planning{padding-left:0;border-left:0;border-top:1px solid var(--ag-line);padding-top:25px}.ag-planning dd{font-size:32px}.ag-actions{gap:12px}.ag-rfq{padding:23px 20px}.ag-suppliers{padding-block:0 32px}.ag-suppliers>div{grid-template-columns:1fr;gap:23px}.ag-suppliers>div>section,.ag-suppliers>div>section:first-child{padding-left:17px;border-left:1px solid var(--ag-line)}.ag-suppliers section p{font-size:16px;margin-top:8px}.ag-related{grid-template-columns:1fr;gap:22px;padding-block:28px 20px}.ag-bottom{padding-block:5px 32px;flex-wrap:wrap}}
.ag-stage-notes{display:grid;gap:8px;padding-block:0 24px}
.ag-band.reading-section>.ag-chapter{padding-block:0}
.ag-rfq.reading-closing{padding-inline:0;background:transparent;border-top:1px solid var(--ag-line)}
</style>
