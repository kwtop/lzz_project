---
import Layout from '../layouts/Layout.astro';
import {resources} from '../data/resources';
import {guideImages} from '../data/refinedImages';
import {photoFrame} from '../lib/photoFrame';
import {knowledgeTopics,knowledgeLinks} from '../data/knowledgeCenter';
interface Props {topic?:string;news?:boolean}
const {topic,news=false}=Astro.props;
const group=knowledgeTopics.find(item=>item.id===topic);
const title=news?'Company News':group!.title;
const description=news?'Team activities and company updates from LZZ, with original photographs and records.':group!.description;
const articles=news?resources.filter(item=>item.category==='Company news'):group!.slugs.map(slug=>resources.find(item=>item.slug===slug)!);
const frames=new Map(await Promise.all(articles.map(async article=>{
 const src=guideImages[article.slug]?.image||article.image;
 return [article.slug,src?(await photoFrame(src,article.imageWidth||600,article.imageHeight||400)).style:''] as const;
})));
---
<Layout title={news?title:title+' | CNC Machining Resources'} description={description}>
 <div class:list={['finesse-category',{'finesse-category-news':news}]}>
 <header class="container finesse-category-masthead"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href={news?'/about/':'/resources/'}>{news?'About LZZ':'Resources'}</a><span>/</span><span>{title}</span></nav><div><h1>{title}</h1><p>{description}</p></div></header>
 {topic==='engineering-guides'&&<nav class="container page-jump-nav" aria-label="Material examples"><a href="#coated-parts">Surface-coated part photographs</a><a href="/cases/custom-plastic-parts-ptfe-pom-pe-acrylic/">Plastic part examples</a></nav>}
 <section class="container category-library" aria-label={title+' articles'}>
  {articles.map((article,index)=>{
   const visual=guideImages[article.slug];
   return <article class:list={['category-story',{'finesse-category-featured':!news&&topic==='rfq-guides'&&index===0}]}>
    <figure data-image-origin={visual?.disclosure?'AI-generated':'source-photo'}>{(visual?.image||article.image)&&<img src={visual?.image||article.image} srcset={visual?.srcset||article.imageSrcset} sizes={news?'(max-width:760px) 90vw, 550px':topic==='rfq-guides'&&index===0?'(max-width:760px) 90vw, 360px':'(max-width:760px) 112px, 180px'} alt={visual?.alt||article.imageAlt||article.title} width={article.imageWidth||600} height={article.imageHeight||400} style={frames.get(article.slug)} loading="lazy"/>}{visual?.disclosure&&<figcaption>AI-generated illustrative image. {visual.disclosure}</figcaption>}</figure>
    <div>{article.eventDate&&<time class="news-date" datetime={article.eventDate}>{article.eventDateLabel}</time>}<h2><a href={(news?'/about/company-news/':'/resources/')+article.slug+'/'}>{article.title}</a></h2><p>{article.description}</p><a class="text-link" href={(news?'/about/company-news/':'/resources/')+article.slug+'/'}>{news?'Read company update':'Read the guide'}</a></div>
   </article>;
  })}
 </section>
 <slot/>
 {!news&&<nav class="container category-browse" aria-label="Other Resources categories"><h2>Explore Resources</h2><div>{knowledgeLinks.filter(link=>link.href!==Astro.url.pathname).map(link=><a href={link.href}>{link.title}</a>)}</div></nav>}
 </div>
</Layout>
<style>
 :global(body.brand-site) .finesse-category-masthead{padding-block:28px 36px}
 .finesse-category-masthead .breadcrumbs{padding-bottom:26px}
 .finesse-category-masthead>div{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.85fr);gap:64px;align-items:start}
 :global(body.brand-site) .finesse-category-masthead h1{font-size:clamp(34px,3.8vw,48px);font-weight:550;letter-spacing:-.035em;line-height:1.12;text-wrap:balance;overflow-wrap:anywhere;min-width:0}
 .finesse-category-masthead p{font-size:17px;line-height:1.7;color:var(--muted);max-width:48ch}
 .news-date{display:block;margin-bottom:12px;color:var(--muted);font-size:14px;line-height:1.5}
 .category-library{padding-block:8px 64px}
 .category-story{display:grid;grid-template-columns:180px minmax(0,1fr);gap:36px;align-items:start;padding-block:30px;border-top:1px solid var(--border);min-width:0}
 .category-story figure{margin:0;min-width:0}
 .category-story img{display:block;width:100%;aspect-ratio:3/2;height:auto;object-fit:cover;background:var(--surface)}
 .category-story figcaption{font-size:13px;line-height:1.6;color:var(--muted);margin-top:10px}
 .category-story>div{display:flex;flex-direction:column;align-items:flex-start;min-width:0;max-width:70ch}
 :global(body.brand-site) .category-story h2{font-size:clamp(24px,2.4vw,30px);font-weight:550;letter-spacing:-.025em;line-height:1.25;text-wrap:pretty;overflow-wrap:anywhere}
 .category-story p{font-size:16px;line-height:1.7;color:var(--muted);margin-block:12px 14px;max-width:64ch}
 .category-story .text-link{display:inline-flex;align-items:center;min-height:44px;margin-top:0;font-size:14px;white-space:nowrap}
 .category-story h2 a:hover{color:var(--red)}
 .category-story a:focus-visible,.category-browse a:focus-visible{outline:2px solid var(--red);outline-offset:5px}
 .finesse-category:not(.finesse-category-news) .category-story:not(.finesse-category-featured){row-gap:12px}
 .finesse-category:not(.finesse-category-news) .category-story:not(.finesse-category-featured) figure,.finesse-category:not(.finesse-category-news) .category-story:not(.finesse-category-featured)>div{display:contents}
 .finesse-category:not(.finesse-category-news) .category-story:not(.finesse-category-featured) img{grid-column:1;grid-row:1/5;align-self:start}
 .finesse-category:not(.finesse-category-news) .category-story:not(.finesse-category-featured) h2{grid-column:2;grid-row:1}
 .finesse-category:not(.finesse-category-news) .category-story:not(.finesse-category-featured) p{grid-column:2;grid-row:2;margin:0}
 .finesse-category:not(.finesse-category-news) .category-story:not(.finesse-category-featured) figcaption{grid-column:2;grid-row:3;margin:0}
 .finesse-category:not(.finesse-category-news) .category-story:not(.finesse-category-featured) .text-link{grid-column:2;grid-row:4}
 .finesse-category-featured{grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr);gap:56px;align-items:center;padding-block:32px 36px}
 .finesse-category-featured figure{grid-column:2;grid-row:1}
 .finesse-category-featured>div{grid-column:1;grid-row:1}
 :global(body.brand-site) .finesse-category-featured h2{font-size:clamp(28px,3vw,36px);line-height:1.17}
 .finesse-category-featured .text-link{margin-top:8px}
 .finesse-category-news .category-library{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:40px;padding-block:8px 64px}
 .finesse-category-news .category-story{display:flex;flex-direction:column;gap:22px;padding-block:24px 0;align-items:stretch}
 .finesse-category-news .category-story img{object-fit:contain}
 .finesse-category-news .category-story>div{flex:1}
 .finesse-category-news .category-story .text-link{margin-top:auto}
 .category-browse{display:grid;grid-template-columns:minmax(0,.6fr) minmax(0,1.4fr);gap:40px;padding-block:32px 56px;border-top:1px solid var(--border)}
 :global(body.brand-site) .category-browse h2{font-size:24px;font-weight:550;line-height:1.25}
 .category-browse>div{display:flex;flex-wrap:wrap;gap:0 24px;min-width:0}
 .category-browse a{display:inline-flex;align-items:center;min-height:44px;border-bottom:1px solid var(--border);font-size:15px;font-weight:550;line-height:1.5}
 .category-browse a:hover{border-color:var(--red);color:var(--red)}
 @media(max-width:760px){:global(body.brand-site) .finesse-category-masthead{padding-block:22px 28px}.finesse-category-masthead .breadcrumbs{padding-bottom:22px}.finesse-category-masthead>div{grid-template-columns:minmax(0,1fr);gap:18px}.finesse-category-masthead p{font-size:16px}.category-library{padding-block:0 40px}.category-story{grid-template-columns:112px minmax(0,1fr);gap:20px;padding-block:26px}.category-story>div{display:contents}:global(body.brand-site) .category-story h2{font-size:22px;align-self:center}.category-story p,.category-story .text-link{grid-column:1/-1}.category-story p{margin-block:0}.category-story figure{grid-row:1}.category-story figcaption{font-size:13px}.finesse-category-featured{grid-template-columns:minmax(0,1fr);gap:22px;padding-block:28px}.finesse-category-featured figure{grid-column:1;grid-row:2;max-width:460px}.finesse-category-featured>div{display:flex;grid-column:1;grid-row:1}.finesse-category-featured img{max-height:240px;object-fit:contain}:global(body.brand-site) .finesse-category-featured h2{font-size:28px}.finesse-category-featured p{margin-block:14px 12px}.finesse-category-news .category-library{grid-template-columns:minmax(0,1fr);gap:30px;padding-block:0 44px}.finesse-category-news .category-story>div{display:flex}:global(body.brand-site) .finesse-category-news .category-story h2{font-size:26px;align-self:stretch}.finesse-category-news .category-story p{margin-block:12px 14px}.category-browse{grid-template-columns:minmax(0,1fr);gap:18px;padding-block:28px 44px}.category-browse>div{gap:0 20px}}
 @media(max-width:414px){.category-story{grid-template-columns:88px minmax(0,1fr);gap:16px}.category-story img{aspect-ratio:1.15}:global(body.brand-site) .category-story h2{font-size:20px}.finesse-category-featured{grid-template-columns:minmax(0,1fr)}.finesse-category-featured img,.finesse-category-news .category-story img{aspect-ratio:3/2}:global(body.brand-site) .finesse-category-featured h2{font-size:27px}}
 @media(max-width:760px){.finesse-category:not(.finesse-category-news) .category-story:not(.finesse-category-featured) img{grid-row:1}.finesse-category:not(.finesse-category-news) .category-story:not(.finesse-category-featured) p,.finesse-category:not(.finesse-category-news) .category-story:not(.finesse-category-featured) figcaption,.finesse-category:not(.finesse-category-news) .category-story:not(.finesse-category-featured) .text-link{grid-column:1/-1}}
</style>
