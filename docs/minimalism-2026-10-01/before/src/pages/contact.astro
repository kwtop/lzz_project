---
import Layout from '../layouts/Layout.astro';
import {ArrowRight} from 'lucide-react';
---
<Layout title="Contact LZZ Precision" description="Contact LZZ Precision in Hangzhou by email or WhatsApp. Find our factory address and prepare a quote request with your drawing, material and quantity." cta={false}>
 <div class="container contact-page">
  <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/about/">About LZZ</a><span>/</span><span>Contact Us</span></nav>
  <header><p class="contact-label">Contact LZZ</p><h1>Let's talk about<br/>your next part.</h1><p>Contact us about custom CNC machining, supplier documents or a workshop visit.</p></header>
  <div class="contact-grid">
   <section aria-labelledby="contact-details-title"><h2 id="contact-details-title">Contact details</h2><dl><div><dt>Email</dt><dd><a href="mailto:roger@lzz-cnc.com">roger@lzz-cnc.com</a></dd></div><div><dt>WhatsApp</dt><dd><a href="https://wa.me/8613858102479">+86 138 5810 2479 <ArrowRight size={20} aria-hidden="true"/></a></dd></div><div><dt>Location &amp; time zone</dt><dd>Hangzhou, China · UTC+8</dd></div></dl></section>
   <section class="contact-rfq" aria-labelledby="contact-rfq-title"><h2 id="contact-rfq-title">Ready to request a quote?</h2><p>Prepare your drawing, material and quantity so we can review your part and quote the scope.</p><a class="button" href="/quote/">Prepare RFQ email <ArrowRight size={18} aria-hidden="true"/></a><p class="contact-note">Review the draft, attach your drawing in your email app, then send it to LZZ.</p><a class="text-link" href="/resources/rfq-checklist/">View the RFQ checklist</a></section>
  </div>
  <section class="contact-address" aria-labelledby="contact-address-title"><div><h2 id="contact-address-title">Find us in Hangzhou</h2><p>Hangzhou Lizhizao Precision Machinery Co., Ltd.</p></div><div><address>No. 4 Fengcheng Road<br/>Pingyao, Yuhang District<br/>Hangzhou, Zhejiang, China</address><p>Contact us to arrange your workshop visit.</p><a class="text-link" href="/factory/">Explore our factory <ArrowRight size={17} aria-hidden="true"/></a></div></section>
 </div>
</Layout>
<style>
 .contact-page{padding-block:32px 72px}.contact-page .breadcrumbs{padding:0 0 36px}.contact-page header{max-width:760px;margin-bottom:56px}.contact-page .contact-label{font-size:13px;font-weight:650;color:var(--red);text-transform:uppercase;margin-bottom:18px}:global(body.brand-site) .contact-page h1{font-size:clamp(40px,5vw,68px);line-height:1.07;letter-spacing:-.045em;font-weight:600}.contact-page p{font-size:17px;line-height:1.7;color:var(--muted);max-width:56ch;margin-top:20px}:global(body.brand-site) .contact-page h2{font-size:30px;line-height:1.2;letter-spacing:-.025em;font-weight:550}.contact-grid{display:grid;grid-template-columns:1.2fr 1fr;gap:80px;align-items:start}.contact-grid dl{margin:22px 0 0}.contact-grid dl>div{padding-block:22px;border-top:1px solid var(--border)}.contact-grid dt{font-size:14px;color:var(--muted);margin-bottom:10px}.contact-grid dd{font-size:clamp(18px,2vw,26px);margin:0;line-height:1.4}.contact-grid dd a{display:inline-flex;gap:18px;align-items:center;min-height:44px}.contact-rfq{padding:36px;background:#f0f1f2}.contact-rfq .button{margin-top:24px;gap:18px;border-radius:0}.contact-rfq .contact-note{font-size:14px;line-height:1.7;margin-top:18px}.contact-rfq .text-link{margin-top:22px}.contact-address{display:grid;grid-template-columns:1.2fr 1fr;gap:80px;margin-top:56px;border-top:1px solid var(--border);padding-top:40px}.contact-address address{font-size:21px;line-height:1.7;font-style:normal}.contact-address p{font-size:15px}.contact-address .text-link{margin-top:20px}.contact-page a:focus-visible{outline:2px solid var(--red);outline-offset:5px}@media(max-width:760px){.contact-page{padding-block:24px 44px}.contact-page .breadcrumbs{padding-bottom:28px}.contact-page header{margin-bottom:36px}.contact-grid,.contact-address{grid-template-columns:1fr;gap:28px}.contact-rfq{padding:26px}.contact-address{margin-top:36px;padding-top:32px}}
</style>
