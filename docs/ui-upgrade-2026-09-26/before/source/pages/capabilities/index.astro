---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Arrow from '../../components/Arrow.astro';
import {categoryDetails} from '../../data/presentation';
import catalog from '../../data/catalog.json';
import {capabilityGroups} from '../../data/capabilityGroups';
import {matchesPartCategory} from '../../data/productTags';
import {productImage,productSrcset} from '../../data/refinedImages';
import {photo} from '../../data/evidence';
const paths=[
 {id:'machining-processes',title:'Choose a process',question:'I know how my part is made',description:'Compare milling, turning, five-axis and casting machining by geometry and setup.'},
 {id:'materials',title:'Choose a material',question:'I know the material I need',description:'Start with the specified alloy or polymer grade; confirm the exact material for your part.'},
 {id:'production-stages',title:'Plan an order',question:'I need a prototype or a small batch',description:'Orders start at 1 piece. Compare prototype and bridge-production needs, then share your drawing and quantity.'},
];
const groups=capabilityGroups.map((group,i)=>({...paths[i],categories:group.keys.map(key=>catalog.categories.find(c=>c.key===key)!).map(c=>({...c,example:catalog.products.find(p=>matchesPartCategory(p,c.key))!,count:catalog.products.filter(p=>matchesPartCategory(p,c.key)).length}))}));
---
<Layout title="CNC machining capabilities" description="Explore LZZ CNC milling, turning, 5-axis machining, material options, prototype machining and small-batch production.">
 <PageHero variant="compact-capability" lines={['Find the right route','for your part']} image={photo('five-axis-operation').src} imageAlt={photo('five-axis-operation').alt} imageSrcset={photo('five-axis-operation').srcset}/>
 <nav class="container customer-paths" aria-label="Explore capabilities by">{paths.map((path,i)=><a href={'#'+path.id}><span class="path-index">0{i+1}</span><h2>{path.question}</h2><span class="path-action">{path.title}<Arrow size={18}/></span></a>)}</nav>
 <div class="container capability-directory">{groups.map(group=><section id={group.id} class="capability-directory-group"><header><h2>{group.title}</h2><p>{group.description}</p></header><div class="capability-directory-links">{group.categories.map(c=><a href={'/capabilities/'+c.slug+'/'}><img class="capability-example" src={productImage(c.example)} srcset={productSrcset(c.example)} sizes="96px" width="96" height="96" alt="" loading="lazy"/><div><h3>{categoryDetails[c.slug]?.title||c.name}</h3></div><span>{c.count} {c.count===1?'example':'examples'}<Arrow size={19}/></span></a>)}</div></section>)}</div>
 <section class="container route-example" aria-labelledby="route-example-title"><div><p class="route-example-label">Geometry first</p><h2 id="route-example-title">One drawing can call for more than one route.</h2><p>A rotational shaft starts with its diameters and datum axis; a housing starts with pockets and interfaces; angled ports may require another setup or a multi-axis review. The actual process and inspection method depend on the controlled model and drawing.</p><a class="text-link" href="/insights/cnc-process-selection/">Compare milling, turning and multi-axis routes</a></div><figure data-image-origin="AI-generated"><img src="/media/process-route-illustration.webp" width="1536" height="1024" alt="Conceptual examples of a turned shaft, milled housing and angled multi-face component" loading="lazy"/><figcaption>AI-generated geometry illustration. These are not photographs of LZZ parts, equipment or completed orders.</figcaption></figure></section>
 <section class="surface-band" id="sample-to-part"><div class="container sample-route"><div><h2>From sample to part</h2><ol><li><strong>Review the sample.</strong> Share the part, mating components and features to retain or change.</li><li><strong>Reconstruct the model.</strong> Discuss scanning and 2D/3D modeling for a manufacturability review.</li><li><strong>Approve the requirements.</strong> Confirm material, datums, tolerances and inspection criteria before machining.</li></ol></div><a class="text-link" href="/quote/?part=Sample-to-part%20support">Discuss your sample <Arrow/></a></div></section>
</Layout>
<style>
 #sample-to-part{scroll-margin-top:100px}.sample-route ol{padding-left:20px;margin-top:24px;line-height:1.7}.sample-route li+li{margin-top:12px}
 .route-example{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:5%;align-items:center;padding-block:72px;border-top:1px solid var(--border)}.route-example-label{font-size:12px;font-weight:750;color:var(--red);text-transform:uppercase;letter-spacing:.08em;margin-bottom:14px}.route-example h2{font-size:clamp(30px,3vw,42px);line-height:1.1}.route-example p:not(.route-example-label){font-size:16px;line-height:1.65;margin:20px 0}.route-example figure{margin:0;min-width:0}.route-example img{width:100%;height:auto;display:block;background:#f8f8f7;border-radius:12px}.route-example figcaption{font-size:12px;line-height:1.5;color:var(--muted);margin-top:10px}@media(max-width:760px){.route-example{grid-template-columns:1fr;gap:26px;padding-block:46px}.route-example p:not(.route-example-label){font-size:15px}}
 .customer-paths{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px;padding-block:36px;border-bottom:1px solid var(--border)}.customer-paths>a{display:flex;flex-direction:column;align-items:flex-start;padding:12px 0;gap:18px}.path-index{color:var(--red);font-size:13px}.customer-paths h2{font-size:25px;line-height:1.2;max-width:300px}.path-action{display:flex;align-items:center;gap:12px;font-size:14px;margin-top:auto;min-height:44px}.customer-paths a:hover .path-action{color:var(--red)}
 .capability-directory-group{display:grid;grid-template-columns:1fr 2fr;gap:64px;padding-block:64px;scroll-margin-top:100px}.capability-directory-group+section{border-top:1px solid var(--border)}.capability-directory-group header h2{font-size:34px}.capability-directory-group header p{font-size:16px;line-height:1.7;margin-top:18px;color:var(--muted)}.capability-directory-links>a{display:flex;align-items:center;justify-content:space-between;gap:28px;padding-block:24px;border-bottom:1px solid var(--border)}.capability-directory-links>a:first-child{padding-top:0}.capability-directory-links h3{font-size:23px}.capability-directory-links p{font-size:15px;line-height:1.65;color:var(--muted);margin-top:10px}.capability-directory-links>a>span{display:flex;align-items:center;gap:12px;white-space:nowrap;font-size:13px;color:var(--muted)}.capability-directory-links>a:hover h3{color:var(--red)}.sample-route{padding-block:48px;display:flex;align-items:center;justify-content:space-between;gap:40px}.sample-route h2{font-size:30px}.sample-route p{max-width:680px;line-height:1.7;margin-top:16px}.sample-route>a{flex-shrink:0}
 @media(max-width:760px){.customer-paths{grid-template-columns:1fr;gap:0;padding-block:16px}.customer-paths>a{display:grid;grid-template-columns:24px 1fr;gap:8px 14px;padding-block:18px}.customer-paths h2{font-size:22px;max-width:none}.path-action{grid-column:2;min-height:30px}.capability-directory-group{grid-template-columns:1fr;gap:28px;padding-block:40px}.capability-directory-group header h2{font-size:28px}.capability-directory-links>a{align-items:flex-start;gap:14px}.capability-directory-links>a>span{font-size:12px}.capability-directory-links h3{font-size:21px}.sample-route{display:block}.sample-route h2{font-size:28px}.sample-route>a{margin-top:20px}}
</style>
