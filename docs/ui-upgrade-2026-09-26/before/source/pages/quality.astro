---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Arrow from '../components/Arrow.astro';
import EvidenceImage from '../components/EvidenceImage.astro';
import IllustrativeScene from '../components/IllustrativeScene.astro';
const stages=[
 {number:'01',title:'Drawing and specifications',text:'Before quoting, we review the drawing, critical dimensions, mating surfaces, material and finish to agree the inspection plan.'},
 {number:'02',title:'Sample inspection',text:'Review the sample inspection results with us and resolve drawing changes before approving production.'},
 {number:'03',title:'Checks during production',text:'We inspect the first article and check agreed features during manufacturing against your order requirements.'},
 {number:'04',title:'Final inspection and shipment',text:'Final QC takes place before shipment, using the acceptance criteria and records agreed for your order.'},
];
---
<Layout title="Quality control for custom CNC machined parts" description="LZZ is ISO 9001 certified. Review its machining inspection stages, dimensional checks and the records to specify with your order.">
 <PageHero lines={['Quality control','for your parts']} action={{label:'Discuss your inspection needs',href:'/quote/'}}/>
 <section class="container section quality-overview" aria-labelledby="quality-overview-title">
  <figure><EvidenceImage id="cmm-room" sizes="(max-width:760px) calc(100vw - 48px), 540px"/></figure>
  <div><h2 id="quality-overview-title">Define the checks<br/>Agree the records</h2><dl><div><dt>Dimensions &amp; fit</dt><dd>Critical features, datums and mating surfaces.</dd></div><div><dt>Material &amp; finish</dt><dd>Material grade, treatment and cosmetic requirements.</dd></div><div><dt>Acceptance records</dt><dd>Report format, traceability and sampling requirements.</dd></div></dl><a class="text-link" href="#inspection-records">Plan your inspection records <Arrow/></a></div>
 </section>
 <section class="container section cmm-detail-section" aria-labelledby="cmm-detail-title"><div class="cmm-detail-copy"><h2 id="cmm-detail-title">Illustrative CMM inspection scene</h2><p>This AI-generated image shows a technician operating a coordinate measuring machine. It is illustrative—not an LZZ employee, inspection photograph, measurement result or calibration record. The original CMM photographs above show equipment in the company archive. For your order, agree the feature, method and records required before production.</p><a class="text-link" href="/quote/">Discuss critical dimensions <Arrow/></a></div><IllustrativeScene id="cmmOperator" sizes="(max-width:760px) calc(100vw - 44px), 44vw" className="cmm-detail-visual"/></section>
 <section class="surface-band section"><div class="container"><div class="section-heading"><h2>Checks at each<br/>production stage</h2></div><div class="quality-stages">{stages.map(stage=><article><span>{stage.number}</span><div><h3>{stage.title}</h3><p>{stage.text}</p></div></article>)}</div><a class="text-link process-link" href="/factory/#workflow">See the complete manufacturing process <Arrow/></a></div></section>
  <section class="section measurement-section"><div class="container company-introduction"><div><h2>Dimensional<br/>measurement</h2></div><div class="measurement-list"><dl class="measurement-matrix"><div><dt>Coordinate measuring machine</dt><dd>Positions and geometric features, checked against drawing datums.</dd></div><div><dt>Height gauges</dt><dd>Heights and dimensional checks using the agreed setup.</dd></div><div><dt>Optical projectors</dt><dd>Profiles and features suited to optical measurement.</dd></div></dl><p class="measurement-note">For selected critical features, ±0.01 mm may be used as an engineering reference after review. It is not a general part tolerance or a guarantee; the drawing, material, geometry, setup and measurement method determine whether it applies. Ask LZZ to confirm the instrument range, current calibration evidence and availability of a project-specific measurement record for your requirements. The source photograph shows a coordinate measuring machine, not a measurement or calibration record.</p><a class="text-link" href="/factory/#equipment">See machining and inspection equipment <Arrow/></a></div></div></section>
 <section class="container section quality-records" id="inspection-records"><div class="section-heading"><h2>Inspection records<br/>for your order</h2></div><div class="document-needs"><details open><summary>Dimensional results</summary><p>Identify critical features and the first-article or dimensional report format you need. Specify the datums and whether dimensions apply before or after finishing.</p></details><details><summary>Material &amp; treatment records</summary><p>Specify the material grade and condition, along with any material or finishing documents you need. Confirm traceability requirements and the documents to supply when agreeing the quotation.</p></details><details><summary>Surface &amp; batch acceptance</summary><p>Mark cosmetic faces, masked areas and edge conditions. Include sampling requirements and the approval process for any proposed deviation.</p></details></div><div class="record-example"><div class="record-explainer"><h3>Make acceptance clear before machining</h3><p>This blank layout shows the information to agree for a dimensional report. Your approved drawing, feature list, measurement method and sampling plan determine the actual record.</p><p class="record-disclaimer">Illustrative layout only. No customer data, inspection results or approval are represented.</p></div><div class="record-sheet" aria-label="Blank example dimensional inspection record layout"><div class="record-sheet-head"><strong>Dimensional inspection record</strong><span>BLANK FORMAT · NO RESULTS</span></div><div class="record-meta"><span>Drawing / revision <b>To agree</b></span><span>Part / batch reference <b>To agree</b></span></div><div class="record-table-wrap"><table><thead><tr><th scope="col">Feature / datum</th><th scope="col">Drawing limit</th><th scope="col">Method</th><th scope="col">Result</th></tr></thead><tbody><tr><td>To define</td><td>—</td><td>To agree</td><td>—</td></tr><tr><td>To define</td><td>—</td><td>To agree</td><td>—</td></tr><tr><td>To define</td><td>—</td><td>To agree</td><td>—</td></tr></tbody></table></div><div class="record-sheet-foot"><span>Sampling plan: to agree</span><span>Review / approval: blank</span></div></div></div><p class="document-note">Ask LZZ to confirm which records can be supplied for your order before machining. No customer report or measurement result is published on this site.</p><a class="text-link" href="/insights/rfq-checklist/">Prepare your drawing and inspection checklist <Arrow/></a></section>
 <section class="surface-band section quality-reference" id="quality-management"><div class="container company-introduction"><div><h2>ISO 9001-certified<br/>quality management</h2><p class="qualification-note">LZZ is ISO 9001 certified. The enterprise-recognition documents shown on our About page are separate awards, not the ISO certificate or a product approval.</p><a class="text-link" href="/about/#documents">View company documents <Arrow/></a></div><div class="qualification-details">
  <details><summary>Company recognition documents</summary><p>Our company documents include an education collaboration plaque, a high-tech enterprise certificate and Zhejiang science and technology SME recognition.</p><p>They cover enterprise recognition and education collaboration. Read the English descriptions alongside the original Chinese documents.</p></details>
  <details><summary>ISO 9001 certification &amp; order checks</summary><p>LZZ is ISO 9001 certified. We confirm requirements before machining, inspect the first article and check agreed features during production and before shipment.</p><p>For supplier qualification, ask LZZ for the certificate details and applicable scope. Agree any part-specific inspection records or industry approvals separately before production.</p></details>
  <details><summary>Feature-specific tolerance review</summary><p>We agree acceptance limits from your drawing, taking material, geometry, finish, setup and inspection method into account. A reference tolerance cannot be applied to every part or dimension.</p><a class="text-link" href="/quote/">Discuss critical dimensions <Arrow/></a></details>
 </div></div></section>
</Layout>
<style>
 .quality-overview{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center}
 .quality-overview figure{margin:0;min-width:0}
 .quality-overview :global(img){width:100%;height:auto;aspect-ratio:3/4;object-fit:cover;border-radius:20px}
 .quality-overview h2{font-size:40px}
 .quality-overview p{margin-block:20px}
 .quality-overview dl{margin:24px 0}
 .quality-overview dl>div{padding-block:15px;border-top:1px solid var(--border)}
 .quality-overview dt{font-size:18px;font-weight:600}
 .quality-overview dd{margin:6px 0 0;font-size:15px;color:var(--muted)}
 .cmm-detail-section{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center;padding-top:0}.cmm-detail-copy{max-width:500px}.cmm-detail-copy h2{font-size:clamp(32px,3.6vw,52px);margin:0 0 18px}.cmm-detail-copy p{font-size:17px;line-height:1.75;max-width:48ch}.cmm-detail-copy .text-link{margin-top:26px}.cmm-detail-section figure{min-width:0;margin:0}.cmm-detail-section img{display:block;width:100%;height:450px;object-fit:cover;object-position:center}.cmm-detail-section figcaption{font-size:12px;line-height:1.55;color:var(--muted);margin-top:10px}
 .measurement-list details{border-bottom:1px solid var(--border)}
 .measurement-list summary{cursor:pointer;padding-block:20px;font-size:22px;line-height:1.3;font-weight:600;min-height:44px}
 .measurement-list details p{padding-bottom:22px}
 .quality-records{padding-top:0;scroll-margin-top:100px}
 .quality-reference h2,#quality-management h2{font-size:32px}
 .qualification-note{font-size:15px;line-height:1.7;margin:20px 0 24px;max-width:46ch}
 .qualification-details details{border-bottom:1px solid var(--border);padding-block:4px 12px}
 .qualification-details summary{font-size:19px;font-weight:600;line-height:1.4;cursor:pointer;min-height:52px;align-content:center;padding-block:14px}
 .qualification-details p{font-size:15px;margin-block:12px 20px}
 .qualification-details .text-link{margin-bottom:16px}
 #quality-management{scroll-margin-top:100px}
 .quality-stages{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:28px}.quality-stages article{border-top:1px solid var(--border);padding-top:22px}.quality-stages article>span{display:block;color:var(--red);font-size:14px;margin-bottom:20px}.quality-stages h3{font-size:23px;line-height:1.25}.quality-stages p{font-size:15px;line-height:1.75;margin-top:16px}.process-link{margin-top:32px}
 .measurement-intro{font-size:17px;margin-top:24px}.measurement-list article+article{margin-top:30px;padding-top:25px;border-top:1px solid var(--border)}.measurement-list h3{font-size:28px;line-height:1.2}.measurement-list article p{font-size:17px;margin-top:15px}.measurement-note,.document-note{font-size:14px;margin:28px 0;max-width:850px}
 .document-needs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:36px;align-items:start}.document-needs details{border-block:1px solid var(--border);padding-block:12px}.document-needs summary{font-size:22px;line-height:1.3;font-weight:600;cursor:pointer;min-height:60px;align-content:center;padding-block:12px}.document-needs p{font-size:16px;margin-block:12px 18px}
 .record-example{display:grid;grid-template-columns:minmax(0,.75fr) minmax(0,1.25fr);gap:55px;align-items:start;margin-top:55px;padding-top:45px;border-top:1px solid var(--border)}.record-explainer{max-width:390px}.record-explainer h3{font-size:clamp(28px,2.8vw,38px);line-height:1.15;margin:18px 0}.record-explainer p{font-size:15px;line-height:1.75}.record-explainer .record-disclaimer{font-size:13px;margin-top:20px}.record-sheet{min-width:0;border:1px solid var(--border);background:#fff;box-shadow:0 18px 45px #1720270c;padding:28px}.record-sheet-head{display:flex;justify-content:space-between;gap:20px;align-items:flex-start;padding-bottom:18px;border-bottom:2px solid var(--ink)}.record-sheet-head strong{font-family:var(--heading);font-size:20px;line-height:1.2}.record-sheet-head span{color:var(--red);font-size:10px;letter-spacing:.1em;font-weight:700;text-align:right}.record-meta{display:flex;gap:12px 30px;flex-wrap:wrap;padding:17px 0;color:var(--muted);font-size:12px}.record-meta b{color:var(--ink);font-weight:500;margin-left:4px}.record-table-wrap{width:100%;overflow-x:auto}.record-sheet table{width:100%;border-collapse:collapse;text-align:left;font-size:12px;min-width:460px}.record-sheet th{background:#f1f3f4;color:var(--ink);font-weight:650}.record-sheet th,.record-sheet td{padding:12px 10px;border-bottom:1px solid var(--border)}.record-sheet td{color:var(--muted)}.record-sheet-foot{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;font-size:11px;color:var(--muted);margin-top:16px}
 .record-explainer h3{margin-top:0}.record-explainer p,.record-explainer .record-disclaimer,.measurement-note,.document-note,.qualification-note{font-size:16px}.record-meta,.record-sheet-foot{font-size:14px}.record-sheet table{font-size:14px}
 @media(max-width:1000px){.quality-stages{grid-template-columns:repeat(2,minmax(0,1fr))}.quality-overview{gap:32px}.record-example{gap:28px}}
 @media(max-width:760px){.quality-overview{grid-template-columns:1fr;gap:28px;padding-top:26px}.quality-overview :global(img){aspect-ratio:4/3;object-position:center}.cmm-detail-section{grid-template-columns:1fr;gap:24px}.cmm-detail-section img{height:auto;aspect-ratio:1.4}.quality-overview h2,.quality-reference h2,#quality-management h2{font-size:30px}.quality-stages,.document-needs{grid-template-columns:1fr;gap:26px}.quality-stages h3,.measurement-list h3,.document-needs h3{font-size:24px}.quality-stages article{display:grid;grid-template-columns:24px 1fr;gap:18px}.quality-stages article>span{margin:4px 0 0}.quality-stages p,.measurement-list article p{font-size:16px}.quality-records{padding-top:0}.record-example{grid-template-columns:1fr;gap:25px;margin-top:40px;padding-top:35px}.record-sheet{padding:18px}.record-sheet-head strong{font-size:17px}.record-sheet table{min-width:0}.record-sheet thead{display:none}.record-sheet tbody,.record-sheet tr{display:block}.record-sheet tr{padding:8px 0;border-bottom:1px solid var(--border)}.record-sheet td{display:flex;justify-content:space-between;gap:12px;padding:5px 0;border:0}.record-sheet td::before{color:var(--ink);font-weight:650}.record-sheet td:nth-child(1)::before{content:'Feature / datum'}.record-sheet td:nth-child(2)::before{content:'Drawing limit'}.record-sheet td:nth-child(3)::before{content:'Method'}.record-sheet td:nth-child(4)::before{content:'Result'}}
</style>
