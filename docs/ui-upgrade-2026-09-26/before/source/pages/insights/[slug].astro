---
import {guideImages} from '../../data/refinedImages';
import Layout from '../../layouts/Layout.astro';
import Arrow from '../../components/Arrow.astro';
import {resources} from '../../data/resources';
import {guidePartExamples} from '../../data/editorialLinks';
import {productTitle} from '../../data/presentation';
import catalog from '../../data/catalog.json';
import {load} from 'cheerio';
export function getStaticPaths(){return resources.map(article=>({params:{slug:article.slug},props:{article}}));}
const {article}=Astro.props;
const visual=guideImages[article.slug];
const $=load(article.html,null,false);
const contents: {id:string;label:string}[]=[];
$('h2').each((i,element)=>{const id=$(element).attr('id')||'section-'+(i+1);$(element).attr('id',id);contents.push({id,label:$(element).text()});});
const articleBody=$.html();
const examples=(guidePartExamples[article.slug]||[]).map(slug=>catalog.products.find(product=>product.slug===slug)).filter((product):product is (typeof catalog.products)[number]=>Boolean(product));
---
<Layout title={article.title} description={article.description} article={true} articleImage={visual?.image||article.image}>
 <article>
  <header class="article-masthead"><div class="container"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/insights/">Resources</a><span>/</span><span>{article.category}</span></nav><h1>{article.title}</h1></div></header>
  {visual&&<figure class="container article-editorial-image" data-image-origin={visual.disclosure?'AI-generated':'source-photo'}><img src={visual.image} srcset={visual.srcset} sizes="(max-width:760px) 90vw, 960px" alt={visual.alt} width="1200" height="800"/>{visual.disclosure&&<figcaption><strong>AI-generated illustrative image.</strong> {visual.disclosure}</figcaption>}</figure>}
  <div class:list={['container article-reading',{'with-toc':contents.length>0}]}>
   {contents.length>0&&<aside class="article-contents"><details class="contents-disclosure" open><summary>On this page</summary><nav aria-label="Article contents">{contents.map(c=><a href={'#'+c.id}>{c.label}</a>)}</nav></details></aside>}
   <div class="prose" set:html={articleBody}/>
  </div>
  {examples.length>0&&<section class="container article-part-examples" aria-labelledby="article-examples-title"><div><p class="article-example-label">Apply the guide</p><h2 id="article-examples-title">Related part examples</h2><p>Use these examples to see the shapes and drawing questions discussed above. Each custom part still needs its own drawing and quote.</p></div><div>{examples.map(product=><a href={'/products/'+product.slug+'/'}>{productTitle(product)}</a>)}</div></section>}
  <div class="container article-return"><a class="text-link" href="/insights/">Back to resources <Arrow/></a></div>
 </article>
</Layout>
<style>
 .article-part-examples{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:6%;border-top:1px solid var(--border);padding-block:44px}.article-part-examples h2{font-size:clamp(28px,3vw,38px);line-height:1.15}.article-part-examples p:not(.article-example-label){font-size:14px;line-height:1.6;color:var(--muted);margin-top:12px;max-width:44ch}.article-example-label{font-size:12px;font-weight:750;letter-spacing:.08em;text-transform:uppercase;color:var(--red);margin-bottom:11px}.article-part-examples>div:last-child{display:grid;gap:10px;align-content:start}.article-part-examples a{display:block;border:1px solid var(--border);border-radius:10px;padding:17px 20px;line-height:1.4;font-weight:650}.article-part-examples a:hover{border-color:var(--red);color:var(--red)}@media(max-width:760px){.article-part-examples{grid-template-columns:1fr;gap:23px}}
 .article-editorial-image{margin-top:24px;margin-bottom:0}.article-editorial-image img{display:block;width:100%;height:auto;max-height:620px;object-fit:cover;border-radius:14px}.article-editorial-image figcaption{max-width:960px;margin:10px auto 0;color:var(--muted);font-size:12px;line-height:1.55}
 :global(.article-reading .prose .guide-illustration){margin:30px 0}.article-reading .prose :global(.guide-illustration img){display:block;width:100%;height:auto;aspect-ratio:3/2;object-fit:cover;border-radius:12px}.article-reading .prose :global(.guide-illustration figcaption){margin-top:9px;color:var(--muted);font-size:12px;line-height:1.55}
 :global(.article-reading .prose .decision-table-wrap){width:100%;overflow-x:auto;overscroll-behavior-inline:contain;margin:26px 0 34px;border:1px solid var(--border);border-radius:10px;background:white}
 :global(.article-reading .prose .decision-table-wrap:focus-visible){outline:2px solid var(--red);outline-offset:3px}
 :global(.article-reading .prose .decision-table){width:100%;min-width:620px;border-collapse:collapse;text-align:left;font-size:14px;line-height:1.6}
 :global(.article-reading .prose .decision-table th),:global(.article-reading .prose .decision-table td){padding:15px 16px;border-bottom:1px solid var(--border);vertical-align:top}
 :global(.article-reading .prose .decision-table thead th){background:#f1f3f4;color:var(--ink);font-weight:700}
 :global(.article-reading .prose .decision-table tbody th){min-width:120px;color:var(--ink);font-weight:650}
 :global(.article-reading .prose .decision-table tr:last-child th),:global(.article-reading .prose .decision-table tr:last-child td){border-bottom:0}
 :global(.article-reading .prose .process-comparison-photos){display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin:30px 0 38px}
 :global(.article-reading .prose .process-comparison-photos figure){margin:0;min-width:0}
 :global(.article-reading .prose .process-comparison-photos img){display:block;width:100%;height:220px;object-fit:cover;border-radius:9px}
 :global(.article-reading .prose .process-comparison-photos figcaption){margin-top:9px;color:var(--muted);font-size:11px;line-height:1.45}
 :global(.article-reading .prose .shipment-photo-grid){display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin:26px 0 18px}
 :global(.article-reading .prose .shipment-photo-grid figure){min-width:0;margin:0}
 :global(.article-reading .prose .shipment-photo-grid img){display:block;width:100%;height:235px;aspect-ratio:4/3;object-fit:cover;border:1px solid var(--border);border-radius:10px}
 :global(.article-reading .prose .shipment-photo-grid figcaption){margin:10px 0 0;color:var(--muted);font-size:12px;line-height:1.5}
 :global(.article-reading .prose .shipment-archive-note){padding:15px 18px;background:var(--surface);border-left:3px solid var(--red);font-size:14px;line-height:1.65}
 :global(.article-reading .prose .shipment-history-gallery){display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin:26px 0 18px}
 :global(.article-reading .prose .shipment-history-gallery figure){margin:0;min-width:0}
 :global(.article-reading .prose .shipment-history-gallery img){display:block;width:100%;height:220px;object-fit:cover;border:1px solid var(--border);border-radius:10px}
 :global(.article-reading .prose .shipment-history-gallery figcaption){margin:10px 0 0;color:var(--muted);font-size:11px;line-height:1.5}
 :global(.article-reading .prose .workflow-ai-illustration){margin:28px 0}
 :global(.article-reading .prose .workflow-ai-illustration img){display:block;width:100%;height:auto;aspect-ratio:3/2;object-fit:cover;border-radius:12px}
 :global(.article-reading .prose .workflow-ai-illustration figcaption){margin-top:10px;color:var(--muted);font-size:12px;line-height:1.55}
 @media(max-width:850px){:global(.article-reading .prose .shipment-photo-grid){grid-template-columns:repeat(2,minmax(0,1fr))}:global(.article-reading .prose .process-comparison-photos){grid-template-columns:1fr 1fr}}
 @media(max-width:600px){.article-editorial-image{padding-inline:22px}.article-reading .prose :global(.decision-table){min-width:620px}:global(.article-reading .prose .shipment-photo-grid){grid-template-columns:1fr;gap:22px}:global(.article-reading .prose .shipment-photo-grid img){height:auto;aspect-ratio:1.4}:global(.article-reading .prose .shipment-history-gallery){grid-template-columns:1fr;gap:22px}:global(.article-reading .prose .shipment-history-gallery img){height:auto;aspect-ratio:1.45}:global(.article-reading .prose .process-comparison-photos){grid-template-columns:1fr}:global(.article-reading .prose .process-comparison-photos img){height:auto;aspect-ratio:1.5}}
</style>
<script>
 const contents=document.querySelector<HTMLDetailsElement>('.contents-disclosure');
 const mobile=matchMedia('(max-width:760px)');
 const adaptContents=()=>{if(contents)contents.open=!mobile.matches;};
 adaptContents();
 mobile.addEventListener('change',adaptContents);
</script>
