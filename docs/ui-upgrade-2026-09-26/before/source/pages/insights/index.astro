---
import {guideImages} from '../../data/refinedImages';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Arrow from '../../components/Arrow.astro';
import {resources} from '../../data/resources';
const guideGroups=[
 {id:'rfq-guides',title:'Prepare a useful RFQ',description:'Start with the drawing, part function and the information needed for a comparable quotation.',slugs:['rfq-checklist','how-we-work','custom-cnc-machined-components-for-prototypes-and-production']},
 {id:'engineering-guides',title:'Choose a route and specification',description:'Compare geometry, materials and finishing requirements before the machining route is confirmed.',slugs:['cnc-process-selection','material-and-finish-checklist']},
 {id:'delivery-guides',title:'Plan repeat orders and delivery',description:'Separate prototype approval, batch requirements, production timing and international transit.',slugs:['prototype-vs-small-batch-cnc','custom-cnc-parts-shipping-checklist']},
].map(group=>({...group,guides:group.slugs.map(slug=>resources.find(resource=>resource.slug===slug)).filter((resource):resource is (typeof resources)[number]=>Boolean(resource))}));
const news=resources.filter(resource=>resource.category==='Company news');
---
<Layout title="CNC machining resources and buyer guides" description="Guides to CNC machining inquiries, drawing preparation, inspection requirements and ordering custom parts from LZZ.">
 <PageHero lines={['CNC machining','buyer guides']}/>
 <div class="container resource-overview"><p>Find the next question for your drawing, process choice or order plan. Orders start at 1 piece; production takes 7–14 business days after drawing and order confirmation, including surface finishing. Shipping time is additional. Agree tolerances, records, price and delivery arrangements for your part.</p><nav aria-label="Guide topics">{guideGroups.map(group=><a href={'#'+group.id}>{group.title}</a>)}</nav></div>
 {guideGroups.map(group=><section class="container section resource-guides" id={group.id}><div class="section-heading"><div><h2>{group.title}</h2><p class="resource-group-intro">{group.description}</p></div></div><div class="resource-grid">{group.guides.map(r=><a href={'/insights/'+r.slug+'/'}>{guideImages[r.slug]&&<img class="resource-guide-image" data-image-origin={guideImages[r.slug].disclosure?'AI-generated':'source-photo'} src={guideImages[r.slug].image} srcset={guideImages[r.slug].srcset} sizes="(max-width:760px) 90vw, 400px" alt={guideImages[r.slug].alt} width="600" height="400" loading="lazy"/>}{guideImages[r.slug]?.disclosure&&<span class="resource-image-note">AI-generated illustrative image · {guideImages[r.slug].disclosure}</span>}<h3>{r.title}</h3><p>{r.description}</p><span class="text-link">Read the guide <Arrow/></span></a>)}</div></section>)}
 <section class="container journal-section section" aria-labelledby="company-news-title"><div class="section-heading"><h2 id="company-news-title">Company news</h2></div>
  {news.map(a=><article class="journal-story"><a class="journal-image" href={'/insights/'+a.slug+'/'} tabindex="-1" aria-hidden="true"><img src={a.image} srcset={guideImages[a.slug]?.srcset} sizes="(max-width:760px) 90vw, 600px" alt={guideImages[a.slug]?.alt||a.title} width="650" height="430" loading="lazy"/></a><div class="journal-copy"><h2><a href={'/insights/'+a.slug+'/'}>{a.title}</a></h2><a class="text-link" href={'/insights/'+a.slug+'/'}>Read article <Arrow/></a></div></article>)}
 </section>
</Layout>
<style>.resource-overview{padding-block:42px 12px}.resource-overview>p{max-width:850px;font-size:18px;line-height:1.65}.resource-overview nav{display:flex;flex-wrap:wrap;gap:10px;margin-top:24px}.resource-overview nav a{display:inline-flex;align-items:center;min-height:44px;padding:10px 15px;border:1px solid var(--border);border-radius:8px;font-size:14px;font-weight:650}.resource-overview nav a:hover{border-color:var(--red);color:var(--red)}.resource-guides{padding-top:45px;padding-bottom:35px;scroll-margin-top:100px}.resource-guides+.resource-guides{border-top:1px solid var(--border)}.resource-group-intro{font-size:16px;line-height:1.65;max-width:680px;margin-top:14px}.resource-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:36px}.resource-grid>a{display:flex;flex-direction:column;align-items:flex-start;border-top:2px solid var(--ink);padding-top:24px}.resource-grid .resource-guide-image{width:100%;height:220px;object-fit:cover;border-radius:9px}.resource-grid .resource-image-note{font-size:11px;line-height:1.45;color:var(--muted);margin-top:8px}.resource-grid h3{font-size:29px;line-height:1.15;margin:18px 0}.resource-grid p{font-size:16px;line-height:1.7;margin-bottom:24px}.resource-grid .text-link{margin-top:auto}.journal-section{border-top:1px solid var(--border)}.journal-copy>p:not(.article-category){margin-top:20px}@media(max-width:760px){.resource-overview{padding-block:30px 10px}.resource-overview>p{font-size:15px}.resource-grid{grid-template-columns:1fr;gap:36px}.resource-guides{padding-top:38px}}</style>
