---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import Materials from '../components/Materials';
import FactorySection from '../components/FactorySection.astro';
import EvidenceImage from '../components/EvidenceImage.astro';
import {engineeringCases} from '../data/cases';
import {services} from '../data/services';
import catalog from '../data/catalog.json';
import {productImage,productSrcset} from '../data/refinedImages';
import '../styles/home-current.css';
const selections=[
 {slug:'ultra-high-precision-machining-services',name:'Machining an impeller'},
 {slug:'custom-high-precision-cnc-milling-5-axis-machining-services-oem-odm',name:'Multi-bore milled component'},
 {slug:'precision-stainless-steel-indexing-plunger-manufacturer-and-spring-loaded-locking-pin-supplier',name:'Turned locking pin'}
].map(s=>({...s,product:catalog.products.find(p=>p.slug===s.slug)!}));
---
<Layout immersive cta={false}>
 <section class="precision-hero">
  <img class="precision-scene" src="/media/machining-hero-v2.webp" alt="CNC spindle above a metal workpiece" width="1672" height="941" fetchpriority="high"/>
  <div class="container precision-message"><h1>Your parts<br/>Machined to order</h1><p>Custom CNC machining for prototypes<br class="desktop-break"/> and small production runs.</p><a class="button" href="/quote/">Discuss your part <Arrow/></a><p class="hero-note">From 1 piece · 7–14 business days · ISO 9001 certified</p></div>
  <div class="container hero-baseline"><a href="#selected-parts">See our work <Arrow/></a></div>
 </section>
 <FactorySection/>
 <section class="selected-parts container" id="selected-parts">
  <div class="selected-heading"><div><h2>Curves, bores and threads</h2></div><a class="text-link" href="/products/">Browse all parts <Arrow/></a></div>
  <div class="selected-grid">{selections.map((s,i)=><a class:list={['selected-part',{'selected-main':i===0}]} href={`/products/${s.slug}/`}><div class="selected-image"><img src={productImage(s.product)} srcset={productSrcset(s.product)} sizes="(max-width:760px) 90vw, 400px" alt={s.product.name} width="800" height="800" loading="lazy"/></div><div class="selected-info"><h3>{s.name}</h3></div></a>)}</div>
 </section>
 <section class="container home-cases section"><div class="section-heading"><div><h2>How parts take shape</h2></div></div><div class="home-case-grid">{engineeringCases.map(item=><a href={'/cases/'+item.slug+'/'}><EvidenceImage id={item.hero} sizes="(max-width:760px) 90vw, 30vw"/><h3>{item.title}</h3></a>)}</div></section>
 <section class="machining-editorial" id="capabilities"><div class="container machining-layout">
  <div class="machining-visual"><EvidenceImage id="five-axis-machine-wide" sizes="(max-width:760px) 100vw, 50vw"/></div>
  <div class="machining-copy"><h2>The right process<br/>for your part</h2><div class="machining-services">{services.map(s=><a href={`/capabilities/${s.slug}/`}><h3>{s.name}</h3><Arrow/></a>)}</div><a class="text-link" href="/capabilities/">View machining capabilities <Arrow/></a></div>
 </div></section>
 <section class="materials section"><div class="container"><div class="section-heading"><div><h2>Metals and plastics</h2></div></div><Materials client:visible/></div></section>
 <section class="project-start section"><div class="container">
  <div class="section-heading"><div><h2>What to send for a quote</h2></div></div>
  <div class="project-start-layout"><figure><img src="/media/project-detail-v4.webp" alt="Close-up of machined aluminum pockets, a bore and threaded holes" width="1400" height="933" loading="lazy"/></figure><div class="start-options">
   <article><h3>Have a drawing?</h3><a class="button" href="/quote/">Prepare an inquiry <Arrow/></a></article>
   <article><h3>Still preparing?</h3><a class="text-link" href="/insights/rfq-checklist/">View the RFQ checklist <Arrow/></a></article>
  </div></div>
 </div></section>
</Layout>
<style>
 .home-case-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:26px}.home-case-grid>a{min-width:0;border-top:1px solid var(--border);padding-top:22px}.home-case-grid :global(img){display:block;width:100%;height:250px;object-fit:cover}.home-case-grid h3{font-size:27px;line-height:1.15;margin:16px 0 0}.home-case-grid>a:hover h3{color:var(--red)}@media(max-width:760px){.home-case-grid{grid-template-columns:1fr;gap:35px}.home-case-grid :global(img){height:auto;aspect-ratio:1.55}}
</style>
