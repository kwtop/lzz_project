---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import {photo} from '../../data/evidence';
import ProductExplorer from '../../components/ProductExplorer';
import catalog from '../../data/catalog.json';
const products=catalog.products.map(({slug,name,categories,images})=>({slug,name,categories,images}));
---
<Layout title="Custom parts: machining examples" description="Browse custom CNC machined part examples by process and material, including housings, shafts, fittings and complex components.">
 <PageHero variant="compact-catalog" lines={['Custom machined','parts']} image={photo('five-axis-operation').src} imageAlt={photo('five-axis-operation').alt} imageCaption="Original LZZ multi-axis machining photograph. This image does not establish a material grade, tolerance or accepted order." imageSrcset={photo('five-axis-operation').srcset}/>
 <section class="container catalog-intro" aria-labelledby="catalog-intro-title"><div><p class="catalog-eyebrow">Part examples, not stock items</p><h2 id="catalog-intro-title">Start with the shape and job of your part.</h2></div><div><p>These are made-to-drawing examples, not stocked SKUs with fixed specifications. Filter by feature, process or material; send your controlled drawing for a project-specific review.</p><a href="/insights/rfq-checklist/">What to include in your drawing package</a></div></section>
 <section class="container section catalog-section"><ProductExplorer products={products} categories={catalog.categories} client:load/></section>
 <nav class="container geometry-paths" aria-label="Browse part examples by geometry"><a href="/products/small-batch-cnc-machining-manufacturer-complex-aluminum-housings/"><strong>Housings &amp; pockets</strong><span>Walls, cavities, interfaces</span></a><a href="/products/custom-cnc-turned-stainless-steel-components-manufacturer-and-precision-shaft-supplier/"><strong>Shafts &amp; turned parts</strong><span>Diameters, fits, runout</span></a><a href="/products/custom-oem-cnc-turned-fittings-connectors-and-flanges-manufacturer/"><strong>Fittings &amp; flanges</strong><span>Threads and sealing faces</span></a><a href="/products/custom-cnc-machined-castings-transmission-housings-pump-bodies/"><strong>Cast blanks to finish</strong><span>Machining allowance and datums</span></a></nav>
</Layout>
<style>
 .catalog-intro{display:grid;grid-template-columns:1fr 1fr;gap:7%;padding-block:58px 30px;border-bottom:1px solid var(--border)}.catalog-eyebrow{font-size:12px;font-weight:750;color:var(--red);letter-spacing:.08em;text-transform:uppercase;margin-bottom:13px}.catalog-intro h2{font-size:clamp(30px,3.2vw,46px);line-height:1.1;max-width:16ch}.catalog-intro>div:last-child p{font-size:17px;line-height:1.65;max-width:62ch}.catalog-intro>div:last-child a{display:inline-flex;min-height:44px;align-items:center;border-bottom:1px solid var(--red);font-weight:650;margin-top:15px}.geometry-paths{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;padding-block:22px 64px;border-top:1px solid var(--border)}.geometry-paths a{display:flex;flex-direction:column;gap:8px;padding:17px 0;border-top:2px solid var(--ink);min-width:0}.geometry-paths strong{font-size:17px;line-height:1.25}.geometry-paths span{font-size:13px;color:var(--muted);line-height:1.45}.geometry-paths a:hover strong{color:var(--red)}@media(max-width:760px){.catalog-intro{grid-template-columns:1fr;gap:14px;padding-block:20px 11px}.catalog-intro>div:last-child p{font-size:14px;line-height:1.5}.catalog-intro>div:last-child a{font-size:13px;margin-top:8px}.geometry-paths{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.geometry-paths strong{font-size:15px}:global(body.brand-site.task-pages .catalog-section){padding-top:18px}}
</style>
