---
import Layout from '../../layouts/Layout.astro';
import Arrow from '../../components/Arrow.astro';
import EvidenceImage from '../../components/EvidenceImage.astro';
import {engineeringCases} from '../../data/cases';
import {photo} from '../../data/evidence';
import {casePartExamples} from '../../data/editorialLinks';
import {productTitle} from '../../data/presentation';
import catalog from '../../data/catalog.json';
export function getStaticPaths(){return engineeringCases.map(item=>({params:{slug:item.slug},props:{item}}));}
const {item}=Astro.props;
const sections=[['Workpiece & requirements',item.workpiece],['Setup & sequence',item.setup],['Visible part features',item.visible],['Inspection to agree for a similar part',item.inspection]];
const examples=(casePartExamples[item.slug]||[]).map(slug=>catalog.products.find(product=>product.slug===slug)).filter((product):product is (typeof catalog.products)[number]=>Boolean(product));
---
<Layout title={item.title} description={item.lead} article articleImage={photo(item.hero).src}>
 <nav class="container breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/cases/">Process studies</a><span>/</span><span aria-current="page">{item.title}</span></nav>
 <article class="container case-study"><header><h1>{item.title}</h1><p>{item.lead}</p></header>
  <figure class="case-hero"><EvidenceImage id={item.hero} sizes="(max-width:760px) 100vw, 1100px" loading="eager"/></figure>
  <div class="case-content"><div class="case-sections">{sections.map(([heading,copy],index)=><section><span>{String(index+1).padStart(2,'0')}</span><div><h2>{heading}</h2><p>{copy}</p></div></section>)}</div><aside><h2>Source boundary</h2><p>These are original LZZ process photographs. The source set contains no controlled drawing, measurement report or material certificate for this study.</p><h3>Related capabilities</h3>{item.relatedCapabilities.map(slug=><a href={'/capabilities/'+slug+'/'}>{slug.replaceAll('-',' ')} <Arrow size={16}/></a>)}<a href="/quote/" class="button">Discuss your drawing <Arrow size={18}/></a></aside></div>
  <section class="case-gallery"><h2>Photographs from the process</h2><div>{item.photos.map(id=><figure><EvidenceImage id={id} sizes="(max-width:760px) 90vw, 45vw"/></figure>)}</div></section>
  <section class="case-related" aria-labelledby="case-related-title"><h2 id="case-related-title">Explore similar part geometry</h2><p>These catalog examples illustrate related forms and drawing questions. They are not identified as the workpieces in the photographs above or as results from the same customer project.</p><div>{examples.map(product=><a href={'/products/'+product.slug+'/'}>{productTitle(product)}</a>)}</div></section>
  <a class="text-link" href="/cases/">See all process studies <Arrow/></a>
 </article>
</Layout>
<style>
 .case-study{padding-bottom:90px}.case-study header{padding:55px 0 45px;max-width:970px}.case-study h1{font-size:clamp(48px,6vw,88px);line-height:1.02;letter-spacing:-.04em;margin:17px 0}.case-study header p{font-size:clamp(18px,2vw,23px);line-height:1.55;max-width:760px}.case-hero{margin:0}.case-hero :global(img){width:100%;height:min(64vw,680px);min-height:390px;object-fit:cover;display:block}.case-study figcaption{font-size:13px;line-height:1.55;color:var(--muted);padding-top:12px}.case-content{display:grid;grid-template-columns:minmax(0,1fr) 310px;gap:8%;padding-block:65px}.case-sections section{display:grid;grid-template-columns:40px minmax(0,1fr);gap:24px;border-top:1px solid var(--border);padding:27px 0}.case-sections span{font-size:13px;color:var(--red)}.case-sections h2{font-size:clamp(24px,3vw,36px);line-height:1.18}.case-sections p{font-size:17px;line-height:1.72;max-width:690px;margin-top:14px}.case-content aside{background:var(--surface);padding:28px;align-self:start}.case-content aside h2{font-size:22px}.case-content aside h3{font-size:17px;margin-top:30px}.case-content aside p{line-height:1.65;margin-top:12px}.case-content aside>a:not(.button){display:flex;justify-content:space-between;gap:15px;text-transform:capitalize;padding:12px 0;border-bottom:1px solid var(--border)}.case-content aside .button{margin-top:27px}.case-gallery{border-top:1px solid var(--border);padding:45px 0}.case-gallery h2{font-size:38px;margin-bottom:30px}.case-gallery>div{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.case-gallery figure{margin:0;min-width:0}.case-gallery :global(img){width:100%;height:390px;object-fit:cover;display:block}@media(max-width:850px){.case-content{grid-template-columns:1fr;gap:24px}.case-gallery>div{grid-template-columns:1fr}.case-gallery :global(img){height:auto;aspect-ratio:1.35}.case-hero :global(img){height:auto;min-height:0;aspect-ratio:1.3}.case-study header{padding-top:35px}}
 .case-related{border-top:1px solid var(--border);padding:42px 0}.case-related h2{font-size:clamp(26px,3vw,36px)}.case-related p{max-width:760px;font-size:14px;line-height:1.65;color:var(--muted);margin:12px 0 22px}.case-related>div{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px}.case-related a{display:block;border:1px solid var(--border);border-radius:10px;padding:18px 20px;font-weight:650;line-height:1.35}.case-related a:hover{border-color:var(--red);color:var(--red)}@media(max-width:600px){.case-related>div{grid-template-columns:1fr}}
</style>
