---
import {productImage,productSrcset} from '../data/refinedImages';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Arrow from '../components/Arrow.astro';
import EvidenceImage from '../components/EvidenceImage.astro';
import CompanyFacts from '../components/CompanyFacts.astro';
import {applications,companyHistory} from '../data/company';
import CompanyNetwork from '../components/CompanyNetwork.astro';
import CompanyArchive from '../components/CompanyArchive.astro';
import ApplicationContexts from '../components/ApplicationContexts.astro';
import catalog from '../data/catalog.json';
import {productTitle} from '../data/presentation';
const featured=[
 {slug:'custom-cnc-machined-electronic-throttle-body-manufacturer-and-automotive-prototype-supplier'},
 {slug:'precision-stainless-steel-cnc-turned-parts-manufacturer-and-316l-components-supplier'},
 {slug:'precision-cnc-machining-for-complex-plastic-geometries-and-tight-tolerances'},
].map(item=>({...item,product:catalog.products.find(p=>p.slug===item.slug)!}));
const documentNotes=[
 {title:'Precision manufacturing teaching base',type:'Education collaboration plaque',description:'The plaque names Zhejiang Institute of Mechanical & Electrical Engineering and Lizhizao as a practical teaching base for AI precision manufacturing.',date:'November 2023, as printed.',scope:'Education collaboration, not a quality-system certificate.'},
 {title:'High-tech enterprise certificate',type:'Enterprise recognition',description:'The original names Hangzhou Lizhizao Precision Machinery Co., Ltd. and carries Zhejiang science and technology, finance and tax authority seals.',date:'Issued 8 December 2023; the printed validity period is three years.',scope:'Enterprise recognition, not a product conformity or ISO certificate.'},
 {title:'Zhejiang science & technology SME',type:'Provincial enterprise recognition',description:'The certificate names Lizhizao as a Zhejiang science and technology small or medium-sized enterprise. Zhejiang’s science and technology authority is named on the document.',date:'No issue date is stated in the displayed document.',scope:'Enterprise recognition; current status and applicable scope should be confirmed.'}
];
const certificates=catalog.companyAssets.filter(asset=>asset.source.includes('/certificate/'));
---
<Layout title="About LZZ: precision manufacturing in Hangzhou" description="See LZZ's company history, original company documents, machining workshop, team activities and factory visit photographs in Hangzhou.">
 <PageHero lines={['CNC machining','in Hangzhou']} image="/media/company-parts-retouched-v2.webp" imageAlt="Assorted machined metal components" imageClass="company-parts"/>
 <section class="company-introduction container section">
  <div><h2>Custom parts<br/>since 2017</h2><p class="company-name">Hangzhou Lizhizao<br/>Precision Machinery Co., Ltd.</p><p class="company-tagline">Your CNC machining partner from China.</p></div>
  <div class="company-text"><p>We are an ISO 9001-certified CNC machining company. We make prototypes and small production batches from drawings or samples, with orders starting at 1 piece.</p><a class="text-link" href="/factory/">Inside our factory <Arrow/></a></div>
 </section>
 <div class="container"><CompanyFacts/></div>
 <section class="container section" id="company-history"><div class="section-heading"><h2>Our company<br/>over time</h2></div><ol class="company-history">{companyHistory.map((stage,index)=><li><span>{String(index+1).padStart(2,'0')}</span><h3>{stage.title}</h3><p>{stage.text}</p></li>)}</ol></section>
 <section class="container section" id="documents"><div class="section-heading"><h2>Company documents</h2><p class="section-intro">These original Chinese documents record enterprise recognition and education collaboration; none is the ISO 9001 certificate. LZZ is ISO 9001 certified. Ask us for certificate details and applicable scope during supplier qualification. <a href="/quality/">See quality control and inspection information.</a></p></div>
  <div class="certificate-grid">{certificates.map((certificate,index)=>{const note=documentNotes[index];return <article class="certificate-document">
   <a class="certificate-image" href={certificate.image} target="_blank" rel="noopener noreferrer" aria-label={'Open original '+note.title}><img src={certificate.image} alt={note.title+', original Chinese document'} width="400" height="520" loading="lazy"/></a>
   <div class="certificate-copy"><h3>{note.title}</h3><p class="document-type">{note.type}</p><p class="document-scope">{note.scope}</p><details class="document-detail"><summary>Issuer and date details</summary><p>{note.description}</p><p>{note.date}</p></details><a class="text-link" href={certificate.image} target="_blank" rel="noopener noreferrer">View original document <Arrow size={18}/></a></div>
  </article>;})}</div>
 </section>
 <section class="company-evidence surface-band"><div class="container company-evidence-inner"><figure class="equipment-feature"><EvidenceImage id="workshop-aisle" sizes="(max-width:760px) 90vw, 50vw"/></figure><div><h2>Your project<br/>in production</h2><a class="text-link" href="/insights/how-we-work/">See the project steps <Arrow/></a></div></div></section>
 <section class="section" id="applications"><div class="container"><div class="section-heading"><h2>Parts for<br/>your industry</h2></div><div class="application-grid">{applications.map(application=><details class="application-item"><summary>{application.title}</summary><p>{application.description}</p><a class="text-link" href={application.href}>{application.label}<Arrow size={18}/></a></details>)}</div><p class="application-note">Application examples adapted from the original company brochure. They do not establish customer relationships, past supply, regulatory qualification, certification or suitability for a specific end use. Share the drawing and applicable standards so each project can be reviewed.</p></div></section>
 <ApplicationContexts/>
 <section class="container section" id="part-studies"><div class="section-heading"><h2>A closer look<br/>at our parts</h2></div><div class="part-study-grid">{featured.map(item=><article><img src={productImage(item.product)} srcset={productSrcset(item.product)} sizes="(max-width:760px) 112px, 400px" width="800" height="800" loading="lazy" alt={productTitle(item.product)}/><h3>{productTitle(item.product)}</h3><a class="text-link" href={'/products/'+item.slug+'/#engineering-review'}>Read the engineering notes <Arrow size={18}/></a></article>)}</div></section>
 <CompanyNetwork/>
 <CompanyArchive/>
</Layout>
<style>
 .company-tagline{margin-top:16px;font-size:14px;line-height:1.5;color:var(--muted);font-weight:600}.company-history{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:28px}.company-history li{border-top:1px solid var(--border);padding-top:22px}.company-history span{font-size:14px;color:var(--red)}.company-history h3{font-size:25px;line-height:1.18;margin:24px 0 16px}.company-history p{font-size:15px;line-height:1.75}@media(max-width:1000px){.company-history{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.company-history{grid-template-columns:1fr;gap:28px}.company-history h3{margin-top:16px}}
 .application-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:30px 36px}.application-grid details{border-top:1px solid var(--border);padding-top:20px;min-width:0}.application-grid summary{cursor:pointer;list-style:none;font-size:19px;line-height:1.3;font-weight:650}.application-grid summary::-webkit-details-marker{display:none}.application-grid summary:focus-visible{outline:2px solid var(--red);outline-offset:4px}.application-grid details p{margin:16px 0;font-size:15px;line-height:1.65}.application-grid .text-link{font-size:13px}.application-note{margin-top:35px;font-size:13px;line-height:1.65;max-width:900px;color:var(--muted)}
 .part-study-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:36px}.part-study-grid img{width:100%;height:auto;aspect-ratio:1;object-fit:contain;background:#fff;border:1px solid #e6e8e9}.part-study-grid h3{margin-top:24px;font-size:28px;line-height:1.15}.part-study-grid p{margin:18px 0;font-size:16px}
 @media(max-width:1000px){.application-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:760px){.application-grid,.part-study-grid{grid-template-columns:1fr;gap:36px}.application-grid h3,.part-study-grid h3{font-size:27px}}
</style>
