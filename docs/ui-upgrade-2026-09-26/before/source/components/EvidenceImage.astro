---
import {photo} from '../data/evidence';
const {id,sizes='(max-width: 760px) 100vw, 50vw',loading='lazy',class:className}=Astro.props;
const item=photo(id);
---
<img class={className} src={item.src} srcset={item.srcset} sizes={sizes} width={item.width} height={item.height} alt={item.alt} loading={loading} decoding="async"/>
