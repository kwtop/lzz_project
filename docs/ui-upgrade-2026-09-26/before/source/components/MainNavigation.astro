---
const current=Astro.url.pathname;
const processLinks=[
 {title:'CNC Milling',href:'/capabilities/cnc-milling-service/'},
 {title:'CNC Turning',href:'/capabilities/cnc-turning-service/'},
 {title:'5-Axis Machining',href:'/capabilities/5-axis-cnc-machining/'},
 {title:'Casting Machining',href:'/capabilities/casting-machining/'},
];
const evidenceLinks=[{title:'Our Factory',href:'/factory/'},{title:'Quality Control',href:'/quality/'},{title:'Workshop Process Studies',href:'/cases/'}];
const resourceLinks=[{title:'All Buyer Guides',href:'/insights/'},{title:'Drawing & RFQ Checklist',href:'/insights/rfq-checklist/'},{title:'Compare Machining Processes',href:'/insights/cnc-process-selection/'},{title:'How to Order',href:'/insights/how-we-work/'}];
---
<nav id="main-nav" aria-label="Main navigation">
 <details name="main-navigation" class="nav-group" data-active={current.startsWith('/capabilities/')||undefined}>
  <summary>Capabilities</summary>
  <div class="nav-panel nav-panel-capabilities"><a class="nav-overview" href="/capabilities/">All Machining Capabilities</a><div class="nav-columns"><div><p class="nav-group-label">Machining processes</p>{processLinks.map(link=><a href={link.href} aria-current={current===link.href?'page':undefined}>{link.title}</a>)}</div><div><p class="nav-group-label">Start from your requirement</p><a href="/capabilities/#materials">Materials</a><a href="/capabilities/#production-stages">Prototype &amp; small batch</a><a href="/capabilities/#sample-to-part">Starting with a sample</a></div></div></div>
 </details>
 <a href="/products/" aria-current={current.startsWith('/products/')?'page':undefined}>Part Examples</a>
 <details name="main-navigation" class="nav-group" data-active={['/factory/','/quality/'].includes(current)||current.startsWith('/cases/')||undefined}><summary>Factory &amp; Quality</summary><div class="nav-panel nav-panel-small">{evidenceLinks.map(link=><a href={link.href} aria-current={current===link.href?'page':undefined}>{link.title}</a>)}</div></details>
 <details name="main-navigation" class="nav-group nav-group-resources" data-active={current.startsWith('/insights/')||undefined}><summary>Resources</summary><div class="nav-panel nav-panel-small">{resourceLinks.map(link=><a href={link.href} aria-current={current===link.href?'page':undefined}>{link.title}</a>)}</div></details>
 <a href="/about/" aria-current={current==='/about/'?'page':undefined}>About LZZ</a>
</nav>
<script>
 const nav=document.querySelector('#main-nav')!;
 const groups=Array.from(nav.querySelectorAll<HTMLDetailsElement>('.nav-group'));
 const closeGroups=()=>groups.forEach(g=>g.open=false);
 groups.forEach(group=>{
  group.addEventListener('toggle',()=>{if(group.open)groups.filter(g=>g!==group).forEach(g=>g.open=false);});
  group.addEventListener('keydown',event=>{if(event.key==='Escape'&&group.open){event.stopPropagation();group.open=false;group.querySelector('summary')?.focus();}});
 });
 document.addEventListener('click',event=>{if(event.target instanceof Node&&!nav.contains(event.target))closeGroups();});
 nav.addEventListener('focusout',()=>{requestAnimationFrame(()=>{if(!nav.contains(document.activeElement))closeGroups();});});
 document.querySelector('.site-header')?.addEventListener('pointerleave',event=>{if(event instanceof PointerEvent&&event.pointerType==='mouse'&&matchMedia('(min-width:961px)').matches)closeGroups();});
 nav.addEventListener('click',event=>{if(event.target instanceof Element&&event.target.closest('a')){closeGroups();document.querySelector('.site-header')?.classList.remove('menu-open');const toggle=document.querySelector('.menu-toggle');toggle?.setAttribute('aria-expanded','false');toggle?.setAttribute('aria-label','Open navigation');}});
 matchMedia('(min-width:961px)').addEventListener('change',closeGroups);
</script>
