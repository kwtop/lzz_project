---
import Arrow from './Arrow.astro';
const {label='Related resources'}=Astro.props;
const links=[
 {href:'/quality/',title:'Quality & inspection'},
 {href:'/insights/rfq-checklist/',title:'Drawing & RFQ checklist'},
 {href:'/insights/cnc-process-selection/',title:'Choose a machining process'},
 {href:'/insights/prototype-vs-small-batch-cnc/',title:'Prototype vs small batch'},
 {href:'/insights/material-and-finish-checklist/',title:'Material & Finish Guide'},
 {href:'/insights/custom-cnc-parts-shipping-checklist/',title:'International shipping checklist'},
 {href:'/insights/how-we-work/',title:'How we work'},
];
---
<nav class="resource-links" id="related-resources" aria-label={label}>
 <h3>Related resources</h3>
 <div class="resource-link-grid">{links.map(link=><a href={link.href}><span>{link.title}</span><Arrow size={20}/></a>)}</div>
</nav>
<style>
 .resource-links{margin-block:42px 32px}
 .resource-links h3{font-size:20px;font-weight:550;line-height:1.3;margin:0 0 18px}
 .resource-link-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:36px}
 .resource-link-grid a{display:flex;align-items:center;justify-content:space-between;gap:20px;min-height:68px;padding:18px 12px;border-bottom:1px solid var(--border,#d6d9d9);color:var(--ink,#171b1e);text-decoration:none;font-size:16px;font-weight:500;line-height:1.5;transition:background-color .16s ease,color .16s ease}
 .resource-link-grid a:nth-child(-n+2){border-top:1px solid var(--border,#d6d9d9)}
 .resource-link-grid a span{min-width:0;overflow-wrap:anywhere}
 .resource-link-grid a :global(svg){flex-shrink:0;color:var(--red,#e5232e)}
 .resource-link-grid a:hover{background:var(--surface,#f1f2f3);color:var(--ink,#171b1e)}
 .resource-link-grid a:focus-visible{outline:2px solid var(--red,#e5232e);outline-offset:3px;background:var(--surface,#f1f2f3)}
 @media(max-width:760px){.resource-links{margin-block:34px 28px}.resource-link-grid{grid-template-columns:1fr}.resource-link-grid a{min-height:64px;padding:17px 8px;gap:16px}.resource-link-grid a:nth-child(2){border-top:0}}
 @media(prefers-reduced-motion:reduce){.resource-link-grid a{transition:none}}
</style>
