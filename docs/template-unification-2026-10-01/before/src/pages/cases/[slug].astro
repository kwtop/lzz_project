---
import Layout from '../../layouts/Layout.astro';
import PrismaticStudy from '../../components/PrismaticStudy.astro';
import Arrow from '../../components/Arrow.astro';
import EvidenceImage from '../../components/EvidenceImage.astro';
import {engineeringCases} from '../../data/cases';
import {photo} from '../../data/evidence';
import {casePartExamples} from '../../data/editorialLinks';
import {productTitle,categoryDetails} from '../../data/presentation';
import catalog from '../../data/catalog.json';
import WorkshopVideo from '../../components/WorkshopVideo.astro';
import ReferenceGallery from '../../components/ReferenceGallery.astro';
import WorkshopCollection from '../../components/WorkshopCollection.astro';
import {workshopCollections} from '../../data/workshopCollections';
export function getStaticPaths(){return engineeringCases.map(item=>({params:{slug:item.slug},props:{item}}));}
const {item}=Astro.props;
const sections=item.collection?workshopCollections[item.collection].map(section=>[section.title,section.copy]):[['The component',item.workpiece],['Machining setup',item.setup],['Machined features',item.visible],['Inspection planning',item.inspection]];
const examples=(casePartExamples[item.slug]||[]).map(slug=>catalog.products.find(product=>product.slug===slug)).filter((product):product is (typeof catalog.products)[number]=>Boolean(product));
const photographyScope=item.collection?"These photographs and clips come from the supplied LZZ material collection. They show separate part examples, not a single customer order. Material names follow the source labels; exact grades, dimensions and acceptance results require the order documents.":"The photographs come from the LZZ workshop and show the part shapes and setups discussed here. They do not confirm material grades, dimensions or inspection results, and no customer is identified. Use the drawing and inspection notes to plan a similar part.";
---
<Layout title={item.title} description={item.lead} article articleImage={photo(item.hero).src} cta={item.slug!=='milling-prismatic-components'}>
 {item.slug==='milling-prismatic-components'?<PrismaticStudy/>:<>
 <nav class="container breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/products/">Custom Parts</a><span>/</span><a href="/cases/">Machining Studies</a><span>/</span><span aria-current="page">{item.title}</span></nav>
 <article class="container case-study"><header><h1>{item.title}</h1><p>{item.lead}</p></header>
  <div class="case-procurement"><details class="case-source" open><summary>Photography &amp; project scope</summary><p>{photographyScope}</p></details><a href="/quote/" class="button">Discuss your drawing <Arrow size={18}/></a></div>
  <details class="study-contents" open={Boolean(item.collection)}><summary>On this page</summary><nav class="page-jump-nav" aria-label="Study sections">{sections.map(([heading],index)=><a href={item.collection?'#'+workshopCollections[item.collection][index].id:'#study-'+index}>{heading}</a>)}</nav></details>

  <div class="case-content">{item.collection?<WorkshopCollection collection={item.collection}/>:<div class="case-sections">{sections.map(([heading,copy],index)=><section id={'study-'+index}><figure>{index<2&&<><EvidenceImage id={item.photos[index]} sizes="(max-width:760px) 90vw, 560px" loading={index===0?'eager':'lazy'}/><figcaption>{String(index+1).padStart(2,'0')} · LZZ workshop</figcaption></>}</figure><div><h2>{heading}</h2><p>{copy}</p></div></section>)}</div>}<aside><h3>Related capabilities</h3>{item.relatedCapabilities.map(slug=><a href={'/capabilities/'+slug+'/'}>{categoryDetails[slug]?.title||slug.replaceAll('-',' ')} <Arrow size={16}/></a>)}</aside></div>

  {item.video&&<><ReferenceGallery ids={['display-housing-pair']} title="Two faces of the enclosure"/><WorkshopVideo id={item.video} title="Watch the display housing in the workshop" description="The clip shows a person holding and turning the machined panel, followed by a view of the CNC machine and workpiece. Compare the broad faces, internal recesses and overall form."/></>}
  {examples.length>0&&<section class="case-related" aria-labelledby="case-related-title"><h2 id="case-related-title">Parts with similar features</h2><p>Separate catalog examples for a similar enquiry.</p><div>{examples.map(product=><a href={'/products/'+product.slug+'/'}>{productTitle(product)}</a>)}</div></section>}
  <a class="text-link" href="/cases/">See all process studies <Arrow/></a>
 </article>
 </>}
</Layout>
<style>
 .case-procurement{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:24px 40px;align-items:start;border-top:1px solid var(--border);border-bottom:1px solid var(--border);padding:18px 0 24px;margin-bottom:24px}.case-source{min-width:0}.case-source p{font-size:15px;line-height:1.7;margin-top:10px;max-width:75ch}.case-procurement>.button{margin-top:4px;white-space:nowrap}.study-contents[open] .page-jump-nav{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:4px 24px;padding-block:8px 16px}.study-contents[open] .page-jump-nav a{min-width:0;line-height:1.5}
 .case-source summary{cursor:pointer;min-height:44px;display:list-item;font-size:16px;font-weight:550}.case-study{padding-bottom:96px}.case-study header{padding:24px 0 28px;max-width:970px}.case-study h1{font-size:var(--type-display);line-height:1.12;letter-spacing:-.035em;margin:16px 0;font-weight:550}.case-study header p{font-size:18px;line-height:1.7;max-width:70ch}
 .study-contents{margin-bottom:24px}.study-contents>summary{font-size:16px;font-weight:600;min-height:44px;cursor:pointer;padding:12px 0}
 .case-content{padding-bottom:56px}.case-sections{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:48px 40px}.case-sections section{min-width:0;scroll-margin-top:110px}.case-sections section:first-child{grid-column:1/-1;display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);align-items:center;gap:48px}.case-sections section:nth-child(2){grid-column:1/-1;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));align-items:center;gap:40px}.case-sections figure{margin:0;min-width:0}.case-sections figure:empty{display:none}.case-sections :global(img){display:block;width:100%;height:auto;max-height:520px;object-fit:contain;background:#fff}.case-sections section:nth-child(2) figure{max-width:460px}.case-study figcaption{font-size:14px;line-height:1.6;color:var(--muted);padding-top:12px}.case-sections section:nth-child(n+3){border-top:1px solid var(--border);padding-top:32px}.case-study .case-sections h2{font-size:clamp(26px,3vw,36px);line-height:1.2}.case-sections p{font-size:17px;line-height:1.75;max-width:70ch;margin-top:16px}
 .case-content aside{margin-top:64px;padding-top:32px;border-top:1px solid var(--border)}.case-study aside h2{font-size:26px}.case-study aside h3{font-size:18px;margin-top:28px}.case-content aside p{line-height:1.7;margin-top:16px;max-width:75ch}.case-content aside>a:not(.button){display:flex;align-items:center;justify-content:space-between;gap:24px;max-width:460px;min-height:44px;text-transform:capitalize;padding:12px 0;border-bottom:1px solid var(--border)}.case-content aside>a:not(.button):hover{color:var(--red)}.case-content aside .button{margin-top:28px}
 .case-related{border-top:1px solid var(--border);padding:48px 0}.case-study .case-related h2{font-size:clamp(28px,3vw,36px)}.case-related p{max-width:75ch;font-size:16px;line-height:1.7;color:var(--muted);margin:16px 0 24px}.case-related>div{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px 40px}.case-related a{display:flex;align-items:center;min-height:48px;border-bottom:1px solid var(--border);padding:16px 0;font-weight:600;line-height:1.5}.case-related a:hover{border-color:var(--red);color:var(--red)}
 @media(max-width:760px){.case-study{padding-bottom:56px}.case-study header{padding:32px 0}.case-study header p{font-size:16px}.case-procurement{grid-template-columns:1fr;gap:16px;padding-block:20px}.case-procurement>.button{grid-row:1;justify-self:start;margin:0}.case-source{grid-row:2}.study-contents[open] .page-jump-nav{grid-template-columns:1fr;gap:0}.case-sections,.case-sections section:first-child,.case-sections section:nth-child(2){grid-template-columns:1fr;gap:28px}.case-sections{gap:40px}.case-sections section:nth-child(2) figure{max-width:none}.case-sections p{font-size:16px}.case-content{padding-bottom:40px}.case-content aside{margin-top:40px}.case-related{padding-block:32px}.case-related>div{grid-template-columns:1fr}}
</style>
