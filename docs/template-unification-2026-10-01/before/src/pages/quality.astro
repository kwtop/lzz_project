---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import EvidenceImage from '../components/EvidenceImage.astro';
const qualificationFields=[
 'Named legal entity: Hangzhou Lizhizao Precision Machinery Co., Ltd.',
 'Certificate number, issuing certification body and verification method.',
 'Issue and expiry dates, covered site and certified activities.',
 'The current certificate copy and the inspection records required for your project.',
];
const qualificationBody='Please provide the current ISO 9001 certificate for Hangzhou Lizhizao Precision Machinery Co., Ltd., including certificate number, issuing body, validity dates, covered site, scope and verification method.\n\nProject / drawing reference:\nRequired inspection records:';
const qualificationHref='mailto:roger@lzz-cnc.com?subject='+encodeURIComponent('Supplier qualification documents')+'&body='+encodeURIComponent(qualificationBody);

const stages=[
 {number:'01',title:'Drawing review',text:'Agree critical features, datums and acceptance criteria.'},
 {number:'02',title:'First article',text:'Check the initial part before the production run. Agree any customer approval hold point in advance.'},
 {number:'03',title:'In-process checks',text:'Inspect agreed features during machining.'},
 {number:'04',title:'Final inspection',text:'Verify the finished parts against the agreed order.'},
];

const quoteHref='/quote/?'+new URLSearchParams({part:'Quality review — inspection requirements and order records'}).toString();
const priorities=[['Critical features','Identify key dimensions, datums and functional requirements from your drawing.'],['Measurement method','Agree suitable inspection equipment and acceptance limits.'],['Required records','Confirm the reports and documents you need before machining starts.']];
const documents=[
 ['Dimensional & first-article reports','Reports identify the part number, drawing revision and part or batch reference. Specify whether acceptance dimensions apply before or after finishing; use the report fields above to agree the required results.'],
 ['Material records','Specify the material grade, condition and required traceability. The quotation confirms which material documents will accompany your order.'],
 ['Finishing documents','We arrange the treatment documentation required by your order, linked to the specified process and part or batch. State any special acceptance test or document requirement before production.'],
 ['Surface & batch acceptance','Mark cosmetic faces, masked areas and edge conditions. Include sampling requirements and the approval process for any proposed deviation.'],
];
const methods=[['Coordinate measuring machine (CMM)','Positions and geometric features against drawing datums.'],['Height gauges','Heights and dimensions in the agreed setup.'],['Optical projectors','Profiles suited to optical measurement.'],['Other checks to specify','For threads, roughness, coating thickness or hardness, state the method and acceptance criteria on your drawing. Confirm checks and records with the quotation.']];
---
<Layout title="Quality control for custom CNC machined parts" description="LZZ is ISO 9001 certified. Review its machining inspection stages, dimensional checks and the records to specify with your order." cta={false}>
 <article class="qv-page">
  <header class="qv-wrap qv-hero">
   <div><h1>Quality control for<br/>CNC machined parts</h1><p class="qv-lead">Dimensional checks, material requirements and inspection records, agreed against your drawing.</p>
    <dl class="qv-priorities">{priorities.map(([label,text])=><div><dt>{label}</dt><dd>{text}</dd></div>)}</dl>
    <a class="qv-button" href={quoteHref}>Discuss your inspection needs <Arrow size={18}/></a>
   </div>
   <figure class="qv-hero-photo" data-image-origin="original-photo"><EvidenceImage id="cmm-detail" loading="eager" sizes="(max-width:760px) 90vw, 42vw"/><figcaption>CMM probe and fixture · LZZ inspection area</figcaption></figure>
  </header>
  <section class="qv-tint" id="inspection-records"><div class="qv-wrap qv-report">
   <div><p class="qv-kicker">Inspection record format</p><h2>Agree what the<br/>report will contain</h2><p>Define the information shown on dimensional and first-article reports, including the part number, drawing revision, specified features, datums, acceptance limits, measurement method and results.</p><p>Agree sampling, report format and any customer approval hold point before production.</p></div>
   <div class="qv-sheet" aria-label="Blank example dimensional inspection record layout">
    <div class="qv-sheet-heading"><h3>Dimensional inspection record</h3><span>BLANK FORMAT / NO RESULTS</span></div>
    <dl class="qv-meta"><div><dt>Drawing / revision</dt><dd>To agree</dd></div><div><dt>Part / batch reference</dt><dd>To agree</dd></div></dl>
    <div class="qv-table-scroll" tabindex="0" role="region" aria-label="Blank inspection record table"><table><thead><tr><th scope="col">Feature / datum</th><th scope="col">Drawing limit</th><th scope="col">Method</th><th scope="col">Result</th></tr></thead><tbody>{[0,1,2].map(()=><tr><td>To define</td><td>—</td><td>To agree</td><td>—</td></tr>)}</tbody></table></div>
    <div class="qv-sheet-foot"><span>Sampling plan: <strong>To agree</strong></span><span>Review / approval: <strong>Blank</strong></span></div>
    <p class="qv-small">Blank example only. No customer data, measured results or approval.</p>
   </div>
  </div></section>
  <section class="qv-wrap qv-documents" id="order-documentation">
   <h2>Order documentation and acceptance</h2><p>Specify the documents and acceptance requirements with your quotation. No customer report or measurement result is published on this site.</p>
   <dl class="qv-rows">{documents.map(([label,text])=><div><dt>{label}</dt><dd>{text}</dd></div>)}</dl>
   <p class="qv-small">Ask LZZ to confirm which records can be supplied before machining. Your quotation will list the included documents and any extra cost.</p>
  </section>
  <section class="qv-tint" id="inspection-process"><div class="qv-wrap qv-process">
   <h2>Checks at each production stage</h2>
   <ol class="qv-stages">{stages.map(stage=><li><span>{stage.number}</span><h3>{stage.title}</h3><p>{stage.text}</p></li>)}</ol>
   <a class="qv-secondary" href="/factory/#workflow">See the complete manufacturing process <Arrow size={17}/></a>
  </div></section>
  <section class="qv-wrap qv-equipment" id="inspection-equipment">
   <div><h2>Inspection equipment and methods</h2><p>Choose the measurement method for the feature and its drawing limits. The equipment below covers dimensional checks; specify any additional tests with your quotation request.</p><p class="qv-calibration">Request the current calibration records during supplier review.</p>
    <dl class="qv-methods" id="measurement-methods">{methods.map(([label,text])=><div><dt>{label}</dt><dd>{text}</dd></div>)}</dl>
    <a class="qv-secondary" href="/factory/#equipment">See machining and inspection equipment <Arrow size={17}/></a>
   </div>
   <figure data-image-origin="original-photo"><EvidenceImage id="cmm-detail" sizes="(max-width:760px) 90vw, 28vw"/></figure>
  </section>
  <section class="qv-tint" id="quality-management"><div class="qv-wrap qv-qualification">
   <div><h2>Supplier qualification</h2><p>LZZ is ISO 9001-certified. Request the current certificate for your supplier file and check the details listed here.</p><p>The <a class="qv-inline" href="/about/#documents">company recognition documents</a> are separate from the ISO certificate.</p><a class="qv-secondary" href={qualificationHref}>Request certificate &amp; scope <Arrow size={17}/></a></div>
   <div><h3>Hangzhou Lizhizao Precision Machinery Co., Ltd.</h3><p>When reviewing our ISO 9001 certificate, please check:</p><ul>{qualificationFields.map(field=><li>{field}</li>)}</ul><p class="qv-small">Certificate number, issuer and current validity are available on request.</p></div>
  </div></section>
  <section class="qv-wrap qv-resources"><div><h2>Resources and checklists</h2><p>Prepare your drawing and inspection requirements.</p></div><nav aria-label="Quality resources"><a class="qv-secondary" href="/downloads/order-acceptance-checklist.txt" download>Download the order acceptance checklist <Arrow size={17}/></a><a class="qv-secondary" href="/resources/rfq-checklist/">Prepare your drawing and inspection checklist <Arrow size={17}/></a></nav></section>
 </article>
</Layout>
<style>
 .qv-page{background:#fff;color:#171d21;--qv-line:#dce1e4;--qv-muted:#55616b}.qv-page .qv-wrap{width:calc(100% - 128px);max-width:1200px;margin-inline:auto}.qv-page h1,.qv-page h2,.qv-page h3{margin:0;line-height:1.12;font-weight:550;letter-spacing:-.04em;text-wrap:balance}.qv-page h2{font-size:clamp(30px,3vw,43px)}.qv-page h3{font-size:22px;letter-spacing:-.02em}.qv-page p{font-size:18px;line-height:1.55;color:var(--qv-muted);margin:16px 0 0}.qv-page a{text-decoration:none}.qv-page a:focus-visible,.qv-table-scroll:focus-visible{outline:3px solid #176f9a;outline-offset:4px}.qv-page figure{margin:0}.qv-page .qv-small{font-size:15px;line-height:1.55}.qv-page section[id],.qv-page dl[id]{scroll-margin-top:110px}.qv-tint{background:#f0f4f5}
 .qv-hero{display:grid;grid-template-columns:1.1fr 1fr;gap:64px;align-items:start;padding-block:34px 44px}.qv-page .qv-hero h1{font-size:clamp(42px,4.2vw,60px);line-height:1.05;letter-spacing:-.045em;text-wrap:initial;margin:10px 0 0}.qv-page .qv-lead{font-size:21px;max-width:40ch;margin-top:24px}.qv-priorities{margin:32px 0;border-top:1px solid var(--qv-line)}.qv-priorities>div{display:grid;grid-template-columns:35% 65%;padding:15px 0;border-bottom:1px solid var(--qv-line)}.qv-priorities dt{font-weight:550;font-size:17px;line-height:1.45;text-transform:none;letter-spacing:0;padding-right:20px}.qv-priorities dd{margin:0;font-size:17px;color:var(--qv-muted);line-height:1.45}.qv-hero-photo :global(img){display:block;width:100%;height:555px;object-fit:cover;object-position:center 58%}.qv-hero-photo figcaption{font-size:13px;line-height:1.5;color:var(--qv-muted);margin-top:8px}.qv-page .qv-button{display:inline-flex;justify-content:center;align-items:center;gap:14px;background:#dc0029;color:#fff;min-height:54px;padding:15px 24px;font-size:16px;font-weight:600;border-radius:2px}.qv-page .qv-button:hover{background:#b60022}
 .qv-report{display:grid;grid-template-columns:.8fr 1.4fr;gap:60px;padding-block:38px}.qv-page .qv-kicker{font-size:12px;letter-spacing:.1em;text-transform:uppercase;margin:0 0 14px}.qv-report>div>p{font-size:18px}.qv-sheet{padding:24px;background:#fff;border:1px solid var(--qv-line);align-self:center;min-width:0}.qv-sheet-heading{display:flex;justify-content:space-between;align-items:center;gap:24px;padding-bottom:16px;border-bottom:1px solid var(--qv-line)}.qv-page .qv-sheet h3{font-size:21px;line-height:1.3;letter-spacing:-.025em;text-wrap:initial}.qv-sheet-heading>span{font-size:11px;color:#c80026;font-weight:650;white-space:nowrap}.qv-meta{display:flex;flex-wrap:wrap;gap:12px 22px;margin:17px 0}.qv-meta>div{display:flex;gap:10px;font-size:14px}.qv-meta dt{color:var(--qv-muted);font-size:14px;letter-spacing:0;text-transform:none}.qv-meta dd{font-weight:550;margin:0}.qv-table-scroll{overflow-x:auto}.qv-sheet table{border-collapse:collapse;width:100%;font-size:15px;text-align:left}.qv-sheet th,.qv-sheet td{border:1px solid var(--qv-line);padding:13px 12px;line-height:1.4}.qv-sheet th{background:#eef2f3;font-weight:550}.qv-sheet td{color:var(--qv-muted)}.qv-sheet-foot{display:flex;justify-content:space-between;gap:16px;margin-top:24px;font-size:14px;color:var(--qv-muted)}.qv-sheet-foot strong{font-weight:550}.qv-page .qv-sheet .qv-small{font-size:13px;margin-top:18px}
 .qv-documents{padding-block:40px}.qv-documents>p{max-width:95ch}.qv-rows{margin:24px 0 0;border-top:1px solid var(--qv-line)}.qv-rows>div{display:grid;grid-template-columns:35% 65%;border-bottom:1px solid var(--qv-line);padding:18px 0}.qv-rows dt{font-size:18px;font-weight:550;line-height:1.45;letter-spacing:0;text-transform:none;padding-right:32px}.qv-rows dd{margin:0;font-size:17px;color:var(--qv-muted);line-height:1.6}
 .qv-process{padding-block:36px}.qv-stages{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;padding:0;list-style:none;margin:30px 0 24px}.qv-stages li{padding-right:24px;border-right:1px solid #cbd4d9}.qv-stages li:last-child{border:0;padding:0}.qv-stages li>span{display:block;font-size:28px;color:#075280;margin-bottom:12px}.qv-page .qv-stages h3{font-size:23px}.qv-page .qv-stages p{font-size:16px;margin-top:12px}.qv-page .qv-secondary{display:inline-flex;align-items:center;justify-content:space-between;gap:20px;border:1px solid var(--qv-line);background:#fff;color:#17232b;min-height:44px;padding:11px 16px;font-size:14px;font-weight:550;line-height:1.45}.qv-page .qv-secondary:hover{border-color:#075280;color:#075280}
 .qv-equipment{display:grid;grid-template-columns:1.8fr .85fr;gap:52px;padding-block:40px}.qv-page .qv-equipment h2{font-size:38px}.qv-equipment>figure :global(img){width:100%;height:100%;max-height:570px;display:block;object-fit:cover;object-position:center 65%}.qv-equipment>figure{min-height:0}.qv-page .qv-calibration{font-size:16px;margin-top:12px}.qv-methods{margin:24px 0}.qv-methods>div{display:grid;grid-template-columns:46% 54%;padding:12px 0;border-bottom:1px solid var(--qv-line)}.qv-methods dt{font-size:16px;font-weight:550;line-height:1.45;letter-spacing:0;text-transform:none;padding-right:24px}.qv-methods dd{margin:0;font-size:16px;line-height:1.55;color:var(--qv-muted)}
 .qv-qualification{display:grid;grid-template-columns:1fr 1.15fr;gap:48px;padding-block:32px}.qv-page .qv-qualification h2{font-size:36px}.qv-qualification>div+div{border-left:1px solid #d1dadd;padding-left:42px}.qv-page .qv-qualification h3{font-size:19px;letter-spacing:-.02em;line-height:1.35;text-wrap:initial}.qv-page .qv-qualification p{font-size:16px;margin-top:12px}.qv-page .qv-qualification .qv-small{font-size:14px}.qv-qualification ul{padding-left:18px;margin:12px 0}.qv-qualification li{font-size:15px;line-height:1.55;color:var(--qv-muted);margin:6px 0}.qv-qualification .qv-secondary{margin-top:18px}.qv-page .qv-inline{color:inherit;text-decoration:underline;text-underline-offset:3px}.qv-page .qv-inline:hover{color:#075280}
 .qv-resources{display:grid;grid-template-columns:1.15fr 1fr;align-items:center;gap:50px;padding-block:28px}.qv-page .qv-resources h2{font-size:32px}.qv-page .qv-resources p{font-size:16px;margin-top:12px}.qv-resources nav{display:grid;gap:10px}
 @media(min-width:761px) and (max-width:1100px){.qv-page .qv-wrap{width:calc(100% - 64px)}.qv-hero{gap:32px;grid-template-columns:1.1fr 1fr}.qv-page .qv-hero h1{font-size:42px}.qv-hero-photo :global(img){height:560px}.qv-priorities>div{grid-template-columns:1fr;gap:6px}.qv-priorities{margin-block:24px}.qv-page .qv-button{font-size:14px;padding-inline:16px}.qv-report{grid-template-columns:1fr;gap:28px}.qv-report>div:first-child{max-width:70ch}.qv-stages{grid-template-columns:repeat(2,1fr);gap:28px}.qv-stages li:nth-child(2){border:0}.qv-equipment{grid-template-columns:1.4fr .8fr;gap:28px}.qv-page .qv-equipment h2{font-size:32px}.qv-methods>div{grid-template-columns:1fr;gap:8px}.qv-qualification{gap:28px}.qv-qualification>div+div{padding-left:28px}}
 @media(max-width:760px){.qv-page .qv-wrap{width:calc(100% - 40px)}.qv-hero{grid-template-columns:1fr;gap:28px;padding-block:30px}.qv-page .qv-hero h1{font-size:38px}.qv-page .qv-lead{font-size:18px;margin-top:20px}.qv-priorities{margin-block:24px}.qv-priorities>div{grid-template-columns:36% 64%;padding-block:14px}.qv-priorities dt,.qv-priorities dd{font-size:15px}.qv-priorities dt{padding-right:16px}.qv-page .qv-button{font-size:15px;padding-inline:18px}.qv-hero-photo :global(img){height:390px}.qv-page h2{font-size:30px}.qv-page p{font-size:17px}.qv-report{grid-template-columns:1fr;gap:26px;padding-block:30px}.qv-report>div>p{font-size:17px}.qv-sheet{padding:16px}.qv-sheet-heading{display:block}.qv-page .qv-sheet h3{font-size:20px;margin-bottom:10px}.qv-sheet-heading>span{font-size:10px}.qv-meta{display:grid;gap:8px}.qv-meta>div,.qv-meta dt{font-size:12px}.qv-sheet table{font-size:12px;table-layout:fixed}.qv-sheet th,.qv-sheet td{padding:10px 6px;overflow-wrap:anywhere}.qv-sheet th:nth-child(1){width:31%}.qv-sheet-foot{font-size:12px;flex-wrap:wrap;gap:8px;margin-top:18px}.qv-documents{padding-block:30px}.qv-rows>div{grid-template-columns:1fr;gap:10px;padding-block:20px}.qv-rows dt{font-size:18px}.qv-rows dd{font-size:16px}.qv-page .qv-small{font-size:14px}.qv-process{padding-block:30px}.qv-stages{grid-template-columns:1fr;gap:0;margin-block:24px}.qv-stages li,.qv-stages li:last-child{display:grid;grid-template-columns:36px 1fr;gap:8px 14px;border:0;border-top:1px solid #cbd4d9;padding:20px 0}.qv-stages li>span{font-size:21px;grid-row:1/3;margin:0}.qv-page .qv-stages h3{font-size:22px}.qv-page .qv-stages p{margin:0;font-size:16px}.qv-equipment{grid-template-columns:1fr;gap:28px;padding-block:30px}.qv-page .qv-equipment h2{font-size:30px}.qv-methods>div{grid-template-columns:44% 56%}.qv-methods dt,.qv-methods dd{font-size:15px}.qv-methods dt{padding-right:18px}.qv-equipment>figure :global(img){height:360px;object-fit:cover}.qv-qualification{grid-template-columns:1fr;gap:26px;padding-block:30px}.qv-page .qv-qualification h2{font-size:30px}.qv-qualification>div+div{padding:24px 0 0;border-left:0;border-top:1px solid #d1dadd}.qv-resources{grid-template-columns:1fr;gap:22px;padding-block:28px}.qv-page .qv-resources h2{font-size:28px}.qv-secondary :global(svg),.qv-button :global(svg){flex-shrink:0}}
 .qv-page #inspection-equipment.qv-equipment{grid-template-columns:1.8fr .85fr;gap:52px}.qv-page #inspection-equipment>div:first-child{display:block;grid-column:auto}.qv-page #inspection-equipment>div:first-child h2{grid-row:auto}.qv-page #inspection-equipment>div:first-child p{margin:16px 0 0}.qv-page #inspection-equipment>figure :global(img){height:100%;max-height:570px;object-position:center 65%}.qv-page #inspection-records{padding-bottom:0}
 @media(min-width:761px) and (max-width:1100px){.qv-page #inspection-equipment.qv-equipment{grid-template-columns:1.4fr .8fr;gap:28px}}
 @media(max-width:760px){.qv-page #inspection-equipment.qv-equipment{grid-template-columns:1fr;gap:28px}.qv-page #inspection-equipment>figure :global(img){height:360px}}
</style>
