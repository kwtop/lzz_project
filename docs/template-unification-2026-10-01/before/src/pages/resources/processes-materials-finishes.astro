---
import Layout from '../../layouts/Layout.astro';
import {ArrowRight,Mail} from 'lucide-react';
import {guideImages} from '../../data/refinedImages';
import media from '../../data/additionalMedia.generated.json';
import {knowledgeLinks} from '../../data/knowledgeCenter';
const process=guideImages['cnc-process-selection'];
const photographs=[media.photos['finish-coated-round'],media.photos['finish-coated-bars']];
const requirements=[['Substrate material','Specify the material grade of the part.'],['Treatment specification','State the required coating or surface treatment.'],['Surfaces to coat or mask','Identify which surfaces to coat and which to mask.'],['Critical dimensions','State whether critical dimensions apply before or after coating.'],['Thickness','Agree any coating thickness requirements.'],['Appearance','Specify any appearance requirements.'],['Test requirements','Agree any test requirements with the quotation.']];
const sections=[['process-selection','Process selection guide'],['material-finish','Material and finish guide'],['coated-parts','Surface-coated parts'],['coating-requirements','Coating requirements'],['part-construction','Compare part construction'],['other-resources','Other resources']];
---
<Layout title="Machining Guides" description="Compare machining processes and material options. Check which finishing details need to be on your drawing." cta={false}>
 <div class="machining-manual">
  <header class="container manual-hero">
   <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/resources/">Resources</a><span>/</span><span>Machining Guides</span></nav>
   <p class="manual-eyebrow">Machining Guides</p>
   <div class="manual-intro"><h1>CNC processes,<br/>materials and finishes</h1><p>Compare machining processes and material options. Check which finishing details need to be on your drawing.</p></div>
  </header>
  <nav class="container manual-index" aria-label="On this page">{sections.map(([id,label])=><a href={'#'+id}>{label}</a>)}</nav>
  <div class="container manual-body">
   <section class="manual-guide" id="process-selection" aria-labelledby="process-title">
    <div><span class="manual-number" aria-hidden="true">01</span><h2 id="process-title">CNC milling vs turning<br class="manual-desktop"/> vs 5-axis machining:<br class="manual-desktop"/> how to choose</h2><p>Compare CNC turning, milling and multi-axis setups by part geometry, drawing requirements and the questions to confirm before requesting a quote.</p><a class="button" href="/resources/cnc-process-selection/">Read process selection guide <ArrowRight size={18} aria-hidden="true"/></a></div>
    <figure class="manual-process-photo" data-image-origin="source-photo"><img src={process.image} srcset={process.srcset} sizes="(max-width:760px) 90vw, 610px" alt={process.alt} width="900" height="600" loading="eager"/></figure>
   </section>
   <section class="manual-guide" id="material-finish" aria-labelledby="material-title">
    <div><span class="manual-number" aria-hidden="true">02</span><h2 id="material-title">Specifying material and finish for a machined part</h2><p>Specify the material grade and finish for your CNC part, including mating surfaces, dimensions after coating and the documentation required.</p><a class="button" href="/resources/material-and-finish-checklist/">Read material &amp; finish guide <ArrowRight size={18} aria-hidden="true"/></a></div>
    <div class="manual-specification"><dl><div><dt>Material grade</dt><dd>Specify the substrate material and grade for your CNC part.</dd></div><div><dt>Mating surfaces</dt><dd>Identify mating surfaces and any surfaces to coat or mask.</dd></div><div><dt>After-coating dimensions</dt><dd>State whether critical dimensions apply before or after coating.</dd></div></dl><div class="manual-documents"><h3>Documentation required</h3><p>State which records you need. Agree any thickness, appearance or test requirements with the quotation.</p></div></div>
   </section>
   <section class="manual-evidence" id="coated-parts" aria-labelledby="coated-title">
    <span class="manual-number" aria-hidden="true">03</span><h2 id="coated-title">Surface-coated parts</h2>
    <div class="manual-evidence-intro"><p>These source photographs are labeled as Teflon surface coating. They show coated part forms, including circular components and long pieces with repeated holes. This is a surface treatment example; it is separate from parts made from PTFE material.</p><p class="manual-evidence-note">The photographs show appearance and shape. They do not identify a coating grade, thickness, test result or performance rating.</p></div>
    <div class="manual-photos">{photographs.map(image=><figure data-image-origin="source-photo"><a class="manual-image-link" href={image.src} aria-label={'View full image: '+image.caption}><img src={image.src} srcset={image.srcset} sizes="(max-width:760px) 90vw, 550px" width={image.width} height={image.height} alt={image.caption} loading="lazy"/></a><figcaption>{image.caption}</figcaption><a class="manual-photo-action" href={image.src}>View full image <ArrowRight size={16} aria-hidden="true"/></a></figure>)}</div>
   </section>
   <section class="manual-requirements" id="coating-requirements" aria-labelledby="requirements-title"><h2 id="requirements-title">Define the coating requirement</h2><dl>{requirements.map(([title,description])=><div><dt>{title}</dt><dd>{description}</dd></div>)}</dl></section>
   <section class="manual-construction" id="part-construction" aria-labelledby="construction-title"><h2 id="construction-title">Compare the part construction</h2><div class="manual-construction-grid"><div><h3>Plastic parts</h3><p>Parts made from plastic material.</p><a class="manual-link" href="/cases/custom-plastic-parts-ptfe-pom-pe-acrylic/">View plastic part examples <ArrowRight size={16} aria-hidden="true"/></a></div><div><h3>Coated metal parts</h3><p>Metal components with a surface coating, as shown in the photographs above.</p></div><div><h3>Components with a separate covering</h3><p>Parts with a separate covering, including covered wheels and rollers.</p><a class="manual-link" href="/products/#additional-part-forms">View covered wheels and rollers <ArrowRight size={16} aria-hidden="true"/></a></div></div></section>
   <nav class="manual-resources" id="other-resources" aria-labelledby="resources-title"><h2 id="resources-title">Other resources</h2><div>{knowledgeLinks.filter(link=>link.href!==Astro.url.pathname).map(link=><a class="manual-link" href={link.href}>{link.title}<ArrowRight size={16} aria-hidden="true"/></a>)}</div></nav>
  </div>
  <section class="manual-rfq" aria-labelledby="manual-rfq-title"><div class="container"><div><h2 id="manual-rfq-title">Discuss material and finish</h2><p>Send your drawing with the proposed grade and finish. Mark mating surfaces and any dimensions that must be checked after treatment.</p></div><div class="manual-rfq-actions"><a class="button" href="/quote/">Prepare RFQ email <ArrowRight size={18} aria-hidden="true"/></a><a class="manual-email" href="mailto:roger@lzz-cnc.com"><Mail size={16} aria-hidden="true"/>roger@lzz-cnc.com</a><p>Prepare a draft, attach your drawing in your email app, then send it to LZZ.</p></div></div></section>
 </div>
</Layout>
<style>
 .machining-manual{background:#fafafa;color:#171b1e;--manual-rule:#d9dcde}
 .machining-manual figure,.machining-manual dl,.machining-manual dd{margin:0}
 .machining-manual p{color:#596169;font-size:16px;line-height:1.65;max-width:65ch}
 :global(body.brand-site) .machining-manual h1,:global(body.brand-site) .machining-manual h2,:global(body.brand-site) .machining-manual h3{color:inherit;font-family:inherit;text-wrap:pretty;letter-spacing:-.035em;font-weight:600}
 :global(body.brand-site) .machining-manual h2{font-size:34px;line-height:1.16}
 :global(body.brand-site) .machining-manual h3{font-size:21px;line-height:1.3;letter-spacing:-.025em}
 .manual-hero{padding-top:42px;padding-bottom:42px}.manual-hero .breadcrumbs{margin:0;padding:0 0 24px;font-size:13px}
 .machining-manual .manual-eyebrow{font-size:13px;font-weight:650;line-height:1.5;text-transform:uppercase;color:var(--red);margin:0 0 20px}
 .manual-intro{display:grid;grid-template-columns:minmax(0,2.45fr) minmax(0,1fr);gap:52px;align-items:center}
 :global(body.brand-site) .machining-manual h1{font-size:clamp(40px,5.8vw,82px);line-height:1.06;letter-spacing:-.05em;margin:0;text-wrap:initial}
 .manual-intro>p{border-left:1px solid var(--manual-rule);padding:10px 0 10px 34px;line-height:1.75}
 .manual-index{display:flex;flex-wrap:wrap;justify-content:space-between;gap:4px 22px;border-bottom:1px solid var(--manual-rule);padding-bottom:12px}.manual-index a{font-size:13px;font-weight:550;min-height:44px;display:flex;align-items:center;padding-block:10px;border-bottom:2px solid transparent}.manual-index a:first-child{border-color:var(--red)}.manual-index a:hover{color:var(--red);border-color:var(--red)}
 .manual-body>section,.manual-resources{scroll-margin-top:110px}
 .manual-guide{display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);gap:60px;align-items:center;padding-block:52px;border-bottom:1px solid var(--manual-rule)}
 .manual-number{display:block;width:fit-content;color:var(--red);font-size:26px;font-weight:600;letter-spacing:-.04em;line-height:1.2;border-bottom:2px solid var(--red);padding-bottom:3px;margin-bottom:24px}
 .manual-guide p{margin:18px 0 22px}.machining-manual .button{border-radius:0;min-height:48px;padding:14px 20px;font-size:14px;gap:12px;line-height:1.4}
 .manual-process-photo img{display:block;width:100%;height:355px;object-fit:cover;object-position:center}
 .manual-specification{background:#f0f1f2}.manual-specification dl{display:grid;grid-template-columns:repeat(3,minmax(0,1fr))}.manual-specification dl>div{padding:24px 20px}.manual-specification dl>div+div{border-left:1px solid #fff}.manual-specification dt{font-size:15px;font-weight:600;line-height:1.4;min-height:44px}.manual-specification dd{font-size:14px;line-height:1.7;color:#596169;margin-top:20px}
 .manual-documents{border-top:1px solid #fff;padding:20px}.manual-documents h3{font-size:15px!important;letter-spacing:0!important}.manual-documents p{font-size:14px;margin:12px 0 0}
 .manual-evidence{padding-top:52px}.manual-evidence-intro{display:grid;grid-template-columns:1fr 1fr;gap:80px;margin:20px 0 26px}.manual-evidence-intro .manual-evidence-note{border-left:1px solid var(--manual-rule);padding-left:30px;font-size:14px;max-width:48ch;align-self:center}
 .manual-photos{display:grid;grid-template-columns:1fr 1fr;gap:32px}.manual-photos img{width:100%;height:300px;object-fit:contain;background:#f1f1f0;display:block}.manual-image-link{display:block}.manual-photos figcaption{font-size:13px;line-height:1.6;color:#596169;margin:12px 0 0}.manual-photo-action{display:inline-flex;align-items:center;gap:9px;font-size:13px;min-height:44px;color:var(--red);font-weight:600}
 .manual-requirements{padding-top:36px}.manual-requirements h2,.manual-construction h2,.manual-resources h2{font-size:28px!important}.manual-requirements>p,.manual-construction>p,.manual-resources>p{margin:12px 0 20px}.manual-requirements dl>div{display:grid;grid-template-columns:34% 1fr;gap:28px;padding:12px 0;border-top:1px solid var(--manual-rule);font-size:15px;line-height:1.6}.manual-requirements dl>div:last-child{border-bottom:1px solid var(--manual-rule)}.manual-requirements dt{font-weight:600}.manual-requirements dd{color:#596169}
 .manual-construction{padding-top:40px}.manual-construction-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:32px}.manual-construction-grid>div{padding:8px 28px 22px 0}.manual-construction-grid>div+div{border-left:1px solid var(--manual-rule);padding-left:28px}.manual-construction-grid p{font-size:15px;margin:22px 0 18px}.manual-link{display:inline-flex;align-items:center;gap:12px;min-height:44px;padding:8px 12px;border:1px solid var(--manual-rule);font-size:14px;font-weight:550;line-height:1.5}.manual-link :global(svg){flex:none;color:var(--red)}.manual-link:hover{color:var(--red);border-color:var(--red)}
 .manual-resources{padding:28px 0 40px;border-top:1px solid var(--manual-rule)}.manual-resources>div{display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap}
 .manual-rfq{background:#171b1e;color:#fff}.manual-rfq>.container{display:grid;grid-template-columns:1.5fr 1fr;gap:100px;padding-block:40px}.manual-rfq h2{font-size:36px!important}.manual-rfq p{color:#c6cbd0;margin-top:18px;max-width:55ch}.manual-rfq-actions{border-left:1px solid #45494d;padding-left:40px}.manual-email{display:flex;align-items:center;gap:10px;margin-top:16px;font-size:14px;min-height:30px}.manual-rfq-actions p{font-size:13px;line-height:1.6;margin-top:6px;max-width:38ch}
 .machining-manual a:focus-visible{outline:2px solid var(--red);outline-offset:5px}.manual-rfq a:focus-visible{outline-color:#fff}
 @media(max-width:1000px){.manual-intro{gap:28px;grid-template-columns:2fr 1fr}.manual-guide{gap:32px}.manual-specification dl>div{padding:18px 14px}.manual-construction-grid{gap:18px}.manual-construction-grid>div{padding-right:12px}.manual-construction-grid>div+div{padding-left:18px}.manual-rfq>.container{gap:40px}}
 @media(max-width:760px){.manual-hero{padding-top:26px;padding-bottom:24px}.manual-hero .breadcrumbs{padding-bottom:22px}.manual-intro{display:block}.manual-intro>p{border:0;padding:0;margin-top:24px;max-width:45ch}:global(body.brand-site) .machining-manual h1{font-size:clamp(30px,7.6vw,52px);line-height:1.12;letter-spacing:-.045em}.manual-index{justify-content:flex-start;gap:2px 20px;padding-bottom:16px}.manual-index a{font-size:12px}.manual-guide{grid-template-columns:1fr;gap:28px;padding-block:36px}.manual-number{font-size:23px;margin-bottom:20px}:global(body.brand-site) .machining-manual h2{font-size:28px}.manual-desktop{display:none}.manual-process-photo img{height:auto;aspect-ratio:1.5}.manual-specification dl{grid-template-columns:1fr}.manual-specification dl>div{padding:18px 20px;display:grid;grid-template-columns:1fr 1.35fr;gap:18px}.manual-specification dl>div+div{border-left:0;border-top:1px solid #fff}.manual-specification dt{min-height:0}.manual-specification dd{margin:0}.manual-evidence{padding-top:36px}.manual-evidence-intro{grid-template-columns:1fr;gap:20px}.manual-evidence-intro .manual-evidence-note{padding-left:18px;max-width:none}.manual-photos{grid-template-columns:1fr;gap:22px}.manual-photos img{height:auto;max-height:none}.manual-requirements{padding-top:24px}.manual-requirements dl>div{grid-template-columns:1fr;gap:5px;padding-block:15px}.manual-construction-grid{grid-template-columns:1fr;gap:0}.manual-construction-grid>div,.manual-construction-grid>div+div{border-left:0;padding:22px 0;border-top:1px solid var(--manual-rule)}.manual-construction-grid p{margin:12px 0}.manual-resources>div{display:grid;grid-template-columns:1fr 1fr;gap:12px}.manual-resources .manual-link{font-size:13px;justify-content:space-between}.manual-rfq>.container{grid-template-columns:1fr;gap:24px;padding-block:32px}.manual-rfq-actions{border:0;padding:0}.manual-rfq h2{font-size:30px!important}.manual-rfq-actions .button{width:100%;justify-content:space-between}}
</style>
