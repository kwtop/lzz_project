---
import photos from '../data/companyNewsMedia.json';
import type {Resource} from '../data/resources';
import {load} from 'cheerio';
import Arrow from './Arrow.astro';
interface Props {article:Resource;relatedNews:Resource[]}
const {article,relatedNews}=Astro.props;
const images=photos.filter(photo=>photo.group==='team-may-2025');
const $=load(article.html,null,false);
const paragraphs=$.root().children('p').map((_,p)=>$(p).text()).get();
---
<article class="mo-page">
 <header class="mo-wrap mo-masthead">
  <nav aria-label="Breadcrumb" class="mo-breadcrumb"><a href="/about/">About LZZ</a><span>/</span><a href="/about/company-news/">Company News</a></nav>
  <div class="mo-heading"><div><h1>{article.title}</h1><p class="mo-date">LZZ team outing · <time datetime={article.eventDate}>{article.eventDateLabel}</time></p></div><p class="mo-intro">{paragraphs[0]}</p></div>
 </header>
 <figure class="mo-hero" data-image-origin="source-photo"><a href={images[0].src} aria-label={'View full photograph: '+images[0].caption}><img src={images[0].src} srcset={images[0].srcset} sizes="96vw" alt={images[0].caption} width={images[0].width} height={images[0].height} loading="eager" fetchpriority="high"/></a><figcaption class="mo-wrap">{images[0].caption}</figcaption></figure>
 <section class="mo-wrap mo-story" aria-labelledby="section-1"><div><h2 id="section-1">Time together beyond the workshop</h2><p>{paragraphs[1]}</p></div><figure data-image-origin="source-photo"><a href={images[1].src} aria-label={'View full photograph: '+images[1].caption}><img src={images[1].src} srcset={images[1].srcset} sizes="(max-width:760px) 90vw, 65vw" alt={images[1].caption} width={images[1].width} height={images[1].height} loading="lazy"/></a><figcaption>{images[1].caption}</figcaption></figure></section>
 <section class="mo-wrap mo-pair" id="section-2" aria-label="Photographs from the outing">{[images[3],images[2]].map(photo=><figure data-image-origin="source-photo"><a href={photo.src} aria-label={'View full photograph: '+photo.caption}><img src={photo.src} srcset={photo.srcset} sizes="(max-width:760px) 90vw, 52vw" alt={photo.caption} width={photo.width} height={photo.height} loading="lazy"/></a><figcaption>{photo.caption}</figcaption></figure>)}</section>
 <div class="mo-wrap mo-continuation"><p>For more about the team’s working environment,</p><a class="mo-secondary" href="/factory/">See the LZZ workshop <Arrow size={17}/></a></div>
 <div class="mo-wrap mo-return"><a class="mo-secondary" href="/about/company-news/">Back to Company News <Arrow size={17}/></a></div>
 <nav class="mo-wrap mo-news" aria-labelledby="more-news-title"><h2 id="more-news-title">More company news</h2>{relatedNews.map(item=><a href={'/about/company-news/'+item.slug+'/'}><time datetime={item.eventDate}>{item.eventDateLabel}</time><span>{item.title}</span><Arrow size={18}/></a>)}</nav>
 <section class="mo-contact"><div class="mo-wrap"><div><h2>Have a part in mind?</h2><p>Share your drawing, material and quantity so we can review the part and prepare a quote.</p></div><div class="mo-actions"><a class="mo-primary" href="/quote/">Prepare RFQ email <Arrow size={17}/></a><a class="mo-email" href="mailto:roger@lzz-cnc.com">roger@lzz-cnc.com</a></div></div></section>
</article>
<style>
 .mo-page{background:#fff;color:#192129}.mo-page .mo-wrap{width:calc(100% - 128px);max-width:1280px;margin-inline:auto}.mo-page h1,.mo-page h2{font-weight:550;letter-spacing:-.035em;margin:0;line-height:1.12;text-wrap:initial}.mo-page p{font-size:19px;line-height:1.65;color:#525b64;margin:0}.mo-page a{text-decoration:none}.mo-page a:focus-visible{outline:3px solid #07558b;outline-offset:5px}.mo-page [id]{scroll-margin-top:110px}.mo-page figure{margin:0;min-width:0}.mo-page figure a{display:block}.mo-page img{display:block;width:100%;height:auto}.mo-page figcaption{font-size:15px;line-height:1.55;color:#5c6670;margin-top:14px}.mo-masthead{padding-block:55px 38px}.mo-breadcrumb{display:flex;gap:12px;align-items:center;font-size:14px;color:#57636c;margin-bottom:32px}.mo-breadcrumb a:hover{color:#b80014}.mo-heading{display:grid;grid-template-columns:1.55fr 1fr;gap:70px;align-items:start}.mo-page h1{font-size:clamp(40px,4.45vw,64px);max-width:21ch}.mo-page .mo-date{font-size:17px;margin-top:26px}.mo-page .mo-intro{padding-top:9px;max-width:43ch}.mo-hero>a{margin-inline:20px}.mo-hero img{aspect-ratio:1.86;object-fit:cover;object-position:center 100%}.mo-page .mo-hero figcaption{margin-top:16px}.mo-story{display:grid;grid-template-columns:.85fr 2fr;gap:54px;padding-block:48px}.mo-page .mo-story h2{font-size:43px;max-width:15ch}.mo-story p{margin-top:24px;max-width:32ch}.mo-story img{aspect-ratio:1.62;object-fit:cover;object-position:center 85%}.mo-pair{display:grid;grid-template-columns:.8fr 1.25fr;gap:32px;align-items:start}.mo-pair img{height:560px;object-fit:cover;object-position:center}.mo-continuation{display:flex;flex-wrap:wrap;gap:12px 20px;align-items:center;padding-block:40px}.mo-page .mo-continuation p{font-size:18px}.mo-page .mo-secondary{display:inline-flex;align-items:center;gap:18px;min-height:46px;padding:10px 18px;border:1px solid #d5dce1;color:#29333a;font-size:15px;font-weight:550;line-height:1.5}.mo-secondary:hover{color:#a90014;border-color:#a90014}.mo-return{padding-block:20px 34px;border-top:1px solid #dce1e5}.mo-news{padding-block:32px 40px;border-top:1px solid #dce1e5}.mo-page .mo-news h2{font-size:36px;margin-bottom:20px}.mo-news>a{display:grid;grid-template-columns:30% 1fr auto;gap:24px;align-items:center;min-height:58px;padding-block:16px;border-bottom:1px solid #dce1e5;font-size:17px;line-height:1.5}.mo-news time{font-size:16px;color:#59646e}.mo-news>a:hover{color:#b80014}.mo-contact{background:#f3f4f5;padding-block:36px}.mo-contact>.mo-wrap{display:flex;justify-content:space-between;align-items:center;gap:40px}.mo-page .mo-contact h2{font-size:36px}.mo-contact p{font-size:17px;max-width:55ch;margin-top:15px}.mo-actions{flex-shrink:0;display:grid;gap:15px;justify-items:start}.mo-page .mo-primary{display:inline-flex;align-items:center;justify-content:center;gap:20px;white-space:nowrap;min-height:50px;padding:13px 22px;background:#ce0018;color:#fff;font-size:16px;font-weight:600;border-radius:2px}.mo-primary:hover{background:#aa0013}.mo-email{font-size:15px;color:#52606b;min-height:36px;padding-block:5px}.mo-email:hover{color:#b80014}
 @media(max-width:1100px){.mo-page .mo-wrap{width:calc(100% - 64px)}.mo-heading{gap:32px;grid-template-columns:1.3fr 1fr}.mo-page h1{font-size:46px}.mo-page .mo-intro{font-size:17px}.mo-story{grid-template-columns:1fr 1.65fr;gap:32px}.mo-page .mo-story h2{font-size:34px}.mo-story p{font-size:17px}.mo-pair img{height:auto;object-fit:contain}.mo-page .mo-contact h2{font-size:30px}}
 @media(max-width:760px){.mo-page .mo-wrap{width:calc(100% - 40px)}.mo-masthead{padding-block:28px}.mo-breadcrumb{font-size:13px;margin-bottom:25px}.mo-heading{grid-template-columns:1fr;gap:20px}.mo-page h1{font-size:37px;line-height:1.13}.mo-page .mo-date{font-size:15px;margin-top:18px}.mo-page .mo-intro{padding:0;font-size:17px;max-width:none}.mo-hero>a{margin-inline:0}.mo-hero img{aspect-ratio:4/3;object-fit:contain}.mo-page figcaption{font-size:13px;margin-top:10px}.mo-page .mo-hero figcaption{margin-top:12px}.mo-story{grid-template-columns:1fr;gap:24px;padding-block:32px}.mo-page .mo-story h2{font-size:31px;max-width:20ch}.mo-story p{font-size:17px;margin-top:18px;max-width:none}.mo-story img{aspect-ratio:4/3;object-fit:contain}.mo-pair{grid-template-columns:1fr;gap:28px}.mo-pair img{height:auto;object-fit:contain}.mo-continuation{padding-block:30px;gap:14px}.mo-page .mo-continuation p{font-size:17px}.mo-return{padding-block:20px 28px}.mo-news{padding-block:26px 32px}.mo-page .mo-news h2{font-size:29px}.mo-news>a{grid-template-columns:1fr auto;gap:8px 16px;padding-block:18px;font-size:17px}.mo-news time{grid-column:1/-1;font-size:14px}.mo-contact{padding-block:28px}.mo-contact>.mo-wrap{display:grid;gap:24px}.mo-page .mo-contact h2{font-size:29px}.mo-contact p{font-size:16px}.mo-page :global(svg){flex-shrink:0}}
</style>
