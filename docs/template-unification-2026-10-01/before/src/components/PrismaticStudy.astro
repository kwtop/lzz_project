---
import Arrow from './Arrow.astro';
import {engineeringCases} from '../data/cases';
const item=engineeringCases.find(item=>item.slug==='milling-prismatic-components')!;
const image=(name:string,width:number)=>`/media/prismatic-study/${name}-${width}.webp`;
const srcset=(name:string)=>[640,1200,2000].map(w=>`${image(name,w)} ${w}w`).join(', ');
const quoteHref='/quote/?'+new URLSearchParams({part:'Prismatic multi-feature part — drawing review'}).toString();
const checks=[['Bores','Identify critical bores and their locations.'],['Hole patterns','Confirm hole patterns and related datums.'],['Mounting faces','Specify mounting faces used for location and function.'],['Positional relationships','Define the key relative positions between features.']];
---
<article class="ps-page">
 <header class="ps-hero">
  <img src={image('machine',2000)} srcset={srcset('machine')} sizes="100vw" width="2400" height="1100" alt="Milling spindle above a rectangular workpiece held in a vise" fetchpriority="high"/>
  <div class="ps-width ps-hero-copy"><h1>CNC milling for<br/>prismatic parts</h1><p>Mounting faces, bores and pockets in one machined body.</p></div>
 </header>
 <section class="ps-width ps-intro">
  <h2>Multi-feature components</h2>
  <p class="ps-lead">{item.lead}</p>
  <p class="ps-scope">These views focus on part form and machining setup. Material grades, dimensions and inspection results must be confirmed from project documents. Use the drawing and inspection notes below to plan a similar part.</p>
 </section>
 <section class="ps-features" id="component">
  <a class="ps-photo ps-parts-photo" href={image('parts',2000)} target="_blank" rel="noopener" aria-label="View full-size prismatic component image"><img src={image('parts',1200)} srcset={srcset('parts')} sizes="(max-width:760px) 100vw, 60vw" width="1800" height="1400" alt="Rectangular machined components with rows of circular holes and end pockets" loading="lazy"/></a>
  <div class="ps-feature-copy"><h2>Faces, holes<br/>and pockets</h2><p>Flat faces, holes and pockets share a prismatic body. Define the locating faces and the relationship of the other features to them.</p></div>
 </section>
 <section class="ps-setup" id="machining-setup"><div class="ps-width ps-setup-grid">
  <div><h2>Locating the part<br/>for milling</h2><p>{item.setup}</p></div>
  <a class="ps-photo ps-setup-photo" href={image('machine',2000)} target="_blank" rel="noopener" aria-label="View full-size milling setup image"><img src={image('machine-detail',1200)} srcset={srcset('machine-detail')} sizes="(max-width:760px) 90vw, 43vw" width="1600" height="1000" alt="Detail of the spindle, coolant nozzle and vise holding the workpiece" loading="lazy"/></a>
 </div></section>
 <section class="ps-width ps-inspection" id="inspection-planning"><h2>Inspection requirements</h2><p>Mark the features below on your drawing, then agree the inspection method, sampling plan and report format.</p>
  <dl class="ps-checks">{checks.map(([name,copy])=><div><dt>{name}</dt><dd>{copy}</dd></div>)}</dl>
  <a class="ps-button" href={quoteHref}>Discuss your drawing <Arrow size={18}/></a><p class="ps-quote-note">Include material and quantity with your drawing. The RFQ form prepares an email draft for you to review and send.</p>
 </section>
 <section class="ps-width ps-related"><h2>Related studies and capabilities</h2><div class="ps-related-grid">
  <nav aria-label="Related capabilities"><h3>Related capabilities</h3><a href="/capabilities/cnc-milling-service/">CNC Milling Service <Arrow size={17}/></a><a href="/capabilities/low-volume-production/">Low-volume Production <Arrow size={17}/></a></nav>
  <nav aria-label="Parts with similar features"><h3>Parts with similar features</h3><a href="/products/custom-oem-high-precision-cnc-milling-manufacturer/">Milled instrument blocks &amp; brackets <Arrow size={17}/></a><a href="/products/global-manufacturer-of-multi-sided-precision-machined-components/">Multi-sided machined components <Arrow size={17}/></a><p>Separate catalog examples for a similar enquiry.</p><a class="ps-all" href="/cases/">See all process studies <Arrow size={17}/></a></nav>
 </div></section>
</article>
<style>
 .ps-page{background:white;color:#171d21;--ps-line:#dce0e3;--ps-muted:#59646e}.ps-page .ps-width{width:calc(100% - 128px);max-width:1220px;margin-inline:auto}.ps-page h1,.ps-page h2,.ps-page h3{margin:0;font-weight:550;letter-spacing:-.04em;line-height:1.1;text-wrap:balance}.ps-page h2{font-size:clamp(32px,3.4vw,48px)}.ps-page p{font-size:19px;line-height:1.6;color:var(--ps-muted);margin:20px 0 0}.ps-page a{text-decoration:none}.ps-page a:focus-visible{outline:3px solid #176f9a;outline-offset:5px}.ps-hero{position:relative;min-height:570px;display:flex;align-items:center;background:#171d21;overflow:hidden}.ps-hero>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:60% center}.ps-hero-copy{position:relative;padding-block:95px}.ps-page .ps-hero h1{font-size:clamp(46px,5.3vw,76px);color:white;max-width:20ch;text-wrap:initial;line-height:1.08}.ps-page .ps-hero p{font-size:23px;color:#fff;max-width:38ch;line-height:1.45;margin-top:28px}.ps-intro{padding-block:40px 48px}.ps-page .ps-lead{font-size:22px;margin-top:18px}.ps-page .ps-scope{font-size:17px;line-height:1.6;max-width:88ch;margin-top:18px}.ps-features{display:grid;grid-template-columns:61% 39%;align-items:stretch}.ps-photo{display:block;overflow:hidden}.ps-photo img{display:block;width:100%;height:100%;object-fit:cover}.ps-parts-photo{height:490px;min-height:0}.ps-parts-photo img{object-position:center 60%}.ps-feature-copy{padding:64px 60px 64px 48px;align-self:center;max-width:560px}.ps-feature-copy p{font-size:19px}.ps-feature-copy p+p{margin-top:14px}.ps-setup{background:#f5f6f7;padding-block:36px}.ps-setup-grid{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:62px}.ps-setup-grid>div{padding-block:24px}.ps-setup-photo{height:335px}.ps-inspection{padding-block:44px 40px}.ps-inspection>p{margin-top:16px}.ps-checks{margin:20px 0 24px;border-top:1px solid var(--ps-line)}.ps-checks>div{display:grid;grid-template-columns:30% 70%;border-bottom:1px solid var(--ps-line)}.ps-checks dt,.ps-checks dd{font-size:17px;line-height:1.5;margin:0;padding:13px 22px;letter-spacing:0;text-transform:none}.ps-checks dt{font-weight:550;background:#f6f7f8;border-right:1px solid var(--ps-line)}.ps-checks dd{color:var(--ps-muted)}.ps-page .ps-button{display:inline-flex;align-items:center;justify-content:center;gap:15px;background:#e00028;color:white;font-size:17px;min-height:56px;padding:16px 30px;font-weight:600;border-radius:2px}.ps-page .ps-button:hover{background:#b60020}.ps-page .ps-quote-note{font-size:16px;margin-top:16px}.ps-related{padding-block:28px 52px;border-top:1px solid var(--ps-line)}.ps-page .ps-related h2{font-size:34px}.ps-related-grid{display:grid;grid-template-columns:1fr 1fr;gap:60px;margin-top:28px}.ps-related-grid>nav+nav{border-left:1px solid var(--ps-line);padding-left:40px}.ps-page .ps-related h3{font-size:21px;letter-spacing:-.02em;margin-bottom:14px}.ps-related a{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:14px 0;border-top:1px solid var(--ps-line);font-size:17px;color:#075280}.ps-related a:hover{color:#b60020}.ps-page .ps-related p{font-size:14px;margin:8px 0 16px}.ps-related .ps-all{display:inline-flex;border:1px solid var(--ps-line);padding:12px 16px;font-size:15px;font-weight:550}
 @media(min-width:761px) and (max-width:1100px){.ps-page .ps-width{width:calc(100% - 64px)}.ps-hero{min-height:0;flex-direction:column;align-items:stretch}.ps-hero>img{position:static;order:2;height:340px}.ps-hero-copy{order:1}.ps-page .ps-hero h1{font-size:56px}.ps-hero-copy{padding-block:60px}.ps-hero>img{object-position:65% center}.ps-feature-copy{padding:32px}.ps-features{grid-template-columns:55% 45%}.ps-setup-grid{gap:32px}.ps-page h2{font-size:34px}.ps-related-grid{gap:30px}.ps-related-grid>nav+nav{padding-left:28px}}
 @media(max-width:760px){.ps-page .ps-width{width:calc(100% - 40px)}.ps-hero{display:flex;flex-direction:column;min-height:0;align-items:stretch}.ps-hero>img{position:static;order:2;height:285px;object-position:70% center}.ps-hero-copy{padding-block:34px 30px;order:1}.ps-page .ps-hero h1{font-size:43px;max-width:none}.ps-page .ps-hero p{font-size:18px;margin-top:20px;max-width:30ch}.ps-page h2{font-size:32px;line-height:1.14}.ps-page p{font-size:17px;margin-top:18px}.ps-intro{padding-block:30px 34px}.ps-desktop-break{display:none}.ps-page .ps-lead{font-size:18px}.ps-page .ps-scope{font-size:15px}.ps-features{grid-template-columns:1fr}.ps-parts-photo{min-height:0;height:340px}.ps-feature-copy{padding:30px 20px 36px;max-width:none}.ps-feature-copy p{font-size:17px}.ps-setup{padding-block:30px}.ps-setup-grid{grid-template-columns:1fr;gap:24px}.ps-setup-grid>div{padding:0}.ps-setup-photo{height:230px}.ps-inspection{padding-block:32px}.ps-inspection>p br{display:none}.ps-checks>div{grid-template-columns:36% 64%}.ps-checks dt,.ps-checks dd{font-size:14px;padding:12px 10px;overflow-wrap:anywhere}.ps-page .ps-button{font-size:16px;min-height:54px}.ps-related{padding-block:28px 36px}.ps-page .ps-related h2{font-size:28px}.ps-related-grid{grid-template-columns:1fr;gap:30px}.ps-related-grid>nav+nav{padding-left:0;border-left:0}.ps-related a{font-size:16px;min-height:48px}.ps-page .ps-quote-note{font-size:15px}}
</style>
