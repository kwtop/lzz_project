---
import DemoLayout from '../../layouts/ContentDemoLayout.astro';
import catalog from '../../data/catalog.json';
import {categoryDetails,productTitle,productImageAlt} from '../../data/presentation';
import {productImage,productSrcset} from '../../data/refinedImages';
import {matchesPartCategory} from '../../data/productTags';
import {capabilityOverview} from '../../data/capabilityOverview';
import {capabilityContent} from '../../data/capabilityContent';
import {materialGrades} from '../../data/materialGrades';
import {processDelivery} from '../../data/orderDeliverables';
import {caseForCapability} from '../../data/cases';
import {capabilityGroups} from '../../data/capabilityGroups';
import {photo} from '../../data/evidence';
import media from '../../data/additionalMedia.generated.json';
import {inquiryHref} from '../../lib/inquiryContext';

const slug='plastic-machined-parts';
const category=catalog.categories.find(item=>item.slug===slug)!;
const detail=categoryDetails[slug];
const overview=capabilityOverview[slug];
const content=capabilityContent[slug];
const grades=materialGrades[slug];
const delivery=processDelivery[slug];
const products=catalog.products.filter(item=>matchesPartCategory(item,category.key));
const cases=caseForCapability(slug);
const hero=photo('plastic-ptfe-shafts');
const acrylic=photo('plastic-acrylic-detail');
const ptfe=photo('plastic-ptfe-batch');
const peek=media.videos['peek-parts'];
const quoteHref=inquiryHref({id:slug,title:detail.title,legacyName:category.name,path:'/capabilities/'+slug+'/',kind:'capability'});
// A combined presentation of the two existing lists; no material properties are inferred.
const polymers=['PEEK','PTFE','Polyimide','Nylon','PA6','PA66','POM (acetal / Delrin)','HDPE','UHMW','Acrylic','PC (polycarbonate)','ABS','PVC','PP'];
const requirementsStart=overview.materialFinish.indexOf('Specify the exact');
const materialRequirements=requirementsStart>=0?overview.materialFinish.slice(requirementsStart):overview.materialFinish;
const siblingGroup=capabilityGroups.find(group=>group.keys.includes(category.key))!;
const siblings=siblingGroup.keys.map(key=>catalog.categories.find(item=>item.key===key)!).filter(item=>item.slug!==slug);
const furtherResources=[
 {href:'/resources/rfq-checklist/',title:'Drawing & RFQ checklist'},
 {href:'/resources/cnc-process-selection/',title:'Choose a machining process'},
 {href:'/resources/prototype-vs-small-batch-cnc/',title:'Prototype vs small batch'},
 {href:'/resources/custom-cnc-parts-shipping-checklist/',title:'International shipping checklist'},
 {href:'/resources/how-we-work/',title:'How we work'},
];
---
<DemoLayout title="Plastic machining" original="/capabilities/plastic-machined-parts/">
 <article class="cl-category">
  <header class="cl-wrap cl-section cc-hero">
   <div class="cc-hero-copy">
    <nav class="cc-crumb" aria-label="Breadcrumb"><a href="/capabilities/">Capabilities</a><span aria-hidden="true">/</span><span>Plastic machining</span></nav>
    <h1>Engineering plastics,<br/>machined for your part</h1>
    <p class="cc-lead">{detail.description}</p>
    <div class="cc-hero-actions"><a class="cl-button" href={quoteHref}>Prepare RFQ email <span aria-hidden="true">↗</span></a><a class="cl-link" href="#part-examples">Find a part example <span aria-hidden="true">↓</span></a></div>
   </div>
   <figure class="cc-hero-figure" data-image-origin="source-photo">
    <div class="cc-hero-frame"><img src={hero.src} srcset={hero.srcset} sizes="(max-width:760px) 90vw, 46vw" width={hero.width} height={hero.height} alt={hero.alt} fetchpriority="high"/></div>
    <figcaption>Stepped and threaded forms · original PTFE source collection.</figcaption>
   </figure>
  </header>

  <section class="cc-archive-band" id="machining-studies">
   <div class="cl-wrap cl-section">
    <div class="cl-heading"><div><p class="cl-kicker">Workshop archive</p><h2>Plastic forms, up close</h2></div>{cases[0]&&<a class="cl-link" href={'/cases/'+cases[0].slug+'/'}>Explore plastic examples <span aria-hidden="true">↗</span></a>}</div>
    <div class="cc-archive">
     <figure data-image-origin="source-video"><video controls playsinline muted preload="none" poster={peek.poster} width={peek.width} height={peek.height} aria-label="Original workshop video of PEEK components with perimeter holes and narrow parallel slots"><source src={peek.src} type="video/mp4"/>Your browser does not support this video. <a href={peek.src}>Open the original PEEK video</a>.</video><figcaption><strong>PEEK components</strong><br/>Perimeter holes &amp; parallel slots · original clip.</figcaption></figure>
     <figure data-image-origin="source-photo"><img src={acrylic.src} srcset={acrylic.srcset} sizes="(max-width:760px) 43vw, 30vw" width={acrylic.width} height={acrylic.height} alt={acrylic.alt} loading="lazy"/><figcaption><strong>Acrylic components</strong><br/>Transparent rims &amp; stepped forms.</figcaption></figure>
     <figure data-image-origin="source-photo"><img src={ptfe.src} srcset={ptfe.srcset} sizes="(max-width:760px) 43vw, 30vw" width={ptfe.width} height={ptfe.height} alt={ptfe.alt} loading="lazy"/><figcaption><strong>PTFE components</strong><br/>Small forms with holes, from the source collection.</figcaption></figure>
    </div>
    <p class="cl-note">Materials follow the archive labels. These examples show geometry, not verified grade, tolerance or application approval.</p>
   </div>
  </section>

  <section class="cl-wrap cl-section cc-fit" id="engineering-fit">
   <div class="cc-fit-heading"><p class="cl-kicker">Engineering fit</p><h2>{overview.heading}</h2><p>{content.scope}</p></div>
   <div class="cc-fit-body">
    <dl class="cl-dl"><div><dt>Geometry &amp; process</dt><dd>{overview.geometry}</dd></div><div><dt>Size &amp; workholding</dt><dd>{overview.workholding}</dd></div></dl>
    <div class="cc-materials" id="material-options">
     <h3>Polymer options to discuss</h3>
     <ul class="cc-polymer-list" aria-label="Combined polymer options from the service summary and common-material sheet">{polymers.map(polymer=><li>{polymer}</li>)}</ul>
     <p class="cl-note">{grades.note}</p>
     <details class="cc-material-notes"><summary>Grade, stock &amp; surface requirements</summary><p>{materialRequirements}</p></details>
    </div>
   </div>
  </section>

  <section class="cc-parts-band" id="part-examples">
   <div class="cl-wrap cl-section">
    <div class="cl-heading"><h2>Compare part examples</h2><a class="cl-link" href="/products/">Browse all parts <span aria-hidden="true">↗</span></a></div>
    <div class="cc-parts">{products.map(product=><a href={'/products/'+product.slug+'/'}><div class="cc-part-image"><img src={productImage(product)} srcset={productSrcset(product)} sizes="(max-width:760px) 43vw, 23vw" width="800" height="800" alt={productImageAlt(product)} loading="lazy"/></div><h3>{productTitle(product)}</h3><span class="cc-part-exit">View requirements <span aria-hidden="true">↗</span></span></a>)}</div>
   </div>
  </section>

  <section class="cl-wrap cl-section cc-acceptance" id="capability-scope">
   <div class="cl-heading"><h2>Drawing &amp; acceptance</h2></div>
   <div class="cc-criteria">
    <div><h3>Define the part</h3>{content.drawing.map(paragraph=><p>{paragraph}</p>)}</div>
    <div id="inspection"><h3>Agree the acceptance conditions</h3>{content.inspection.map(paragraph=><p>{paragraph}</p>)}<p>Agree the measurement method and required records before production.</p></div>
   </div>
   <details class="cc-route" id="service-summary"><summary>{delivery.title}</summary><ul>{delivery.items.map(item=><li>{item}</li>)}</ul></details>
  </section>

  <section class="cl-wrap cl-section cc-enquiry" id="enquiry">
   <div class="cl-next">
    <div><p class="cl-kicker">Your next step</p><h2>Prepare your plastic machining enquiry</h2>{content.rfq.map(paragraph=><p>{paragraph}</p>)}</div>
    <div class="cc-enquiry-actions"><a class="cl-button" href={quoteHref}>Prepare RFQ email <span aria-hidden="true">↗</span></a><p class="cl-note">Add requirements to the draft, then attach drawings in your email app before sending.</p><a class="cl-link" href="mailto:roger@lzz-cnc.com">roger@lzz-cnc.com <span aria-hidden="true">↗</span></a></div>
   </div>
   <nav class="cc-next-links" aria-label="Useful next steps"><a class="cl-link" href="/quality/">Quality &amp; inspection <span aria-hidden="true">↗</span></a><a class="cl-link" href="/resources/material-and-finish-checklist/">Material &amp; finish guide <span aria-hidden="true">↗</span></a></nav>
   <details class="cc-further" id="related-resources"><summary>Related materials, equipment &amp; engineering resources</summary><div class="cc-further-grid"><nav aria-label="Related materials"><h3>Other materials</h3><ul>{siblings.map(item=><li><a href={'/capabilities/'+item.slug+'/'}>{categoryDetails[item.slug].title} <span aria-hidden="true">↗</span></a></li>)}</ul></nav><nav aria-label="Equipment and order records"><h3>Equipment &amp; order records</h3><ul><li><a href="/factory/#equipment">Workshop equipment ↗</a></li><li><a href="/quality/#order-documentation">Order documentation ↗</a></li><li><a href="/factory/#order-deliverables">Order deliverables ↗</a></li></ul></nav><nav aria-label="More engineering resources"><h3>Engineering resources</h3><ul>{furtherResources.map(resource=><li><a href={resource.href}>{resource.title} <span aria-hidden="true">↗</span></a></li>)}<li><a href="/cases/">All machining studies ↗</a></li></ul></nav></div></details>
  </section>
 </article>
</DemoLayout>

<style>
 .cc-hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);align-items:center;gap:72px}
 .cc-hero-copy,.cc-hero-figure{min-width:0}
 .cc-crumb{display:flex;align-items:center;flex-wrap:wrap;gap:12px;color:var(--cl-muted);font-size:13px;margin-bottom:28px}
 .cc-crumb a{display:inline-flex;align-items:center;min-height:32px}
 .cc-crumb a:hover{color:var(--red)}
 .cc-lead{margin-top:26px!important;max-width:42ch!important}
 .cc-hero-actions{display:flex;align-items:center;flex-wrap:wrap;gap:14px 24px;margin-top:30px}
 .cc-hero-frame{aspect-ratio:4/3;background:#e7e8e4}
 .cc-hero-frame img{width:100%;height:100%;object-fit:contain}
 .cc-archive-band{background:#f2f4f3}
 .cc-archive{display:grid;grid-template-columns:1fr 1fr 1fr;gap:28px}
 .cc-archive figure{min-width:0}
 .cc-archive :is(img,video){display:block;width:100%;height:340px;object-fit:contain;background:#e5e8e4}
 .cc-archive video{background:#1f2426}
 .cc-archive figcaption{margin-top:14px}
 .cc-archive-band .cl-note{margin-top:24px}
 .cc-fit{display:grid;grid-template-columns:minmax(0,4fr) minmax(0,7fr);gap:80px}
 .cc-fit-heading>p:last-child{margin-top:24px}
 .cc-fit-body{min-width:0}
 .cc-fit :global(.cl-dl>div){grid-template-columns:160px minmax(0,1fr);gap:24px}
 .cc-materials{margin-top:34px}
 .cc-polymer-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));column-gap:24px;list-style:none;padding:0;margin:18px 0 0;border-top:1px solid var(--cl-rule)}
 .cc-polymer-list li{padding-block:12px;border-bottom:1px solid var(--cl-rule);color:var(--cl-ink)}
 .cc-material-notes{margin-top:18px}
 .cc-parts-band{background:#f7f8f7}
 .cc-parts{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:28px}
 .cc-parts>a{min-width:0}
 .cc-part-image{aspect-ratio:1;background:#eef0ee;overflow:hidden;display:grid;place-items:center}
 .cc-part-image img{height:100%;width:100%;object-fit:contain;padding:14px}
 .cc-parts h3{margin-top:18px}
 .cc-part-exit{display:inline-flex;align-items:center;gap:18px;margin-top:12px;font-size:13px;color:var(--cl-muted);min-height:32px}
 .cc-parts>a:hover h3{color:var(--red);text-decoration:underline;text-underline-offset:5px}
 .cc-criteria{display:grid;grid-template-columns:1fr 1fr;gap:80px}
 .cc-criteria p{margin-top:18px}
 .cc-route{margin-top:36px}
 .cc-route ul{padding-left:20px;margin:0}
 .cc-route li+li{margin-top:14px}
 .cc-enquiry{padding-top:0!important}
 .cc-enquiry-actions{min-width:0}
 .cc-enquiry-actions>.cl-link{margin-top:14px}
 .cc-next-links{display:flex;align-items:center;flex-wrap:wrap;gap:18px 32px;margin-top:24px}
 .cc-further{margin-top:28px}
 .cc-further-grid{display:grid;grid-template-columns:1fr 1fr 1.3fr;gap:36px}
 .cc-further-grid ul{list-style:none;padding:0;margin:14px 0 0}
 .cc-further-grid a{display:inline-flex;align-items:center;min-height:44px;padding-block:8px}
 .cc-further-grid a:hover{color:var(--red);text-decoration:underline;text-underline-offset:4px}
 :global(body.brand-site.finesse-redesigned .cl-demo .cc-parts h3){font-size:18px!important;line-height:1.4!important}
 :global(body.brand-site.finesse-redesigned .cl-demo .cc-polymer-list li){font-size:15px!important;line-height:1.5!important;color:var(--cl-ink)}
 :global(body.brand-site.finesse-redesigned .cl-demo .cc-enquiry .cl-kicker){color:#c3ccce!important;margin-top:0!important}
 @media(max-width:1000px){
  .cc-hero{gap:40px}
  .cc-fit{gap:40px;grid-template-columns:minmax(0,1fr) minmax(0,1.7fr)}
  .cc-fit :global(.cl-dl>div){grid-template-columns:1fr;gap:8px}
  .cc-polymer-list{grid-template-columns:repeat(2,minmax(0,1fr))}
  .cc-archive :is(img,video){height:300px}
  .cc-parts{gap:18px}
  .cc-criteria{gap:40px}
 }
 @media(max-width:760px){
  .cc-hero{grid-template-columns:1fr;gap:30px}
  .cc-hero{padding-block:30px 38px;gap:22px}
  .cc-hero-copy{display:contents}
  .cc-crumb{order:1;margin-bottom:0}
  .cc-hero h1{order:2}
  .cc-hero-figure{order:3}
  .cc-lead{order:4;margin-top:0!important}
  .cc-hero-actions{order:5;margin-top:0}
  .cc-hero-figure{max-width:560px}
  .cc-hero-frame{aspect-ratio:4/3}
  .cc-archive{grid-template-columns:1fr 1fr;gap:24px 18px}
  .cc-archive figure:first-child{grid-column:1/-1;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.15fr);gap:22px;align-items:center}
  .cc-archive figure:first-child video{height:246px}
  .cc-archive :is(img,video){height:236px}
  .cc-archive figure:first-child figcaption{margin-top:0}
  .cc-fit{grid-template-columns:1fr;gap:28px}
  .cc-fit-heading>p:last-child{margin-top:20px}
  .cc-polymer-list{grid-template-columns:repeat(2,minmax(0,1fr));column-gap:18px}
  .cc-parts{grid-template-columns:1fr 1fr;gap:30px 18px}
  .cc-part-image img{padding:9px}
  .cc-parts h3{margin-top:14px}
  .cc-criteria{grid-template-columns:1fr;gap:30px}
  .cc-criteria p{margin-top:14px}
  .cc-route{margin-top:28px}
  .cc-next-links{align-items:flex-start;gap:12px 24px}
  .cc-further-grid{grid-template-columns:1fr;gap:26px}
  :global(body.brand-site.finesse-redesigned .cl-demo .cc-parts h3){font-size:17px!important;line-height:1.4!important}
  :global(body.brand-site.finesse-redesigned .cl-demo .cc-hero h1){font-size:32px!important;text-wrap:initial;max-width:100%!important}
 }
 @media(max-width:390px){.cc-archive :is(img,video){height:200px}.cc-archive figure:first-child video{height:218px}.cc-part-exit{gap:8px;font-size:12px}}
</style>
