---
interface Props {name:string;alt:string;class?:string;}
import {refinedSrcset} from '../data/refinedImages';
const {name,alt,class:className=''}=Astro.props;
---
<img class={className} src={`/media/${name}.webp`} srcset={name.endsWith('-v3')?refinedSrcset(name):`/media/${name}-720.webp 720w, /media/${name}.webp 1440w`} sizes="(max-width:760px) calc(100vw - 44px), (max-width:1100px) 46vw, 640px" alt={alt} width={name.endsWith('-v3')?1200:1440} height={name.endsWith('-v3')?800:name==='workshop-retouched-v2'?913:960} loading="lazy" decoding="async"/>
