-muted)}.rq-delivery p{font-size:13px;margin-top:13px}.rq-send{display:grid;grid-template-columns:1.1fr 1fr;gap:44px;padding-block:35px}.rq-send h2{font-size:32px}.rq-send p{margin-top:18px}.rq-send>div:last-child{padding-left:35px;border-left:1px solid var(--rq-line)}.rq-send ol{list-style:none;padding:0;margin:0;font-size:16px;line-height:1.6}.rq-send ol+p{font-size:14px;margin-top:10px}.rfq-editorial .rq-button{display:inline-flex;gap:24px;align-items:center;justify-content:center;background:#c7222f;color:white;padding:13px 23px;font-size:15px;font-weight:600;min-height:50px;margin-top:17px}.rfq-editorial .rq-button:hover{background:#a91b26;text-decoration:none}.rq-mail{display:flex;align-items:center;gap:12px;width:fit-content;font-size:14px;min-height:40px;margin-top:5px}.rq-related{display:grid;grid-template-columns:1.2fr 1fr;gap:55px;padding-block:29px 36px}.rq-related h2{font-size:28px}.rq-related p{font-size:15px;margin-top:12px}.rq-related>div:last-child{border-left:1px solid var(--rq-line);padding-left:30px;display:flex;flex-direction:column;align-items:flex-start}.rq-related .rq-link{margin-top:0}
@media(max-width:1100px){.rq-wrap{width:calc(100% - 64px)}.rq-hero{padding-right:32px;gap:28px}.rq-hero img{height:535px}.rq-hero figcaption{padding-left:32px}.rq-essentials h2{font-size:27px}.rq-commercial-grid{grid-template-columns:1fr;gap:25px}.rq-terms{grid-template-columns:.7fr 1.3fr}.rq-delivery{padding-left:0;border:0}.rq-delivery dl{display:grid;grid-template-columns:1fr 1fr;gap:10px 24px}.rq-delivery dl>div{grid-template-columns:1fr;gap:4px}.rq-send{gap:30px}.rq-send>div:last-child{padding-left:25px}.rq-send h2{font-size:29px}}
