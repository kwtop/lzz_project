---
import catalog from '../data/catalog.json';
const documentNotes=[
 {title:'Precision manufacturing teaching base',type:'Education collaboration plaque',description:'The plaque names Zhejiang Institute of Mechanical & Electrical Engineering and Lizhizao as a practical teaching base for AI precision manufacturing.',date:'November 2023, as printed.',scope:'Education collaboration, not a quality-system certificate.'},
 {title:'High-tech enterprise certificate',type:'Enterprise recognition',description:'The original names Hangzhou Lizhizao Precision Machinery Co., Ltd. and carries Zhejiang science and technology, finance and tax authority seals.',date:'Issued 8 December 2023; the printed validity period is three years.',scope:'Enterprise recognition, not a product conformity or ISO certificate.'},
 {title:'Zhejiang science & technology SME',type:'Provincial enterprise recognition',description:'The certificate names Lizhizao as a Zhejiang science and technology small or medium-sized enterprise. Zhejiang’s science and technology authority is named on the document.',date:'No issue date is stated in the displayed document.',scope:'Enterprise recognition; current status and applicable scope should be confirmed.'}
];
const certificates=catalog.companyAssets.filter(asset=>asset.source.includes('/certificate/'));
---
  <section class="ab-documents-band" id="documents"><div class="ab-wrap ab-section"><div class="ab-heading"><div><h2>Original company documents</h2><p>The original documents below cover enterprise recognition and education collaboration. They are separate from our ISO 9001 certification.</p></div><a class="ab-secondary" href="/quality/#quality-management">Request current ISO 9001 certificate</a></div><p class="ab-note ab-document-note">For supplier qualification, request the current ISO certificate, validity, applicable scope, issuer and verification details.</p><div class="ab-documents">{certificates.map((certificate,index)=>{const note=documentNotes[index];return <article class="ab-document"><a class="ab-document-image" href={certificate.image} target="_blank" rel="noopener noreferrer" aria-label={'Open original '+note.title}><img src={certificate.image} alt={note.title+', original Chinese document'} width="140" height="110" loading="lazy"/></a><div><h3>{note.title}</h3><p>{note.scope}</p><details><summary>Issuer and date details</summary><p>{note.description}</p><p>{note.date}</p></details></div><a class="ab-secondary" href={certificate.image} target="_blank" rel="noopener noreferrer">View original document</a></article>;})}</div></div></section>
