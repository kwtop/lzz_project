# Runtime secrets. Set real values through Wrangler secrets or the Pages dashboard.
# Never put these values in PUBLIC_ variables or commit actual .dev.vars.
TOKEN_SECRET='GENERATE_AT_LEAST_32_RANDOM_CHARACTERS'
TURNSTILE_SECRET_KEY='YOUR_PRODUCTION_TURNSTILE_SECRET'
# Only required when ADMIN_AUTH_MODE=password. setup-local-backend.mjs creates the local hash.
ADMIN_PASSWORD_HASH='pbkdf2-sha256$100000$BASE64_SALT$BASE64_HASH'
