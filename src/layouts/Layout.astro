---
import RfqPanel from '../components/RfqPanel.astro';
import {usesImmersiveInnerHero} from '../data/innerHeroScenes';
import SiteFooter from '../components/SiteFooter.astro';
import ContactIcon from '../components/ContactIcon.astro';
import '@fontsource-variable/inter';
import '@fontsource-variable/inter/wght-italic.css';
import legacyStyles from '../styles/legacy-site.css?inline';
import '../styles/redesign-system.css';
import '../styles/editorial-layout-20261015.css';
import '../styles/reading-polish.css';
import '../styles/penta-next.css';
import '../styles/penta-capabilities-rollout.css';
import '../styles/penta-information-rollout.css';
import '../styles/penta-products-rollout.css';
import '../styles/site-composition.css';
import '../styles/penta-interiors.css';
import '../styles/image-layout-20261018.css';
import '../styles/penta-image-composition.css';
import '../styles/floating-navigation.css';
import '../styles/context-links.css';
import '../styles/navigation-centered.css';
import '../styles/interaction-states.css';
import {isRedesigned,usesEditorialLayout} from '../data/redesignRollout';
import MainNavigation from '../components/MainNavigation.astro';
import SectionBreadcrumb from '../components/SectionBreadcrumb.astro';
import {siteSections,sectionForPath,breadcrumbTrail} from '../data/siteSections';
import SiteInteractions from '../components/SiteInteractions.astro';
import PalettePreview from '../components/PalettePreview.astro';
import {siteOrigin,pageDescriptions,pageTitles} from '../data/seo';
import {categoryDetails} from '../data/presentation';
import {pageTemplateFor} from '../data/pageTemplates';
import {socialImageFor} from '../data/socialImages';
import AnalyticsConsent from '../components/AnalyticsConsent.astro';
const {
 title='Custom CNC machining in Hangzhou',
 description=pageDescriptions[Astro.url.pathname] || categoryDetails[Astro.url.pathname.split('/')[2]]?.description || 'Discuss your custom CNC machining requirements with LZZ Precision in Hangzhou.',
 cta=true, immersive=false,breadcrumbWidth='standard',
 closingTitle='Have a part in mind?',
 closingDescription='Leave your email or WhatsApp number. Add a drawing or message if you have one. We reply within 12 hours.',
 closingHref='/quote/',closingLabel='Request a quote',headerQuoteHref='/quote/',
}=Astro.props;
function contextualQuote(href:string) {
 if(!href.startsWith('/quote/'))return href;
 const link=new URL(href,siteOrigin);
 if(!link.searchParams.has('source'))link.searchParams.set('source',Astro.url.pathname);
 if(!link.searchParams.has('part')&&Astro.url.pathname!=='/')link.searchParams.set('part',title);
 return link.pathname+link.search;
}
const contextualHeaderQuote=contextualQuote(headerQuoteHref);
const contextualClosingQuote=contextualQuote(closingHref);
const canonical=new URL(Astro.url.pathname,siteOrigin).href;
const seoTitle=pageTitles[Astro.url.pathname]||title;
const entity=Astro.props.structuredEntity;
const entityId=canonical+(entity?.type==='Product'?'#product':'#service');
const noindex=Astro.props.noindex || Astro.url.pathname==='/404.html' || Astro.url.pathname==='/404/';
// Error pages render at the requested URL; their presentation belongs to the recovery page.
const designPath=Astro.props.designPath || Astro.url.pathname;
const pageTemplate=pageTemplateFor(designPath);
const modern=isRedesigned(designPath);
// Keep the sample prop compatible while the confirmed language covers canonical pages.
const innerLayout=modern&&designPath!=='/'&&!/^\/(preview|visual-directions|homepage-directions|content-layout-demo)/.test(designPath);
const splitInnerHero=innerLayout&&(/^\/capabilities(?:\/|$)/.test(designPath)||['/factory/','/about/','/about/company-profile/','/about/how-we-work/','/about/contact/','/machined-parts/'].includes(designPath));
const immersiveInnerHero=innerLayout&&usesImmersiveInnerHero(designPath);
const capabilitySceneHero=innerLayout&&/^\/capabilities(?:\/|$)/.test(designPath);
const pentaSample=Astro.props.pentaSample===true||(modern&&(!noindex||/^\/404(?:\.html|\/)?$/.test(designPath)));
const floatingNavigation=modern&&pentaSample;
const headerOverPhoto=designPath==='/'||immersiveInnerHero||capabilitySceneHero||splitInnerHero;
const sharingImage=socialImageFor(Astro.props.articleImage);
const socialImage=new URL(sharingImage.src,siteOrigin).href;
const isInformationPage=/^\/(about|resources|factory)(\/|$)/.test(Astro.url.pathname);
const section=sectionForPath(designPath);
const trail=breadcrumbTrail(designPath,title);
const crumbs=trail.length?trail.map(item=>({name:item.name,item:new URL(item.href,siteOrigin).href})):[{name:'Home',item:siteOrigin+'/'}];
if(!trail.length&&Astro.url.pathname!=='/')crumbs.push({name:title,item:canonical});
const structured={'@context':'https://schema.org','@graph':[
 {'@type':'Organization','@id':siteOrigin+'/#organization',name:'Hangzhou Lizhizao Precision Machinery Co., Ltd.',alternateName:'LZZ Precision',url:siteOrigin+'/',logo:new URL('/media/lzz-logo.png',siteOrigin).href,email:'roger@lzz-cnc.com',telephone:'+86 138 5810 2479',address:{'@type':'PostalAddress',streetAddress:'No. 4 Fengcheng Road',addressLocality:'Pingyao, Yuhang District, Hangzhou',addressRegion:'Zhejiang',addressCountry:'CN'}},
 {'@type':'WebSite','@id':siteOrigin+'/#website',url:siteOrigin+'/',name:'LZZ Precision',publisher:{'@id':siteOrigin+'/#organization'},inLanguage:'en'},
 {'@type':'WebPage','@id':canonical+'#webpage',url:canonical,name:title,description,isPartOf:{'@id':siteOrigin+'/#website'},inLanguage:'en',...(crumbs.length>1?{breadcrumb:{'@id':canonical+'#breadcrumb'}}:{}),...(entity?{mainEntity:{'@id':entityId}}:Astro.props.article?{mainEntity:{'@id':canonical+'#article'}}:{})},
 ...(crumbs.length>1?[{'@type':'BreadcrumbList','@id':canonical+'#breadcrumb',itemListElement:crumbs.map((crumb,index)=>({'@type':'ListItem',position:index+1,...crumb}))}]:[]),
 ...(entity?[{'@type':entity.type,'@id':entityId,url:canonical,name:entity.name,description:entity.description,...(entity.image?{image:new URL(entity.image,siteOrigin).href}:{}),...(entity.type==='Service'?{provider:{'@id':siteOrigin+'/#organization'}}:{manufacturer:{'@id':siteOrigin+'/#organization'}})}]:[]),
 ...(Astro.props.article?[{'@type':'Article','@id':canonical+'#article',url:canonical,inLanguage:'en',headline:Astro.props.articleHeadline||title,description,mainEntityOfPage:{'@id':canonical+'#webpage'},publisher:{'@id':siteOrigin+'/#organization'},...(Astro.props.articleAuthor?{author:{'@id':siteOrigin+'/#organization'}}:{}),...(Astro.props.articlePublished?{datePublished:Astro.props.articlePublished}:{}),...(Astro.props.articleModified?{dateModified:Astro.props.articleModified}:{}),...(Astro.props.articleImage?{image:new URL(Astro.props.articleImage,siteOrigin).href}:{}),...(Astro.props.articleSection?{articleSection:Astro.props.articleSection}:{}),...(Astro.props.articleSources?.length?{citation:Astro.props.articleSources}:{})}]:[])
]};
---
<!doctype html>
<html lang="en">
 <head>
  {!modern&&<style is:inline set:html={legacyStyles}/>}
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
  {pentaSample&&<link rel="preload" href="/fonts/roboto-condensed-bold.woff2" as="font" type="font/woff2" crossorigin/>}
  <script is:inline>
   if (['localhost','127.0.0.1'].includes(location.hostname) && (location.pathname==='/' || /^\/machined-parts\/gallery\/[^/]+\/$/.test(location.pathname)) && new URLSearchParams(location.search).get('preview')==='palette-a') document.documentElement.dataset.palette='a';
  </script>
  <title>{seoTitle} | LZZ Precision</title><meta name="description" content={description}/>
  {!noindex&&<link rel="canonical" href={canonical}/>}
  {noindex&&<meta name="robots" content="noindex, follow"/>}
  <meta name="theme-color" content="#242724"/><link rel="icon" type="image/svg+xml" href="/favicon.svg?v=lzz-graphite-20261018"/>
  <meta property="og:title" content={seoTitle+' | LZZ Precision'}/><meta property="og:description" content={description}/><meta property="og:type" content={Astro.props.article?'article':'website'}/>
  <meta property="og:url" content={canonical}/><meta property="og:image" content={socialImage}/><meta property="og:image:alt" content={sharingImage.alt}/>
  <meta name="twitter:card" content="summary_large_image"/>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structured).replace(/</g,'\\u003c')}/>
 </head>
 <body data-inner-layout={innerLayout?'penta':undefined} data-inner-hero={capabilitySceneHero?'scene':immersiveInnerHero?'immersive':splitInnerHero?'split':undefined} data-home-layout={Astro.props.homeLayout==='penta'?'penta':undefined} data-visual-system={pentaSample?'drawing-first':undefined} data-home-hero={Astro.props.homeHero?"centered-20261017":undefined} data-penta-sample={pentaSample?'20261017':undefined} data-reading-path={designPath} data-page-template={pageTemplate} data-editorial-layout={modern&&usesEditorialLayout(designPath)?'20261015':undefined} data-design-version={modern?"20261017":undefined} class:list={modern?["redesign-site","rd-"+pageTemplate]:['brand-site','finesse-redesigned','precision-gallery','template-'+pageTemplate,{'apple-layout':!noindex&&!/^\/(preview|content-layout-demo-20261010)\//.test(Astro.url.pathname),'home-refined':immersive,'task-pages':/^\/(machined-parts|capabilities|factory|quote)(\/|$)/.test(Astro.url.pathname)}]}>
  <a class="skip-link" href="#main">Skip to content</a>
  <AnalyticsConsent/>
  {(!modern)&&(Astro.url.pathname==='/' || /^\/machined-parts\/gallery\/[^/]+\/$/.test(Astro.url.pathname))&&<PalettePreview/>}
  <header class="site-header navigation-polished" data-navigation={floatingNavigation?'floating':undefined} data-header-tone={headerOverPhoto?'light':'dark'}>
   {floatingNavigation&&<span class="header-surface" aria-hidden="true"></span>}
   <div class:list={['header-inner',{'header-no-quote':Astro.url.pathname==='/quote/'}]}>
    <a href="/" class="brand" aria-label="LZZ Precision home"><img class="brand-logo" src="/media/lzz-logo.png" alt="LZZ" width="108" height="60"/></a>
    <MainNavigation centered={floatingNavigation}/>
    {modern?<div class="header-actions">
     <a class="header-whatsapp" href="https://wa.me/8613858102479" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp +86 138 5810 2479 (opens in a new tab)">
      <ContactIcon kind="whatsapp"/>
     </a>
     {Astro.url.pathname!=='/quote/'&&<a class="button header-quote" href={contextualHeaderQuote}>Request a quote</a>}
    </div>:Astro.url.pathname!=='/quote/'&&<a class="button header-quote" href={contextualHeaderQuote}>Request a quote</a>}
    <button class="menu-toggle" aria-label="Open navigation" aria-expanded="false" aria-controls="main-nav"><span></span><span></span></button>
   </div>
  </header>
  <noscript>
   <style is:inline>body.redesign-site>.site-header{position:relative!important;inset:auto!important;background:#242724!important;color:#fff!important}body.redesign-site>.site-header .brand-logo{filter:none!important}body.redesign-site>.site-header #main-nav,body.redesign-site>.site-header .menu-toggle,body.redesign-site>.site-header-space{display:none!important}body.redesign-site>.site-header .header-inner{grid-template-columns:1fr auto!important}body.redesign-site>.site-header .header-actions{margin-left:auto!important}</style>
   <nav class="site-nojs-navigation" aria-label="Site sections">{siteSections.map(item=><a href={item.href}>{item.title}</a>)}</nav>
  </noscript>
  {floatingNavigation&&!headerOverPhoto&&<div class="site-header-space" aria-hidden="true"></div>}
  <main id="main" tabindex="-1" class:list={{'info-page':isInformationPage}} data-site-section={section?.key}><SectionBreadcrumb items={trail} width={breadcrumbWidth}/><slot/>{cta&&!modern&&<RfqPanel title={closingTitle} note={closingDescription} href={contextualClosingQuote} label={closingLabel}/>}</main>
  <SiteFooter quoteHref={headerQuoteHref==='/quote/'?contextualClosingQuote:contextualHeaderQuote}/>
  {modern&&pentaSample&&<SiteInteractions/>}
  <script>
   if(!document.body.classList.contains('redesign-site')) import('../scripts/site-motion');
   const pentaContentLayout=document.body.dataset.homeLayout==='penta'||document.body.dataset.innerLayout==='penta';
   if(document.body.hasAttribute('data-penta-sample')&&!pentaContentLayout&&!matchMedia('(prefers-reduced-motion: reduce)').matches){
    const entrance=new IntersectionObserver(entries=>entries.forEach(entry=>{if(entry.isIntersecting){entry.target.classList.add('pn-in-view');entrance.unobserve(entry.target);}}),{threshold:.12});
    document.querySelectorAll('main section h2,main section>header,main figure').forEach(element=>{if(!element.closest('astro-island'))entrance.observe(element);});
   }
   const toggle=document.querySelector<HTMLButtonElement>('.menu-toggle');
   const header=document.querySelector<HTMLElement>('.site-header');
   if(header?.dataset.navigation==='floating'){
    let floating=false;
    const updateHeader=()=>{
     const next=window.scrollY>=48||(floating&&window.scrollY>16);
     if(next!==floating){floating=next;header.classList.toggle('is-floating',floating);}
    };
    updateHeader();
    window.addEventListener('scroll',updateHeader,{passive:true});
    window.addEventListener('pageshow',updateHeader);
   }
   const mobileMenu=matchMedia('(max-width:1099.98px)');
   const background=Array.from(document.querySelectorAll<HTMLElement>('main,.lzz-footer'));
   const originalInert=new Map<HTMLElement,boolean>();
   let menuOpen=false;
   const setMenu=(requested:boolean)=>{
    const open=requested&&mobileMenu.matches;
    toggle?.setAttribute('aria-expanded',String(open));toggle?.setAttribute('aria-label',open?'Close navigation':'Open navigation');
    header?.classList.toggle('menu-open',open);document.documentElement.classList.toggle('site-nav-open',open);
    if(open&&!menuOpen){background.forEach(element=>{originalInert.set(element,element.inert);element.inert=true;});}
    if(!open&&menuOpen){background.forEach(element=>{element.inert=originalInert.get(element)||false;});originalInert.clear();}
    menuOpen=open;
    if(open)header?.querySelector<HTMLElement>('.nav-root')?.focus();
    else header?.querySelectorAll<HTMLDetailsElement>('details[open]').forEach(group=>group.open=false);
   };
   toggle?.addEventListener('click',()=>setMenu(toggle.getAttribute('aria-expanded')!=='true'));
   header?.addEventListener('navigation:close',()=>setMenu(false));
   header?.addEventListener('keydown',event=>{
    if(event.key!=='Tab'||!menuOpen)return;
    const targets=Array.from(header.querySelectorAll<HTMLElement>('a[href],button,summary')).filter(element=>element.getClientRects().length>0&&!element.hasAttribute('disabled'));
    const first=targets[0],last=targets.at(-1);
    if(event.shiftKey&&document.activeElement===first){event.preventDefault();last?.focus();}
    else if(!event.shiftKey&&document.activeElement===last){event.preventDefault();first?.focus();}
   });
   document.addEventListener('keydown',event=>{if(event.key==='Escape'&&header?.classList.contains('menu-open')){setMenu(false);toggle?.focus();}});
   document.addEventListener('click',event=>{if(event.target instanceof Node&&!header?.contains(event.target))setMenu(false);});
   header?.addEventListener('focusout',()=>requestAnimationFrame(()=>{if(header.classList.contains('menu-open')&&!header.contains(document.activeElement))setMenu(false);}));
   mobileMenu.addEventListener('change',()=>setMenu(false));
   window.addEventListener('pageshow',()=>setMenu(false));
  </script>
 </body>
</html>
<style is:global>
 .brand-site a.contact-link{display:flex;align-items:center;gap:10px;width:fit-content;max-width:100%;min-height:44px;border:0}
 .brand-site .contact-link .contact-icon{flex-shrink:0}
 .brand-site .contact-link .whatsapp-icon{color:#25d366}
 .brand-site .contact-link span{overflow-wrap:anywhere}
 .brand-site .contact-link:hover span{text-decoration:underline;text-underline-offset:4px}
 @media(min-width:761px) and (max-width:960px){
  .brand-site .site-header nav{display:none;position:absolute;top:100px;left:0;right:0;background:var(--ink);padding:20px 35px 30px;border-bottom:1px solid #ffffff30;box-shadow:0 12px 20px #0002}
  .brand-site .site-header nav a{display:block;font-size:17px;padding:13px 0}
  .brand-site .site-header.menu-open nav{display:block}
  .brand-site .menu-toggle{display:block}
  .brand-site .header-quote{margin-left:auto}
 }
 .company-text p a,.principle-list p a,.section-intro a,.quote-support-note a{text-decoration:underline;text-underline-offset:3px}
</style>



