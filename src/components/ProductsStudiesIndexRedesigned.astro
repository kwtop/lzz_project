---
import ProductsFigure from './ProductsFigure.astro';
import {engineeringCases} from '../data/cases';
import {caseReading} from '../data/caseReading';
import {photo} from '../data/evidence';
import {siteOrigin} from '../data/seo';
import '../styles/products-20261015.css';
const link=(slug:string)=>'/machined-parts/machining-examples/'+slug+'/',processes=engineeringCases.filter(p=>!p.collection),collections=engineeringCases.filter(p=>p.collection);
const featured=processes.find(p=>p.slug==='two-stage-cnc-milling')!;
const otherProcesses=processes.filter(p=>p!==featured);
const anchors:Record<string,string>={'five-axis-machining-multi-face-parts':'multi-face-access','turning-then-milling-cylindrical-parts':'turning-milling','two-stage-cnc-milling':'two-setups','milling-a-pocketed-enclosure-form':'pockets-and-bores','milling-prismatic-components':'prismatic-parts','29-inch-display-housing-cnc-machining':'display-housing'};
const schema={'@context':'https://schema.org','@type':'ItemList',name:'Six machining examples and two workshop collections',numberOfItems:engineeringCases.length,itemListElement:[...processes,...collections].map((p,i)=>({'@type':'ListItem',position:i+1,name:caseReading[p.slug].title,url:siteOrigin+link(p.slug)}))};
---
<article class="rd-page pd-page"><div class="rd-wrap"><header class="pd-studies-head"><h1>Machining examples</h1><p class="pd-lead">Compare holding positions, tool access and the feature relationships that control fit. Choose from six workshop studies or two independent material collections.</p></header>
 <section id="geometry" aria-label="Six machining examples"><span id="processes-title" class="pd-anchor"/><article class="ps-index-feature" id="two-setups" data-core-section="Compare two holding positions"><div class="ps-index-pair">{featured.photos.map((id,i)=><ProductsFigure {...photo(id)} caption={'Setup '+(i+1)+' · source photo'} class={'ps-setup-'+(i+1)} detailWindow sizes="(max-width:767px) calc(180vw - 144px), 600px" eager/>)}</div><div><a href={link(featured.slug)}><h2>One part, two holding positions</h2></a><p>{caseReading[featured.slug].focus}. Review {caseReading[featured.slug].inspectionFocus.toLowerCase()}.</p></div></article><div class="ps-index-list" data-core-section="Choose a machining problem">{otherProcesses.map(item=><article id={anchors[item.slug]}><ProductsFigure {...photo(item.video?'display-housing-panel':item.hero)} caption={undefined} origin="original-photo" sizes="(max-width:767px) calc(100vw - 40px), 560px"/><div><a href={link(item.slug)}><h2>{caseReading[item.slug].title}</h2></a><p>{caseReading[item.slug].focus}. Review {caseReading[item.slug].inspectionFocus.toLowerCase()}.</p>{item.video&&<p class="pd-small">29-inch names the display; enclosure dimensions and machine travel remain to be defined.</p>}</div></article>)}</div></section>
 <section class="rd-section" id="part-families" data-core-section="Choose a material collection"><header><h2>Independent material collections</h2><p>Each source group stands on its own. These records do not establish one order, material test results or a continuous manufacturing sequence.</p></header><div class="ps-collection-grid">{collections.map(item=><article><ProductsFigure {...photo(item.collection==='metal'?'metal-aluminum-close':'plastic-ptfe-shafts')} caption="Original photo" origin="original-photo"/><div><a href={link(item.slug)}><h3>{item.collection==='metal'?'Metal part forms':'Plastic part forms'}</h3></a><p>{caseReading[item.slug].focus}.</p></div></article>)}</div></section>
 <section class="rd-section pd-end" data-core-section="Drawing review and quotation"><div><h2>Review a similar component</h2><p>Send the current drawing, exact material, quantity and the feature relationships that control fit.</p><a class="rd-link" href="/resources/ordering/rfq-checklist/">RFQ checklist</a></div><div id="prepare-rfq"><a class="rd-button" href="/quote/?part=Machining+study+drawing+review">Prepare RFQ email</a><p class="pd-small">Prepare a draft, then attach drawings and send it from your email app.</p></div></section>
 </div></article><script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\\u003c')}/>
