---
import type {CapabilityArt} from '../data/capabilityDesign';
interface Props {art:CapabilityArt;eager?:boolean;class?:string;sizes?:string}
const {art,eager=false,class:className,sizes='(max-width:767px) calc(100vw - 44px), 480px'}=Astro.props;
const widths=art.stem?.includes('/image-led-20261015/')?[480,800,1200,1600]:art.stem?.includes('/editorial-rebuild-20261015/')||art.stem?.includes('/procurement-layout-20261015/')?[480,800,1200,1448]:[480,800,1200,1536];
---
<figure class:list={['cx-concept',className]} data-image-origin={art.origin||'AI-generated'}>
 <img src={art.stem?art.stem+'-1200.webp':art.src} srcset={art.stem?widths.map(w=>`${art.stem}-${w}.webp ${w===1600?1536:w}w`).join(', '):undefined} sizes={sizes} width={art.width||1536} height={art.height||1024} alt={art.alt} loading={eager?'eager':'lazy'} decoding="async"/>
 <figcaption>{art.caption}</figcaption>
</figure>
