---
interface Props {label?:string}
const {label='On this page'}=Astro.props;
---
<details class="reading-index" data-reading-index open>
 <summary>{label}<svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="m5 7.5 5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></summary>
 <slot/>
</details>
<script is:inline>
 document.querySelectorAll('[data-reading-index]:not([data-reading-index-ready])').forEach(index=>{
  index.dataset.readingIndexReady='true';
  const compact=window.matchMedia('(max-width:960px)');
  const sync=()=>{index.open=!compact.matches;};
  sync();
  compact.addEventListener('change',sync);
  index.addEventListener('click',event=>{
   if(compact.matches&&event.target instanceof Element&&event.target.closest('a[href^="#"]'))index.open=false;
  });
 });
</script>
