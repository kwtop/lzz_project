---
import {ArrowUpRight,ArrowRight} from 'lucide-react';
import {parts,processes,materials,facts,studies,steps,photo} from './content';
const {section}=Astro.props;
---
{section==='planning'&&<section class="planning wrap" aria-label="Order planning"><div><span class="label">Minimum order</span><strong>From 1 piece</strong></div><div><span class="label">Production time</span><strong>7–14 business days</strong></div><div><p>After drawing and order confirmation, including surface finishing. Transit is additional.</p><a class="text-link" href="/about/how-we-work/">How ordering works <ArrowRight size={17}/></a></div></section>}
{section==='parts'&&<section class="parts-section wrap section" id="parts"><header class="section-heading"><div><span class="eyebrow">Custom parts</span><h2>Made around<br/>your requirements.</h2></div><div><p>Explore part examples, then send your own drawing. Material, finish and acceptance criteria are agreed for your order.</p><a class="text-link" href="/machined-parts/">Browse all parts <ArrowUpRight size={18}/></a></div></header><div class="parts-grid">{parts.map((p,i)=><a class={'part part-'+i} href={'/machined-parts/gallery/'+p.slug+'/'}><figure><img src={p.image} alt={p.name} width="1200" height="1200" loading="eager"/></figure><div class="part-caption"><div><span class="label">{p.detail}</span><h3>{p.name}</h3></div><ArrowUpRight size={22}/></div></a>)}</div></section>}
{section==='process'&&<section class="process-section section" id="process"><div class="wrap process-layout"><div class="process-intro"><span class="eyebrow">Capabilities & materials</span><h2>The right process<br/>for your part.</h2><p>We review the drawing and critical features before choosing the machining route.</p><a class="text-link" href="/capabilities/">All machining capabilities <ArrowUpRight size={18}/></a><figure><img src={photo('turning-operation').src} alt={photo('turning-operation').alt} width="1000" height="1200" loading="eager"/><figcaption>CNC turning · LZZ workshop</figcaption></figure></div><div class="process-directory"><div class="process-list">{processes.map((p,i)=><a href={p.href}><span class="process-number">0{i+1}</span><div><h3>{p.name}</h3><p>{p.description}</p></div><ArrowUpRight size={22}/></a>)}</div><div class="material-list"><h3>Start with the material</h3><nav aria-label="Materials">{materials.map(m=><a href={m.href}>{m.name}<ArrowUpRight size={16}/></a>)}</nav><a class="text-link" href="/resources/technical-guides/material-and-finish-checklist/">Material & finish checklist <ArrowRight size={17}/></a></div></div></div></section>}
{section==='evidence'&&<section class="evidence-section section wrap" id="quality"><header class="section-heading"><div><span class="eyebrow">Factory & quality</span><h2>A closer look<br/>at LZZ.</h2></div><div><p>Custom CNC machining in Hangzhou. See the workshop and discuss the inspection records your part requires.</p><a class="text-link" href="/about/">About our company <ArrowUpRight size={18}/></a></div></header><figure class="workshop"><img src={photo('workshop-wide').src} alt={photo('workshop-wide').alt} width="1600" height="1108" loading="eager"/><figcaption>LZZ machining workshop · Hangzhou, China</figcaption></figure><div class="facts">{facts.map(f=><div><strong>{f.value}</strong><span>{f.label}</span></div>)}<a class="text-link" href="/factory/">Explore our factory <ArrowUpRight size={18}/></a></div><div class="inspection"><figure><img src={photo('cmm-room').src} alt={photo('cmm-room').alt} width="1200" height="1600" loading="eager"/></figure><div><span class="eyebrow">Inspection</span><h3>Check the features<br/>that matter.</h3><p>We agree measurement methods, critical dimensions and inspection records against your drawing before machining.</p><a class="text-link" href="/factory/quality/">Quality control & records <ArrowUpRight size={18}/></a><div class="qualification"><h4>Supplier qualification</h4><p>Request the current ISO 9001 certificate and scope for your supplier review.</p><a href="/factory/quality/#quality-management">View qualification requirements <ArrowRight size={16}/></a></div></div></div></section>}
{section==='studies'&&<section class="studies-section section wrap"><header class="section-heading"><div><span class="eyebrow">Machining examples</span><h2>From setup<br/>to component.</h2></div><div><p>Explore machining routes and the features to define for a similar part.</p><a class="text-link" href="/machined-parts/machining-examples/">All machining examples <ArrowUpRight size={18}/></a></div></header><div class="studies-grid">{studies.map((s,i)=><a class={'study study-'+i} href={'/machined-parts/machining-examples/'+s.slug+'/'}><figure><img src={s.image.src} alt={s.image.alt} width="1200" height="800" loading="eager"/></figure><div><span class="label">{s.process}</span><h3>{s.title}</h3><p>{s.lead}</p><span class="text-link">Explore the study <ArrowUpRight size={17}/></span></div></a>)}</div></section>}
{section==='ordering'&&<section class="ordering section wrap"><header><span class="eyebrow">Working together</span><h2>A clear path<br/>from drawing to part.</h2><a class="text-link" href="/about/how-we-work/">How we work <ArrowUpRight size={18}/></a></header><ol>{steps.map(([title,text],i)=><li><span>0{i+1}</span><div><h3>{title}</h3><p>{text}</p></div></li>)}</ol></section>}
