---
import Layout from '../layouts/Layout.astro';
import AboutPhoto from './AboutPhoto.astro';
import AboutClosing from './AboutClosing.astro';
import {companyFacts} from '../data/company';
import {companyNews} from '../data/companyNews';
import {photoById} from '../data/aboutEditorial';
import '../styles/about-redesign.css';
const updates=['australian-customer-workshop-visit-january-2025','china-africa-west-lake-summit-2025'].map(slug=>companyNews.find(item=>item.slug===slug)!);
const legacyHashes=Object.fromEntries(['company-overview','company-factory','people-heading','company-history','company-network','applications','part-studies'].map(id=>[id,'/about/company-profile/#'+id]));
Object.assign(legacyHashes,{documents:'/about/company-profile/#documents','company-archive':'/about/company-news/',contact:'/about/contact/'});
---
<Layout title="About LZZ: CNC machining in Hangzhou" description="Meet LZZ Precision in Hangzhou. Explore the company, drawing-to-delivery process, supplier documents, workshop visits and contact details." cta={false}>
 <article class="al-page al-overview"><div class="al-wrap">
  <header class="al-hero"><div class="al-overview-intro"><div><h1>LZZ Precision.<br/>Custom machining in Hangzhou.</h1></div><div><p class="al-lead">LZZ Precision makes custom CNC machined parts to your drawing. Get to know the company, review how an order moves from quotation to delivery, and find the information you need to qualify us as a supplier.</p><a class="al-inline-link" href="/about/company-profile/">Meet LZZ Precision</a></div></div><AboutPhoto id="workshop-wide" caption="LZZ machining workshop · Hangzhou, China" eager class="al-overview-image" sizes="(max-width:760px) calc(100vw - 44px), 1280px"/><dl class="al-facts">{companyFacts.map(fact=><div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}</dl></header>
  <section class="al-section" aria-labelledby="al-company-paths"><header class="al-section-head"><h2 id="al-company-paths">Get to know your machining supplier</h2><p>Start with the company and workshop, then review the working process and documents relevant to your order.</p></header><div class="al-pathways"><article class="al-pathway-feature"><AboutPhoto id="visitor-part-discussion" caption="A component discussion during the January 2025 workshop visit"/><h3><a href="/about/company-profile/">The company behind the parts</a></h3><p>Our Hangzhou workshop, engineering experience and company development, with original photographs and company recognition documents for supplier review.</p><a class="al-inline-link" href="/about/company-profile/">Company profile</a></article><div class="al-pathway-list"><article><h3><a href="/about/how-we-work/">From your drawing to delivery</a></h3><p>Quotation scope, sample approval, inspection and delivery responsibilities. See what to agree at each stage.</p></article><article><h3><a href="/about/company-news/">Company news and workshop visits</a></h3><p>Original photographs from workshop visits, events and days with the LZZ team.</p></article><article><h3><a href="/about/contact/">Talk to LZZ</a></h3><p>Email, WhatsApp, our Hangzhou address and the information to include with a machining inquiry.</p></article></div></div></section>
  <section class="al-section" aria-labelledby="al-supplier-review"><div class="al-assurance"><div><h2 id="al-supplier-review">Review the requirements that matter to your order</h2><p>Supplier information and part acceptance serve different purposes. Confirm both before releasing production.</p><a class="al-inline-link" href="/about/company-profile/#documents">Review supplier documents</a></div><dl class="al-assurance-list"><div><dt>Company and quality system</dt><dd>LZZ is ISO 9001 certified. Request the current certificate, holder and scope for your supplier review.</dd></div><div><dt>Drawing and acceptance</dt><dd>Specify the revision, material, critical features, finish and inspection records needed for your part.</dd></div><div><dt>Order and delivery</dt><dd>Agree the quantity, quotation scope, production schedule, packing and shipping basis.</dd></div></dl></div></section>
  <section class="al-section" aria-labelledby="al-working-people"><header class="al-section-head"><h2 id="al-working-people">People, parts and conversations</h2><p>Workshop visits and company events provide a closer look at LZZ. Explore the dated records and original photographs.</p></header><div class="al-news-teasers">{updates.map((item,i)=>{const image=photoById(i===0?'australian-visit-01':'china-africa-summit-01');return <article><a href={'/about/company-news/'+item.slug+'/'} aria-label={'Read '+item.title}><AboutPhoto src={image.src} srcset={image.srcset} width={image.width} height={image.height} alt={image.caption} class="al-teaser-photo"/></a><time datetime={item.eventDate}>{item.eventDateLabel}</time><h3><a href={'/about/company-news/'+item.slug+'/'}>{item.title}</a></h3><p>{item.description}</p></article>;})}</div><a class="al-inline-link" href="/about/company-news/">Explore company news</a></section>
  <AboutClosing/>
 </div></article>
</Layout>
<script is:inline define:vars={{legacyHashes}}>const moveLegacyAboutHash=()=>{const target=legacyHashes[location.hash.slice(1)];if(target)location.replace(target);};moveLegacyAboutHash();window.addEventListener('hashchange',moveLegacyAboutHash);</script>
