---
import type {RevisedCapability} from '../data/capabilityRedesign';
import {capabilityArtwork} from '../data/capabilityDesign';
import CapabilityIntro from './CapabilityIntro.astro';
import CapabilityMaterialTable from './CapabilityMaterialTable.astro';
import CapabilityExamples from './CapabilityExamples.astro';
import CapabilityConcept from './CapabilityConcept.astro';
import CapabilityEvidence from './CapabilityEvidence.astro';
import CapabilityInspectionReview from './CapabilityInspectionReview.astro';
import CapabilityInquiry from './CapabilityInquiry.astro';
import CapabilityDecisionGuide from './CapabilityDecisionGuide.astro';
import {capabilityDecisions} from '../data/capabilityDecisions';
import ProductsFigure from './ProductsFigure.astro';
import {siteImage} from '../data/siteImages';
import '../styles/plastic-machining.css';
interface Props {page:RevisedCapability;quoteHref:string}
const {page,quoteHref}=Astro.props;
const guide=capabilityDecisions[page.slug];
const examplesPage={...page,plan:{...page.plan,exampleIntro:guide.featureIntro}};
const acceptanceQuestions=page.scopeQuestions.filter(q=>q.question!=='Is PTFE the same as a Teflon coating?');
---
<div class="polymer-page pn-capability-rollout" data-penta-capability={page.slug}>
 <div data-core-section="service"><CapabilityIntro page={page} material quoteHref={quoteHref}/></div>
 <CapabilityExamples page={examplesPage} skipHero singleEntry coreSection="part-forms"/>
 <div class="polymer-section polymer-materials" data-core-section="polymer-selection"><CapabilityMaterialTable page={page} title="Polymer selection and dimensional stability" intro={guide.materialsIntro}><CapabilityDecisionGuide slug={page.slug} compact/></CapabilityMaterialTable></div>
 <section class="polymer-section polymer-support" id="geometry-review" data-core-section="support-and-access"><header><h2>Support the working features</h2></header><div class="polymer-support-grid"><CapabilityConcept art={{...capabilityArtwork.plastic,caption:'Geometry illustration of a thin polymer part supported by a fixture.'}}/><div><p>Low-stress clamping, wall support and temperature control help limit deflection when machining press fits, inserts or deep pockets.</p><p>Blind holes restrict cutter reach; we review hole depth and the wall needed to support assembly loads at inserts.</p></div></div></section>
 <section class="polymer-section polymer-archive" id="machining-studies" data-core-section="source-collection"><header class="polymer-heading"><h2>Machined polymer forms</h2><p>Compare stepped forms, slots and drilled features.</p></header><div class="polymer-archive-grid"><CapabilityEvidence id="plastic-ptfe-intermediate" caption="Semi-finished parts identified as PTFE in the collection." sizes="(max-width:767px) 230px, 250px"/><CapabilityEvidence id="plastic-ptfe-shafts" caption="Stepped parts identified as PTFE in the collection." sizes="(max-width:767px) 230px, 250px"/><div class="polymer-clip"><ProductsFigure {...siteImage('peek-components-reference')} sizes="(max-width:767px) calc(100vw - 40px), 370px" sourceHref="/media/source-details/peek-parts.mp4" sourceLabel="View original clip" showSourceLink/></div></div>{page.study&&<a class="rd-link" href={page.study.href}>{page.study.title}</a>}</section>
 <CapabilityInspectionReview page={page} title="Accept the part in its agreed condition" questions={acceptanceQuestions}/>
 <CapabilityInquiry page={page} quoteHref={quoteHref} orderFirst coreSection="quotation"/>
</div>
