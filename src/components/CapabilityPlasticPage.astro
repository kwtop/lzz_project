---
import type {RevisedCapability} from '../data/capabilityRedesign';
import {capabilityArtwork} from '../data/capabilityDesign';
import CapabilityIntro from './CapabilityIntro.astro';
import CapabilityMaterialTable from './CapabilityMaterialTable.astro';
import CapabilityExamples from './CapabilityExamples.astro';
import CapabilityConcept from './CapabilityConcept.astro';
import CapabilityEvidence from './CapabilityEvidence.astro';
import CapabilityInspectionReview from './CapabilityInspectionReview.astro';
import CapabilityInquiry from './CapabilityInquiry.astro';
import CapabilityDecisionGuide from './CapabilityDecisionGuide.astro';
import {capabilityDecisions} from '../data/capabilityDecisions';
import ProductsFigure from './ProductsFigure.astro';
import ProductsClip from './ProductsClip.astro';
import {siteImage} from '../data/siteImages';
import '../styles/plastic-machining.css';
interface Props {page:RevisedCapability;quoteHref:string}
const {page,quoteHref}=Astro.props;
const guide=capabilityDecisions[page.slug];
const examplesPage={...page,plan:{...page.plan,exampleIntro:guide.featureIntro}};
const acceptanceQuestions=page.scopeQuestions.filter(q=>q.question!=='Is PTFE the same as a Teflon coating?');
---
<div class="polymer-page pn-capability-rollout" data-penta-capability={page.slug}>
 <div data-core-section="service"><CapabilityIntro page={page} material quoteHref={quoteHref}/></div>
 <CapabilityExamples page={examplesPage} skipHero singleEntry coreSection="part-forms"/>
 <div class="polymer-section polymer-materials" data-core-section="polymer-selection"><CapabilityMaterialTable page={page} title="Choose the polymer and measurement conditions" intro={guide.materialsIntro}><CapabilityDecisionGuide slug={page.slug}/></CapabilityMaterialTable></div>
 <section class="polymer-section polymer-support" id="geometry-review" data-core-section="support-and-access"><header><h2>Support the working features</h2></header><div class="polymer-support-grid"><CapabilityConcept art={{...capabilityArtwork.plastic,caption:'Holes, wall sections and fitted interfaces need support suited to the polymer and assembly loads. Geometry illustration.'}}/><div><p>Clamping can deflect a plastic part before cutting begins. Low-stress workholding, thin-wall support and temperature control help establish a suitable machining plan, especially around press fits, inserts and deep pockets.</p><p>Blind holes limit tool access differently from through-holes. Insert interfaces and the surrounding walls also carry assembly loads, so the hole depths, wall sections and mating components are reviewed together.</p><p>A fit measured after machining can change with temperature or moisture exposure. The acceptance plan therefore identifies temperature, moisture and conditioning; electrical, food-contact and medical requirements need separate documents or tests.</p></div></div></section>
 <section class="polymer-section polymer-archive" id="machining-studies" data-core-section="source-collection"><header class="polymer-heading"><h2>Machined polymer forms</h2><p>Intermediate forms, long stepped parts and the holes and slots in PEEK components require different support and tool access. Specify the exact material grade and performance requirements for each part number.</p></header><div class="polymer-archive-grid"><CapabilityEvidence id="plastic-ptfe-intermediate" caption="The intermediate forms show the material present before later features are completed. Identified as semi-finished PTFE parts in the source collection." sizes="(max-width:767px) 230px, 250px"/><CapabilityEvidence id="plastic-ptfe-shafts" caption="Long stepped forms show how working diameters relate along a part. Identified as PTFE in the source collection; original photograph." sizes="(max-width:767px) 230px, 250px"/><div class="polymer-clip"><ProductsFigure {...siteImage('peek-components-reference')} sizes="(max-width:767px) calc(100vw - 40px), 370px" sourceHref="/media/source-details/peek-parts.mp4" sourceLabel="View original clip" showSourceLink/><ProductsClip id="peek-parts" title="Original PEEK component clip" description="A 3-second PEEK component clip showing perimeter holes and parallel slots." showHeading={false}/></div></div>{page.study&&<a class="rd-link" href={page.study.href}>{page.study.title}</a>}</section>
 <CapabilityInspectionReview page={page} title="Accept the part in its agreed condition" questions={acceptanceQuestions}/>
 <CapabilityInquiry page={page} quoteHref={quoteHref} orderFirst coreSection="quotation"/>
</div>
