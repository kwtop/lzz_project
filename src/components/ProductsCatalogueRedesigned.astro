---
import PartsCatalogueExplorer from './PartsCatalogueExplorerRedesigned';
import ProductsFigure from './ProductsFigure.astro';
import {partVisual,partDisplayTitle,partDisplayFeature} from '../data/productsEditorial';
import {partBrowseGroups,matchesBrowseFilter,partMaterialStatus} from '../data/productBrowse';
import {productTitle} from '../data/presentation';
import {productSummary} from '../data/productSummaries';
import {productManufacturing} from '../data/manufacturing';
import {productTags} from '../data/productTags';
import {partTask,realProductDetails} from '../data/productsRebuild';
import sourceMedia from '../data/productSourceMedia.generated.json';
import catalog from '../data/catalog.json';
import additional from '../data/additionalMedia.generated.json';
import {siteOrigin} from '../data/seo';
import '../styles/products-20261015.css';
const labels:Record<string,string>={'CNC-Milling-Service':'CNC milling','CNC-Turning-Service':'CNC turning','5-Axis-CNC-Machining':'5-axis machining','Casting-Machining':'Machining of castings','Aluminum-CNC-Parts':'Aluminum','Stainless-Steel-CNC-Parts':'Stainless steel','Copper-Brass-CNC-Parts':'Copper & brass','Plastic-Machined-Parts':'Engineering plastics','Prototype-Machining':'Prototype','Low-Volume-Production':'Small batch'};
const facets=[{label:'Process',keys:['CNC-Milling-Service','CNC-Turning-Service','5-Axis-CNC-Machining','Casting-Machining']},{label:'Material',keys:['Aluminum-CNC-Parts','Stainless-Steel-CNC-Parts','Copper-Brass-CNC-Parts','Plastic-Machined-Parts']},{label:'Order type',keys:['Prototype-Machining','Low-Volume-Production']}].map(f=>({label:f.label,options:f.keys.map(key=>({key,label:labels[key]}))}));
const browseForms=[...partBrowseGroups,...[{key:'castings',label:'Machined castings',task:'casting'},{key:'assemblies',label:'Component & assembly references',task:'assembly'}].map(g=>({...g,slugs:catalog.products.filter(p=>partTask(sourceMedia[p.slug as keyof typeof sourceMedia].id)===g.task).map(p=>p.slug)}))];
const cards=catalog.products.map(p=>{const summary=productSummary(p);return {slug:p.slug,title:partDisplayTitle(p),...partVisual(p),...realProductDetails[sourceMedia[p.slug as keyof typeof sourceMedia].id],quality:sourceMedia[p.slug as keyof typeof sourceMedia].id==='P04'?'low-resolution' as const:undefined,material:partMaterialStatus(p),feature:sourceMedia[p.slug as keyof typeof sourceMedia].id==='P08'?'':partDisplayFeature(p,summary.card),search:[p.name,partDisplayTitle(p),productTitle(p),...productTags(p).map(t=>t.replaceAll('-',' ')),...Object.values(summary),...Object.values(productManufacturing(p))].join(' ').toLowerCase().replace(/\s+/g,' '),filters:catalog.categories.filter(c=>matchesBrowseFilter(p,c.key)).map(c=>c.key),forms:browseForms.filter(g=>g.slugs.includes(p.slug)).map(g=>g.key)}});
const schema={'@context':'https://schema.org','@type':'ItemList',name:'Machined parts gallery',numberOfItems:cards.length,itemListElement:cards.map((p,i)=>({'@type':'ListItem',position:i+1,name:p.title,url:siteOrigin+'/machined-parts/gallery/'+p.slug+'/'}))};
const referenceGalleries=[{slug:'covered-part-forms',title:'Covered wheels, rollers & shaped components',href:'#covered-part-forms',...additional.photos['covered-wheels'],feature:'Reference gallery · core, covering, hardness and bonding to define.',search:'covered coated rubber polyurethane wheels rollers shaped components cores covering hardness bonding shafts'},{slug:'gear-forms',title:'Conical & cylindrical gear forms',href:'#gear-forms',...additional.photos['gear-bevel-examples'],feature:'Reference gallery · tooth specification, mating form and inspection to define.',search:'gears gear conical cylindrical bevel tooth teeth bore hub mating components'}].map(p=>({...p,alt:p.title}));
const groups=[{id:'covered-part-forms',title:'Covered wheels, rollers & shaped components',description:'Specify the core and covering materials, hardness, mounting interfaces and exposed working surfaces. Agree formulation, covering thickness and bonding separately; the photographs do not identify these values.',ids:['covered-wheels','covered-rollers','covered-shaped-parts']},{id:'gear-forms',title:'Conical & cylindrical gear forms',description:'Supply the tooth specification, material, mating component, bore and hub dimensions. Agree the tooth and interface inspection method; tooth counts, module and accuracy are not inferred from photographs.',ids:['gear-bevel-examples','gear-cylindrical-examples']}];
---
<article class="rd-page pd-page pd-catalogue-page"><div class="rd-wrap"><header class="pd-catalogue-head" data-core-section="Gallery introduction"><h1>Parts gallery</h1><p class="pd-lead">35 reference records to help define your custom part.</p></header>
 <section aria-label="Find custom part references" data-core-section="Find and compare reference forms"><PartsCatalogueExplorer cards={cards} referenceGalleries={referenceGalleries} forms={browseForms.map(({key,label})=>({key,label}))} facets={facets} client:load/></section>
 <section class="rd-section" id="additional-part-forms" data-core-section="Covered parts and gear source collections"><header><h2>Covered parts and gear forms</h2><p>These complete source collections remain available independently of the gallery filters.</p></header>{groups.map(group=><article class="pd-archive-group pd-archive-story" id={group.id}><div><h3>{group.title}</h3><p>{group.description}</p></div><div class="pd-archive-media">{group.ids.map(id=>{const im=additional.photos[id as keyof typeof additional.photos];return <ProductsFigure {...im} alt={im.caption} origin={im.kind}/>})}</div></article>)}</section>
 <nav class="pd-collection-links" aria-label="Material collections"><a href="/machined-parts/machining-examples/custom-plastic-parts-ptfe-pom-pe-acrylic/">Plastic part photographs &amp; clips</a><a href="/machined-parts/machining-examples/custom-metal-parts-batch-examples/">Metal part photographs &amp; clips</a></nav>
 <section class="rd-section pd-end" data-core-section="Machining review and enquiry"><div><h2>From the part form to the setup</h2><p>See original workshop photographs of milling, turning and changing the holding orientation.</p><a class="rd-link" href="/machined-parts/machining-examples/">Machining setups &amp; studies</a></div><div id="prepare-rfq"><h3>Your drawing is the starting point</h3><a class="rd-button" href="/quote/?part=Part+example+drawing+review">Prepare RFQ email</a><p class="pd-small">Prepare a draft, then attach drawings and send it from your email app.</p></div></section>
 </div></article><script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\\u003c')}/>
