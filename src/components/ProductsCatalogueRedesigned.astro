---
import PartsCatalogueExplorer from './PartsCatalogueExplorerRedesigned';
import ProductsFigure from './ProductsFigure.astro';
import {partVisual,partDisplayTitle,partDisplayFeature} from '../data/productsEditorial';
import {partBrowseGroups,matchesBrowseFilter,partMaterialStatus} from '../data/productBrowse';
import {productTitle} from '../data/presentation';
import {gradeReview,productSummary} from '../data/productSummaries';
import {productManufacturing} from '../data/manufacturing';
import {productTags} from '../data/productTags';
import {partTask,realProductDetails} from '../data/productsRebuild';
import sourceMedia from '../data/productSourceMedia.generated.json';
import {cataloguePreview} from '../data/cataloguePreviews';
import catalog from '../data/catalog.json';
import additional from '../data/additionalMedia.generated.json';
import {siteOrigin} from '../data/seo';
import '../styles/products-20261015.css';
const labels:Record<string,string>={'CNC-Milling-Service':'CNC milling','CNC-Turning-Service':'CNC turning','5-Axis-CNC-Machining':'5-axis machining','Casting-Machining':'Machining of castings','Aluminum-CNC-Parts':'Aluminum','Stainless-Steel-CNC-Parts':'Stainless steel','Copper-Brass-CNC-Parts':'Copper & brass','Plastic-Machined-Parts':'Engineering plastics','Prototype-Machining':'Prototype','Low-Volume-Production':'Small batch'};
const facets=[{label:'Process',keys:['CNC-Milling-Service','CNC-Turning-Service','5-Axis-CNC-Machining','Casting-Machining']},{label:'Material',keys:['Aluminum-CNC-Parts','Stainless-Steel-CNC-Parts','Copper-Brass-CNC-Parts','Plastic-Machined-Parts']},{label:'Order type',keys:['Prototype-Machining','Low-Volume-Production']}].map(f=>({label:f.label,options:f.keys.map(key=>({key,label:labels[key]}))}));
const browseForms=[...partBrowseGroups,...[{key:'castings',label:'Machined castings',task:'casting'},{key:'assemblies',label:'Components & assemblies',task:'assembly'}].map(g=>({...g,slugs:catalog.products.filter(p=>partTask(sourceMedia[p.slug as keyof typeof sourceMedia].id)===g.task).map(p=>p.slug)}))];
const cards=catalog.products.map(product=>{
 const summary=productSummary(product);
 const sourceId=sourceMedia[product.slug as keyof typeof sourceMedia].id;
 const title=partDisplayTitle(product);
 const feature=partDisplayFeature(product,summary.card);
 const material=summary.material===gradeReview?{}:{material:partMaterialStatus(product)};
 return {
  slug:product.slug,title,
  ...partVisual(product),...realProductDetails[sourceId],...cataloguePreview(product.slug),...material,
  feature:sourceId==='P08'?'':feature,
  search:[product.name,title,productTitle(product),feature,...productTags(product).map(tag=>tag.replaceAll('-',' ')),...Object.values(summary),...Object.values(productManufacturing(product))].join(' ').toLowerCase().replace(/\s+/g,' '),
  filters:catalog.categories.filter(category=>matchesBrowseFilter(product,category.key)).map(category=>category.key),
  forms:browseForms.filter(group=>group.slugs.includes(product.slug)).map(group=>group.key),
 };
});
const schema={'@context':'https://schema.org','@type':'ItemList',name:'Machined parts gallery',numberOfItems:cards.length,itemListElement:cards.map((p,i)=>({'@type':'ListItem',position:i+1,name:p.title,url:siteOrigin+'/machined-parts/gallery/'+p.slug+'/'}))};
const referenceGalleries=[{slug:'covered-part-forms',title:'Covered wheels, rollers & shaped components',href:'#covered-part-forms',...additional.photos['covered-wheels'],feature:'Reference gallery · core, covering, hardness and bonding to define.',search:'covered coated rubber polyurethane wheels rollers shaped components cores covering hardness bonding shafts'},{slug:'gear-forms',title:'Conical & cylindrical gear forms',href:'#gear-forms',...additional.photos['gear-bevel-examples'],feature:'Reference gallery · tooth specification, mating form and inspection to define.',search:'gears gear conical cylindrical bevel tooth teeth bore hub mating components'}].map(p=>({...p,alt:p.title}));
const groups=[{id:'covered-part-forms',title:'Covered wheels, rollers & shaped components',description:'Specify the core and covering materials, hardness, mounting interfaces and exposed working surfaces. Agree the formulation, covering thickness and bonding requirements for each component.',ids:['covered-wheels','covered-rollers','covered-shaped-parts']},{id:'gear-forms',title:'Conical & cylindrical gear forms',description:'Supply the tooth specification, material, mating component, bore and hub dimensions. Agree the tooth and interface inspection method; tooth counts, module and accuracy are not inferred from photographs.',ids:['gear-bevel-examples','gear-cylindrical-examples']}];
---
<article class="rd-page pd-page pd-catalogue-page"><div class="rd-wrap"><header class="pd-catalogue-head" data-core-section="Gallery introduction"><h1>Parts gallery</h1></header>
 <section aria-label="Find custom part references" data-core-section="Find and compare reference forms"><PartsCatalogueExplorer cards={cards} referenceGalleries={referenceGalleries} forms={browseForms.map(({key,label})=>({key,label}))} facets={facets} client:load/></section>
 <section class="rd-section" id="additional-part-forms" data-core-section="Covered parts and gear source collections">
  <header><h2>Covered parts and gear forms</h2></header>
  {groups.map(group=><article class="pd-archive-group pd-archive-story" id={group.id}>
   <header class="pd-archive-heading"><h3>{group.title}</h3><p>{group.description}</p></header>
   <div class="pd-archive-media" data-views={group.ids.length}>
    {group.ids.map(id=>{const im=additional.photos[id as keyof typeof additional.photos];return <ProductsFigure {...im} alt={im.caption} origin={im.kind} sizes={group.ids.length===3?'(max-width:767px) calc(100vw - 40px), (max-width:900px) calc(100vw - 80px), (max-width:1220px) calc((100vw - 136px) / 3), 362px':'(max-width:767px) calc(100vw - 40px), (max-width:900px) calc(100vw - 80px), (max-width:1220px) calc((100vw - 108px) / 2), 556px'}/>})}
   </div>
  </article>)}
 </section>
 <nav class="pd-collection-links pn-link-index" aria-label="Material collections"><a href="/machined-parts/machining-examples/custom-plastic-parts-ptfe-pom-pe-acrylic/">Plastic part photos</a><a href="/machined-parts/machining-examples/custom-metal-parts-batch-examples/">Metal part photos</a></nav>
 <section class="rd-section pd-end" data-core-section="Machining review and enquiry"><div><h2>From the part form to the setup</h2><a class="rd-link" href="/machined-parts/machining-examples/">Machining setups &amp; studies</a></div><div id="prepare-rfq"><h3>Your drawing is the starting point</h3><a class="rd-button" href={'/quote/?'+new URLSearchParams({part:'Part example drawing review',source:Astro.url.pathname}).toString()}>Request a quote</a></div></section>
 </div></article><script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\\u003c')}/>
