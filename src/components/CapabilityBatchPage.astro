---
import type {RevisedCapability} from '../data/capabilityRedesign';
import {batchReleaseFields} from '../data/capabilityRedesign';
import {capabilityHeroPart} from '../data/capabilityRebuild';
import PentaInnerHero from './PentaInnerHero.astro';
import CapabilityReference from './CapabilityReference.astro';
import CapabilityEvidence from './CapabilityEvidence.astro';
import CapabilityInquiry from './CapabilityInquiry.astro';
import CapabilityConcept from './CapabilityConcept.astro';
import {libraryGuide} from '../data/resourceLibrary';
import '../styles/low-volume-production.css';
interface Props {page:RevisedCapability;quoteHref:string}
const {page,quoteHref}=Astro.props;
const packing={stem:'/media/site-polish-20261016/packing-concept',width:1536,height:1024,alt:'four generic metal components separated in individual foam recesses inside an unmarked carton',caption:'Packing illustration: parts separated in protective foam.'};
---
<div class="batch-page pn-capability-rollout" data-penta-capability={page.slug}>
<PentaInnerHero title={page.plan.title} lead="We machine pilot and repeat batches against the approved revision for each part number, keeping mixed orders traceable." slug={page.slug} part={capabilityHeroPart(page.slug)} quoteHref={quoteHref} secondaryHref="#release-definition" secondaryLabel="Plan each line item"/>
<section class="rd-section cx-project-band batch-definition" id="release-definition" data-core-section="release-definition"><header><h2>One controlled specification per component</h2><p>Specify each part separately and flag the components that need to fit together.</p></header><div class="batch-definition-content" id="part-examples"><dl class="batch-definition-fields">{batchReleaseFields.map(([title,text])=><div><dt>{title}</dt><dd>{text}</dd></div>)}</dl><div class="batch-definition-forms"><CapabilityReference part={page.parts[1]} namedLink singleEntry/><div class="batch-related-form"><a class="rd-link" href={page.parts[2].href}>{page.parts[2].title}</a><p>{page.parts[2].text}</p></div></div></div><p class="cx-callout">Batch size depends on geometry, workholding, material, finishing and inspection.</p></section>
<section class="rd-section batch-approval" id="engineering-fit" data-core-section="first-article-and-release"><header><h2>Approve the first parts, then release the batch</h2><p>When the order calls for a hold point, you can review first-article results before the rest of the batch runs.</p></header><div class="cx-batch-approval"><CapabilityEvidence id="cmm-room" caption="LZZ CMM. Check measurement range and current calibration for your features."/><ol class="cx-release-stages"><li><h3>Before the first parts</h3><p>Approve the revision, critical features, datums and limits. Agree methods, report formats and any hold for first-article approval.</p></li><li><h3>Review the result</h3><p>Review first-article results and in-process and final sampling. Track part, batch, material and finish; record nonconformances and approved deviations.</p></li><li><h3>Release or change</h3><p>Record who approved release, when and against which revision. Approve changes before machining repeat orders.</p></li></ol></div><div class="cx-inline-actions"><a class="rd-link" href={libraryGuide('prototype-vs-small-batch-cnc').href}>Prototype approval and batch release</a></div></section>

<section class="rd-section batch-packing" id="repeat-and-packing" data-core-section="repeat-and-packing"><header><h2>Keep repeat batches traceable through packing</h2></header><div class="batch-packing-grid"><CapabilityConcept art={packing}/><div class="cx-packing-review"><ul><li>Carry forward the approved grade, condition and finish; check changes against shared fits and sampling.</li><li>Separate parts to protect working surfaces, threads, cosmetic faces and edges.</li><li>Label each pack with part number, revision and quantity.</li></ul><div><h3>Records and handover</h3><p>Agree which records travel with the batch and who is responsible for delivery.</p><a class="rd-link" href={libraryGuide('custom-cnc-parts-shipping-checklist').href}>Packing and shipping checklist</a></div></div></div></section>
<CapabilityInquiry page={page} quoteHref={quoteHref} orderFirst coreSection="quotation"/>
</div>
