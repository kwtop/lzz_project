---
import type {RevisedCapability} from '../data/capabilityRedesign';
import {batchReleaseFields} from '../data/capabilityRedesign';
import {capabilityHeroPart} from '../data/capabilityRebuild';
import PentaInnerHero from './PentaInnerHero.astro';
import CapabilityReference from './CapabilityReference.astro';
import CapabilityEvidence from './CapabilityEvidence.astro';
import CapabilityInquiry from './CapabilityInquiry.astro';
import CapabilityConcept from './CapabilityConcept.astro';
import {libraryGuide} from '../data/resourceLibrary';
import '../styles/low-volume-production.css';
interface Props {page:RevisedCapability;quoteHref:string}
const {page,quoteHref}=Astro.props;
const packing={stem:'/media/site-polish-20261016/packing-concept',width:1536,height:1024,alt:'four generic metal components separated in individual foam recesses inside an unmarked carton',caption:'Packing · Confirm protection and packing for the actual order.'};
---
<div class="batch-page pn-capability-rollout" data-penta-capability={page.slug}>
<PentaInnerHero title={page.plan.title} lead="We machine pilot and repeat batches to the approved drawing for each part number. Each release has its own quantity, material, finishing and inspection requirements." slug={page.slug} part={capabilityHeroPart(page.slug)} quoteHref={quoteHref} secondaryHref="#release-definition" secondaryLabel="Plan each line item"/>
<section class="rd-section cx-project-band batch-definition" id="release-definition" data-core-section="release-definition"><header><h2>One controlled specification per component</h2><p>In a mixed-part order, each line item has its own drawing revision, quantity and acceptance requirements.</p></header><div class="batch-definition-content" id="part-examples"><dl class="batch-definition-fields">{batchReleaseFields.map(([title,text])=><div><dt>{title}</dt><dd>{text}</dd></div>)}</dl><div class="batch-definition-forms"><CapabilityReference part={page.parts[1]} namedLink singleEntry/><div class="batch-related-form"><a class="rd-link" href={page.parts[2].href}>{page.parts[2].title}</a><p>{page.parts[2].text}</p></div></div></div><p class="cx-callout">A practical batch size depends on the part geometry and workholding as well as its material, finishing and inspection requirements.</p></section>
<section class="rd-section batch-approval" id="engineering-fit" data-core-section="first-article-and-release"><header><h2>Approve the first parts, then release the batch</h2><p>The quotation and order set hold points, sampling and approval responsibility.</p></header><div class="cx-batch-approval"><CapabilityEvidence id="cmm-room" caption="Original LZZ CMM photograph. Confirm the method, current calibration and report scope for your features."/><ol class="cx-release-stages"><li><h3>Before the first parts</h3><p>Approve the production revision, critical features, datums and acceptance limits. Agree measurement methods, first-article and dimensional report format, and whether production waits for approval.</p></li><li><h3>Review the result</h3><p>Review first-article measurements, in-process and final sampling. Keep part / batch identification, material and finishing traceability. Record nonconformances and authorized deviations.</p></li><li><h3>Release or change</h3><p>Name the approver and record the release date and decision. Authorize changed specifications before machining; repeat releases use the approved baseline and change-control process.</p></li></ol></div><div class="cx-inline-actions"><a class="rd-link" href={libraryGuide('prototype-vs-small-batch-cnc').href}>Prototype approval and batch release</a></div></section>

<section class="rd-section batch-packing" id="repeat-and-packing" data-core-section="repeat-and-packing"><header><h2>Keep the repeat release and packing aligned</h2></header><div class="batch-packing-grid"><CapabilityConcept art={packing}/><div class="cx-packing-review"><ul><li>Keep the approved part number, revision, grade, condition and finish with each release.</li><li>Review authorized changes for their effect on shared interfaces and sampling.</li><li>Protect working surfaces, threads, cosmetic faces and vulnerable edges.</li><li>Agree part identification, quantities per pack, required records and delivery responsibilities.</li></ul><div><h3>Confirm the packing for this order</h3><p>The packing plan separates the parts, protects working interfaces and labels each pack with part number, revision and quantity.</p><a class="rd-link" href={libraryGuide('custom-cnc-parts-shipping-checklist').href}>Packing and shipping checklist</a></div></div></div></section>
<CapabilityInquiry page={page} quoteHref={quoteHref} orderFirst coreSection="quotation"/>
</div>
