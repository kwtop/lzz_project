---
import EvidenceImage from './EvidenceImage.astro';
import {photo} from '../data/evidence';
import {photoFrame} from '../lib/photoFrame';
interface Props {id:string;caption:string;class?:string;sizes?:string;eager?:boolean}
const {id,caption,class:className,sizes='(max-width:760px) calc(100vw - 44px), 560px',eager=false}=Astro.props;
const source=photo(id);
const frame=await photoFrame(source.src,source.width,source.height);
---
<figure class:list={['fd-photo',className]} data-photo-id={id} style={'--fd-source-ratio:'+frame.width/frame.height}>
 <div class="fd-photo-frame"><EvidenceImage id={id} sizes={sizes} loading={eager?'eager':'lazy'}/></div>
 <figcaption>{caption}</figcaption>
</figure>
