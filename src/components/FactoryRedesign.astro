---
import Layout from '../layouts/Layout.astro';
import ImmersiveInnerHero from './ImmersiveInnerHero.astro';
import {siteImage} from '../data/siteImages';
import CapabilityEvidence from './CapabilityEvidence.astro';
import CapabilityConcept from './CapabilityConcept.astro';
import {factoryQuote,workshopMachines,inspectionStages,measurementMethods,orderRecords,qualificationFields,qualificationHref,reportHref} from '../data/factoryEditorial';
import {orderConditions} from '../data/capabilityRedesign';
import '../styles/capability-redesign.css';
import '../styles/factory-redesign.css';
const quoteHref=factoryQuote('overview');
const stageCopy=[
'Agree the drawing revision, critical features, datums and acceptance limits, including which features to record and the required records.',
'Check the initial part before the production run. Agree in advance whether production must wait for your sample approval.',
'Inspect the agreed features during machining, with defined check points, sampling and handling of deviations.',
'Verify finished parts against the agreed drawing and order. Identify checks before or after finishing and the final release records.',
];
const aliases:Record<string,string>={'workshop-title':'workshop','equipment-title':'equipment','quality-title':'quality','documents-title':'documents','delivery-title':'delivery','factory-overview-title':'factory-title','workshop-photographs':'workshop','inspection':'quality','inspection-title':'quality','methods-title':'inspection-equipment','inspection-process-title':'inspection-process','records-title':'inspection-records','qualification-title':'quality-management','workflow-title':'workflow','factory-questions':'delivery','questions-title':'delivery','factory-rfq-title':'prepare-rfq','prepare-email':'prepare-rfq','section-pages-title':'workshop','factory-explore-title':'workshop','factory-review-title':'workshop','factory-package-title':'documents'};
const anchorAliases=(target:string)=>Object.entries(aliases).filter(([,value])=>value===target).map(([key])=>key);
const inputs=['STEP model and controlled 2D drawing with part number, units and revision','The controlling document if model and drawing requirements conflict','Material grade and condition, finish, quantity and protected surfaces','Critical features, datums, tolerances and acceptance limits','First-article hold points, sampling, methods, reports and approval responsibility','Delivery destination, requested date, packing and handover requirements'];
---
<Layout title="CNC Factory & Quality Control in Hangzhou" description="Review LZZ's Hangzhou workshop, machining setups, inspection methods, approval stages and supplier records for custom CNC parts." cta={false} headerQuoteHref={quoteHref}>
<article class="rd-wrap rd-page fx-page">
 <section class="fx-intro" data-core-section="Factory and workshop facts" aria-labelledby="factory-title">{anchorAliases('factory-title').map(id=><span class="fx-anchor" id={id}/>)}
  <ImmersiveInnerHero title="CNC machining in Hangzhou" id="factory-title" lead="See our Hangzhou workshop, the machining setups we use and how we plan inspection for prototypes and small production runs." quoteHref={quoteHref} secondaryHref="#equipment" secondaryLabel="Explore factory & quality"/>
  <dl class="fx-primary-facts"><div><dt>Established</dt><dd>2017 <span>· Hangzhou, China</span></dd></div><div><dt>Production facility</dt><dd>1,500 m²</dd></div><div><dt>Equipment</dt><dd>40+ <span>machining &amp; supporting units</span></dd></div></dl>
  <nav class="fx-local-nav pn-link-index pn-link-index--sections" aria-label="Explore factory and quality"><a href="#workshop">Workshop</a><a href="#equipment">Equipment fit</a><a href="#quality">Inspection</a><a href="#documents">Records</a><a href="#delivery">Delivery</a></nav>
  <div class="fx-production fx-opening-appendix" id="workshop">{anchorAliases('workshop').map(id=><span class="fx-anchor" id={id}/>)}<div class="fx-facts-and-photo"><div><h3>Experience and reference capacity</h3><dl class="fx-fact-list" id="production-capacity"><div><dt>Team experience</dt><dd>More than 15 years of CNC machining experience.</dd></div><div><dt>Reference capacity</dt><dd>About 100,000 small parts per month. Output varies with geometry, material, finishing and the mix of orders.</dd></div></dl><p class="rd-note">For supplier qualification, request dated capacity records with the reporting period, shifts and part mix, alongside the equipment list, staffing and floor-area information.</p></div><CapabilityEvidence id="workshop-operators-2025" image={siteImage('workshop-craft')} caption="Operators and machines on the LZZ production floor. Original source archive: November 2025." sizes="(max-width:767px) calc(100vw - 40px), 560px"/></div>
 </div></section>
<section class="rd-section fx-equipment" data-core-section="Equipment and part fit" id="equipment">{anchorAliases('equipment').map(id=><span class="fx-anchor" id={id}/>)}<header><h2>Machining setups for different part forms</h2><p>Tool access and workholding determine how bores, pockets, threads and angled faces can be reached.</p></header><div class="fx-equipment-grid">{workshopMachines.map(machine=><article><CapabilityEvidence id={machine.photo} caption={machine.caption} image={siteImage(machine.photo==='milling-enclosure-operation'?'setup-first':machine.photo==='turning-operation'?'turning-process':'five-axis-process')}/><h3><a href={machine.href}>{machine.name}</a></h3><p>{machine.text} {machine.parts}</p></article>)}</div><aside class="fx-fit-inputs" id="equipment-review"><h3>Check the size and holding arrangement</h3><div><p>Send the finished-part and stock dimensions, weight and clamping restrictions. We review machine travel, load, tool access, fixture clearance and protected surfaces for your drawing. Maximum sizes are not published here.</p><p class="rd-note">Request the relevant machine models, working range and indexed or simultaneous five-axis capability for your part. The equipment total includes machining and supporting units.</p></div></aside></section>
 <section class="rd-section fx-quality" data-core-section="Inspection stages and methods" id="quality">{anchorAliases('quality').map(id=><span class="fx-anchor" id={id}/>)}<header><h2>Inspection from drawing review to finished parts</h2><p>The drawing defines critical features, datums and acceptance limits. Agree sampling, hold points and the records needed for release.</p></header><div class="fx-inspection-review"><div>{anchorAliases('inspection-process').map(id=><span class="fx-anchor" id={id}/>)}<ol class="fx-inspection-stages" id="inspection-process">{inspectionStages.map((stage,index)=><li><div><h3>{stage.title}</h3><p>{stageCopy[index]}</p></div></li>)}</ol><p class="cx-callout">At incoming-material review, confirm the required grade, condition, supplied blanks and material records for the order. Define any additional incoming checks in the quotation.</p><a class="rd-link" href="/resources/technical-guides/critical-features-cnc-drawing/">Define the critical drawing features</a>
 </div></div><div class="fx-subsection" id="inspection-equipment">{anchorAliases('inspection-equipment').map(id=><span class="fx-anchor" id={id}/>)}<header><h3>Choose a method for each feature</h3><p>Use the drawing datums, consistent support and the correct measurement stage. Confirm whether dimensions apply before or after finishing.</p></header><div class="fx-method-layout"><div><dl class="fx-method-list" id="measurement-methods">{measurementMethods.map(([feature,method,agreement])=><div><dt>{feature}</dt><dd><strong>{method}</strong><p>{agreement}</p></dd></div>)}</dl><p class="cx-callout">Request the instrument range and current calibration evidence relevant to the specified features. Confirm the method and records for any additional special tests in the quotation.</p></div><CapabilityEvidence id="cmm-room" image={siteImage('inspection-room')} caption="Original CMM photograph. Current range, calibration, accuracy and report availability require separate confirmation." class="fx-cmm" sizes="(max-width:767px) calc(100vw - 40px), 340px"/></div></div></section>
 <section class="rd-section" id="documents" data-core-section="Order records and supplier qualification">{anchorAliases('documents').map(id=><span class="fx-anchor" id={id}/>)}<header class="fx-records-heading"><h2>Inspection records and supplier documents</h2><p>Confirm the document package before ordering. Every part record needs a defined scope and a drawing revision, part or batch reference.</p></header><div class="fx-document-layout"><div id="inspection-records">{anchorAliases('inspection-records').map(id=><span class="fx-anchor" id={id}/>)}<h3>Records for your parts</h3><dl class="fx-record-list" id="order-documentation">{orderRecords.map(([record,content,reference])=><div><dt>{record}</dt><dd>{content} {reference}</dd></div>)}</dl><div class="fx-document-actions"><a class="rd-link" href={reportHref}>Request a relevant sample inspection report</a><a class="rd-link" href="/downloads/order-acceptance-checklist.txt" download>Download acceptance checklist</a></div></div><aside class="fx-qualification-panel" id="quality-management">{anchorAliases('quality-management').map(id=><span class="fx-anchor" id={id}/>)}<h3>Supplier qualification</h3><p>LZZ is ISO 9001 certified. Request the current certificate and scope for your supplier review.</p><dl class="fx-qualification-fields">{qualificationFields.map(([title,text])=><div><dt>{title}</dt><dd>{text}</dd></div>)}</dl><a class="rd-link" href={qualificationHref}>Request the ISO certificate</a><div class="fx-document-actions"><a class="rd-link" href="/about/company-profile/#quality-system">Quality system and certificate</a><a class="rd-link" href="/about/company-profile/#documents">Company recognition documents</a></div></aside></div></section>
 <section class="rd-section fx-handover" data-core-section="Packing and handover" id="delivery">{anchorAliases('delivery').map(id=><span class="fx-anchor" id={id}/>)}<header><h2>Packing and handover</h2><p>The packing plan covers surface protection, part identification and the records travelling with the order. Delivery responsibilities are agreed in the quotation.</p></header><div class="fx-delivery-layout"><div id="workflow">{anchorAliases('workflow').map(id=><span class="fx-anchor" id={id}/>)}<ul id="order-deliverables"><li>Protect sealing faces, threads, cosmetic surfaces and vulnerable features.</li><li>Identify part number, drawing revision and quantity for each pack.</li><li>Include the agreed dimensional, material and finishing records.</li><li>Confirm packing arrangements, shipment documents, destination and delivery responsibilities.</li></ul><p class="fx-packing-request">Agree a packing plan showing how parts are separated, working interfaces are protected and identification is applied. Review the complete arrangement before shipment.</p><div class="fx-document-actions"><a class="rd-link" href="/resources/ordering/">Drawing, approval and delivery guide</a><a class="rd-link" href="/resources/ordering/custom-cnc-parts-shipping-checklist/">Packing and shipping checklist</a></div></div><aside class="fx-packing-pending"><CapabilityConcept art={{stem:"/media/site-polish-20261016/packing-concept",width:1536,height:1024,alt:"Generic machined forms separated in protective foam inside a carton",caption:"Protective packing · confirm protection and packing for the actual order."}}/><p class="rd-note">Set the packing requirements for the dimensions and transport conditions of your order.</p></aside></div>
 </section><section class="rd-section cx-inquiry" data-core-section="Drawing inputs and quotation" id="prepare-rfq">{anchorAliases('prepare-rfq').map(id=><span class="fx-anchor" id={id}/>)}<header><h2>Discuss your part and supplier requirements</h2><p>Send your drawing package and let us know which supplier documents your team needs.</p></header><ul class="cx-rfq-inputs">{inputs.map(input=><li>{input}</li>)}</ul><div class="cx-inquiry-action"><a class="rd-button" href={quoteHref}>Request a quote</a><p class="rd-note">Review your draft in the browser, then attach the drawings and send it from your email app.</p><a class="rd-link" href="/about/how-we-work/">Review project responsibilities</a></div><p class="cx-order-note" id="order-conditions">{orderConditions}</p></section>
</article>
</Layout>
<script>
 const aliases:Record<string,string>={'workshop-title':'workshop','equipment-title':'equipment','quality-title':'quality','documents-title':'documents','delivery-title':'delivery','factory-overview-title':'factory-title','workshop-photographs':'workshop','inspection':'quality','inspection-title':'quality','methods-title':'inspection-equipment','inspection-process-title':'inspection-process','records-title':'inspection-records','qualification-title':'quality-management','workflow-title':'workflow','factory-questions':'delivery','questions-title':'delivery','factory-rfq-title':'prepare-rfq','prepare-email':'prepare-rfq','section-pages-title':'workshop','factory-explore-title':'workshop','factory-review-title':'workshop','factory-package-title':'documents'};
 function revealFactoryAnchor(){const key=location.hash.slice(1);const target=document.getElementById(aliases[key]||key);if(target)requestAnimationFrame(()=>target.scrollIntoView({block:'start'}));}
 window.addEventListener('hashchange',revealFactoryAnchor);if(location.hash)revealFactoryAnchor();
</script>





