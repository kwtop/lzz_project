---
import Layout from '../layouts/Layout.astro';
import ImmersiveInnerHero from './ImmersiveInnerHero.astro';
import {photo} from '../data/evidence';
import {photoFrame} from '../lib/photoFrame';
import {manufacturingCapacity,factoryCapabilityRows,factoryWorkshopRecords} from '../data/factoryCapabilities';
import CapabilityEvidence from './CapabilityEvidence.astro';
import CapabilityConcept from './CapabilityConcept.astro';
import {factoryQuote,workshopMachines,inspectionStages,measurementMethods,orderRecords,qualificationFields,qualificationHref,reportHref} from '../data/factoryEditorial';
import {orderConditions} from '../data/capabilityRedesign';
import '../styles/capability-redesign.css';
import '../styles/factory-redesign.css';
const quoteHref=factoryQuote('overview');
const fitQuoteHref=factoryQuote('overview','equipment');
const workshopPhoto=photo('workshop-wide');
const workshopFrame=await photoFrame(workshopPhoto.src,workshopPhoto.width,workshopPhoto.height);
const factoryHero={...workshopPhoto,width:workshopFrame.width,height:workshopFrame.height,origin:'original-photo',position:'60% 50%',mobilePosition:'60% 40%'};
const aliases:Record<string,string>={'workshop-title':'workshop','equipment-title':'equipment','quality-title':'quality','documents-title':'documents','delivery-title':'delivery','factory-overview-title':'factory-title','workshop-photographs':'workshop','inspection':'quality','inspection-title':'quality','methods-title':'inspection-equipment','inspection-process-title':'inspection-process','records-title':'inspection-records','qualification-title':'quality-management','workflow-title':'workflow','factory-questions':'delivery','questions-title':'delivery','factory-rfq-title':'prepare-rfq','prepare-email':'prepare-rfq','section-pages-title':'workshop','factory-explore-title':'workshop','factory-review-title':'workshop','factory-package-title':'documents'};
const anchorAliases=(target:string)=>Object.entries(aliases).filter(([,value])=>value===target).map(([key])=>key);
const inputs=['A STEP model and 2D drawing with the part number, units and revision; which file controls if their requirements differ','Material grade and condition, finish, quantity and surfaces that need protection','Critical features, datums, tolerances and acceptance limits','Any first-article approval, sampling, measurement methods and reports your order needs','Delivery destination, requested date, packing and handover requirements'];
---
<Layout title="CNC Factory & Quality Control in Hangzhou" description={`LZZ's ${manufacturingCapacity.facilityArea} Hangzhou factory has ${manufacturingCapacity.fiveAxisMachines} five-axis machines and ${manufacturingCapacity.cncLathes} CNC lathes. See equipment capacity, original workshop records and CMM inspection for custom parts.`} articleImage={factoryHero.src} cta={false} headerQuoteHref={quoteHref}>
<article class="rd-wrap rd-page fx-page">
 <section class="fx-intro" data-core-section="Factory and workshop facts" aria-labelledby="factory-title">{anchorAliases('factory-title').map(id=><span class="fx-anchor" id={id}/>)}
  <ImmersiveInnerHero title="CNC factory & quality control" id="factory-title" lead={`${manufacturingCapacity.fiveAxisMachines} five-axis machines and ${manufacturingCapacity.cncLathes} CNC lathes in our ${manufacturingCapacity.facilityArea} Hangzhou workshop, with CMM inspection for custom machined parts.`} image={factoryHero} quoteHref={quoteHref} secondaryHref="#equipment" secondaryLabel="View equipment & capacity"/>
  <dl class="fx-primary-facts"><div><dt>5-axis machines</dt><dd>{manufacturingCapacity.fiveAxisMachines}</dd></div><div><dt>CNC lathes</dt><dd>{manufacturingCapacity.cncLathes}</dd></div><div><dt>Production facility</dt><dd>{manufacturingCapacity.facilityArea}</dd></div><div><dt>Critical dimensions</dt><dd>{manufacturingCapacity.criticalFeatureTolerance}<span>Subject to part evaluation</span></dd></div></dl>
  <nav class="fx-local-nav pn-link-index pn-link-index--sections" aria-label="Explore factory and quality"><a href="#equipment">Equipment & capacity</a><a href="#workshop">Workshop records</a><a href="#quality">Inspection</a><a href="#documents">Records</a><a href="#delivery">Delivery</a></nav>
 </section>
 <section class="rd-section fx-equipment" data-core-section="Equipment capacity and workshop records" id="equipment">{anchorAliases('equipment').map(id=><span class="fx-anchor" id={id}/>)}
  <header><h2>Equipment & machining capacity</h2><p>Five-axis machining, CNC turning and milling support prototypes and small production runs. The equipment total includes machining and supporting units.</p></header>
  <div class="fx-capacity-layout">
   <table class="fx-capacity-table" aria-label="LZZ facility, equipment and machining capacity"><thead><tr><th scope="col">Facility / capability</th><th scope="col">Capacity & scope</th></tr></thead><tbody>{factoryCapabilityRows.map(row=><tr><th scope="row">{row.label}</th><td><strong>{row.value}</strong><span>{row.detail}</span></td></tr>)}</tbody></table>
   <aside class="fx-workshop-view"><CapabilityEvidence id="workshop-operators-2025" originalOnly showCaption caption="Machines and operators on the LZZ workshop floor." sizes="(max-width:767px) calc(100vw - 40px), 480px"/><h3>Manufacturing in Hangzhou since 2017</h3><p>Our engineering team has more than 15 years of CNC machining experience.</p><p id="production-capacity">We review available capacity against your mix of parts, quantities and delivery dates.</p></aside>
  </div>
  <div class="fx-workshop-records" id="workshop">{anchorAliases('workshop').map(id=><span class="fx-anchor" id={id}/>)}<header><h3>Machines, machining and parts</h3><p>Workshop photographs and machining records from LZZ.</p></header><div class="fx-proof-grid">{factoryWorkshopRecords.map(record=><article><CapabilityEvidence id={record.photo} originalOnly sizes="(max-width:767px) calc(100vw - 40px), 360px"/><h3>{record.title}</h3><p>{record.text}</p><a class="rd-link" href={record.href}>{record.link}</a></article>)}</div></div>
  <details class="fx-route-details"><summary>Machining routes, setup and part fit</summary><div class="fx-route-detail-body"><p id="equipment-fit-intro">We plan the setup around cutter access and clamping, preserving the required relationships between features.</p>
  <table class="fx-fit-table" aria-describedby="equipment-fit-intro">
   <thead><tr><th scope="col">Machining route</th><th scope="col">Common parts</th><th scope="col">Geometry and workholding</th><th scope="col">Related examples</th></tr></thead>
   <tbody>{workshopMachines.map(machine=><tr><th scope="row"><a href={machine.href}>{machine.process}</a></th><td data-label="Common parts">{machine.parts}</td><td data-label="Geometry and workholding">{machine.geometry}</td><td data-label="Related examples"><ul>{machine.examples.map(([label,href])=><li><a href={href}>{label}</a></li>)}</ul></td></tr>)}</tbody>
  </table>
  <div class="fx-axis-note"><h3>Indexed positioning and simultaneous five-axis cutting</h3><p>With indexed positioning, the rotary axes set a fixed angle before cutting. The cutter then machines that face with the rotary axes held in position. Simultaneous five-axis cutting coordinates linear and rotary motion during the cut, changing the tool angle along the surface.</p><p>We review tool access and workholding from your model, then confirm the proposed machining route and its limits in the quotation. If the part requires simultaneous five-axis cutting, that route needs confirmation before ordering.</p><a class="rd-link" href="/capabilities/5-axis-cnc-machining/">More about multi-axis part geometry</a></div>
  <aside class="fx-fit-inputs" id="equipment-review"><h3>Will the part and stock fit?</h3><div><p>Finished-part and stock dimensions show the space needed for cutting and clamping. Material and weight affect the load and support. Clamping restrictions and surfaces that need protection help us check fixture clearance, cutter reach and access around the part.</p><p>With those details, we can assess machine travel, load and workholding for your drawing. We can also identify the machine information needed for your supplier review.</p><a class="rd-button" href={fitQuoteHref}>Ask about equipment fit</a><p class="rd-note">Start with your name, destination country and a contact method. A message and drawings are optional.</p></div></aside>
  </div></details>
 </section>
 <section class="rd-section fx-quality" data-core-section="Inspection stages and methods" id="quality">{anchorAliases('quality').map(id=><span class="fx-anchor" id={id}/>)}<header><h2>Inspection from drawing to finished parts</h2><p>We base inspection on the drawing’s critical features and datums. Before production, we agree acceptance limits, sampling, approval hold points and the records needed to release the parts.</p></header><div class="fx-inspection-review"><div>{anchorAliases('inspection-process').map(id=><span class="fx-anchor" id={id}/>)}<ol class="fx-inspection-stages" id="inspection-process">{inspectionStages.map(stage=><li><div><h3>{stage.title}</h3><p>{stage.text} {stage.agreement}</p></div></li>)}</ol><p class="cx-callout">Incoming-material review establishes the required grade, condition, supplied blanks and material records. Any additional checks belong in the quotation.</p><a class="rd-link" href="/resources/technical-guides/critical-features-cnc-drawing/">Mark critical features on the drawing</a>
 </div></div><div class="fx-subsection" id="inspection-equipment">{anchorAliases('inspection-equipment').map(id=><span class="fx-anchor" id={id}/>)}<header><h3>A measurement method for each feature</h3><p>We locate the part from its drawing datums and use consistent support during measurement. The order specifies whether acceptance applies before or after finishing.</p></header><div class="fx-method-layout"><div><dl class="fx-method-list" id="measurement-methods">{measurementMethods.map(([feature,method,agreement])=><div><dt>{feature}</dt><dd><strong>{method}</strong><p>{agreement}</p></dd></div>)}</dl><p class="cx-callout">For supplier qualification, you can request instrument ranges and current calibration evidence relevant to the specified features. We agree the methods and records for additional special tests in the quotation.</p></div><CapabilityEvidence id="cmm-room" showCaption caption="Coordinate measuring machine" class="fx-cmm" sizes="(max-width:767px) calc(100vw - 40px), 340px"/></div></div></section>
 <section class="rd-section" id="documents" data-core-section="Order records and supplier qualification">{anchorAliases('documents').map(id=><span class="fx-anchor" id={id}/>)}<header class="fx-records-heading"><h2>Inspection records and supplier documents</h2><p>We list the documents supplied with your parts in the quotation. Each record identifies the drawing revision and part or batch. You can also request equipment, capacity or inspection documents for supplier qualification.</p></header><div class="fx-document-layout"><div id="inspection-records">{anchorAliases('inspection-records').map(id=><span class="fx-anchor" id={id}/>)}<h3>Records for your parts</h3><dl class="fx-record-list" id="order-documentation">{orderRecords.map(([record,content,reference])=><div><dt>{record}</dt><dd>{content} {reference}</dd></div>)}</dl><div class="fx-document-actions"><a class="rd-link" href={reportHref}>Ask about a sample inspection report</a><a class="rd-link" href="/downloads/order-acceptance-checklist.txt" download>Download acceptance checklist</a></div></div><aside class="fx-qualification-panel" id="quality-management">{anchorAliases('quality-management').map(id=><span class="fx-anchor" id={id}/>)}<h3>Supplier qualification</h3><p>LZZ is ISO 9001 certified. For supplier qualification, ask for the current certificate and confirm its holder, site, scope and validity.</p><dl class="fx-qualification-fields">{qualificationFields.map(([title,text])=><div><dt>{title}</dt><dd>{text}</dd></div>)}</dl><a class="rd-link" href={qualificationHref}>Request the ISO certificate</a><div class="fx-document-actions"><a class="rd-link" href="/about/company-profile/#documents">Company recognition documents</a></div></aside></div></section>
 <section class="rd-section fx-handover" data-core-section="Packing and handover" id="delivery">{anchorAliases('delivery').map(id=><span class="fx-anchor" id={id}/>)}<header><h2>Packing and handover</h2><p>The packing plan covers surface protection, part identification and the records travelling with the order. The quotation sets delivery responsibilities.</p></header><div class="fx-delivery-layout"><div id="workflow">{anchorAliases('workflow').map(id=><span class="fx-anchor" id={id}/>)}<ul id="order-deliverables"><li>Protection for sealing faces, threads, cosmetic surfaces and vulnerable features.</li><li>Part number, drawing revision and quantity identified on each pack.</li><li>The specified dimensional, material and finishing records.</li><li>Packing arrangements, shipment documents, destination and delivery responsibilities.</li></ul><p class="fx-packing-request">We agree the packing arrangement before shipment, including any customer review needed for the order.</p><div class="fx-document-actions"><a class="rd-link" href="/resources/ordering/">Drawing, approval and delivery guide</a><a class="rd-link" href="/resources/ordering/custom-cnc-parts-shipping-checklist/">Packing and shipping checklist</a></div></div><aside class="fx-packing-pending"><CapabilityConcept art={{stem:"/media/site-polish-20261016/packing-concept",width:1536,height:1024,alt:"Generic machined forms separated in protective foam inside a carton",caption:"Packing protection follows the part dimensions and transport conditions in the order."}}/></aside></div>
 </section><section class="rd-section cx-inquiry" data-core-section="Drawing inputs and quotation" id="prepare-rfq">{anchorAliases('prepare-rfq').map(id=><span class="fx-anchor" id={id}/>)}<header><h2>Ask about your part</h2><p>Leave your name, destination country and the best way to reach you. You can add a message or drawing, and mention any supplier documents your team needs.</p></header><div class="fx-inquiry-requirements"><h3>Useful details when you have them</h3><ul class="cx-rfq-inputs">{inputs.map(input=><li>{input}</li>)}</ul></div><div class="cx-inquiry-action"><a class="rd-button" href={quoteHref}>Send an inquiry</a><p class="rd-note">We send a first reply within 12 hours of receiving your inquiry. A complete quote may need further discussion of the drawing or process.</p><a class="rd-link" href="/about/how-we-work/">How we handle your project</a></div><p class="cx-order-note" id="order-conditions">{orderConditions}</p></section>
</article>
</Layout>
<script>
 const aliases:Record<string,string>={'workshop-title':'workshop','equipment-title':'equipment','quality-title':'quality','documents-title':'documents','delivery-title':'delivery','factory-overview-title':'factory-title','workshop-photographs':'workshop','inspection':'quality','inspection-title':'quality','methods-title':'inspection-equipment','inspection-process-title':'inspection-process','records-title':'inspection-records','qualification-title':'quality-management','workflow-title':'workflow','factory-questions':'delivery','questions-title':'delivery','factory-rfq-title':'prepare-rfq','prepare-email':'prepare-rfq','section-pages-title':'workshop','factory-explore-title':'workshop','factory-review-title':'workshop','factory-package-title':'documents'};
 function revealFactoryAnchor(){const key=location.hash.slice(1);const target=document.getElementById(aliases[key]||key);if(target){for(let parent=target.parentElement;parent;parent=parent.parentElement){if(parent instanceof HTMLDetailsElement)parent.open=true;}requestAnimationFrame(()=>target.scrollIntoView({block:'start'}));}}
 window.addEventListener('hashchange',revealFactoryAnchor);if(location.hash)revealFactoryAnchor();
</script>





