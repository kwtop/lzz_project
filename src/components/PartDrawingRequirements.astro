---
import ProductsFigure from './ProductsFigure.astro';
import PentaConcept from './PentaConcept.astro';
import type {PentaConceptId} from '../data/pentaConcepts';
type Image={src:string;srcset?:string;width?:number;height?:number;alt:string;origin?:string;nativeWidth?:number};
interface Props {conceptId?:PentaConceptId;heading:string;intro?:string|false;scope?:string;casting?:{focus:string;inputs:string};detail?:Image;realDetail?:Image;visual:Image;requirements:{title:string;body:string;check:string}[];combineChecks?:boolean;featureText?:Record<string,string>;featureTitles?:Record<string,string>;question?:{question:string;answer:string};supporting?:Array<Image&{caption:string;note:string}>;layout?:'table';sharedNote?:string;questionBesideFeatures?:boolean;questionInRequirements?:boolean}
const {conceptId,heading,intro,scope,casting,detail,realDetail,visual,requirements,combineChecks=false,featureText={},featureTitles={},question,supporting=[],layout,sharedNote,questionBesideFeatures=false,questionInRequirements=false}=Astro.props;
---
<section class="rd-section pd-drawing-module" id="fit-review" data-core-section="Geometry and acceptance requirements"><span id="drawing-review" class="pd-anchor"/><span id="drawing-title" class="pd-anchor"/><span id="scope-title" class="pd-anchor"/>
 <header><h2 id="geometry-title">{heading}</h2>{intro===false?<span class="pd-anchor" id={casting?'casting-blank':'supply-scope'}/>:intro?<p id={casting?'casting-blank':'supply-scope'}>{intro}</p>:<>{scope&&<p id={casting?'casting-blank':'supply-scope'}>{scope}</p>}{casting&&<p>{casting.focus} {casting.inputs}</p>}</>}</header>
 <div class:list={["pd-drawing-layout",{"pd-drawing-with-photo":Boolean(detail||realDetail||supporting.length||conceptId)}]}>{(detail||realDetail||supporting.length>0||conceptId)&&<div class="pd-drawing-photo">{conceptId&&<PentaConcept id={conceptId} class="pd-figure"/>}{detail&&<ProductsFigure {...detail} caption="Blade roots and hub bore · real source detail."/>}{question&&questionBesideFeatures&&<aside class="pd-drawing-question"><h3>{question.question}</h3><p>{question.answer}</p></aside>}{realDetail&&<ProductsFigure {...visual} caption="Complete batch source. The arrangement does not establish order quantity or shipment."/>}{supporting.length>0&&<div id="additional-reference-views">{sharedNote&&<p class="pd-small pd-source-group-note">{sharedNote}</p>}{supporting.map(im=><div><ProductsFigure {...im}/>{!sharedNote&&<p class="pd-small">{im.note}</p>}</div>)}</div>}</div>}{layout==='table'?<div class="pd-requirement-table"><table class="rd-table rd-stacked"><thead><tr><th scope="col">Review area</th><th scope="col">Drawing and acceptance requirements</th></tr></thead><tbody>{requirements.map(f=><tr><th scope="row">{featureTitles[f.title]||f.title}</th><td><p>{featureText[f.title]||`${f.body} ${f.check}`}</p></td></tr>)}</tbody></table><p class="pd-small">Inspection follows the agreed measurement method, final surface condition, sampling plan and report format.</p>{question&&questionInRequirements&&<div class="pd-drawing-question"><h3>{question.question}</h3><p>{question.answer}</p></div>}</div>:<div class="pd-feature-reading pd-drawing-features">{requirements.map(f=><section><div><h3>{featureTitles[f.title]||f.title}</h3>{featureText[f.title]?<p>{featureText[f.title]}</p>:combineChecks?<p>{f.body} {f.check}</p>:<><p>{f.body}</p><p class="pd-acceptance">{f.check}</p></>}</div></section>)}<p class="pd-small">Inspection follows the agreed measurement method, final surface condition, sampling plan and report format.</p></div>}</div>
 {question&&!questionBesideFeatures&&!questionInRequirements&&<div class="pd-drawing-question"><h3>{question.question}</h3><p>{question.answer}</p></div>}
</section>
