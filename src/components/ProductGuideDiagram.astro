---
import type {ProductDiagramKind} from '../data/productGuideTypes';
import '../styles/product-guides.css';
interface Props {kind:ProductDiagramKind;caption:string;legend:string[]}
const {kind,caption,legend}=Astro.props;
const titleId='pg-'+kind+'-title',descriptionId='pg-'+kind+'-description';
const titles:Record<ProductDiagramKind,string>={enclosure:'Enclosure feature map',circular:'Circular-part datum relationships',shaft:'Shaft fit and runout features',fitting:'Thread and seal interfaces',casting:'Casting blank and finished features',plastic:'Plastic-part measurement conditions',impeller:'Impeller model features',masking:'Aluminum masking locations',manifold:'Manifold interface map',plunger:'Indexing-plunger requirements'};
---
<figure class="pg-diagram" data-technical-diagram={kind}>
 <svg viewBox="0 0 640 360" role="img" aria-labelledby={titleId+' '+descriptionId}>
  <title id={titleId}>{titles[kind]}</title><desc id={descriptionId}>{caption}</desc>
  <defs><pattern id={'pg-hatch-'+kind} width="12" height="12" patternUnits="userSpaceOnUse"><path d="M0 12 12 0" class="pg-hatch"/></pattern></defs>
  {kind==='enclosure'&&<>
   <path class="pg-face" d="m120 120 290-45 120 83-288 55z"/><path class="pg-side" d="m120 120 122 93v100l-122-87z"/><path class="pg-side" d="m242 213 288-55v100l-288 55z"/>
   <path class="pg-recess" d="m175 130 223-32 77 54-223 41z"/><path class="pg-detail" d="m175 130 5 61 72 49 223-43v-45M252 193v47"/>
   <ellipse cx="238" cy="159" rx="14" ry="8"/><ellipse cx="400" cy="137" rx="14" ry="8"/><path class="pg-leader" d="m172 99-35-43M344 205l20 89M491 229l74 20"/>
   <text x="112" y="49">A</text><text x="360" y="328">B</text><text x="578" y="259">C</text>
  </>}
  {kind==='circular'&&<>
   <circle class="pg-face" cx="315" cy="181" r="137"/><circle class="pg-recess" cx="315" cy="181" r="69"/><circle class="pg-detail" cx="315" cy="181" r="100" stroke-dasharray="7 7"/>
   {[0,60,120,180,240,300].map(angle=><circle cx={315+100*Math.cos(angle*Math.PI/180)} cy={181+100*Math.sin(angle*Math.PI/180)} r="12"/>)}
   <path class="pg-axis" d="M140 181h348M315 18v324"/><path class="pg-leader" d="m253 229-86 59M385 119l100-62M351 181h151"/>
   <text x="139" y="315">A</text><text x="499" y="56">B</text><text x="515" y="190">C</text>
  </>}
  {kind==='shaft'&&<>
   <path class="pg-face" d="M90 150h115v-37h126v-30h115v55h101v97H446v31H331v-30H205v-33H90z"/>
   <path class="pg-detail" d="M205 150v53M331 113v123M446 138v97"/><path class="pg-axis" d="M50 184h540"/>
   <path class="pg-leader" d="m143 150-19-76M331 252l-65 62M493 138l32-65"/><path class="pg-accent" d="M178 118a50 50 0 0 1 63-23m-12-8 12 8-5 14"/>
   <text x="110" y="61">A</text><text x="251" y="341">B</text><text x="528" y="62">C</text>
  </>}
  {kind==='fitting'&&<>
   <path class="pg-face" d="M110 129h115l30-43h111l30 43h140v108H396l-30 40H255l-30-40H110z"/>
   <path class="pg-recess" d="M110 164h426v38H110z"/>
   {[130,151,172,193].map(x=><path class="pg-detail" d={'M'+x+' 129l-14 35m14 38-14 35'}/>)}
   <path class="pg-accent" d="M427 129v35m0 38v35M445 129v35m0 38v35"/><path class="pg-recess" d="M300 86v78h20V86"/>
   <path class="pg-leader" d="m167 129-25-62M435 239l35 69M310 112l45-63"/><text x="119" y="55">A</text><text x="472" y="334">B</text><text x="364" y="49">C</text>
  </>}
  {kind==='casting'&&<>
   <path class="pg-stock" d="m102 120 47-34 72 10 37-28 101 13 35 29 95-7 47 47-9 83-43 37-94-7-43 26-110-12-63 10-48-49z"/>
   <path class="pg-recess" d="M162 121h300v129H162z"/><path class="pg-face" d="M192 153h240v66H192z"/>
   <circle cx="311" cy="185" r="57"/><circle class="pg-recess" cx="311" cy="185" r="34"/><path class="pg-axis" d="M244 185h136M311 112v148"/>
   <path class="pg-accent" d="M162 250h300"/><path class="pg-leader" d="m117 132-39-48M220 110l-41-58M335 209l114 102"/>
   <text x="54" y="72">A</text><text x="165" y="42">B</text><text x="459" y="332">C</text>
  </>}
  {kind==='plastic'&&<>
   <ellipse class="pg-face" cx="317" cy="119" rx="117" ry="64"/><path class="pg-side" d="M200 119v112c0 86 234 86 234 0V119c0 86-234 86-234 0z"/><ellipse class="pg-recess" cx="317" cy="119" rx="63" ry="34"/>
   <path class="pg-accent" d="M155 119h45m234 0h47M155 89v62m326-62v62M200 105v28m234-28v28"/>
   <path class="pg-detail" d="M205 296h224v25H205zM99 47v38a13 13 0 1 0 15 0V47a8 8 0 0 0-15 0z"/>
   <path class="pg-leader" d="M147 67h68M316 310v23M480 119l49 61"/><text x="230" y="75">A</text><text x="305" y="356">B</text><text x="542" y="195">C</text>
  </>}
  {kind==='impeller'&&<>
   <circle class="pg-face" cx="315" cy="185" r="132"/>
   {[0,45,90,135,180,225,270,315].map(angle=><path class="pg-blade" transform={'rotate('+angle+' 315 185)'} d="M334 150q12-80 99-60-61 4-72 82z"/>)}
   <circle class="pg-face" cx="315" cy="185" r="45"/><circle class="pg-recess" cx="315" cy="185" r="22"/>
   <path class="pg-leader" d="m219 107-55-59M348 178l169-32M303 224l-34 98"/><text x="135" y="44">A</text><text x="530" y="151">B</text><text x="255" y="348">C</text>
  </>}
  {kind==='masking'&&<>
   <path class="pg-face" d="m131 109 302-34 97 75-300 50z"/><path class="pg-side" d="m230 200 300-50v102l-300 56zM131 109l99 91v108l-99-81z"/>
   <ellipse class="pg-mask" cx="299" cy="142" rx="32" ry="19"/>
   <path class="pg-mask" d="m385 180 68-12v66l-68 13z"/><circle class="pg-mask" cx="184" cy="212" r="17"/>
   <path class="pg-leader" d="m288 127-28-76M418 213l101 96M177 210l-76 65"/><text x="241" y="42">A</text><text x="527" y="332">B</text><text x="73" y="297">C</text>
  </>}
  {kind==='manifold'&&<>
   <rect class="pg-face" x="102" y="73" width="407" height="105" rx="37"/>
   {[151,239,327,415].map(x=><><path class="pg-side" d={'M'+x+' 172v49q0 28 24 28h30v44h-43q-53 0-53-60v-61z'}/><ellipse class="pg-recess" cx={x+45} cy="272" rx="25" ry="14"/></>)}
   <ellipse class="pg-recess" cx="508" cy="124" rx="29" ry="40"/><path class="pg-axis" d="M119 126h355"/>
   <path class="pg-leader" d="m174 277-55 48M303 92l-3-54M525 128l58 66"/><text x="94" y="347">A</text><text x="287" y="28">B</text><text x="592" y="217">C</text>
  </>}
  {kind==='plunger'&&<>
   <path class="pg-face" d="M101 117h85v-28h235v28h93v130h-93v28H186v-28h-85z"/>
   <path class="pg-recess" d="M101 160h100v-34h204v34h109v43H405v35H201v-35H101z"/><path class="pg-detail" d="M214 133h9l14 92 18-92 18 92 18-92 18 92 18-92 18 92 18-92h33"/>
   <path class="pg-face" d="M67 169h498v25H67z"/><path class="pg-accent" d="M522 147h60m-10-8 10 8-10 8"/>
   <path class="pg-leader" d="m533 193 30 87M321 134l15-74M425 248l-23 65"/><text x="569" y="309">A</text><text x="330" y="49">B</text><text x="386" y="343">C</text>
  </>}
 </svg>
 <figcaption>{caption} <span class="pg-scale">Feature map · not to scale</span></figcaption>
 <ol class="pg-diagram-legend">{legend.map(item=><li>{item}</li>)}</ol>
</figure>
