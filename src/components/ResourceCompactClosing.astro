---
interface Props {title?:string;text?:string;href?:string}
const {title='Have a part to discuss?',text='Leave your name, destination country and contact details. Drawings and a message are optional.',href='/quote/?'+new URLSearchParams({source:Astro.url.pathname}).toString()}=Astro.props;
---
<section class="res-wrap res-compact-closing" id="prepare-email" aria-label="Discuss your part" data-resource-module><span class="res-anchor" id="manual-rfq-title"/><div><h2>{title}</h2><p>{text}</p></div><a class="res-link" href={href}>Request a quote</a></section>
