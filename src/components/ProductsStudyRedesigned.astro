---
import {studyReadingPolish} from '../data/readingPolish';
import type {EngineeringCase} from '../data/cases';
import {caseReading} from '../data/caseReading';
import {caseStories} from '../data/caseStories';
import {studyChecks} from '../data/studyEditorial';
import {workshopCollections} from '../data/workshopCollections';
import {studyNext} from '../data/productStudyRoutes';
import {categoryDetails} from '../data/presentation';
import {photo} from '../data/evidence';
import {realStudyDetails} from '../data/productsRebuild';
import StudyCollectionConditions from './StudyCollectionConditions.astro';
import ProductsFigure from './ProductsFigure.astro';
import StudyCollectionFamily from './StudyCollectionFamily.astro';
import ProductsClip from './ProductsClip.astro';
import '../styles/products-20261015.css';
interface Props{item:EngineeringCase;quoteHref:string}
const {item,quoteHref}=Astro.props,reading=caseReading[item.slug],story=caseStories[item.slug],next=studyNext[item.slug],two=item.slug==='two-stage-cnc-milling',panel=Boolean(item.video),collection=item.collection;
const polish=studyReadingPolish[item.slug]||{};
const title=story?.title||reading.title,heroId=polish.heroImage?.id||(panel?'display-housing-panel':item.hero);
const heroVisual=polish.heroImage?.crop?realStudyDetails[heroId]:photo(heroId);
const more=collection?[]:two?[]:panel?['display-housing-pair']:item.photos.filter(id=>id!==item.hero&&id!==heroId&&id!==polish.setupImage?.id);
const families=collection?workshopCollections[collection]:[];
const retainedQuestions=collection?[]:item.slug==='turning-then-milling-cylindrical-parts'?reading.questions.filter(q=>q.question.includes('live-tooling')):[];
const familyName=(f:typeof families[number])=>collection==='metal'&&f.id==='turned-parts'?'Locking-pin and turned-part forms':f.title;
const capability=next.capability||item.relatedCapabilities[0];
const setupDetails=two?['two-stage-first','two-stage-second']:[item.hero].filter(id=>realStudyDetails[id]);
const setupMedia=polish.setupImage?[{...photo(polish.setupImage.id),alt:polish.setupImage.alt,caption:polish.setupImage.caption}]:panel?[photo('display-housing-machining')]:setupDetails.map(id=>realStudyDetails[id]);
---
<article class="rd-page pd-page ps-page" data-case={item.slug} data-layout={collection||'process'}><div class="rd-wrap">
 {collection?<header class="ps-study-header"><h1>{title}</h1><p class="pd-lead">Browse the component groups below, then specify the material grade and acceptance requirements for each selected part. Each group covers separate examples.</p><nav class="ps-collection-nav" aria-label="Part families">{families.map(f=><a href={'#'+f.id}>{f.id==='batch-handling'?'Cleaning clip':f.id==='turned-parts'?'Turned forms':f.id==='aluminum-housings'?'Housings':f.id==='brass-fittings'?'Brass fittings':f.id.toUpperCase()}</a>)}</nav></header>:two?<><header class="ps-study-header"><h1>{title}</h1><p class="pd-lead">{item.lead} Locate the second orientation from the surfaces established in the first.</p></header><div class="ps-source-pair">{item.photos.map((id,i)=><ProductsFigure {...photo(id)} eager={i===0} origin="original-photo" caption={'Setup '+(i+1)+' · original photograph of the same part in a different holding orientation.'}/>)}</div></>:<section class="ps-study-hero" data-core-section="Part forms and machining question"><header><h1>{title}</h1>{polish.heroIntro?<p class="pd-lead">{polish.heroIntro}</p>:<><p class="pd-lead">{item.lead}</p><p>{reading.partPoints[0].text}</p></>}{panel&&<p class="pd-small">The 29-inch dimension refers to the display. Quote the enclosure's actual dimensions and machining envelope.</p>}</header><ProductsFigure {...heroVisual} alt={polish.heroImage?.alt||heroVisual.alt} caption={polish.heroImage?.caption||heroVisual.caption} origin={polish.heroImage?.crop?'original-photo-crop':'original-photo'} eager/></section>}

 {collection?<section id="component" aria-label="Original source groups"><span id="case-part-title" class="pd-anchor"/><span id="study-0" class="pd-anchor"/>{families.map((f,i)=><StudyCollectionFamily family={f} title={familyName(f)} polish={polish} first={i===0}/>)}</section>:<section class="rd-section" id="component" data-core-section="Machining access and datum relationships"><span id="case-part-title" class="pd-anchor"/><span id="study-0" class="pd-anchor"/><span id="technical-points" class="pd-anchor"/><span id="study-2" class="pd-anchor"/><span id="case-technical-title" class="pd-anchor"/><header><h2>{story?.featureHeading||reading.partHeading}</h2><p>{polish.setupIntro||item.workpiece}</p></header><div id="machining-setup"><span id="case-process-title" class="pd-anchor"/><span id="study-1" class="pd-anchor"/>{!polish.setupIntro&&<p class="ps-study-note">{item.setup}</p>}<div class:list={["ps-setup-layout",{"ps-setup-with-image":setupMedia.length>0}]}>{setupMedia.length>0&&<div class="ps-setup-media">{setupMedia.map(image=><ProductsFigure {...image} caption={polish.setupCaption||image.caption}/>)}{panel&&polish.videoWithSetup&&<ProductsClip id="display-housing" title="The display housing in the workshop" description="The full housing and its machining setup." showHeading={false}/>}</div>}<ol class="ps-steps">{reading.steps.map((step,i)=><li><div><h3>{step.title}</h3>{polish.stepText?.[i]?<p>{polish.stepText[i]}</p>:<><p>{step.text}</p>{reading.technical[i]&&<p>{reading.technical[i].text}</p>}</>}</div></li>)}</ol></div>{polish.questionInSetup&&retainedQuestions.map((q,i)=><aside class="ps-setup-question">{i===0&&<><span id="questions" class="pd-anchor"/><span id="case-faq-title" class="pd-anchor"/></>}<h3>{q.question}</h3><p>{q.answer}</p></aside>)}{polish.sequenceNote!==false&&<p class="pd-small ps-study-note">{polish.sequenceNote||story?.processContext||reading.sequenceNote||'These photographs show visible setups. The complete operation order and tool paths are planned from the approved drawing.'}</p>}</div></section>}


 {!collection&&<section class="rd-section ps-acceptance-evidence" id="inspection-planning" data-core-section="Acceptance planning"><span id="case-inspection-title" class="pd-anchor"/><span id="study-3" class="pd-anchor"/><header><h2>{polish.acceptanceHeading||'From the visible form to your acceptance plan'}</h2><p>{item.inspection}</p></header><div class:list={['study-acceptance-layout']}>{<div class="ps-finished-views">{!polish.omitVisible&&<p class="pd-small">{item.visible}</p>}<div class="ps-finished-photos">{more.map(id=><ProductsFigure {...photo(id)} origin="original-photo"/>)}{!panel&&<ProductsFigure {...photo('cmm-detail')} caption="LZZ workshop measurement equipment. This photograph is not an inspection record for the part shown." origin="original-photo"/>}</div></div>}{polish.acceptanceLayout==='table'?<div class="ps-acceptance-table"><table class="rd-table rd-stacked"><thead><tr><th scope="col">Review area</th><th scope="col">Drawing and acceptance requirements</th></tr></thead><tbody>{studyChecks[item.slug].map(([feature,drawing,inspection],i)=><tr><th scope="row">{polish.acceptanceTitles?.[i]||feature}</th><td><p>{polish.acceptanceText?.[i]||`${drawing}. ${inspection}.`}</p></td></tr>)}</tbody></table><p class="pd-small">For a similar part, we agree the measurement method, final surface condition, support, sampling and report format before production.</p></div>:<div class="pd-feature-reading">{studyChecks[item.slug].map(([feature,drawing,inspection],i)=><section><div><h3>{feature}</h3>{polish.acceptanceText?.[i]?<p>{polish.acceptanceText[i]}</p>:<><p>{drawing}</p><p class="pd-acceptance">{inspection}</p></>}</div></section>)}<p class="pd-small">For a similar part, we agree the measurement method, final surface condition, support, sampling and report format before production.</p></div>}</div>{panel&&!polish.videoWithSetup&&<ProductsClip id="display-housing" title="The display housing in the workshop" description="Original views of the full housing panel and its machining setup."/>}</section>}
 <section class:list={['rd-section','pd-order-band',{'ps-collection-order':Boolean(collection)}]} id="drawing-review" data-core-section="Drawing inputs and quotation"><span id="prepare-email" class="pd-anchor"/>{polish.conditionsFirst&&collection&&<StudyCollectionConditions collection={collection} technical={reading.technical} sequenceNote={reading.sequenceNote}/>}<div class="ps-rfq-copy">{!polish.questionInSetup&&<><span id="questions" class="pd-anchor"/><span id="case-faq-title" class="pd-anchor"/></>}{!polish.questionInSetup&&retainedQuestions.map(q=><div class="ps-inline-question"><h3>{q.question}</h3><p>{q.answer}</p></div>)}<h2>Discuss a similar component</h2><ul>{reading.rfq.map(text=><li>{text}</li>)}</ul>{!polish.compactResources&&<nav class="ps-reading-links" id="related-studies" aria-label="Related machining review">{next.studies.slice(0,1).map(s=><div><a class="rd-link" href={'/machined-parts/machining-examples/'+s.slug+'/'}>{caseReading[s.slug].title}</a><p class="pd-small">{s.reason}</p></div>)}{collection&&capability&&<a class="rd-link" href={'/capabilities/'+capability+'/'}>{categoryDetails[capability].title}</a>}<a class="rd-link" href="/resources/ordering/rfq-checklist/">RFQ checklist</a></nav>}<div id="prepare-rfq"><a class="rd-button" href={quoteHref}>Request a quote</a><p class="pd-small">Review the draft, add your drawings and send it from your email app.</p></div></div>{collection?(!polish.conditionsFirst&&<StudyCollectionConditions collection={collection} technical={reading.technical} sequenceNote={reading.sequenceNote}/>):(polish.compactResources?<nav class="ps-compact-reading" id="related-studies" aria-label="Related machining review">{next.studies.slice(0,1).map(s=><div><a class="rd-link" href={'/machined-parts/machining-examples/'+s.slug+'/'}>{caseReading[s.slug].title}</a><p>{s.reason}</p></div>)}{capability&&<a class="rd-link" href={'/capabilities/'+capability+'/'}>{categoryDetails[capability].title}</a>}<a class="rd-link" href="/resources/ordering/rfq-checklist/">RFQ checklist</a></nav>:<aside><h3>Related machining capability</h3>{capability&&<a class="rd-link" href={'/capabilities/'+capability+'/'}>{categoryDetails[capability].title}</a>}<p class="pd-small">Use the controlled drawing to confirm machining scope, material condition and the required acceptance records.</p></aside>)}</section>
 </div></article>
