---
import type {RevisedCapability} from '../data/capabilityRedesign';
import CapabilityIntro from './CapabilityIntro.astro';
import CapabilityMaterialTable from './CapabilityMaterialTable.astro';
import CapabilityEvidence from './CapabilityEvidence.astro';
import CapabilityConcept from './CapabilityConcept.astro';
import CapabilityInspectionReview from './CapabilityInspectionReview.astro';
import CapabilityInquiry from './CapabilityInquiry.astro';
import {capabilityConcepts} from '../data/capabilityRebuild';
import CapabilityDecisionGuide from './CapabilityDecisionGuide.astro';
import {capabilityDecisions} from '../data/capabilityDecisions';
import '../styles/copper-brass.css';
interface Props {page:RevisedCapability;quoteHref:string}
const {page,quoteHref}=Astro.props;
const guide=capabilityDecisions[page.slug];
const geometry={...capabilityConcepts['cnc-turning-service'],caption:'The bore, threads and shoulders define the contact or connection geometry. Geometry illustration; specify the alloy on the drawing.'};
const checks=page.acceptanceChecks.map(row=>row.feature==='Threads & sealing faces'?{...row,inspection:'Agree thread gauges, dimensional measurement methods and burr checks for contact or sealing surfaces.'}:row.feature==='Contact & plated surfaces'?{...row,inspection:'Define the post-plating dimensional records.'}:row);
const tests={question:'Are conductivity, thermal or pressure tests included?',answer:page.scopeQuestions[1].answer};
---
<div class="copper-page pn-capability-rollout" data-penta-capability={page.slug}>
 <div data-core-section="service"><CapabilityIntro page={page} material quoteHref={quoteHref} featureHref="#part-examples"/></div>
 <section class="copper-section copper-functions" id="part-examples" data-core-section="function"><header><h2>Choose the alloy for its function</h2></header><div class="copper-function-grid"><div><p>{guide.featureIntro}</p><h3>Read the connection features</h3><p>The fitting photograph shows threaded ends and working faces. Their geometry helps explain the mating connection; the alloy, contact or sealing requirements and any separate pressure-test methods and limits come from the part specification.</p></div><CapabilityEvidence id="metal-brass-batch" caption="The threads and end faces show where these fittings connect. Original brass-collection photograph; alloy and functional qualification require separate records."/></div><CapabilityDecisionGuide slug={page.slug}/></section>
 <div class="copper-section copper-materials" data-core-section="alloy-and-finish"><CapabilityMaterialTable page={page} title="Choose the alloy, standard and finish" intro={guide.materialsIntro}/></div>
 <section class="copper-section copper-interfaces" id="machining-studies" data-core-section="interfaces"><header><h2>Define the working interfaces</h2></header><div class="copper-interface-grid"><CapabilityConcept art={geometry}/><div><h3>Threads, passages and mating faces</h3><p>Stock dimensions, contact areas and passage access determine how a connector can be held and cut. Thread designation, engagement and burr limits define the mating connection, while the seal or contact faces provide the references for the adjoining part.</p><h3>Plating and the final fit</h3><p>Plating becomes part of the finished interface. Masking protects surfaces that need to stay untreated; fitted dimensions and contact, sealing and cosmetic requirements must refer to the final treatment state.</p>{page.study&&<a class="rd-link" href={page.study.href}>{page.study.title}</a>}</div></div></section>
 <CapabilityInspectionReview page={page} title="Agree dimensional and functional acceptance" questions={[tests]} checks={checks} compactEvidence/>
 <CapabilityInquiry page={page} quoteHref={quoteHref} orderFirst coreSection="quotation"/>
</div>
