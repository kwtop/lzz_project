---
import Layout from '../layouts/Layout.astro';
import AboutRedesignClosing from './AboutRedesignClosing.astro';
import AboutRedesignPhoto from './AboutRedesignPhoto.astro';
import ResourceContentImage from './ResourceContentImage.astro';
import {contentConcepts,inspectionImage} from '../data/resourceImagePlan';
import '../styles/about-approved.css';
import '../styles/about-constitution.css';
import '../styles/content-image-led.css';
const stageImages=[contentConcepts.definition,contentConcepts.records,{evidence:'milling-enclosure-parts',caption:'Machined enclosure forms · original LZZ photograph'},inspectionImage,{evidence:'shipment-2022-order-packing',caption:'Protected parts · November 2022 LZZ packing archive'}];
const stageGroups=[{label:'Define and quote the part',indices:[0,1]},{label:'Approve and manufacture',indices:[2,3]},{label:'Packing and handover',indices:[4]}];
const stages=[
 {id:'quotation-scope',aliases:['ww-define-title','section-3'],title:'Drawing review',buyer:'Supply the controlled drawing and model with part number, units and revision. State material, quantity, function and required arrival. For a sample, identify what to retain or change and the measurement and drawing work needed.',lzz:'Review geometry, workholding, tool access and critical features. Raise questions and propose a machining route or alternatives.',record:'Identify the controlling file if the model and drawing disagree. Approve geometry or setup changes and permitted alternatives before production.',href:'/resources/ordering/rfq-checklist/',link:'Prepare the drawing package'},
 {id:'quotation-stage',aliases:['section-4'],title:'Quotation',buyer:'Identify the finish, inspection, sampling and records required, plus the destination and shipping basis.',lzz:'State the process, material, finish, quantity, inspection and records, production schedule and shipping basis in the quotation.',record:'Confirm the included work, separate charges, payment stages and sample costs. Keep the accepted quotation and drawing revision together.',href:'/resources/ordering/compare-cnc-machining-quotations/',link:'Compare quotation scope'},
 {id:'section-5',aliases:['ww-approval-title'],title:'Sample approval',buyer:'Define fit, appearance and any functional test. Identify who supplies mating components, fixtures and procedures, who checks the sample and the actual approver.',lzz:'Make and review the sample against the agreed revision, material, finish and evaluation scope. Record approved alternatives or unresolved differences.',record:'Record first-article results, the configuration evaluated and release criteria. Prototype material or finish differences limit what it establishes. A changed design, material, finish or route may require approval again; release the batch separately.',href:'/resources/ordering/machined-prototype-approval-checklist/',link:'Use the sample approval checklist'},
 {id:'section-6',aliases:[],title:'Production & inspection',buyer:'Confirm the released revision, material, finish, critical features, datums, sampling and required records.',lzz:'Use the approved configuration. Agree measurement methods, instrument range, available calibration evidence and report format before ordering.',record:'Agree first-article checks, recorded measurements, material traceability and handling of nonconforming parts. Inspection scope is order-specific, not a default promise of 100% inspection. A CMM photograph does not establish calibration or part results.',href:'/factory/#quality',link:'Review inspection planning'},
 {id:'packaging-shipping',aliases:['ww-handover-title','section-8'],title:'Packing & handover',buyer:'Provide destination, receiving contact, required arrival and handling limits. Mark cosmetic faces, seals, threads, fragile edges, cleanliness or corrosion-protection needs and labels.',lzz:'Provide protective packing, a packing list, commercial invoice and shipment information. Include material, finishing and dimensional records when agreed in the order.',record:'Agree cartons or wooden cases, separation, pack weight and handling. Match part number, revision, batch and quantity to the labels and packing list. Confirm transport responsibilities and destination-specific documents before production.',href:'/resources/ordering/custom-cnc-parts-shipping-checklist/',link:'Plan packing and international shipping'},
];
---
<Layout title="How we work: drawing review to CNC parts delivery" description="Follow LZZ's order process: drawing review, quotation, sample approval, production, inspection, packing and delivery responsibilities." cta={false}>
 <article class="ar-page ar-workflow rd-wrap rd-page">
  <section class="ar-workflow-opening" data-core-section="Order basis and five stages"><div class="ar-workflow-intro"><header class="rd-pagehead"><h1>From drawing review to finished parts</h1><p>Five stages, with clear responsibilities and a record before each release.</p></header><AboutRedesignPhoto id="milling-enclosure-operation" caption="CNC milling of an enclosure · LZZ workshop" eager/></div>
  <dl class="ar-order-basis" id="ww-before-title"><div><dt>Minimum order</dt><dd>From 1 piece</dd></div><div><dt>Production</dt><dd>7–14 business days<p>After drawing and order confirmation, including surface finishing. Transit time is additional.</p></dd></div><div><dt>Payment &amp; samples</dt><dd>Agreed in the quotation<a href="#commercial-terms">Review charges and payment terms</a></dd></div></dl></section>
  <nav class="ar-section-nav" aria-label="Order stages">{stages.map((stage,index)=><a href={'#'+stage.id}>{index+1}. {stage.title}</a>)}</nav>
  <div class="ar-order-stages ar-order-stages--illustrated">{stageGroups.map(group=><section class:list={['ar-order-chapter','ar-order-chapter--paired',{'ar-order-chapter--single':group.indices.length===1}]} aria-label={group.label} data-core-section={group.label}>{group.indices.length>1&&<h2>{group.label}</h2>}<div class="ar-chapter-stages">{group.indices.map((index)=>{const stage=stages[index],Heading=group.indices.length===1?'h2':'h3';return <article class="ar-order-stage" id={stage.id}>{stage.aliases.map(id=><span class="ar-anchor" id={id}/>)}<header><span class="ar-stage-number" aria-hidden="true">{index+1}</span><Heading>{stage.title}</Heading></header><div class="ar-stage-layout"><div class="ar-stage-responsibilities"><div><h4>Buyer provides</h4><p>{stage.buyer}</p></div><div><h4>LZZ confirms</h4><p>{stage.lzz}</p></div><div class="ar-stage-record"><h4>Release record</h4><p>{stage.record}</p></div></div><ResourceContentImage image={stageImages[index]}/><a class="ar-text-link ar-stage-guide" href={stage.href}>{stage.link}</a></div></article>;})}</div></section>)}</div>
  <section class="rd-section ar-order-conditions" aria-labelledby="order-conditions-title" data-core-section="Commercial terms, changes and support">
  <section class="ar-terms" id="commercial-terms"><header><h2 id="order-conditions-title">Commercial terms and delivery</h2><p>Keep these decisions with the accepted quotation.</p></header><dl><div><dt>Price and separate charges</dt><dd>Identify tooling, special documentation, freight and duties where charged separately. Confirm the payment method, currency, payment stages and amount at each stage.</dd></div><div><dt>Sample costs</dt><dd>Agree machining, setup and freight charges, including whether a sample fee can be credited toward a later order.</dd></div><div><dt>Delivery responsibilities</dt><dd>Distinguish dispatch from arrival. Agree the Incoterm and version, named place, booking, customs clearance, duties, taxes, insurance and local delivery responsibilities. EXW, FOB or DDP applies as quoted; DDP is not automatic.</dd></div><div><dt>Transport and records</dt><dd>Courier, air or sea depends on size and destination; DHL, FedEx or UPS can be discussed. Confirm destination-specific documents before production. <a href="/factory/#order-documentation">Review order documentation</a> and <a href="/resources/ordering/custom-cnc-parts-shipping-checklist/#archive-title">the historical packing archive</a>.</dd></div></dl></section>
  <section class="ar-terms ar-after-sales" id="section-2"><span id="ww-issue-title"/><header><h3>Changes and after-sales</h3></header><dl><div><dt>Changes after approval</dt><dd>A drawing or quantity change can affect price, route and schedule. Review changed features and update the scope; a revised drawing may need sample approval again. <a href="/resources/ordering/prototype-vs-small-batch-cnc/">Plan prototypes and repeat orders</a>.</dd></div><div><dt>Report a nonconforming part</dt><dd>Send the revision, part or batch reference, affected quantity, photographs and measurements. LZZ reviews the discrepancy against the agreed acceptance criteria and agrees corrective action with you.</dd></div><div><dt>Agree the remedy</dt><dd>Confirm warranty coverage, period and start date, exclusions and the reporting procedure with the order. Agree responsibility for rework, replacement, return freight and any refund. <a href="/about/contact/">Discuss a part discrepancy</a>.</dd></div></dl></section>
  </section>
  <AboutRedesignClosing core="First review and RFQ draft" title="Prepare the first review" text="Bring the controlled drawing and your open decisions into one inquiry."/>
 </article>
</Layout>

