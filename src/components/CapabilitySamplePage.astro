---
import type {RevisedCapability} from '../data/capabilityRedesign';
import {sampleReview,sampleOutputs} from '../data/capabilityRedesign';
import PentaInnerHero from './PentaInnerHero.astro';
import CapabilityMaterialTable from './CapabilityMaterialTable.astro';
import CapabilityInspectionReview from './CapabilityInspectionReview.astro';
import CapabilityConcept from './CapabilityConcept.astro';
import {capabilityArtwork} from '../data/capabilityDesign';
import {capabilityImageLed} from '../data/capabilityImageLed';
import CapabilityInquiry from './CapabilityInquiry.astro';
import {libraryGuide} from '../data/resourceLibrary';
import '../styles/sample-machining.css';
interface Props {page:RevisedCapability;quoteHref:string}
const {page,quoteHref}=Astro.props;
const example=page.parts[0];
const reviewItems=sampleReview.map(([title,text])=>[title,title==='Retain'?'Overall dimensions, working faces, mating parts, bores, threads and sealing surfaces to retain.':title==='Resolve'?'Separate wear and damage from the intended geometry. Establish hidden features, material and treatment, then record the requested design changes.':text]);
const stageRows=sampleOutputs.map((row,index)=>index===1?{...row,approval:'Agree how inaccessible geometry and datum relationships will be established, which files and formats the quotation includes, and who may approve them.'}:row);
const firstPartChecks=page.acceptanceChecks.filter(row=>row.feature==='First-part review');
---
<div class="sample-page pn-capability-rollout" data-penta-capability={page.slug}>
 <PentaInnerHero title={page.plan.title} lead="Start with an existing part: we review what to retain or reconstruct, and you approve the drawing before machining." slug={page.slug} part={example} quoteHref={quoteHref} secondaryHref="#sample-review" secondaryLabel="Sample review checklist"/>
 <section class="rd-section cx-project-band sample-review" id="sample-review" data-core-section="sample-review"><header id="part-examples"><h2>What we need for the first review</h2><p>Photos and dimensions start the review; we identify what needs direct measurement and whether to send the sample.</p></header><div class="cx-stage-visual"><CapabilityConcept art={capabilityArtwork.sample}/><dl class="cx-sample-decisions">{reviewItems.map(([title,text])=><div><dt>{title}</dt><dd>{text}</dd></div>)}</dl></div></section>
 <section class="sample-section sample-deliverables" id="manufacturing-definition" data-core-section="deliverables"><header><div><h2>What each stage delivers</h2><p>The quotation separates reconstruction from machining and sets the files, formats and approvals you need.</p></div><CapabilityConcept art={capabilityImageLed.definition}/></header><table class="rd-table rd-stacked"><thead><tr><th scope="col">Stage</th><th scope="col">Input</th><th scope="col">Output</th><th scope="col">Approval responsibility</th></tr></thead><tbody>{stageRows.map(row=><tr><th scope="row">{row.stage}</th><td data-label="Input">{row.input}</td><td data-label="Output">{row.output}</td><td data-label="Approval responsibility">{row.approval}</td></tr>)}</tbody></table></section>
 <div class="sample-section sample-materials" data-core-section="material-decisions"><CapabilityMaterialTable page={page} title="Replacement material and finish" intro="Select the replacement grade and finish for the intended fit and service conditions."/></div>
 <CapabilityInspectionReview page={page} title="Approve the first part before repeat production" intro="Use first-part measurements and agreed tests to check fit against the approved drawing." questions={[]} checks={firstPartChecks} compactEvidence><a slot="links" class="rd-link sample-inspection-link" href={libraryGuide('machined-prototype-approval-checklist').href}>First-part approval checklist</a></CapabilityInspectionReview>
 <CapabilityInquiry page={page} quoteHref={quoteHref} title="Send the information available now" orderFirst coreSection="quotation"/>
</div>
