---
import type {RevisedCapability} from '../data/capabilityRedesign';
import {sampleReview,sampleOutputs} from '../data/capabilityRedesign';
import CapabilityPartFigure from './CapabilityPartFigure.astro';
import CapabilityMaterialTable from './CapabilityMaterialTable.astro';
import CapabilityInspectionReview from './CapabilityInspectionReview.astro';
import CapabilityConcept from './CapabilityConcept.astro';
import {capabilityArtwork} from '../data/capabilityDesign';
import {capabilityImageLed} from '../data/capabilityImageLed';
import CapabilityInquiry from './CapabilityInquiry.astro';
import {libraryGuide} from '../data/resourceLibrary';
import '../styles/sample-machining.css';
interface Props {page:RevisedCapability;quoteHref:string}
const {page,quoteHref}=Astro.props;
const example=page.parts[0];
const reviewItems=sampleReview.map(([title,text])=>[title,title==='Retain'?'Overall dimensions, working faces, mating parts, bores, threads and sealing surfaces to retain.':title==='Resolve'?text+' Agree the intended geometry rather than copying sample wear.':text]);
const stageRows=sampleOutputs.map((row,index)=>index===1?{...row,approval:'Agree how inaccessible geometry and datum relationships will be established, which files and formats the quotation includes, and who may approve them.'}:row);
const firstPartChecks=page.acceptanceChecks.filter(row=>row.feature==='First-part review');
---
<div class="sample-page">
 <section class="cx-intro cx-intro--sample" data-core-section="service"><header><h1>{page.plan.title}</h1><p class="cx-lead">Start with an existing part. Resolve its geometry, material, intended fit and acceptance requirements in an approved specification before machining.</p></header><CapabilityPartFigure part={example} eager class="cx-intro-part"/><div class="cx-intro-actions"><a class="rd-button" href={quoteHref}>Prepare RFQ email</a><a class="rd-link" href="#sample-review">Review your starting information</a><a class="cx-order-link" href="#order-conditions">Production & reconstruction timing</a></div></section>
 <section class="rd-section cx-project-band sample-review" id="sample-review" data-core-section="sample-review"><header id="part-examples"><h2>Keep the intended fit, resolve the unknowns</h2><p>Use photographs, overall dimensions, mating parts and any existing drawings for the initial review. Wear, hidden features and fitted geometry may need further measurement or a physical sample. The pictured housing is a form reference, not an order-specific reconstruction record.</p></header><div class="cx-stage-visual"><CapabilityConcept art={capabilityArtwork.sample}/><dl class="cx-sample-decisions">{reviewItems.map(([title,text])=><div><dt>{title}</dt><dd>{text}</dd></div>)}</dl></div></section>
 <section class="sample-section sample-deliverables" id="manufacturing-definition" data-core-section="deliverables"><header><div><h2>What each stage delivers</h2><p>Agree measurement and modeling scope, file formats and approval authority in the quotation.</p></div><CapabilityConcept art={capabilityImageLed.definition}/></header><table class="rd-table rd-stacked"><thead><tr><th scope="col">Stage</th><th scope="col">Input</th><th scope="col">Output</th><th scope="col">Approval responsibility</th></tr></thead><tbody>{stageRows.map(row=><tr><th scope="row">{row.stage}</th><td data-label="Input">{row.input}</td><td data-label="Output">{row.output}</td><td data-label="Approval responsibility">{row.approval}</td></tr>)}</tbody></table></section>
 <div class="sample-section sample-materials" data-core-section="material-decisions"><CapabilityMaterialTable page={page} title="Define the replacement material and finish" intro="Record the known specification, resolve unknowns and approve the replacement requirements before machining."/></div>
 <CapabilityInspectionReview page={page} title="Approve the first part before repeat production" intro="Review the measured part and its agreed records against the approved specification." questions={[]} checks={firstPartChecks} compactEvidence><a slot="links" class="rd-link sample-inspection-link" href={libraryGuide('machined-prototype-approval-checklist').href}>First-part approval checklist</a></CapabilityInspectionReview>
 <CapabilityInquiry page={page} quoteHref={quoteHref} title="Send the information available now" orderFirst coreSection="quotation"/>
</div>
