---
import AboutRedesignPhoto from './AboutRedesignPhoto.astro';
import type {ContentImage} from '../data/resourceImagePlan';
import {pentaConceptFor} from '../data/pentaConcepts';
import PentaVisual from './PentaVisual.astro';
import {manufacturingImage} from '../data/pentaInteriors';
import {siteImage,type SiteImageId} from '../data/siteImages';
interface Props {image:ContentImage;class?:string}
const {image,class:className=''}=Astro.props;
const prefix=image.stem||'/media/image-led-20261015/'+image.concept,largest=image.stem?'1536':'1600';
const replacement=!image.evidence?pentaConceptFor(prefix,Astro.url.pathname):undefined;
const newConcept=!image.evidence&&(/packing-concept$/.test(prefix)?'packing':/\/(?:sample-)?definition$/.test(prefix)?'drawing-review':undefined);
const contextImages:Record<string,SiteImageId>={'cmm-room':'inspection-workbench','milling-enclosure-parts':'service-aluminum','aluminum-housings':'guide-prototype-batch'};
const editorial=image.evidence&&contextImages[image.evidence]?siteImage(contextImages[image.evidence]):undefined;
---
<div class:list={['rs-content-image',className]}>
 {editorial?<PentaVisual image={editorial}/>:image.evidence?<AboutRedesignPhoto id={image.evidence} caption={image.caption}/>:newConcept?<PentaVisual image={{...manufacturingImage(newConcept,true),caption:image.caption+' · illustration'}}/>:replacement?<AboutRedesignPhoto src={replacement.stem+'-1440.webp'} srcset={[480,800,1440].map(w=>`${replacement.stem}-${w}.webp ${w}w`).join(', ')} width={replacement.width} height={replacement.height} alt={replacement.alt} caption={replacement.caption} origin="image-reference"/>:<AboutRedesignPhoto src={prefix+'-1200.webp'} srcset={`${prefix}-480.webp 480w, ${prefix}-800.webp 800w, ${prefix}-1200.webp 1200w, ${prefix}-${largest}.webp 1536w`} width={1200} height={800} alt={image.caption} caption={image.caption} origin="image-reference"/>}
</div>
