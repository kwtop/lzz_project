---
import Layout from '../layouts/Layout.astro';
import PentaVisual from './PentaVisual.astro';
import ImmersiveInnerHero from './ImmersiveInnerHero.astro';
import {resourceCovers} from '../data/pentaInteriors';
import {resourceGroups,resourceLibrary,libraryGuide,orderingStages} from '../data/resourceLibrary';
import {productTechnicalGuides} from '../data/productTechnicalGuides';
import {siteOrigin} from '../data/seo';
import '../styles/resources-hierarchy.css';
import '../styles/product-guides.css';
interface Props {kind:'hub'|'ordering'|'machining'}
const {kind}=Astro.props;
const metadata={
 hub:{title:'CNC Machining Resources: Design, Cost and Ordering Guides',description:'CNC machining resources for buyers and engineers: design drawings, tolerances, materials, cost comparisons, RFQ preparation, inspection and shipping.',heading:'Resources for CNC machining',intro:"Design a part for machining, prepare its drawing requirements and compare the work included in a quote. Find technical guides by part type, or follow an order from RFQ to receiving inspection."},
 ordering:{title:'CNC Machining RFQ, Quotation and Ordering Guides',description:'CNC machining purchasing guides for RFQs, quotation comparisons, first article inspection, small batch release, packaging and international shipping.',heading:'RFQ & ordering',intro:"Prepare a CNC machining RFQ, compare quotations for the same scope and record what the first sample must prove. Carry the approved revision through batch release, packaging and delivery."},
 machining:{title:'CNC Machining Technical Guides: Parts, Fits and Materials',description:'CNC machining technical guides for enclosures, shafts, fittings, castings, plastics and impellers. Review datums, fits, materials, anodizing and inspection.',heading:'Technical guides',intro:"Work from the interfaces your part must fit. These guides cover enclosure walls, shaft tolerances, hole patterns and other product details, with drawing, material and inspection requirements alongside them."},
}[kind];
const groups=[...resourceGroups,{key:'faq',title:'FAQ',href:'/resources/faq/',description:'Quick answers about minimum orders, production timing, specifications, inspection and delivery.'}];
const scope:Record<string,string>={ordering:'Machining costs, RFQ preparation, quote comparison, sample approval, repeat production, packing and shipping.',machining:'Design and inspection guidance for your part, with foundations in drawings, materials, finishing and machining routes.',faq:'15 purchasing questions on minimum orders, production timing, specifications, inspection and delivery.'};
const categoryCovers={ordering:resourceCovers['cnc-machining-cost-factors'],machining:resourceCovers['cnc-process-selection']};
const foundations=['critical-features-cnc-drawing','6061-vs-7075-cnc-aluminum','material-and-finish-checklist','cnc-process-selection'].map(libraryGuide);
const partGuides=productTechnicalGuides.map(guide=>libraryGuide(guide.slug));
const technical=[...foundations,...partGuides];
const featuredTechnical=['designing-aluminum-enclosures-for-cnc-machining','what-to-check-before-machining-a-cast-housing','why-machined-plastic-parts-need-defined-measurement-conditions','critical-features-cnc-drawing','material-and-finish-checklist','cnc-process-selection'].map(libraryGuide);
const list=kind==='hub'?groups:kind==='ordering'?resourceLibrary.filter(guide=>guide.group==='ordering'):technical;
const schema={'@context':'https://schema.org','@type':'ItemList',name:metadata.title,numberOfItems:list.length,itemListElement:list.map((item,i)=>({'@type':'ListItem',position:i+1,name:item.title,url:siteOrigin+item.href}))};
---
<Layout title={metadata.title} description={metadata.description} cta={false} breadcrumbWidth="directory">
 <article class:list={['rh-page','rd-page','rh-page--'+kind]}>
  <ImmersiveInnerHero title={metadata.heading} lead={metadata.intro} id="resource-title" credential={false} actions={kind==='hub'?[
   {href:'#rfq-guides',label:'RFQ & ordering',primary:true},{href:'#engineering-guides',label:'Technical guides'},{href:'/resources/faq/',label:'FAQ'},
  ]:kind==='ordering'?[
   {href:'#ordering-worksheets',label:'Download worksheets',primary:true},{href:'/resources/',label:'All resources'},
  ]:[{href:'#technical-guides',label:'Explore the guides',primary:true},{href:'/resources/',label:'All resources'}]}/>
  {kind==='hub'&&<nav class="rh-topics" aria-label="Resource categories" data-resource-module data-core-section="Three resource categories">{groups.map(group=><section class="rh-topic" id={group.key==='ordering'?'rfq-guides':group.key==='machining'?'engineering-guides':'before-rfq-title'}>{group.key!=='faq'&&<a class="rh-topic-image" href={group.href} aria-label={group.title}><PentaVisual image={categoryCovers[group.key as keyof typeof categoryCovers]} class="rh-topic-cover"/></a>}<div class="rh-topic-body"><h2><a href={group.href}>{group.title}</a></h2><p>{scope[group.key]}</p>{group.key!=='faq'&&<ul>{(group.key==='machining'?featuredTechnical:resourceLibrary.filter(guide=>guide.group===group.key)).map(guide=><li><a href={guide.href}>{guide.title}</a></li>)}{group.key==='machining'&&<li><a href={group.href}>Browse all {technical.length} technical guides</a></li>}</ul>}</div></section>)}</nav>}
  {kind==='hub'&&<section class="rh-start rh-start-tools" data-core-section="Prepare a first inquiry"><div><h2>What to include in a quote request</h2><p>Gather the drawing revision, material and finish, quantity and delivery requirements in one brief.</p><a class="rd-link" href="/resources/ordering/rfq-checklist/">Open the RFQ checklist</a></div><div><h3>Blank purchasing worksheets</h3><nav class="rh-start-downloads" aria-label="Blank purchasing worksheets"><a href="/downloads/cnc-rfq-brief.txt" download>Inquiry brief (.txt)</a><a href="/downloads/order-acceptance-checklist.txt" download>Acceptance worksheet (.txt)</a></nav><p class="rd-note">Blank templates to prepare your requirements and acceptance plan.</p></div></section>}
  {kind==='ordering'&&<>
   <div class="rh-ordering" aria-label="Ordering guides" data-core-section="Cost and ordering decisions">{orderingStages.map(stage=><section class="rh-stage rh-stage--direct" id={stage.id} aria-label={stage.title}><span class="rh-anchor" id={stage.id+'-title'}/><ul class="rh-guide-list">{stage.slugs.map(slug=>{const guide=libraryGuide(slug);return <li class="pi-guide-entry"><a href={guide.href} aria-label={guide.title}><PentaVisual image={resourceCovers[slug]}/></a><div><h2><a href={guide.href}>{guide.title}</a></h2><p>{guide.summary}</p></div></li>;})}</ul></section>)}</div>
   <section class="rh-worksheets" id="ordering-worksheets" aria-labelledby="worksheets-title" data-resource-module data-core-section="Blank purchasing worksheets"><div><h2 id="worksheets-title">Blank ordering worksheets</h2><p>Prepare an inquiry brief and record the acceptance requirements. These are blank templates, not completed inspection records.</p></div><nav aria-label="Download blank ordering worksheets"><a href="/downloads/cnc-rfq-brief.txt" download>Inquiry brief (.txt)</a><a href="/downloads/order-acceptance-checklist.txt" download>Acceptance worksheet (.txt)</a></nav></section>
   <p class="rh-reference-line">LZZ’s drawing approval, payment, sample and after-sales responsibilities: <a href="/about/how-we-work/">How we work</a>.</p>
  </>}
  {kind==='machining'&&<>
   <section class="rh-technical" id="technical-guides" aria-label="Technical guides" data-resource-module data-core-section="Material, drawing and process decisions"><header><h2>Design foundations</h2><p>Drawing requirements, material choices and the machining route for your part.</p></header><ul class="rh-guide-list">{foundations.map(guide=><li class="pi-guide-card"><a href={guide.href} aria-label={guide.title}><PentaVisual image={resourceCovers[guide.slug]}/></a><div><h3><a href={guide.href}>{guide.title}</a></h3><p>{guide.summary}</p></div></li>)}</ul></section>
   <section class="rh-technical rh-product-guides" id="product-guides" aria-label="Product technical guides" data-resource-module data-core-section="Design and inspection by part form"><header><h2>Guides for your part</h2><p>Practical design and inspection questions for housings, turned parts, fittings and other custom components.</p></header><ul class="rh-guide-list">{partGuides.map(guide=><li class="pi-guide-card"><a href={guide.href} aria-label={guide.title}><PentaVisual image={resourceCovers[guide.slug]}/></a><div><h3><a href={guide.href}>{guide.title}</a></h3><p>{guide.summary}</p></div></li>)}</ul></section>
   <nav class="rh-reference-line rh-technical-next" aria-label="Apply the technical guidance"><a href="/machined-parts/machining-examples/">See real parts and setups</a><a href={resourceGroups[0].href}>RFQ &amp; ordering guides</a></nav>
  </>}
  <section class="rh-closing" id="prepare-email" aria-labelledby="resource-next-title" data-resource-module data-core-section="Start a part inquiry"><div><h2 id="resource-next-title">Have a part to quote?</h2><p>Add your name, destination country and preferred contact details. Drawings and a message are optional.</p></div><a class="rd-button" href={'/quote/?'+new URLSearchParams({source:Astro.url.pathname}).toString()}>Request a quote</a></section>
 </article>
 <script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\\u003c')}/>
</Layout>
