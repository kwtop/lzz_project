---
import Layout from '../layouts/Layout.astro';
import {resourceGroups,resourceLibrary,libraryGuide,orderingStages} from '../data/resourceLibrary';
import {siteOrigin} from '../data/seo';
import '../styles/resources-hierarchy.css';
interface Props {kind:'hub'|'ordering'|'machining'}
const {kind}=Astro.props;
const metadata={
 hub:{title:'Resources for CNC machining',description:'Choose RFQ and ordering guidance, technical guides or frequently asked questions for your custom CNC parts.',heading:'Resources for CNC machining',intro:'Prepare an order, define your part requirements or find a quick answer.'},
 ordering:{title:'RFQ & ordering for CNC machined parts',description:'Use five practical guides to prepare an RFQ, compare quotations, approve a sample, release repeat production and plan packing and shipping.',heading:'RFQ & ordering',intro:'Choose the guide for your next purchasing decision, from the first quotation to delivery.'},
 machining:{title:'CNC machining technical guides',description:'Define critical drawing features, specify material and finish, and choose a machining process for your custom CNC part.',heading:'Technical guides',intro:'Define the drawing, material and machining requirements before requesting a quote.'},
}[kind];
const groups=[...resourceGroups,{key:'faq',title:'FAQ',href:'/resources/faq/',description:'Quick answers about minimum orders, production timing, specifications, inspection and delivery.'}];
const scope:Record<string,string>={ordering:'RFQ preparation, quote comparison, sample approval, repeat production, packing and shipping.',machining:'Drawing requirements, material and finish specifications, and machining process selection.',faq:'15 purchasing questions on minimum orders, production timing, specifications, inspection and delivery.'};
const technical=['critical-features-cnc-drawing','material-and-finish-checklist','cnc-process-selection'].map(libraryGuide);
const list=kind==='hub'?groups:kind==='ordering'?resourceLibrary.filter(guide=>guide.group==='ordering'):technical;
const schema={'@context':'https://schema.org','@type':'ItemList',name:metadata.title,numberOfItems:list.length,itemListElement:list.map((item,i)=>({'@type':'ListItem',position:i+1,name:item.title,url:siteOrigin+item.href}))};
---
<Layout title={metadata.title} description={metadata.description} cta={false}>
 <article class:list={['rh-page','rd-page','rh-page--'+kind]}>
  <header class="rh-header" data-resource-module><h1>{metadata.heading}</h1><p>{metadata.intro}</p></header>
  {kind==='hub'&&<nav class="rh-topics" aria-label="Resource categories" data-resource-module data-core-section="Three resource categories">{groups.map(group=><section class="rh-topic" id={group.key==='ordering'?'rfq-guides':group.key==='machining'?'engineering-guides':'before-rfq-title'}><h2><a href={group.href}>{group.title}</a></h2><p>{scope[group.key]}</p></section>)}</nav>}
  {kind==='ordering'&&<>
   <div class="rh-ordering" aria-label="Ordering guides" data-core-section="Five purchasing decisions">{orderingStages.map(stage=><section class="rh-stage rh-stage--direct" id={stage.id} aria-label={stage.title}><span class="rh-anchor" id={stage.id+'-title'}/><ul class="rh-guide-list">{stage.slugs.map(slug=>{const guide=libraryGuide(slug);return <li><h2><a href={guide.href}>{guide.title}</a></h2><p>{guide.summary}</p></li>;})}</ul></section>)}</div>
   <section class="rh-worksheets" id="ordering-worksheets" aria-labelledby="worksheets-title" data-resource-module data-core-section="Blank purchasing worksheets"><div><h2 id="worksheets-title">Blank ordering worksheets</h2><p>Prepare an inquiry brief and record the acceptance requirements. These are blank templates, not completed inspection records.</p></div><nav aria-label="Download blank ordering worksheets"><a href="/downloads/cnc-rfq-brief.txt" download>Inquiry brief (.txt)</a><a href="/downloads/order-acceptance-checklist.txt" download>Acceptance worksheet (.txt)</a></nav></section>
   <p class="rh-reference-line">LZZ’s drawing approval, payment, sample and after-sales responsibilities: <a href="/about/how-we-work/">How we work</a>.</p>
  </>}
  {kind==='machining'&&<>
   <section class="rh-technical" aria-label="Technical guides" data-resource-module data-core-section="Three specification decisions"><ul class="rh-guide-list">{technical.map(guide=><li><h2><a href={guide.href}>{guide.title}</a></h2><p>{guide.summary}</p></li>)}</ul></section>
   <nav class="rh-reference-line rh-technical-next" aria-label="Apply the technical guidance"><a href="/machined-parts/machining-examples/">See real parts and setups</a><a href={resourceGroups[0].href}>RFQ &amp; ordering guides</a></nav>
  </>}
  <section class="rh-closing" id="prepare-email" aria-labelledby="resource-next-title" data-resource-module data-core-section="Prepare an RFQ draft"><div><h2 id="resource-next-title">Have your requirements ready?</h2><p>Prepare an email draft, review it, attach drawings and send it from your email app.</p></div><a class="rd-button" href="/quote/">Prepare RFQ email</a></section>
 </article>
 <script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\\u003c')}/>
</Layout>
