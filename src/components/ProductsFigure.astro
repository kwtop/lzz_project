---
import {processDisplay} from '../data/processImageDisplays';
import {imageDescription} from '../lib/imagePresentation';
interface Props{src?:string;srcset?:string;stem?:string;width?:number;height?:number;alt:string;caption?:string;captionId?:string;origin?:string;background?:'transparent';quality?:'low-resolution';eager?:boolean;sizes?:string;class?:string;nativeWidth?:number;detailWindow?:boolean;sourceHref?:string;sourceLabel?:string;showSourceLink?:boolean}
const replacement=processDisplay(Astro.props.src);
const displayProps={...Astro.props,...(replacement?{...replacement,nativeWidth:replacement.width,quality:undefined}:{})};
const {src,srcset,stem,width=1536,height=1024,alt,captionId,origin,background,quality,eager=false,sizes='(max-width:767px) calc(100vw - 44px), 600px',class:className,nativeWidth,detailWindow=false}=displayProps;
const image=src||stem+'-1200.webp',sources=srcset||(stem?[480,800,1200,1536].map(w=>`${stem}-${w}.webp ${w}w`).join(', '):undefined);
const imageAlt=imageDescription(alt);
---
<figure class:list={['pd-figure',className,{'pd-portrait':height>width*1.12}]} data-image-origin={origin} data-image-background={background} data-image-quality={quality} style={`--pd-ratio:${width/height};--pd-native:${nativeWidth||width}px`}>
 {captionId&&<span id={captionId} class="pd-anchor"/>}
 {detailWindow?<div class="pd-image-window"><img src={image} srcset={sources} sizes={sizes} width={width} height={height} alt={imageAlt} loading={eager?'eager':'lazy'} fetchpriority={eager?'high':undefined} decoding="async"/></div>:<img src={image} srcset={sources} sizes={sizes} width={width} height={height} alt={imageAlt} loading={eager?'eager':'lazy'} fetchpriority={eager?'high':undefined} decoding="async"/>}
</figure>
