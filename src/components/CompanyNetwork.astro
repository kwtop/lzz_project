---
import '../styles/company-resource-gallery.css';
import {companyLogos} from '../data/company';
const {compact=false}=Astro.props;
const logos=compact?companyLogos.slice(0,6):companyLogos;
---
<section class="container network-section" id="company-network">
 <div class="network-heading"><h2>Earlier company materials</h2></div>
 <ul class="network-logos" aria-label="Logos from earlier LZZ materials">{logos.map(([name,file])=><li><img src={'/media/partners/'+file} alt={name+' logo from earlier company materials'} width="323" height="184" loading="lazy"/></li>)}</ul>
 {compact&&<a class="text-link" href="/about/#company-network">View the archive </a>}
</section>
<style>
 .network-section{padding-top:72px;padding-bottom:72px}.network-heading{display:flex;justify-content:space-between;align-items:baseline;gap:30px;margin-bottom:30px}.network-heading h2{font-size:clamp(30px,3vw,44px)}.network-heading p{font-size:16px;line-height:1.65;max-width:480px}.network-logos{list-style:none;display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:0;margin:0 0 24px;padding:0;border-top:1px solid var(--border)}.network-logos li{display:flex;align-items:center;justify-content:center;min-width:0;padding:18px 12px;border-bottom:1px solid var(--border)}.network-logos img{width:100%;max-width:190px;height:auto;aspect-ratio:323/184;object-fit:contain}
 @media(max-width:900px){.network-logos{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:600px){.network-section{padding-top:48px;padding-bottom:48px}.network-heading{display:block}.network-heading p{margin-top:16px}.network-logos{grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>
