---
import {productCardTitle,productImageAlt} from '../data/presentation';
import {productImage,productSrcset} from '../data/refinedImages';
import {productImageScale} from '../data/productImagePresentation';
interface Props {product: {slug:string;name:string;images:string[];categories:string[]};reason?:string;}
const {product,reason}=Astro.props;
---
<a class="product-card" href={`/machined-parts/gallery/${product.slug}/`}>
 <div class="product-image"><img src={productImage(product)} srcset={productSrcset(product)} sizes="(max-width:760px) calc(100vw - 44px), (max-width:960px) 42vw, 400px" alt={productImageAlt(product)} width="800" height="800" loading="lazy" style={`transform:scale(${Math.min(1,productImageScale(product.slug))})`}/></div>
 <h3>{productCardTitle(product)}</h3>
 {reason && <p class="product-card-summary product-card-reason">{reason}</p>}
</a>
<style>
 .product-card{display:block;min-width:0;padding:0;border:0;border-radius:0;background:none;box-shadow:none;text-decoration:none;color:inherit}
 .product-card .product-image{display:flex;align-items:center;justify-content:center;aspect-ratio:1;background:#f5f5f3;overflow:hidden;border-radius:0;padding:0}
 .product-card .product-image img{display:block;width:100%;height:100%;object-fit:contain;max-width:100%}
 .product-card h3{font-family:var(--font-text);font-size:25px;line-height:1.24;font-weight:550;letter-spacing:-.025em;margin:22px 0 12px}
 .product-card .product-card-summary.product-card-reason{font-size:16px;line-height:1.65;max-width:48ch;margin:0}
 @media(max-width:760px){.product-card h3{font-size:24px}.product-card .product-card-summary.product-card-reason{font-size:16px}}
</style>

