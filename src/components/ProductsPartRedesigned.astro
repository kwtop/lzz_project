---
import ProductsFigure from './ProductsFigure.astro';
import PartDrawingRequirements from './PartRequirementsTable.astro';
import ProductsInquiryAction from './ProductsInquiryAction.astro';
import ProductsFinishReview from './ProductsFinishReview.astro';
import {partReadingPolish} from '../data/readingPolish';
import {engineeringCases} from '../data/cases';
import {photo} from '../data/evidence';
import {partPlan,partVisual,partDisplayTitle,type PartRecord} from '../data/productsEditorial';
import {productIdentity,primaryReferenceIds} from '../data/productIdentity';
import {productFocus} from '../data/productFocus';
import {productSourceReview} from '../data/productSourceReview';
import {partMaterialStatus} from '../data/productBrowse';
import {productSummary} from '../data/productSummaries';
import {productManufacturing} from '../data/manufacturing';
import {productReferences} from '../data/productReferences';
import {partReadingLinks} from '../data/productReadingLinks';
import {relatedPartDecisions} from '../data/productDecisions';
import {productQuestion} from '../data/productReading';
import {castingReview} from '../data/castingReview';
import {partTask,taskScope,orderProduction,productApplicationContexts,partSupplement,realProductDetails} from '../data/productsRebuild';
import sourceMedia from '../data/productSourceMedia.generated.json';
import {productPhotograph} from '../data/productPhotography';
import additional from '../data/additionalMedia.generated.json';
import catalog from '../data/catalog.json';
import '../styles/products-20261015.css';
interface Props{product:PartRecord;quoteHref:string}
const {product,quoteHref}=Astro.props;
const reading=partReadingPolish[product.slug]||{};
const focus=productFocus(product.slug);
const title=partDisplayTitle(product),identity=productIdentity(product.slug),plan=partPlan(product.slug),review=productSourceReview(product),material=partMaterialStatus(product),summary=productSummary(product),manufacturing=productManufacturing(product),visual=partVisual(product),links=partReadingLinks(product),casting=castingReview[product.slug];
const task=partTask(review.id),scope=reading.scopeCopy||taskScope(task,plan.kind),contexts=productApplicationContexts(product.slug),related=relatedPartDecisions(product,catalog.products).slice(0,1);
const references=(productReferences[product.slug]||[]).filter(id=>id!==primaryReferenceIds[product.slug]);
const runnerReference=references.includes('intake-runner-cad');
const distinctReferences=references.filter(id=>id!=='intake-runner-cad');
const detail=sourceMedia[product.slug as keyof typeof sourceMedia] as typeof sourceMedia['ultra-high-precision-machining-services'];
const question=productQuestion(product.slug,manufacturing.tags);
const sourceCaptionBase=visual.quality==='low-resolution'?'Low-resolution source · form reference only. Detailed photograph needed.':visual.origin==='original-subject-background'?'Original source subject.':primaryReferenceIds[product.slug]?'Original workshop reference.':identity.label+'.';
const captionScope=scope?.replace(/^This source contains several part forms\.\s*/,'');
const sourceCaption=visual.sourceHref&&product.slug==='ultra-high-precision-machining-services'?(reading.scopeInCaption&&captionScope?captionScope:undefined):visual.sourceHref?visual.caption+(reading.scopeInCaption&&captionScope?' '+captionScope:''):reading.sourceCaption||sourceCaptionBase+(reading.scopeInCaption&&captionScope?' '+captionScope:'');
const specialQuestion=['P02','P07','P11','P12','P13','P16','P17','P20','P27','P32'].includes(review.id);
const photograph=productPhotograph(product.slug);
const realDetail=realProductDetails[review.id];
const heroVisual=photograph?{...photograph,caption:photograph.caption+(reading.scopeInCaption&&captionScope?' '+captionScope:'')}:realDetail||{...visual,caption:sourceCaption};
const study=engineeringCases.find(item=>item.slug===links.study)!;
const studyVisual=photo(study.collection==='plastic'?'plastic-ptfe-shafts':study.collection==='metal'?'metal-aluminum-close':study.hero);
const requirements=[...review.features,...(partSupplement[review.id]?[{title:'Further drawing requirements',body:partSupplement[review.id].drawing,check:partSupplement[review.id].check}]:[])].filter(feature=>!reading.omitFeatureTitles?.includes(feature.title));
const processNotes=review.notes.filter(note=>!reading.omitNotes?.includes(note));
const referenceNote=(id:string)=>id.startsWith('plenum-')?'Use the approved component model to define the complete internal section and production revision.':id==='intercooler-batch-detail'?'End sections and repeated fins. Specify the assembly components and required cooling tests in the order.':'Separate reference. Include hidden surfaces and mating details in your drawing.';
const supporting=reading.referenceInFeatures?distinctReferences.map(id=>{const im=additional.photos[id];return {...im,caption:reading.omitSupportingCaption?'':im.caption,alt:im.caption,origin:im.kind,note:referenceNote(id)};}):[];
const externalScope=Boolean((reading.scopeInIntro&&!reading.scopeInCaption&&scope)||(reading.scopeInOrder&&scope)||(reading.scopeInCaption&&(sourceCaption||visual.sourceHref))||(plan.kind==='polymer'&&!reading.polymerConditionsInRequirements&&!scope));
const drawing={scopeAnchor:casting?!Boolean(reading.scopeInIntro&&!reading.scopeInCaption&&scope):!externalScope,conceptId:review.id==='P04'?'port-review' as const:undefined,heading:focus.featureHeading,explanation:focus.featureIntro,intro:reading.drawingIntro,scope:reading.scopeInIntro||reading.scopeInOrder?undefined:scope,casting,detail:detail.detail,realDetail:photograph?undefined:realDetail,visual,requirements,combineChecks:reading.combineChecks,featureText:reading.featureText,featureTitles:reading.featureTitles,question:!reading.omitQuestion&&reading.questionInFeatures&&specialQuestion?{...question,answer:reading.questionAnswer||question.answer}:undefined,questionBesideFeatures:reading.questionBesideFeatures,questionInRequirements:reading.questionInRequirements,supporting,sharedNote:reading.sharedReferenceNote&&supporting.length?referenceNote(distinctReferences[0]):undefined,layout:reading.drawingLayout};
const resourceCandidates=[{href:'/capabilities/'+links.capability+'/',label:links.label},...contexts.map(c=>({href:c.href,label:reading.contextResourceLabel||c.title+' requirements'})),...(casting?[{href:casting.href,label:casting.label}]:[])];
const resourceLinks=resourceCandidates.filter((item,index)=>resourceCandidates.findIndex(other=>other.href===item.href)===index);
---
<article class="rd-page pd-page pd-part-page" data-part={product.slug} data-layout={task} data-form={plan.kind}><div class="rd-wrap">
 <section class="pd-part-opening" aria-labelledby="part-title" data-product-module="Part and material" data-core-section="Part, material and final condition">
  <header class="pd-part-heading"><h1 id="part-title">{title}</h1><p class="pd-lead">{focus.lead}</p>{task==='assembly'&&<p class="pd-supply-identity">{identity.scope}</p>}<div class="pd-hero-action"><a class="rd-button" href={quoteHref}>Request a quote</a></div><nav class="pd-part-index" aria-label="Part requirements"><a href="#fit-review">Drawing & acceptance</a><a href="#part-information">Material & finish</a><a href="#order-details">Order conditions</a></nav></header>
  <div class="pd-part-media"><div class="pd-main-image" id="reference-views"><span id="reference-title" class="pd-anchor"/><ProductsFigure {...heroVisual} showSourceLink caption={heroVisual.caption} eager/>{(reading.scopeInIntro||reading.scopeInCaption)&&scope&&<p class="pd-intro-scope" id={casting?'casting-blank':'supply-scope'}>{scope}</p>}</div>
{runnerReference&&(reading.omitRunnerCaption?<span id="additional-reference-views" class="pd-anchor"/>:<aside class="pd-small pd-runner-source-note" id="additional-reference-views">{!reading.compactRunnerNote&&<strong>Additional reference views</strong>}<p>{additional.photos['intake-runner-cad'].caption}</p>{!reading.compactRunnerNote&&<p>Independent CAD reference; a common controlled revision with the listing has not been established.</p>}</aside>)}</div>

 </section>
 {reading.finishReview&&<ProductsFinishReview reference={related[0].product} reason={focus.comparison+' '+related[0].reason.replace(' with separate appearance references','')}/>}
 {<>{plan.kind==='polymer'&&reading.polymerConditionsInRequirements&&scope&&<span id="measurement-state" class="pd-anchor"/>}<PartDrawingRequirements {...drawing}/></>}
 <section class="rd-section pd-process-context pd-production-review" aria-labelledby="machining-context-title" data-core-section="Machining and application review">
  <div class="pd-process-photo"><ProductsFigure {...studyVisual} caption={reading.studyCaption||(study.collection?'Separate source collection; individual forms and materials require confirmation.':'Related workshop setup, shown on a separate component.')} origin="original-photo"/><a class="rd-link" href={'/machined-parts/machining-examples/'+links.study+'/'}>{links.studyTitle}</a><p class="pd-small pd-object-record">{focus.studyReason}</p></div>
  <div class="pd-process-explanation"><h2 id="machining-context-title">{focus.processHeading}</h2>{focus.process.map(paragraph=><p class="pd-object-process">{paragraph}</p>)}{reading.processIntro!==''&&<p>{reading.processIntro||summary.process}</p>}{processNotes.length>0&&<ul class="pd-review-notes">{processNotes.map(note=><li>{note}</li>)}</ul>}{specialQuestion&&!reading.omitQuestion&&!reading.questionInFeatures&&<div class="pd-order-question"><h3>{question.question}</h3><p>{question.answer}</p></div>}{reading.applicationCopy!==''&&(reading.applicationCopy?<p class="pd-application-copy">{reading.applicationCopy}</p>:<><p class="pd-application-copy">{manufacturing.applications}</p><p class="pd-small">These are potential applications. Suitability and acceptance requirements are reviewed for your drawing.</p></>)}{!reading.omitContexts&&contexts.map(c=><aside class="pd-application-context"><h3>{c.title}</h3>{c.description&&!reading.omitContextDescriptions&&<p>{c.description}</p>}<p>{c.body}</p>{!reading.compactResources&&<a class="rd-link" href={c.href}>Application requirements</a>}</aside>)}{!reading.compactResources&&casting&&<a class="rd-link" href={casting.href}>{casting.label}</a>}</div><aside class="pd-material-rail pd-specification-summary" id="part-information" aria-labelledby="material-title">
    <div class="pd-material-section"><h3 id="material-title">{material.label}</h3><p>{reading.materialIntro||material.value}</p>{!reading.materialIntro&&<p class="pd-small">{material.value.toLowerCase().includes('confirm')?'State the material condition on the drawing.':'Confirm the exact grade and condition for the drawing.'}</p>}</div>
    {!reading.finishReview&&<div class="pd-material-section"><h3>Final surface condition</h3>{reading.finishItems?<ul class="pd-finish-options">{reading.finishItems.map(item=><li>{item}</li>)}</ul>:<p>{manufacturing.finishes}</p>}<p class="pd-small">Confirm substrate compatibility, protected fitted surfaces and dimensions after treatment.</p></div>}
    <p class="pd-small pd-object-material">{focus.materialNote}</p>
    {plan.kind==='polymer'&&!reading.polymerConditionsInRequirements&&<div class="pd-material-state" id={scope?'measurement-state':'supply-scope'}><h3>Polymer and measurement state</h3><p>Specify fillers, stock condition, temperature, moisture, chemical contact, loads and mounting. Agree conditioning, support and measurement temperature.</p><p class="pd-small">Specify any electrical, optical, food-contact or medical requirements with the applicable tests and records.</p></div>}
   </aside>
 </section>
  
 {distinctReferences.length>0&&!reading.referenceInFeatures&&<section class="rd-section" id="additional-reference-views" data-core-section="Additional source references"><header><h2>{reading.referenceHeading||'Additional reference views'}</h2>{reading.sharedReferenceNote&&<p>{referenceNote(distinctReferences[0])}</p>}</header><div class="pd-reference-list">{distinctReferences.map(id=>{const im=additional.photos[id];return <div><ProductsFigure {...im} alt={im.caption} origin={im.kind}/>{!reading.sharedReferenceNote&&<p class="pd-small">{referenceNote(id)}</p>}</div>})}</div></section>}
 {!reading.finishReview&&<section class="rd-section pd-next pd-related-objects" id="related-reading" data-core-section="Related forms and technical reading"><span id="related-part-requirements" class="pd-anchor"/><h2 id="continue-title">Related machining and part forms</h2><div class="pd-related-layout">{related.map(({product:other,reason})=><div class="pd-related-comparison"><ProductsFigure {...partVisual(other)} caption={partVisual(other).sourceHref?undefined:reading.relatedCaption}/><div><a class="pd-related-title" href={'/machined-parts/gallery/'+other.slug+'/'}><h3>{partDisplayTitle(other)}</h3></a><p class="pd-object-comparison">{focus.comparison}</p>{!reading.omitRelatedReason&&<p>{reason}</p>}{reading.compactResources?<nav class="pd-reading-resources" aria-label="Related technical requirements">{resourceLinks.map(item=><a class="rd-link" href={item.href}>{item.label}</a>)}</nav>:<div class="pd-related-capability"><h3>{links.label}</h3><p>Material conditions and machining requirements for a similar part.</p><a class="rd-link" href={'/capabilities/'+links.capability+'/'}>Explore this machining service</a></div>}</div></div>)}</div></section>}
 <section class="rd-section pd-order-band" id="order-details" data-core-section="Drawing review and quotation"><div><h2>Request a quote for your part</h2>{reading.scopeInOrder&&scope&&<p class="pd-order-scope" id="supply-scope">{scope}</p>}{reading.rfqItems?<ul class="pd-order-inputs">{reading.rfqItems.map(item=><li><strong>{item.label}</strong>{item.text}</li>)}</ul>:<p>{review.rfq} Include the revision, quantity and delivery destination.</p>}<a class="rd-link" href="/resources/ordering/rfq-checklist/">RFQ checklist</a>{!reading.orderAfterConditions&&<ProductsInquiryAction quoteHref={quoteHref}/>}</div><aside id="order-conditions"><h3>Minimum order</h3><p>From 1 piece.</p><h3>Production and shipping</h3><p>{orderProduction}</p>{reading.orderAfterConditions&&<ProductsInquiryAction quoteHref={quoteHref}/>}</aside></section>
 </div></article>
