---
import ProductsFigure from './ProductsFigure.astro';
import PartDrawingRequirements from './PartDrawingRequirements.astro';
import ProductsInquiryAction from './ProductsInquiryAction.astro';
import ProductsFinishReview from './ProductsFinishReview.astro';
import {partReadingPolish} from '../data/readingPolish';
import {engineeringCases} from '../data/cases';
import {photo} from '../data/evidence';
import {partPlan,partVisual,partDisplayTitle,type PartRecord} from '../data/productsEditorial';
import {productIdentity,primaryReferenceIds,listingSource} from '../data/productIdentity';
import {productSourceReview} from '../data/productSourceReview';
import {partMaterialStatus} from '../data/productBrowse';
import {productSummary} from '../data/productSummaries';
import {productManufacturing} from '../data/manufacturing';
import {productReferences} from '../data/productReferences';
import {partReadingLinks} from '../data/productReadingLinks';
import {relatedPartDecisions} from '../data/productDecisions';
import {productQuestion} from '../data/productReading';
import {castingReview} from '../data/castingReview';
import {partTask,taskHeadings,taskScope,orderProduction,productApplicationContexts,partSupplement,realProductDetails} from '../data/productsRebuild';
import sourceMedia from '../data/productSourceMedia.generated.json';
import additional from '../data/additionalMedia.generated.json';
import catalog from '../data/catalog.json';
import '../styles/products-20261015.css';
interface Props{product:PartRecord;quoteHref:string}
const {product,quoteHref}=Astro.props;
const reading=partReadingPolish[product.slug]||{};
const title=partDisplayTitle(product),identity=productIdentity(product.slug),plan=partPlan(product.slug),review=productSourceReview(product),material=partMaterialStatus(product),summary=productSummary(product),manufacturing=productManufacturing(product),visual=partVisual(product),links=partReadingLinks(product),casting=castingReview[product.slug];
const task=partTask(review.id),scope=reading.scopeCopy||taskScope(task,plan.kind),contexts=productApplicationContexts(product.slug),related=relatedPartDecisions(product,catalog.products).slice(0,1);
const references=(productReferences[product.slug]||[]).filter(id=>id!==primaryReferenceIds[product.slug]);
const runnerReference=references.includes('intake-runner-cad');
const distinctReferences=references.filter(id=>id!=='intake-runner-cad');
const detail=sourceMedia[product.slug as keyof typeof sourceMedia] as typeof sourceMedia['ultra-high-precision-machining-services'];
const question=productQuestion(product.slug,manufacturing.tags);
const sourceCaptionBase=visual.quality==='low-resolution'?'Low-resolution source · form reference only. Detailed photograph needed.':visual.origin==='original-subject-ai-background'?'Original source subject · AI-generated background.':primaryReferenceIds[product.slug]?'Original workshop reference.':identity.label+'.';
const sourceCaption=reading.sourceCaption||sourceCaptionBase+(reading.scopeInCaption&&scope?' '+scope:'');
const specialQuestion=['P02','P07','P11','P12','P13','P16','P17','P20','P27','P32'].includes(review.id);
const heroDescription=listingSource(product.slug).description.replace(/[.]$/, '');
const realDetail=realProductDetails[review.id];
const study=engineeringCases.find(item=>item.slug===links.study)!;
const studyVisual=photo(study.collection==='plastic'?'plastic-ptfe-shafts':study.collection==='metal'?'metal-aluminum-close':study.hero);
const requirements=[...review.features,...(partSupplement[review.id]?[{title:'Further drawing requirements',body:partSupplement[review.id].drawing,check:partSupplement[review.id].check}]:[])].filter(feature=>!reading.omitFeatureTitles?.includes(feature.title));
const processNotes=review.notes.filter(note=>!reading.omitNotes?.includes(note));
const referenceNote=(id:string)=>id.startsWith('plenum-')?'Independent reference view. These files do not establish one controlled section, batch or verification sequence.':id==='intercooler-batch-detail'?'Separate form reference for repeated fins and end sections; it does not establish one order or cooling performance.':'Independent reference; unseen surfaces and mating details require the drawing.';
const supporting=reading.referenceInFeatures?distinctReferences.map(id=>{const im=additional.photos[id];return {...im,caption:reading.omitSupportingCaption?'':im.caption,alt:im.caption,origin:im.kind,note:referenceNote(id)};}):[];
const drawing={heading:reading.drawingHeading||taskHeadings[task],intro:reading.drawingIntro,scope:reading.scopeInIntro||reading.scopeInOrder?undefined:scope,casting,detail:detail.detail,realDetail,visual,requirements,combineChecks:reading.combineChecks,featureText:reading.featureText,featureTitles:reading.featureTitles,question:!reading.omitQuestion&&reading.questionInFeatures&&specialQuestion?{...question,answer:reading.questionAnswer||question.answer}:undefined,questionBesideFeatures:reading.questionBesideFeatures,questionInRequirements:reading.questionInRequirements,supporting,sharedNote:reading.sharedReferenceNote&&supporting.length?referenceNote(distinctReferences[0]):undefined,layout:reading.drawingLayout};
const resourceCandidates=[{href:'/capabilities/'+links.capability+'/',label:links.label},...contexts.map(c=>({href:c.href,label:reading.contextResourceLabel||c.title+' requirements'})),...(casting?[{href:casting.href,label:casting.label}]:[])];
const resourceLinks=resourceCandidates.filter((item,index)=>resourceCandidates.findIndex(other=>other.href===item.href)===index);
---
<article class="rd-page pd-page pd-part-page" data-part={product.slug} data-layout={task} data-form={plan.kind}><div class="rd-wrap">
 <section class="pd-object-review pd-part-intro" aria-labelledby="part-title" data-product-module="Part and material" data-core-section="Part, material and final condition">
  <header class="pd-object-heading"><h1 id="part-title">{title}</h1><p class="pd-lead">{reading.heroLead||`${heroDescription}. Made to your approved drawing.`}</p><div class="pd-hero-action"><a class="rd-button" href={quoteHref}>Prepare RFQ email</a></div></header>
  <div class="pd-object-media"><div class="pd-main-image" id="reference-views"><span id="reference-title" class="pd-anchor"/><ProductsFigure {...(realDetail||visual)} caption={realDetail?'Real crop from the original batch photograph.':sourceCaption} captionId={reading.scopeInCaption?'supply-scope':undefined} eager/>{reading.scopeInIntro&&!reading.scopeInCaption&&scope&&<p class="pd-intro-scope" id={casting?'casting-blank':'supply-scope'}>{scope}</p>}{task==='assembly'&&<p class="pd-object-scope">{identity.scope}</p>}</div>
{runnerReference&&(reading.omitRunnerCaption?<span id="additional-reference-views" class="pd-anchor"/>:<aside class="pd-small pd-runner-source-note" id="additional-reference-views">{!reading.compactRunnerNote&&<strong>Additional reference views</strong>}<p>{additional.photos['intake-runner-cad'].caption}</p>{!reading.compactRunnerNote&&<p>Independent CAD reference; a common controlled revision with the listing has not been established.</p>}</aside>)}</div><aside class="pd-material-rail" id="part-information" aria-labelledby="material-title">
    <h3 id="material-title">{material.label}</h3><p>{reading.materialIntro||material.value}</p>{!reading.materialIntro&&<p class="pd-small">{material.value.toLowerCase().includes('confirm')?'State the material condition on the drawing.':'Confirm the exact grade and condition for the drawing.'}</p>}
    {!reading.finishReview&&<><h3>Final surface condition</h3>{reading.finishItems?<ul class="pd-finish-options">{reading.finishItems.map(item=><li>{item}</li>)}</ul>:<p>{manufacturing.finishes}</p>}<p class="pd-small">Confirm substrate compatibility, protected fitted surfaces and dimensions after treatment.</p></>}
    {plan.kind==='polymer'&&!reading.polymerConditionsInRequirements&&<div id={scope?'measurement-state':'supply-scope'}><h3>Polymer and measurement state</h3><p>Specify fillers, stock condition, temperature, moisture, chemical contact, loads and mounting. Agree conditioning, support and measurement temperature.</p><p class="pd-small">Color does not establish the polymer or electrical, optical, food-contact or medical suitability; specify the required tests and records.</p></div>}
   </aside>

 </section>
 {reading.finishReview&&<ProductsFinishReview reference={related[0].product} reason={related[0].reason.replace(' with separate appearance references','')}/>}
 {reading.featuresFirst&&<>{plan.kind==='polymer'&&reading.polymerConditionsInRequirements&&scope&&<span id="measurement-state" class="pd-anchor"/>}<PartDrawingRequirements {...drawing}/></>}
 <section class="rd-section pd-process-context" aria-labelledby="machining-context-title" data-core-section="Machining and application review">
  <div class="pd-process-photo"><ProductsFigure {...studyVisual} caption={reading.studyCaption||"Related workshop record · a separate component from this part reference."} origin="original-photo"/><a class="rd-link" href={'/machined-parts/machining-examples/'+links.study+'/'}>{links.studyTitle}</a>{!reading.omitStudyReason&&<p class="pd-small">{links.reason}</p>}</div>
  <div><h2 id="machining-context-title">{reading.processHeading||'Machining and use'}</h2>{reading.processIntro!==''&&<p>{reading.processIntro||summary.process}</p>}{processNotes.length>0&&<ul class="pd-review-notes">{processNotes.map(note=><li>{note}</li>)}</ul>}{specialQuestion&&!reading.omitQuestion&&!reading.questionInFeatures&&<div class="pd-order-question"><h3>{question.question}</h3><p>{question.answer}</p></div>}{reading.applicationCopy!==''&&(reading.applicationCopy?<p class="pd-application-copy">{reading.applicationCopy}</p>:<><p class="pd-application-copy">{manufacturing.applications}</p><p class="pd-small">Application requirements are defined for your drawing; these are not confirmed customer applications.</p></>)}{!reading.omitContexts&&contexts.map(c=><aside class="pd-application-context"><h3>{c.title}</h3>{c.description&&!reading.omitContextDescriptions&&<p>{c.description}</p>}<p>{c.body}</p>{!reading.compactResources&&<a class="rd-link" href={c.href}>Application requirements</a>}</aside>)}{!reading.compactResources&&casting&&<a class="rd-link" href={casting.href}>{casting.label}</a>}</div>
 </section>
  {!reading.featuresFirst&&<PartDrawingRequirements {...drawing}/>}
 {distinctReferences.length>0&&!reading.referenceInFeatures&&<section class="rd-section" id="additional-reference-views" data-core-section="Additional source references"><header><h2>{reading.referenceHeading||'Additional reference views'}</h2>{reading.sharedReferenceNote&&<p>{referenceNote(distinctReferences[0])}</p>}</header><div class="pd-reference-list">{distinctReferences.map(id=>{const im=additional.photos[id];return <div><ProductsFigure {...im} alt={im.caption} origin={im.kind}/>{!reading.sharedReferenceNote&&<p class="pd-small">{referenceNote(id)}</p>}</div>})}</div></section>}
 {!reading.finishReview&&<section class="rd-section pd-next pd-related-objects" id="related-reading" data-core-section="Related forms and technical reading"><span id="related-part-requirements" class="pd-anchor"/><h2 id="continue-title">Related machining and part forms</h2><div class="pd-related-layout">{related.map(({product:other,reason})=><div class="pd-related-comparison"><ProductsFigure {...partVisual(other)} caption={reading.relatedCaption}/><div><a class="pd-related-title" href={'/machined-parts/gallery/'+other.slug+'/'}><h3>{partDisplayTitle(other)}</h3></a>{!reading.omitRelatedReason&&<p>{reason}</p>}{reading.compactResources?<nav class="pd-reading-resources" aria-label="Related technical requirements">{resourceLinks.map(item=><a class="rd-link" href={item.href}>{item.label}</a>)}</nav>:<div class="pd-related-capability"><h3>{links.label}</h3><p>Material conditions, machining inputs and the scope for your drawing.</p><a class="rd-link" href={'/capabilities/'+links.capability+'/'}>Review the machining capability</a></div>}</div></div>)}</div></section>}
 <section class="rd-section pd-order-band" id="order-details" data-core-section="Drawing review and quotation"><div><h2>Review your drawing</h2>{reading.scopeInOrder&&scope&&<p class="pd-order-scope" id="supply-scope">{scope}</p>}{reading.rfqItems?<ul class="pd-order-inputs">{reading.rfqItems.map(item=><li><strong>{item.label}</strong>{item.text}</li>)}</ul>:<p>{review.rfq} Include the revision, quantity and delivery destination.</p>}<a class="rd-link" href="/resources/ordering/rfq-checklist/">RFQ checklist</a>{!reading.orderAfterConditions&&<ProductsInquiryAction quoteHref={quoteHref}/>}</div><aside id="order-conditions"><h3>Minimum order</h3><p>From 1 piece.</p><h3>Production and shipping</h3><p>{orderProduction}</p>{reading.orderAfterConditions&&<ProductsInquiryAction quoteHref={quoteHref}/>}</aside></section>
 </div></article>
