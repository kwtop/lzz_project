---
import AboutRedesignPhoto from './AboutRedesignPhoto.astro';
import {approvedNewsPlans,approvedNewsPhoto} from '../data/aboutApproved';
import type {Resource} from '../data/resources';
import {siteImage} from '../data/siteImages';
interface Props {item:Resource;featured?:boolean;quiet?:boolean;showCategory?:boolean;summary?:boolean}
const {item,featured=false,quiet=false,showCategory=true,summary=true}=Astro.props,plan=approvedNewsPlans[item.slug],original=approvedNewsPhoto(plan.cover);
const preview=plan.cover==='australian-visit-03'?siteImage('news-visit-reframed'):undefined;
const image=preview||original;
const imageCaption=preview?preview.caption:'Original company photograph';
const href='/about/company-news/'+item.slug+'/',Heading=featured?'h2':'h3';
---
<article class="ar-news-record" data-ar-news-category={plan.category}>
 {quiet?<div class="ar-record-image"><AboutRedesignPhoto src={image.src} srcset={image.srcset} width={image.width} height={image.height} alt={preview?preview.alt:original.caption} caption={imageCaption} origin={preview?'image-reference':'original-photo'} sourceHref={original.src}/></div>:<a href={href} aria-label={'Photographs: '+item.title}><AboutRedesignPhoto src={image.src} srcset={image.srcset} width={image.width} height={image.height} alt={preview?preview.alt:original.caption} caption={imageCaption} origin={preview?'image-reference':'original-photo'}/></a>}
 <div class="ar-record-copy"><div class="ar-news-meta"><time datetime={item.eventDate}>{item.eventDateLabel}</time>{showCategory&&<span>{plan.category}</span>}</div><Heading><a href={href}>{item.title}</a></Heading>{summary&&<p>{item.description}</p>}</div>
</article>
