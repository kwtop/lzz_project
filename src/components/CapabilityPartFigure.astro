---
import type {RevisedCapability} from '../data/capabilityRedesign';
interface Props {part:RevisedCapability['parts'][number];eager?:boolean;class?:string;conciseCaption?:boolean;linked?:boolean;showCaption?:boolean}
const {part,eager=false,class:className,linked=true}=Astro.props;
---
<figure class:list={['cx-part-figure',className]} data-image-origin={part.origin} data-image-background={part.background}>
 {linked?<a href={part.href} aria-label={'View '+part.title}><img src={part.src} srcset={part.srcset} width={part.width} height={part.height} sizes="(max-width:767px) calc(100vw - 40px), 560px" alt={part.alt} loading={eager?'eager':'lazy'} fetchpriority={eager?'high':undefined} decoding="async"/></a>:<img src={part.src} srcset={part.srcset} width={part.width} height={part.height} sizes="(max-width:767px) calc(100vw - 40px), 560px" alt={part.alt} loading={eager?'eager':'lazy'} decoding="async"/>}
</figure>
