---
import Layout from '../layouts/Layout.astro';
import AboutNewsRecord from './AboutNewsRecord.astro';
import {approvedNewsPlans} from '../data/aboutApproved';
import {companyNews} from '../data/companyNews';
import '../styles/about-approved.css';
import '../styles/about-constitution.css';
import '../styles/content-image-led.css';
---
<Layout title="Company news: visits, events and life at LZZ" description="Original photographs and dated records from LZZ workshop visits, company events and team activities in Hangzhou." cta={false}>
 <article class="ar-page ar-news-index rd-wrap rd-page">
  <header class="ar-news-head" data-core-section="News directory"><div><h1>Company news</h1><p>Workshop visits, industry events and days with the LZZ team, recorded in original photographs.</p></div></header>
  <nav class="ar-news-filter" aria-label="Filter company news"><button type="button" data-ar-news-filter="all" aria-pressed="true">All updates</button><button type="button" data-ar-news-filter="Workshop & events" aria-pressed="false">Workshop &amp; events</button><button type="button" data-ar-news-filter="Team life" aria-pressed="false">Team life</button></nav><p class="ar-news-count" role="status" aria-live="polite">5 updates</p>
  <section data-core-section="Latest record" class="ar-news-feature" aria-label="Latest dated record"><AboutNewsRecord item={companyNews[0]} featured quiet/></section>
  <section data-core-section="Workshop and industry visits" class="ar-news-archive ar-news-workshop rd-section" aria-labelledby="earlier-records-title"><h2 id="earlier-records-title">Workshop &amp; industry visits</h2><div class="ar-news-archive-grid">{companyNews.slice(1).filter(item=>approvedNewsPlans[item.slug].category==='Workshop & events').map(item=><AboutNewsRecord item={item} quiet showCategory={false}/>)}</div></section><section data-core-section="Team records" class="ar-news-archive ar-news-team rd-section" aria-labelledby="team-records-title"><h2 id="team-records-title">Team records</h2><div class="ar-news-archive-grid">{companyNews.slice(1).filter(item=>approvedNewsPlans[item.slug].category==='Team life').map(item=><AboutNewsRecord item={item} quiet showCategory={false}/>)}</div></section>
  <section class="rd-section ar-news-context"><nav class="ar-links" aria-label="Company information"><a href="/about/company-profile/">Company profile</a><a href="/about/how-we-work/">How we work</a><a href="/about/contact/">Contact LZZ</a></nav></section>
 </article>
</Layout>
<script>
 const archive=document.querySelector('.ar-news-index');
 if(archive){const buttons=archive.querySelectorAll<HTMLButtonElement>('[data-ar-news-filter]'),records=archive.querySelectorAll<HTMLElement>('[data-ar-news-category]'),status=archive.querySelector('.ar-news-count');buttons.forEach(button=>button.addEventListener('click',()=>{const selection=button.dataset.arNewsFilter;let count=0;buttons.forEach(item=>item.setAttribute('aria-pressed',String(item===button)));records.forEach(item=>{item.hidden=selection!=='all'&&item.dataset.arNewsCategory!==selection;if(!item.hidden)count++;});archive.querySelectorAll<HTMLElement>('.ar-news-feature,.ar-news-archive').forEach(group=>{group.hidden=[...group.querySelectorAll<HTMLElement>('[data-ar-news-category]')].every(item=>item.hidden);});if(status)status.textContent=count+(count===1?' update':' updates');}));}
</script>
