---
import ImmersiveInnerHero from './ImmersiveInnerHero.astro';
import ProductsFigure from './ProductsFigure.astro';
import {partVisual} from '../data/productsEditorial';
import {orderProduction} from '../data/productsRebuild';
import {photo} from '../data/evidence';
import catalog from '../data/catalog.json';
import '../styles/products-20261015.css';
const pick=(slug:string)=>catalog.products.find(p=>p.slug===slug)!;
const forms=[
 {key:'housings',label:'Housings & covers',slug:'small-batch-cnc-machining-manufacturer-complex-aluminum-housings',note:'Cavities, sealing faces and mounting features.'},
 {key:'shafts',label:'Shafts, fittings & pins',slug:'precision-stainless-steel-indexing-plunger-manufacturer-and-spring-loaded-locking-pin-supplier',note:'Diameters, threads and engagement.'},
 {key:'blocks',label:'Blocks, brackets & circular forms',slug:'custom-high-precision-cnc-milling-5-axis-machining-services-oem-odm',note:'Locating faces, bores and hole patterns.'},
 {key:'impellers',label:'Impellers',slug:'ultra-high-precision-machining-services',note:'Blade profiles, roots and the hub bore.'},
 {key:'castings',label:'Machined castings',slug:'oem-precision-cnc-machined-casting-housing-structural-enclosures',note:'Blank allowance, supports and machined interfaces.'},
 {key:'assemblies',label:'Component & assembly references',slug:'custom-cnc-machined-electronic-throttle-body-manufacturer-and-automotive-prototype-supplier',note:'Define the individual component, mating interfaces and supply scope.'},
];
---
<article class="rd-page pd-page pd-overview-page"><div class="rd-wrap">
 <ImmersiveInnerHero title="Machined parts, made to your drawing" lead="We mill and turn custom components for prototypes and production. Browse similar part forms, then discuss the material, interfaces and acceptance requirements for your order." secondaryHref="/machined-parts/gallery/" secondaryLabel="Find a part form"><p class="ar-legal">Starting with a sample requires a separate reconstruction and drawing-approval stage.</p></ImmersiveInnerHero>
 <section class="rd-section" id="part-examples" data-core-section="Choose by part form"><header><h2>Find a similar part form</h2><p>Browse 35 references, from individual components to part groups and assembly contexts. We quote your configuration from the controlled drawing.</p></header><nav class="pd-forms" aria-label="Six part forms">{forms.map(f=><a class="pd-form" href={'/machined-parts/gallery/?form='+f.key}><ProductsFigure {...partVisual(pick(f.slug))} caption={undefined}/><div><h3>{f.label}</h3><p>{f.note}</p></div></a>)}</nav><nav class="pd-collection-links pn-link-index" aria-label="Material and order tasks"><div><a href="/machined-parts/gallery/?form=plastics">Engineering plastic parts</a><p>Specify the polymer grade, working surfaces and measurement conditions.</p></div><a href="/machined-parts/gallery/?form=batches">Plan a batch by part number</a></nav></section>
 <section class="rd-section pd-workshop" id="machining-studies" data-core-section="How the part is held and reached"><ProductsFigure {...photo('turn-mill-operation')} caption="Original workshop photograph · milling after turning." origin="original-photo"/><div><h2>See how the part is held and reached</h2><nav class="pd-route-list" aria-label="Machining questions"><a href="/machined-parts/machining-examples/turning-then-milling-cylindrical-parts/"><strong>Turning followed by milling</strong><span>Relate off-axis features to the turned body.</span></a><a href="/machined-parts/machining-examples/two-stage-cnc-milling/"><strong>Two milling setups</strong><span>Retain feature relationships after repositioning.</span></a><a href="/machined-parts/machining-examples/29-inch-display-housing-cnc-machining/"><strong>Display housing machining</strong><span>Define panel support and finished interfaces.</span></a></nav><a class="rd-link" href="/machined-parts/machining-examples/">Machining setups and source collections</a></div></section>
 <section class="rd-section pd-order-band" id="buyer-review" data-core-section="Define and enquire"><div><h2>Quoting your custom part</h2><ul class="pd-order-inputs"><li><strong>Geometry &amp; fit</strong>Current model and controlled drawing revision, units, mating interfaces, datums and critical dimensions.</li><li><strong>Material &amp; final condition</strong>Exact grade, stock condition and finish, including dimensions and surfaces to protect.</li><li><strong>Quantity &amp; acceptance</strong>Quantity, measurement and record requirements, destination and requested date.</li></ul><nav class="pd-reading-resources" aria-label="RFQ guidance"><a class="rd-link" href="/resources/ordering/rfq-checklist/">RFQ checklist</a><a class="rd-link" href="/resources/ordering/">RFQ & ordering</a></nav></div><aside id="enquiry"><h3>Minimum order</h3><p>From 1 piece.</p><h3>Production &amp; shipping</h3><p>{orderProduction}</p><div id="prepare-rfq"><a class="rd-button" href="/quote/?part=Custom+part+reference+review">Request a quote</a><p class="pd-small">Review the draft, add your drawings and send it from your email app.</p></div></aside></section>
 </div></article>
