---
import {footerNavigation} from '../data/footerNavigation.ts';
import {Facebook, Linkedin, MapPin} from 'lucide-react';
import ContactIcon from './ContactIcon.astro';
import '../styles/site-footer.css';
interface Props {quoteHref?:string}
const {quoteHref='/quote/?'+new URLSearchParams({source:Astro.url.pathname}).toString()}=Astro.props;
const isQuotePage=Astro.url.pathname==='/quote/';
---
<footer class="lzz-footer lzz-footer--directory" id="contact" data-footer-version="directory-a">
 <div class="lzz-footer-inner">
  <div class:list={['lzz-footer-head',{'lzz-footer-head--contact-only':isQuotePage}]}>
   <div class="lzz-footer-brand">
    <a href="/" aria-label="LZZ Precision home"><img src="/media/lzz-logo.png" alt="LZZ" width="124" height="69" loading="lazy" /></a>
    <p>Custom CNC machining<br />in Hangzhou, China</p>
   </div>
   <div class="lzz-footer-connect">
    <h2>Tell us about your next part</h2>
    <div class="lzz-footer-contacts">
     <a class="lzz-footer-contact" href="mailto:roger@lzz-cnc.com" aria-label="Email roger@lzz-cnc.com"><ContactIcon kind="email"/><span>roger@lzz-cnc.com</span></a>
     <a class="lzz-footer-contact lzz-footer-whatsapp" href="https://wa.me/8613858102479" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp +86 138 5810 2479 (opens in a new tab)"><ContactIcon kind="whatsapp"/><span>+86 138 5810 2479</span></a>
    </div>
   </div>
   {!isQuotePage&&<a class="lzz-footer-quote" href={quoteHref}>Request a quote</a>}
  </div>
  <nav class="lzz-footer-nav" aria-label="Footer navigation">
   {footerNavigation.map(group=><section class="lzz-footer-group" data-footer-group={group.title}>
    <h2><a href={group.href}>{group.title}</a><button class="lzz-footer-toggle" type="button" aria-label={'Show '+group.title+' links'} aria-expanded="true" aria-controls={'footer-'+group.key} hidden></button></h2>
    <ul id={'footer-'+group.key}>{group.links.map(link=><li><a href={link.href}>{link.title}</a></li>)}</ul>
   </section>)}
  </nav>
  <div class="lzz-footer-base">
   <address class="lzz-footer-address"><MapPin size={24} aria-hidden="true"/><div>No. 4 Fengcheng Road, Pingyao, Yuhang District<br/><span>Hangzhou, Zhejiang, China · UTC+8</span></div></address>
   <nav class="lzz-footer-social" aria-label="Follow LZZ Precision">
    <a href="https://www.facebook.com/lzzcncmachining/" target="_blank" rel="noopener noreferrer" aria-label="LZZ Precision on Facebook (opens in a new tab)"><Facebook size={22} aria-hidden="true"/></a>
    <a href="https://www.linkedin.com/company/lzz-cnc-machining/" target="_blank" rel="noopener noreferrer" aria-label="LZZ Precision on LinkedIn (opens in a new tab)"><Linkedin size={22} aria-hidden="true"/></a>
   </nav>
   <div class="lzz-footer-legal"><span>© {new Date().getFullYear()} Hangzhou Lizhizao Precision Machinery Co., Ltd.</span><a href="/privacy/">Privacy and site information</a></div>
  </div>
 </div>
</footer>
<script>
 const footer=document.querySelector('[data-footer-version="directory-a"]');
 if(footer){
  const mobile=matchMedia('(max-width:639px)');
  const groups=Array.from(footer.querySelectorAll<HTMLElement>('[data-footer-group]')).map(group=>({
   title:group.dataset.footerGroup!,button:group.querySelector<HTMLButtonElement>('.lzz-footer-toggle')!,list:group.querySelector<HTMLUListElement>('ul')!,
  }));
  const setExpanded=(group:typeof groups[number],expanded:boolean)=>{
   group.list.hidden=!expanded;
   group.button.setAttribute('aria-expanded',String(expanded));
   group.button.setAttribute('aria-label',(expanded?'Hide ':'Show ')+group.title+' links');
  };
  const adapt=()=>groups.forEach(group=>{group.button.hidden=!mobile.matches;setExpanded(group,!mobile.matches);});
  groups.forEach(group=>group.button.addEventListener('click',()=>setExpanded(group,group.button.getAttribute('aria-expanded')!=='true')));
  mobile.addEventListener('change',adapt);
  adapt();
 }
</script>

