---
interface Props{src?:string;srcset?:string;stem?:string;width?:number;height?:number;alt:string;caption?:string;eager?:boolean;sizes?:string;class?:string;href?:string;origin?:string}
const {src,srcset,stem,width=1536,height=1024,alt,caption,eager=false,sizes='(max-width:760px) calc(100vw - 44px), 50vw',class:className,href,origin}=Astro.props;
const image=src||stem+'-1200.webp';
const sources=srcset||(stem?[480,800,1200,1536].map(w=>`${stem}-${w}.webp ${w}w`).join(', '):undefined);
const contentHref=href&&!/\.(?:webp|png|jpe?g|avif)(?:$|[?#])/i.test(href)?href:undefined;
---
<figure class:list={['pr-image',className,{'pr-image-portrait':height>width}]} data-image-origin={origin} style={`--pr-image-ratio:${width/height}`}>
 {contentHref?<a href={contentHref}><img src={image} srcset={sources} sizes={sizes} width={width} height={height} alt={alt} loading={eager?'eager':'lazy'} fetchpriority={eager?'high':undefined} decoding="async"/></a>:<img src={image} srcset={sources} sizes={sizes} width={width} height={height} alt={alt} loading={eager?'eager':'lazy'} fetchpriority={eager?'high':undefined} decoding="async"/>}
 {caption&&<figcaption>{caption}</figcaption>}
</figure>
