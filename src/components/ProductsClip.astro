---
import media from '../data/additionalMedia.generated.json';
interface Props{id:keyof typeof media.videos;title:string;description:string;headingLevel?:'h3'|'h4';showHeading?:boolean;posterFirst?:boolean}
const {id,title,description,headingLevel='h3',showHeading=true,posterFirst=false}=Astro.props,clip=media.videos[id],Heading=headingLevel;
---
<section class="ps-video" id={'video-'+id} data-portrait={clip.height>clip.width} aria-label={showHeading?undefined:title} aria-labelledby={showHeading?'video-title-'+id:undefined}>{showHeading?<Heading id={'video-title-'+id}>{title}</Heading>:<span id={'video-title-'+id} class="pd-anchor"/>}<p class="pd-small" id={'video-description-'+id}>{description}</p><figure data-image-origin="original-video"><div data-original-clip>{posterFirst&&<button class="ps-clip-trigger" type="button" aria-label={'Play original clip: '+title}><img src={clip.poster} width={clip.width} height={clip.height} alt="" loading="lazy" data-image-origin="original-video-frame"/><span>Play original clip</span></button>}<video hidden={posterFirst} controls playsinline muted preload="none" poster={clip.poster} width={clip.width} height={clip.height} aria-label={title} aria-describedby={'video-description-'+id}><source src={clip.src} type="video/mp4"/>Your browser does not support this video. <a href={clip.src}>Open the original clip</a>.</video><p class="ps-clip-error pd-small" role="status" hidden>Playback is unavailable. <a href={clip.src}>Open the original clip</a>.</p></div>{posterFirst&&<noscript><style>[data-original-clip]>button.ps-clip-trigger{display:none}</style><video controls playsinline muted preload="none" poster={clip.poster} width={clip.width} height={clip.height} aria-label={title}><source src={clip.src} type="video/mp4"/></video></noscript>}<figcaption>{Math.round(clip.duration)}-second original workshop clip. The recording does not replace agreed inspection records.</figcaption></figure></section>
<script>
 for(const player of document.querySelectorAll<HTMLElement>('[data-original-clip]')){
  const trigger=player.querySelector<HTMLButtonElement>('.ps-clip-trigger'),video=player.querySelector<HTMLVideoElement>('video'),error=player.querySelector<HTMLElement>('.ps-clip-error');
  const showError=()=>{if(error)error.hidden=false;};
  video?.addEventListener('error',showError);
  video?.querySelector('source')?.addEventListener('error',showError);
  trigger?.addEventListener('click',async()=>{if(!video)return;trigger.hidden=true;video.hidden=false;video.focus();try{await video.play();}catch{if(error)error.hidden=false;}});
 }
</script>
<style>
 [data-original-clip] [hidden]{display:none;}
 .ps-clip-trigger{position:relative;display:block;width:100%;border:0;padding:0;background:#171b1b;color:white;cursor:pointer;text-align:center;}
 .ps-clip-trigger img{display:block;width:100%;height:auto;}
 .ps-clip-trigger span{position:absolute;bottom:16px;left:50%;transform:translateX(-50%);padding:10px 14px;background:#171b1b;font-size:14px;line-height:1.3;white-space:nowrap;}
 .ps-clip-trigger:focus-visible{outline:3px solid #1e6088;outline-offset:4px;}
</style>
