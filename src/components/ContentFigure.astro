---
import {contentVisuals,type ContentVisual} from '../data/contentVisuals';
interface Props {visual:ContentVisual; eager?:boolean; class?:string}
const {visual,eager=false,class:className}=Astro.props;
const asset=contentVisuals[visual];
---
<figure class:list={['ce-figure',className]} data-image-origin="AI-generated">
 <img src={'/media/content-guides/'+asset.name+'-1200.webp'} srcset={[480,800,1200,1536].map(w=>`/media/content-guides/${asset.name}-${w}.webp ${w}w`).join(', ')} sizes="(max-width:760px) calc(100vw - 44px), (max-width:1200px) 50vw, 600px" width="1536" height="1024" alt={asset.alt} loading={eager?'eager':'lazy'} decoding="async"/>
</figure>
