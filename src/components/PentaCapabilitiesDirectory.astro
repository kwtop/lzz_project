---
import Layout from '../layouts/Layout.astro';
import {partDisplay} from '../data/capabilityDesign';
import {orderConditions} from '../data/capabilityRedesign';
import {capabilityHeroPart} from '../data/capabilityRebuild';
import catalog from '../data/catalog.json';
import CapabilityEvidence from './CapabilityEvidence.astro';
import PentaInnerHero from './PentaInnerHero.astro';
import PentaVisual from './PentaVisual.astro';
import {siteImage} from '../data/siteImages';


const routes=[
 {slug:'cnc-milling-service',name:'CNC milling',text:'Pockets, flat faces and hole patterns in blocks, brackets and housings.',part:'custom-high-precision-cnc-milling-5-axis-machining-services-oem-odm'},
 {slug:'cnc-turning-service',name:'CNC turning',text:'Shafts, sleeves and fittings built around an axis, with shoulders, bores and threads.',part:'custom-cnc-turned-stainless-steel-components-manufacturer-and-precision-shaft-supplier'},
 {slug:'5-axis-cnc-machining',name:'5-axis machining',text:'Angled faces and continuous contours needing access from several directions.',part:'ultra-high-precision-machining-services'},
 {slug:'casting-machining',name:'Machining of castings',text:'Finished bores, sealing faces and mounting datums in a supplied cast blank.',part:'oem-precision-cnc-machined-casting-housing-structural-enclosures'},
].map(route=>({...route,visual:partDisplay(catalog.products.find(part=>part.slug===route.part)!)}));
const openingPart=routes[2].visual;
const materials=[
 {slug:'aluminum-cnc-parts',title:'Aluminum',text:'Alloy and temper, thin sections and the dimensions after finishing.'},
 {slug:'stainless-steel-cnc-parts',title:'Stainless steel',text:'Grade and condition selected for the service environment and treatment.'},
 {slug:'copper-brass-cnc-parts',title:'Copper & brass',text:'Contact, heat-transfer or sealing requirements, with the alloy standard defined.'},
 {slug:'plastic-machined-parts',title:'Engineering plastics',text:'Polymer and fillers, working conditions and the dimensional inspection state.'},
].map(item=>({...item,visual:capabilityHeroPart(item.slug)}));
const stages=[
 {slug:'prototype-machining',name:'Evaluate a prototype',text:'A prototype can help evaluate fit, assembly, appearance or a defined functional question.',result:'We agree the revision, what to evaluate and which results you need to review.'},
 {slug:'low-volume-production',name:'Plan a pilot or repeat batch',text:'With approved drawings, plan a pilot or repeat release by part number and quantity.',result:'The batch uses an agreed production baseline, with first-article approval, sampling and traceability.'},
 {slug:'starting-with-a-sample',name:'Start with an existing sample',text:'A physical part can be the starting point when the manufacturing definition is incomplete.',result:'The review covers wear and unknowns before model, drawing and first-part approval.'},
];
---
<Layout pentaSample title="CNC Machining Capabilities" description="Choose CNC milling, turning, multi-axis or casting finish machining. Define grades, drawing inputs and acceptance for prototypes, sample reconstruction and repeat batches." cta={false}>
<article class="pn-catalog" data-capability="overview">
 <PentaInnerHero title="CNC machining capabilities" lead="Custom milling, turning and multi-axis machining for prototypes and small production runs. We review the route around your geometry and material." slug="overview" image={siteImage('cnc-equipment')} part={openingPart} secondaryHref="#machining-processes" secondaryLabel="Explore machining services"/>
 <section class="rd-section pn-cx-route-section" id="machining-processes" data-core-section="process-selection"><header><h2>Machining for your part</h2><p>Flat faces, axial features and angled surfaces need different tool access. We review the drawing and setup constraints before proposing a route.</p></header><div class="pn-cx-process-routes">{routes.map((route,index)=><article><a class="pn-cx-route-image" href={'/capabilities/'+route.slug+'/'} aria-label={route.name} data-image-origin={route.visual.origin} data-image-background={route.visual.background}><img src={route.visual.src} srcset={route.visual.srcset} width={route.visual.width} height={route.visual.height} sizes="(max-width:767px) calc(100vw - 40px), 580px" alt={route.visual.alt} loading={index<2?'eager':'lazy'} decoding="async"/><div><h3>{route.name}</h3><p>{route.text}</p></div></a></article>)}</div><p class="rd-note">Material, tolerances and supply scope follow the approved drawing.</p></section>
 <section class="rd-section pn-cx-directory-materials" id="materials" data-core-section="material-selection"><header><h2>Materials we machine</h2><p>Include the grade, condition and finish if these are decided. Otherwise, we can review the application requirements with you.</p></header><div class="pn-material-layout"><PentaVisual class="pn-material-surface" image={siteImage('guide-materials')} sizes="(max-width:767px) calc(100vw - 40px), 46vw"/><nav class="pn-cx-material-routes" aria-label="Material routes">{materials.map(item=><a href={'/capabilities/'+item.slug+'/'} data-image-origin={item.visual.origin} data-image-background={item.visual.background} data-material-route={item.slug}><h3>{item.title}</h3><p>{item.text}</p></a>)}</nav></div></section>
 <section class="rd-section" id="production-stages" data-core-section="project-stage"><header><h2>From prototype to repeat production</h2></header><div class="pn-cx-stage-visual"><div class="pn-cx-project-routes">{stages.map(stage=><article id={stage.slug==='starting-with-a-sample'?'sample-to-part':undefined}><h3><a href={'/capabilities/'+stage.slug+'/'}>{stage.name}</a></h3><div><p>{stage.text} {stage.result}</p></div></article>)}</div></div><a class="rd-link" href="/resources/ordering/">Drawing, approval and delivery responsibilities</a></section>
 <section class="rd-section" id="source-records" data-core-section="Evidence, drawing inputs and quotation"><div class="pn-cx-directory-evidence"><CapabilityEvidence id="two-stage-first" caption="Top-face access illustration based on the archived milling record." frameClass="cx-directory-setup-frame"/><div><h2>See the machining behind the part</h2><p>Explore tool access and workholding, then agree the critical features, inspection methods, sampling and records for your drawing.</p><div class="pn-cx-inline-actions"><a class="rd-link" href="/machined-parts/machining-examples/">Machining examples</a><a class="rd-link" href="/factory/#quality">Factory & inspection</a></div><p class="rd-note">The drawing and agreed order define the material, tolerances and delivery requirements.</p></div></div>
 <div class="cx-inquiry pn-directory-inquiry" id="enquiry"><header><h2>Tell us about your part</h2><p>If the material, process or design is still undecided, tell us what you need to resolve.</p></header><ul class="pn-cx-rfq-inputs"><li>Current model and drawing with units and revision</li><li>Material grade, condition, finish and protected surfaces</li><li>Quantity, critical features and inspection records</li><li>Delivery destination and requested date</li></ul><div class="pn-directory-inquiry-action"><p class="pn-cx-order-note" id="order-conditions">{orderConditions}</p><a class="rd-button" href="/quote/">Request a quote</a><p class="rd-note">Review the draft, add your drawings and send it from your email app.</p></div></div></section>
</article>
</Layout>

