---
// Key buying facts shown at a glance on capability and part pages.
const items=[
 {value:'1 piece',label:'Minimum order'},
 {value:'7-14 business days',label:'Production after drawing & order confirmation'},
 {value:'±0.01 mm',label:'Tolerance reference for selected features'},
 {value:'CMM',label:'Dimensional inspection'},
 {value:'ISO 9001',label:'Certified quality system'},
];
---
<aside class="adv-strip" aria-label="Key facts"><dl>{items.map(item=><div><dt>{item.label}</dt><dd>{item.value}</dd></div>)}</dl></aside>
<style is:global>
 body .adv-strip{width:min(1140px,calc(100% - 80px));margin:0 auto;padding:22px 0;border-bottom:1px solid #dcd8d1}
 body .adv-strip dl{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:20px;margin:0}
 body .adv-strip dl>div{display:flex;flex-direction:column;min-width:0;padding-left:18px;border-left:2px solid #AC4829}
 body .adv-strip dd{order:-1;margin:0;font:700 22px/1.15 var(--heading,'Roboto Condensed'),Arial,sans-serif;color:#222}
 body .adv-strip dt{margin-top:5px;font-size:14px;line-height:1.4;color:#4f5559}
 /* Hero sections already end with a bottom margin; keep the strip close to them. */
 body .ch-hero+.adv-strip{margin-top:-24px}
 body :is(.pd-part-page,.cx-page) .adv-strip{width:100%}
 body .pd-part-page .adv-strip{margin-block:8px 24px}
 @media(max-width:1099px){body .adv-strip dl{grid-template-columns:repeat(3,minmax(0,1fr))}}
 @media(max-width:767px){
  body .adv-strip{width:calc(100% - 40px);padding:18px 0}
  body .adv-strip dl{grid-template-columns:repeat(2,minmax(0,1fr));gap:16px 12px}
  body .adv-strip dl>div:last-child{grid-column:1/-1}
  body .adv-strip dd{font-size:19px}
  body .ch-hero+.adv-strip{margin-top:-34px}
  body .adv-strip dt{font-size:13px}
 }
</style>
