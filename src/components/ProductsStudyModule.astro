---
import type {EngineeringCase} from '../data/cases';
import {engineeringCases} from '../data/cases';
import {caseReading,collectionReading} from '../data/caseReading';
import {caseStories} from '../data/caseStories';
import {studyChecks} from '../data/studyEditorial';
import {workshopCollections} from '../data/workshopCollections';
import {categoryDetails} from '../data/presentation';
import {photo} from '../data/evidence';
import ProductsImage from './ProductsImage.astro';
import ProductsStudyFamilies from './ProductsStudyFamilies.astro';
import ProductsWorkshopVideo from './ProductsWorkshopVideo.astro';
interface Props{item:EngineeringCase;module:string}
const {item,module}=Astro.props,plan=caseReading[item.slug],story=caseStories[item.slug];
const two=item.slug==='two-stage-cnc-milling',panel=item.video==='display-housing';
const processIds=two?item.photos:[item.hero];
const originalIds=item.collection?[]:panel?['display-housing-pair']:item.photos.filter(id=>!processIds.includes(id));
const visual=story?.diagram||plan.illustration;
const checks=item.collection?workshopCollections[item.collection].map(f=>[f.title,collectionReading[f.id].drawing,collectionReading[f.id].inspection]):studyChecks[item.slug];
const similar=engineeringCases.filter(p=>p.slug!==item.slug&&!p.collection).filter(p=>p.relatedCapabilities.some(key=>item.relatedCapabilities.includes(key))).slice(0,2);
const legacyIds=module==='families'||module==='geometry'?['case-part-title']:module==='sequence'?['case-process-title',...(item.collection==='metal'?['technical-points','study-2','case-technical-title']:[])]:module==='material'?['machining-setup','study-1','case-process-title','case-technical-title']:module==='inspection'?['case-inspection-title']:module==='questions'?['case-faq-title']:[];
---
{legacyIds.map(id=><span class="pr-legacy-anchor" id={id}/>)}
{module==='families'&&item.collection&&<section class="pr-section" id="component" aria-labelledby="families-title"><span id="study-0"/><header class="pr-section-head"><h2 id="families-title">{plan.partHeading}</h2><p>These original photographs and clips document the visible forms. Exact grades, dimensions and acceptance are specified for each new order.</p></header><ProductsStudyFamilies collection={item.collection}/></section>}
{module==='geometry'&&<section class="pr-section" id="component" aria-labelledby="geometry-title"><span id="study-0"/><span id="technical-points"/><span id="study-2"/><header class="pr-section-head"><h2 id="geometry-title">{story?.featureHeading||plan.partHeading}</h2><p>{story?.answer||item.workpiece}</p></header><div class="pr-study-geometry"><ProductsImage {...visual} origin="ai-generated-illustration"/><div class="pr-study-points">{plan.technical.map(point=><div><h3>{point.title}</h3><p>{point.text}</p></div>)}</div></div></section>}
{module==='material'&&<section class="pr-section" id="technical-points" aria-labelledby="material-title"><span id="study-2"/><header class="pr-section-head"><h2 id="material-title">Specify the polymer and the conditions of use</h2><p>{plan.sequenceNote||'Choose the exact grade before defining fit, surface and inspection conditions. The collection labels do not establish suitability for a new application.'}</p></header><div class="pr-material-layout"><div class="pr-study-points">{plan.technical.map(point=><div><h3>{point.title}</h3><p>{point.text}</p></div>)}</div><ol class="pr-process-steps">{plan.steps.map(step=><li><h3>{step.title}</h3><p>{step.text}</p></li>)}</ol></div></section>}
{module==='sequence'&&<section class="pr-section" id="machining-setup" aria-labelledby="sequence-title"><span id="study-1"/><header class="pr-section-head"><h2 id="sequence-title">{two?'Compare the two holding orientations':panel?'Support, machine and inspect the panel':item.collection?'Plan the route for each part':'Machining sequence & setup'}</h2><p>{item.collection?plan.sequenceNote||'Define each component, its material and the interfaces needed for assembly.':item.setup}</p></header>
 {two?<><div class="pr-source-pair">{processIds.map((id,i)=><ProductsImage {...photo(id)} caption={i===0?'First setup · original workshop photograph':'Second setup · original workshop photograph'} origin="original-photo" href={photo(id).src}/>)}</div><ol class="pr-process-steps pr-two-sequence">{plan.steps.map(step=><li><h3>{step.title}</h3><p>{step.text}</p></li>)}</ol></>:<div class="pr-process-layout"><ol class="pr-process-steps">{plan.steps.map(step=><li><h3>{step.title}</h3><p>{step.text}</p></li>)}</ol><div>{!item.collection&&<div class="pr-process-images">{processIds.map(id=><ProductsImage {...photo(id)} origin="original-photo" href={photo(id).src}/>)}</div>}{item.collection&&<div class="pr-study-points">{plan.technical.map(point=><div><h3>{point.title}</h3><p>{point.text}</p></div>)}</div>}</div></div>}
 {!item.collection&&<p class="pr-check-note">{story?.processContext||plan.sequenceNote}</p>}
 {originalIds.length>0&&<details class="pr-study-original"><summary>{panel?'View the original panel photograph':'View the original part photograph'}</summary>{originalIds.map(id=><ProductsImage {...photo(id)} origin="original-photo" href={photo(id).src}/>)}</details>}
 {panel&&<ProductsWorkshopVideo id="display-housing" title="The display housing in the workshop" description="Original views of the housing panel and its machining setup."/>}
</section>}
{module==='inspection'&&<section class="pr-section" id="inspection-planning" aria-labelledby="inspection-title"><span id="study-3"/><header class="pr-section-head"><h2 id="inspection-title">Connect the drawing to the acceptance check</h2><p>{item.collection?'Specify acceptance by part number and material family, then agree measurement conditions and required records.':item.inspection}</p></header><table class="pr-checks"><caption>Planning requirements for a similar part, rather than measured results for the photographed components.</caption><thead><tr><th scope="col">{item.collection?'Part family':'Feature'}</th><th scope="col">Define on the drawing</th><th scope="col">Agree for inspection</th></tr></thead><tbody>{checks.map(([feature,drawing,inspection])=><tr><th scope="row">{feature}</th><td data-label="Define on the drawing">{drawing}</td><td data-label="Agree for inspection">{inspection}</td></tr>)}</tbody></table><p class="pr-check-note">Agree the measurement method, final surface condition, sampling and report format before production. Images and clips do not establish measured acceptance results.</p></section>}
{module==='questions'&&<section class="pr-section pr-study-questions" id="questions" aria-labelledby="questions-title"><h2 id="questions-title">Questions about a similar part</h2><div class="pr-question-list">{plan.questions.map(q=><section><h3>{q.question}</h3><p>{q.answer}</p></section>)}</div></section>}
{module==='related'&&<section class="pr-section" id="related-studies" aria-labelledby="related-title"><header class="pr-section-head"><h2 id="related-title">Continue the drawing review</h2><p>Use a related study or capability to clarify the setup and interfaces for your drawing.</p></header><nav class="pr-study-related" aria-label="Related machining guidance"><div>{similar.map(p=><a href={'/machined-parts/machining-examples/'+p.slug+'/'}><h3>{caseReading[p.slug].title}</h3><p>{caseReading[p.slug].focus}.</p></a>)}</div><div>{item.relatedCapabilities.map(slug=><a href={'/capabilities/'+slug+'/'}><h3>{categoryDetails[slug].title}</h3><p>{categoryDetails[slug].description}</p></a>)}<a class="pr-secondary" href="/machined-parts/machining-examples/">Browse all machining examples</a></div></nav></section>}
