---
import EvidenceImage from './EvidenceImage.astro';
import {primaryServices} from '../data/services';
import {partVisual} from '../data/productsEditorial';
import catalog from '../data/catalog.json';
import {realStudyDetails} from '../data/productsRebuild';
import '../styles/home-approved.css';
const parts=[
 {slug:'ultra-high-precision-machining-services',name:'Machined impeller',focus:'Curved blades and a central hub bore.'},
 {slug:'oem-precision-cnc-machined-casting-housing-structural-enclosures',name:'Casting housing',focus:'Ribs, cavities and machined interfaces.'},
 {slug:'precision-stainless-steel-indexing-plunger-manufacturer-and-spring-loaded-locking-pin-supplier',name:'Turned locking pin',focus:'Stepped diameters and a threaded mounting form.'},
 {slug:'precision-cnc-machining-for-complex-plastic-geometries-and-tight-tolerances',name:'Plastic components',focus:'Repeated holes and recessed working faces.'},
].map(item=>({...item,visual:partVisual(catalog.products.find(p=>p.slug===item.slug)!)}));
const materials=[['Aluminum','aluminum-cnc-parts'],['Stainless steel','stainless-steel-cnc-parts'],['Brass & copper','copper-brass-cnc-parts'],['Engineering plastics','plastic-machined-parts']];
---
<div class="hm-page">
 <section data-core-section="Drawing-based CNC parts" class="hm-hero rd-wrap" aria-labelledby="home-title">
  <div class="hm-hero-copy"><h1 id="home-title">Custom CNC parts.<br/>Made to your drawing.</h1><div class="hm-hero-intro"><p>Milling, turning and 5-axis machining in Hangzhou. From your first prototype to a repeat small-batch order.</p><div class="hm-actions"><a class="rd-button" href="/quote/">Prepare RFQ email</a><a class="rd-link" href="/machined-parts/gallery/">Browse parts gallery</a></div></div></div>
  <figure><img src="/media/editorial-rebuild-20261015/machining-hero-1200.webp" srcset="/media/editorial-rebuild-20261015/machining-hero-480.webp 480w, /media/editorial-rebuild-20261015/machining-hero-800.webp 800w, /media/editorial-rebuild-20261015/machining-hero-1200.webp 1200w, /media/editorial-rebuild-20261015/machining-hero-1448.webp 1448w" sizes="(max-width:767px) calc(100vw - 40px), (max-width:1320px) 56vw, 700px" width="1448" height="1086" alt="AI illustration of an end mill machining a pocket in a clamped aluminum workpiece" data-image-origin="AI-generated" fetchpriority="high" decoding="async"/><figcaption>Machining concept · AI illustration</figcaption></figure>
 </section>
 <section data-core-section="Part forms and machining routes" class="hm-parts rd-wrap rd-section" id="selected-parts" aria-labelledby="home-parts-title"><header class="hm-sectionhead"><div><h2 id="home-parts-title">Start with a familiar part.</h2><p>35 real part references. Every new part is made to an agreed drawing.</p></div></header><div class="hm-partgrid">{parts.map((part,index)=><a class="hm-part" href={'/machined-parts/gallery/'+part.slug+'/'}><div class="hm-partimage"><img src={part.visual.src} srcset={part.visual.srcset} sizes={index<2?'(max-width:767px) calc((100vw - 58px) / 2), (max-width:1099px) 44vw, 380px':'(max-width:767px) 112px, (max-width:1099px) 136px, 136px'} width={part.visual.width} height={part.visual.height} alt={part.visual.alt} data-image-origin={part.visual.origin} loading="lazy" decoding="async"/></div><h3>{part.name}</h3><p>{part.focus}</p></a>)}</div>
 <div class="hm-routeindex" id="capabilities"><nav aria-label="Machining capabilities"><h3 id="home-capability-title">By process</h3><div>{primaryServices.map(service=><a href={'/capabilities/'+service.slug+'/'}>{service.name}</a>)}</div></nav><nav aria-label="Material families"><h3>By material</h3><div>{materials.map(([label,slug])=><a href={'/capabilities/'+slug+'/'}>{label}</a>)}</div></nav><p>Specify the exact material grade, stock condition and finish for your part.</p></div></section>
 <section data-core-section="Two setups for one part" class="hm-process rd-section" aria-labelledby="home-studies-title"><div class="hm-studies rd-wrap"><div class="hm-studyphotos"><figure data-image-origin="original-photo-crop"><img src={realStudyDetails['two-stage-first'].src} width={752} height={540} alt={realStudyDetails['two-stage-first'].alt} loading="lazy" decoding="async"/><figcaption>Setup 1 · original photograph, cropped</figcaption></figure><figure data-image-origin="original-photo-crop"><img src={realStudyDetails['two-stage-second'].src} width={752} height={540} alt={realStudyDetails['two-stage-second'].alt} loading="lazy" decoding="async"/><figcaption>Setup 2 · original photograph, cropped</figcaption></figure></div><div class="hm-studycopy"><h2 id="home-studies-title">The setup behind the shape.</h2><p>One part, two milling setups. The second operation must keep the features related to the faces established in the first. See how locating surfaces, clamping access and the inspection plan come together.</p></div><div class="hm-studyactions"><a class="rd-link" href="/machined-parts/machining-examples/two-stage-cnc-milling/">Two-setup milling study</a><nav class="hm-studyrelated" aria-label="Other machining examples"><a href="/machined-parts/machining-examples/29-inch-display-housing-cnc-machining/">29-inch display housing</a><a href="/machined-parts/machining-examples/turning-then-milling-cylindrical-parts/">Turning followed by milling</a></nav></div></div></section>
 <section data-core-section="Workshop and acceptance" class="hm-evidence rd-section" aria-labelledby="home-factory-title"><div class="rd-wrap hm-evidencegrid"><figure data-image-origin="original-photo"><EvidenceImage id="workshop-wide" sizes="(max-width:767px) calc(100vw - 40px), 58vw"/><figcaption>LZZ workshop in Hangzhou · original photograph</figcaption></figure><div class="hm-evidencecopy"><h2 id="home-factory-title">Meet the workshop.</h2><p>LZZ Precision has supplied custom machined parts from Hangzhou since 2017.</p><dl class="hm-facts"><div><dt>Production facility</dt><dd>1,500 m²</dd></div><div><dt>Machining &amp; supporting equipment</dt><dd>40+</dd></div></dl><h3>Agree how your part is accepted</h3><p>Critical dimensions, sampling and inspection records are confirmed for your order.</p><p>LZZ is ISO 9001 certified. <a href="/about/company-profile/#quality-system">Request the current certificate and scope.</a></p><a class="rd-link" href="/factory/">Factory &amp; quality</a></div></div></section>
 <section data-core-section="Quotation inputs and conditions" class="hm-rfq rd-wrap rd-section" id="home-rfq" aria-labelledby="home-rfq-title"><header><h2 id="home-rfq-title">Let’s review your part.</h2></header><dl class="hm-orderfacts"><div><dt>Minimum order</dt><dd>From 1 piece</dd></div><div><dt>Reference production window</dt><dd>7–14 business days</dd><p>After drawing and order confirmation, including surface finishing. Shipping time is additional; your quotation confirms the schedule.</p></div></dl><div class="hm-rfq-tasks"><div><h3>Working from a drawing</h3><ul><li>Drawing and revision</li><li>Material and finish</li><li>Quantity and critical features</li><li>Delivery destination</li></ul><div class="hm-rfq-drawing-links"><a class="rd-button" href="/quote/">Prepare RFQ email</a><a class="rd-link" href="/resources/ordering/rfq-checklist/">RFQ checklist</a></div><p class="rd-note">The website prepares a draft. Attach your drawings and send it from your email app.</p></div><div class="hm-rfq-sample"><h3>Starting with a physical part</h3><p>Reconstruction and drawing approval are separate from production.</p><a class="rd-link" href="/capabilities/starting-with-a-sample/">Review the sample-to-drawing process</a><figure class="hm-rfq-visual" data-image-origin="AI-generated"><img src="/media/image-led-20261015/definition-1200.webp" srcset="/media/image-led-20261015/definition-480.webp 480w, /media/image-led-20261015/definition-800.webp 800w, /media/image-led-20261015/definition-1200.webp 1200w" sizes="(max-width:767px) calc(100vw - 40px), 420px" width="1200" height="800" alt="AI illustration of a physical component alongside a model and drawing, showing the information to agree before machining" loading="lazy"/><figcaption>Model, drawing and part definition · AI illustration</figcaption></figure></div></div></section>
</div>
