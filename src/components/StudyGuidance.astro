---
import type {EngineeringCase} from '../data/cases';
interface Props {item:EngineeringCase}
const {item}=Astro.props;
const capabilityNames:Record<string,string>={'cnc-milling-service':'CNC milling','cnc-turning-service':'CNC turning','5-axis-cnc-machining':'5-axis machining','plastic-machined-parts':'Plastic machining','aluminum-cnc-parts':'Aluminum machining'};
const capability=item.relatedCapabilities.find(slug=>capabilityNames[slug]);
const guide=item.collection?['Specify material and finish','/resources/technical-guides/material-and-finish-checklist/']:['Specify critical drawing features','/resources/technical-guides/critical-features-cnc-drawing/'];
---
<nav class="study-guidance" aria-label="Guidance for a similar part">
 <h2>Plan a similar part</h2>
 <div><a href={guide[1]}>{guide[0]}</a><a href="/resources/ordering/machined-prototype-approval-checklist/">Plan sample acceptance</a>{capability&&<a href={'/capabilities/'+capability+'/'}>{capabilityNames[capability]}</a>}</div>
</nav>
<style>
 .study-guidance{margin-block:48px;padding-top:32px;border-top:1px solid var(--border)}
 .study-guidance h2{margin:0 0 24px}
 .study-guidance>div{display:flex;flex-wrap:wrap;gap:12px 16px}
 .study-guidance a{display:inline-flex;align-items:center;min-height:44px;padding:10px 16px;border:1px solid #bfc3c5;border-radius:4px;color:var(--ink);text-decoration:none;font-size:15px;line-height:1.5}
 .study-guidance a:hover{background:#f2f3f3;border-color:var(--ink)}
 .study-guidance a:focus-visible{outline:2px solid var(--red);outline-offset:4px}
</style>
