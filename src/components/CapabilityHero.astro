---
import CapabilityArtwork from './CapabilityArtwork.astro';
import type {CapabilityPageData} from '../data/capabilityDesign';
interface Props {page:CapabilityPageData}
const {page}=Astro.props;
const {plan,design,content,turning,sample}=page;
---
<section class:list={['cd-hero','cd-hero--'+design.hero]} aria-labelledby={turning?'turning-title':'service-title'}>
 <header><h1 id={turning?'turning-title':'service-title'}>{plan.title}</h1><p class="cd-lead">{design.lead}</p><p>{page.reading?.description||content.description}</p><nav class="cd-hero-actions" aria-label="Explore this service"><a class="cd-link" href={sample?'#sample-review':design.modules[0]==='materials'?'#materials-finishes':design.modules[0]==='parts'?'#part-examples':'#engineering-fit'}>{sample?'Start with your sample':page.reading?'Explore part examples':design.modules[0]==='materials'?'Review material choices':design.modules[0]==='parts'?'Explore the part forms':'Review the requirements'}</a></nav></header>
 <CapabilityArtwork art={page.heroArt} eager class="cd-hero-art"/>
 <div class="cd-order-note"><p><strong>From 1 piece.</strong> Production: 7–14 business days after drawing and order confirmation, including finishing. Shipping is additional.{sample&&' Reconstruction and drawing-approval timing are agreed separately.'}</p></div>
</section>
