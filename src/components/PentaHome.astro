---
import EvidenceImage from './EvidenceImage.astro';
import EditorialImage from './EditorialImage.astro';
import {siteImage} from '../data/siteImages';
import {partVisual} from '../data/productsEditorial';
import {refreshedHomeImage} from '../data/imageRefresh';
import {libraryGuide} from '../data/resourceLibrary';
import {resourceCovers} from '../data/pentaInteriors';
import catalog from '../data/catalog.json';
import {ArrowRight,Drill,RotateCw,ScanLine,ClipboardCheck,Ruler,MessagesSquare,Check} from 'lucide-react';

const part=(slug:string)=>{const item=catalog.products.find(p=>p.slug===slug)!;const image=partVisual(item);return {slug,...image,...refreshedHomeImage(image.src)};};
const forms=[
 {title:'Machined impellers',...part('ultra-high-precision-machining-services')},
 {title:'Cast housings',...part('oem-precision-cnc-machined-casting-housing-structural-enclosures')},
 {title:'Turned components',...part('precision-stainless-steel-indexing-plunger-manufacturer-and-spring-loaded-locking-pin-supplier')},
 {title:'Plastic components',...part('precision-cnc-machining-for-complex-plastic-geometries-and-tight-tolerances')},
 {title:'Multi-sided parts',...part('global-manufacturer-of-multi-sided-precision-machined-components')},
];
const services=[
 {name:'CNC milling',href:'/capabilities/cnc-milling-service/',text:'Pockets, flat faces, bores and hole patterns in custom blocks, brackets and housings.',Icon:Drill},
 {name:'CNC turning',href:'/capabilities/cnc-turning-service/',text:'Shafts, sleeves and fittings with stepped diameters, internal bores and threads.',Icon:RotateCw},
 {name:'5-axis machining',href:'/capabilities/5-axis-cnc-machining/',text:'Angled faces and curved contours, with tool access and setup requirements reviewed for your drawing.',Icon:ScanLine},
];
const support=[
 {name:'Drawing review before production',text:'We check the model and drawing revision, material grade, finish and critical features before production.',Icon:ClipboardCheck},
 {name:'Inspection for your requirements',text:'We agree the acceptance criteria, measurement methods, sampling and records your order needs.',Icon:Ruler},
 {name:'From prototype to repeat orders',text:'Repeat orders use the approved drawing, first-article decision and production requirements from the previous release.',Icon:MessagesSquare},
];
const stages=['Drawing and requirements review','Quotation and order confirmation','Sample or first-article approval, where agreed','Machining and surface finishing','Inspection, protection and packing','Delivery and repeat-order review'];
const studies=[
 {title:'One part, two milling setups',image:'two-stage-first',href:'/machined-parts/machining-examples/two-stage-cnc-milling/',text:'Establish locating faces, then use them for the second operation.'},
 {title:'A 29-inch display housing',image:'display-housing-machining',href:'/machined-parts/machining-examples/29-inch-display-housing-cnc-machining/',text:'See the support and tool access used for a broad display-housing panel.'},
 {title:'Turning followed by milling',image:'turn-mill-operation',href:'/machined-parts/machining-examples/turning-then-milling-cylindrical-parts/',text:'See how milled features relate to the turned axis of a cylindrical part.'},
];
const materialLinks=[
 {title:'Aluminum',href:'/capabilities/aluminum-cnc-parts/',image:siteImage('service-aluminum')},
 {title:'Stainless steel',href:'/capabilities/stainless-steel-cnc-parts/',image:siteImage('service-stainless')},
 {title:'Brass & copper',href:'/capabilities/copper-brass-cnc-parts/',image:siteImage('service-brass')},
 {title:'Engineering plastics',href:'/capabilities/plastic-machined-parts/',image:siteImage('service-polymer')},
];
const resources=[
 {guide:libraryGuide('rfq-checklist'),label:'RFQ & ordering',image:resourceCovers['rfq-checklist']},
 {guide:libraryGuide('cnc-process-selection'),label:'Technical guide',image:resourceCovers['cnc-process-selection']},
 {guide:libraryGuide('material-and-finish-checklist'),label:'Technical guide',image:resourceCovers['material-and-finish-checklist']},
];
const faq=[
 {question:'Can I order a single part?',answer:'Yes. Orders start from 1 piece. Send the current drawing, material, finish and quantity for a manufacturing review and quotation.'},
 {question:'What should I include in an RFQ?',answer:'Include the drawing and revision, a 3D model where available, material grade and condition, finish, quantity, critical features, inspection records and delivery destination. Identify any requirements that are still undecided.'},
 {question:'How long does production take?',answer:'Production takes 7-14 business days after drawing and order confirmation, including surface finishing. Shipping time is additional. The quotation sets the schedule for your quantity and requirements; sample reconstruction and drawing approval are separate stages.'},
 {question:'How are inspection requirements agreed?',answer:'We agree critical dimensions, acceptance criteria, measurement methods, sampling and records for your order. State each critical tolerance on the controlling drawing, since achievable limits vary by feature and part.'},
 {question:'Can you work from a physical sample?',answer:'Yes, we can start the review from a sample. Wear, hidden features, material and functional requirements may need further work before you approve the model and drawing. Reconstruction and drawing approval are agreed separately from production.'},
];
---
<div class="lp-home">
 <section class="lp-hero" aria-labelledby="home-title" data-home-module="hero">
  <div class="lp-container"><div class="lp-hero-copy">
   <h1 id="home-title">Custom CNC machining<br/>Made to your drawing</h1>
   <p class="lp-hero-lead">From prototypes to small production runs.</p>
   <div class="lp-actions"><a class="lp-button" href="/quote/">Request a quote</a><a class="lp-button lp-button-outline" href="/capabilities/">Discover our capabilities</a></div>
   <p class="lp-hero-credentials"><a href="/about/company-profile/#quality-system">ISO 9001 certified</a><span>Hangzhou, China</span><span>Established in 2017</span></p>
  </div></div>
  <figure class="lp-hero-photo"><EditorialImage image={siteImage('home-immersive-cnc')} eager sizes="(max-width:767px) max(100vw, 56.25svh), max(100vw, 177.7svh)"/></figure>
 </section>
 <aside class="lp-facts lp-container" aria-label="LZZ company facts" data-home-module="facts"><dl><div><dt>Established in Hangzhou</dt><dd>2017</dd></div><div><dt>Production facility</dt><dd>1,500 m²</dd></div><div><dt>Machining &amp; supporting units</dt><dd>40+</dd></div><div><dt>Minimum order quantity</dt><dd>From 1 piece</dd></div></dl></aside>
 <div class="lp-content">
  <section class="lp-feature lp-container" aria-labelledby="home-drawing-title" data-home-module="drawing"><figure class="lp-feature-photo"><EditorialImage image={siteImage('home-drawing-review')} sizes="(max-width:767px) calc(100vw - 40px), 570px"/></figure><div class="lp-feature-copy"><p class="lp-label">Your part</p><h2 id="home-drawing-title">From your drawing<br/>to a machining plan</h2><p>We review the surfaces and dimensions that locate your part and control its fit in the assembly.</p><p>Send the current model and drawing revision with the critical dimensions and finish requirements. We resolve machining and inspection questions with you before quotation and production release.</p><ul class="lp-keywords"><li>Geometry</li><li>Material &amp; finish</li><li>Acceptance</li></ul></div></section>
  <section class="lp-feature lp-feature-reversed lp-container" aria-labelledby="home-approach-title" data-home-module="approach"><div class="lp-feature-copy"><p class="lp-label">Our approach</p><h2 id="home-approach-title">Custom parts,<br/>made in <span>Hangzhou</span></h2><p>Established in 2017, LZZ Precision supplies custom machined parts from Hangzhou.</p><p>Our work covers milling, turning and 5-axis machining for prototypes and small production runs. We plan it around your material, finish, critical features and inspection requirements.</p><a class="lp-button lp-button-light" href="/about/">About LZZ</a><p class="lp-certification"><Check size={20} aria-hidden="true"/><span>ISO 9001 certified<br/><a href="/about/company-profile/#quality-system">Request the current certificate and scope</a></span></p></div><div class="lp-approach-media"><figure class="lp-feature-photo"><EditorialImage image={siteImage('home-setup')} sizes="(max-width:767px) calc(100vw - 40px), 570px"/></figure><aside class="lp-drawing-card"><ClipboardCheck size={30} aria-hidden="true"/><h3>Your drawing is the production baseline</h3><p>Revision, material, critical features and agreed inspection records.</p><a href="/about/how-we-work/">How we work <ArrowRight size={17} aria-hidden="true"/></a></aside></div></section>
  <section class="lp-container lp-services" id="capabilities" aria-labelledby="home-services-title" data-home-module="services"><header class="lp-section-head"><h2 id="home-services-title">Our machining services</h2><a class="lp-button lp-button-light" href="/capabilities/">View all capabilities</a></header><div class="lp-service-grid">{services.map(({name,href,text,Icon})=><a class="lp-service-card" href={href}><div class="lp-card-icons"><Icon size={40} strokeWidth={1.35} aria-hidden="true"/><span class="lp-round-arrow"><ArrowRight size={19} aria-hidden="true"/></span></div><h3>{name}</h3><p>{text}</p></a>)}</div></section>
  <section class="lp-highlight lp-wide" aria-labelledby="home-support-title" data-home-module="support"><div class="lp-highlight-image"><EditorialImage image={siteImage('home-tooling')} sizes="(max-width:767px) calc(100vw - 40px), 1280px"/></div><div class="lp-highlight-content"><p class="lp-label">Why work with LZZ</p><h2 id="home-support-title">Practical support<br/>for <span>your next part</span></h2><div class="lp-highlight-intro"><a class="lp-button" href="/factory/">Explore factory &amp; quality</a><p>We review the drawing with you before quoting, including the machining scope, delivery requirements and acceptance checks.</p></div><div class="lp-support-grid">{support.map(({name,text,Icon})=><article><Icon size={34} strokeWidth={1.35} aria-hidden="true"/><h3>{name}</h3><p>{text}</p></article>)}</div></div></section>
  <section class="lp-container lp-part-section" id="selected-parts" aria-labelledby="home-parts-title" data-home-module="parts"><header class="lp-section-head"><h2 id="home-parts-title">Parts we machine</h2><a class="lp-button lp-button-light" href="/machined-parts/gallery/">View all 35 references</a></header><div class="lp-rail-wrap"><div class="lp-part-rail" id="home-part-rail" data-home-rail>{forms.map(item=><a class="lp-part-tile" href={'/machined-parts/gallery/'+item.slug+'/'}><img src={item.src} srcset={item.srcset} sizes="260px" width={item.width} height={item.height} alt={item.alt} data-image-origin={item.origin} loading="lazy" decoding="async"/><h3>{item.title}</h3><span class="lp-round-arrow"><ArrowRight size={18} aria-hidden="true"/></span></a>)}</div><button class="lp-rail-next" type="button" aria-label="Next part references" aria-controls="home-part-rail" data-rail-next="home-part-rail"><ArrowRight size={22} aria-hidden="true"/></button></div></section>
  <section class="lp-process lp-container" aria-labelledby="home-process-title" data-home-module="process"><div><p class="lp-label">Working with LZZ</p><h2 id="home-process-title">From the drawing<br/>to <span>your next order</span></h2><ol>{stages.map(stage=><li>{stage}</li>)}</ol><a class="lp-button lp-button-light" href="/about/how-we-work/">See the full process</a></div><figure><EditorialImage image={siteImage('home-inspection')} sizes="(max-width:767px) calc(100vw - 80px), 440px"/></figure></section>
  <section class="lp-container" aria-labelledby="home-studies-title" data-home-module="studies"><header class="lp-section-head"><h2 id="home-studies-title">See the machining behind the part</h2><a class="lp-button lp-button-light" href="/machined-parts/machining-examples/">View machining examples</a></header><div class="lp-study-grid">{studies.map(study=><a class="lp-study-card" href={study.href}><EvidenceImage id={study.image} sizes="(max-width:767px) calc(100vw - 40px), 365px"/><div><h3>{study.title}</h3><p>{study.text}</p><span>Read the machining study <ArrowRight size={16} aria-hidden="true"/></span></div></a>)}</div></section>
  <section class="lp-container" aria-labelledby="home-materials-title" data-home-module="materials"><header class="lp-section-head"><h2 id="home-materials-title">Materials we machine</h2><a class="lp-button lp-button-light" href="/capabilities/#materials">Explore materials</a></header><div class="lp-material-grid">{materialLinks.map(item=><a href={item.href}><img src={item.image.src} srcset={item.image.srcset} sizes="(max-width:767px) 45vw, 270px" width={item.image.width} height={item.image.height} alt={item.image.alt} data-image-origin={item.image.origin} loading="lazy" decoding="async"/><h3>{item.title}</h3><span class="lp-round-arrow"><ArrowRight size={18} aria-hidden="true"/></span></a>)}</div><p class="lp-material-note">Specify the exact grade, stock condition and finish.</p></section>
  <section class="lp-contact lp-wide" id="home-rfq" aria-labelledby="home-rfq-title" data-home-module="contact"><div><p class="lp-label">Contact us</p><h2 id="home-rfq-title">Ready to discuss<br/><span>your next part?</span></h2><p>Send the drawing, material, finish, quantity and destination. Tell us which features and inspection records matter to your order.</p><div class="lp-actions"><a class="lp-button" href="/quote/">Request a quote</a><a class="lp-button lp-button-outline" href="/about/contact/">Contact LZZ</a></div><p class="lp-contact-note">Prepare a draft here, then attach your drawings and send it from your email app.</p></div><figure><EditorialImage image={siteImage('home-project-support')} sizes="(max-width:767px) calc(100vw - 80px), 480px"/></figure></section>
  <section class="lp-container" aria-labelledby="home-resources-title" data-home-module="resources"><header class="lp-section-head"><h2 id="home-resources-title">Manufacturing resources</h2><a class="lp-button lp-button-light" href="/resources/">View all resources</a></header><div class="lp-resource-grid">{resources.map(({guide,label,image})=><a class="lp-resource-card" href={guide.href}><img src={image.src} srcset={image.srcset} sizes="(max-width:767px) calc(100vw - 40px), (max-width:1200px) 30vw, 365px" width={image.width} height={image.height} alt={image.alt} data-image-origin={image.origin} loading="lazy" decoding="async"/><div><p class="lp-card-label">{label}</p><h3>{guide.title}</h3><p>{guide.summary}</p></div></a>)}</div></section>
  <section class="lp-faq lp-container" aria-labelledby="home-faq-title" data-home-module="faq"><h2 id="home-faq-title">Frequently asked questions</h2><div>{faq.map(({question,answer})=><details><summary>{question}<span aria-hidden="true"></span></summary><p>{answer}</p></details>)}</div><a href="/resources/faq/">View all purchasing questions <ArrowRight size={16} aria-hidden="true"/></a></section>
 </div>
 <section class="lp-footer-intro" aria-label="Prepare a machining inquiry"><h2>Ready to discuss your CNC machined parts?</h2><a class="lp-button" href="/quote/">Request a quote</a></section>
</div>
<script>
 document.querySelectorAll<HTMLButtonElement>('[data-rail-next]').forEach(button=>{
  const rail=document.getElementById(button.dataset.railNext||'');
  if(!rail)return;
  const update=()=>{const atEnd=rail.scrollLeft+rail.clientWidth>=rail.scrollWidth-3;button.dataset.direction=atEnd?'previous':'next';button.setAttribute('aria-label',atEnd?'Previous part references':'Next part references');};
  button.addEventListener('click',()=>{const back=button.dataset.direction==='previous';rail.scrollBy({left:(back?-1:1)*rail.clientWidth*.75,behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth'});});
  rail.addEventListener('scroll',update,{passive:true});update();
 });
</script>

