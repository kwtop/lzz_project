---
import EvidenceImage from './EvidenceImage.astro';
import EditorialImage from './EditorialImage.astro';
import {siteImage} from '../data/siteImages';
import {heroImageSizes} from '../lib/heroImageSizing';
import {partVisual} from '../data/productsEditorial';
import {refreshedHomeImage} from '../data/imageRefresh';
import {libraryGuide} from '../data/resourceLibrary';
import catalog from '../data/catalog.json';
import {ArrowRight,Drill,RotateCw,ScanLine,ClipboardCheck,Ruler,Boxes,Camera,Layers,BookOpen} from 'lucide-react';

const part=(slug:string)=>{const item=catalog.products.find(p=>p.slug===slug)!;const image=partVisual(item);return {slug,...image,...refreshedHomeImage(image.src)};};
const forms=[
 {title:'Precision aluminum housings',...part('precision-small-batch-cnc-milling-manufacturer-for-complex-aluminum-enclosures')},
 {title:'Complex 5-axis parts',...part('ultra-high-precision-machining-services')},
 {title:'Instrument & automation parts',...part('custom-oem-high-precision-cnc-milling-manufacturer')},
 {title:'Turned & milled components',...part('custom-oem-cnc-turning-manufacturer')},
];
const services=[
 {name:'5-axis machining',href:'/capabilities/5-axis-cnc-machining/',text:'Angled faces and curved contours, with tool access and setup requirements reviewed for your drawing.',Icon:ScanLine},
 {name:'CNC milling',href:'/capabilities/cnc-milling-service/',text:'Pockets, flat faces, bores and hole patterns in custom blocks, brackets and housings.',Icon:Drill},
 {name:'CNC turning',href:'/capabilities/cnc-turning-service/',text:'Shafts, sleeves and fittings with stepped diameters, internal bores and threads.',Icon:RotateCw},
];
const support=[
 {name:'Critical dimensions',text:'We check fitted dimensions and hole positions from the drawing datums.',Icon:Ruler},
 {name:'Measurement methods',text:'CMM, height gauges and optical measurement are selected to suit the feature and its specified limits.',Icon:ScanLine},
 {name:'Inspection records',text:'We agree which features to inspect, how many parts to check and which reports to provide.',Icon:ClipboardCheck},
];
const quickLinks=[
 {label:'Parts gallery',href:'/machined-parts/gallery/',Icon:Boxes},
 {label:'Machining examples',href:'/machined-parts/machining-examples/',Icon:Camera},
 {label:'Capabilities',href:'/capabilities/',Icon:Drill},
 {label:'Materials',href:'/capabilities/#materials',Icon:Layers},
 {label:'Technical guides',href:'/resources/technical-guides/',Icon:BookOpen},
];
const stages=['Drawing and requirements review','Quotation and order confirmation','Sample or first-article approval, where agreed','Machining and surface finishing','Inspection and reporting as agreed, followed by packing','Delivery and repeat-order review'];
const studies=[
 {title:'5-axis machining of a multi-face part',image:'five-axis-machine-wide',href:'/machined-parts/machining-examples/five-axis-machining-multi-face-parts/',text:'Rotary workholding gives the cutter access to features on different faces.'},
 {title:'A 29-inch display housing',image:'display-housing-machining',href:'/machined-parts/machining-examples/29-inch-display-housing-cnc-machining/',text:'How a broad display-housing panel is supported and reached during machining.'},
 {title:'Turning followed by milling',image:'turn-mill-operation',href:'/machined-parts/machining-examples/turning-then-milling-cylindrical-parts/',text:'How flats, holes and other milled features relate to a cylindrical part’s turned axis.'},
];
const materialLinks=[
 {title:'Aluminum',href:'/capabilities/aluminum-cnc-parts/',image:siteImage('service-aluminum')},
 {title:'Stainless steel',href:'/capabilities/stainless-steel-cnc-parts/',image:siteImage('service-stainless')},
 {title:'Brass & copper',href:'/capabilities/copper-brass-cnc-parts/',image:siteImage('service-brass')},
 {title:'Engineering plastics',href:'/capabilities/plastic-machined-parts/',image:siteImage('service-polymer')},
];
const resources=[
 {guide:libraryGuide('rfq-checklist')},
 {guide:libraryGuide('cnc-process-selection')},
 {guide:libraryGuide('material-and-finish-checklist')},
];
const faq=[
 {question:'Can I order a single part?',answer:'Yes. Orders start from 1 piece. A drawing, material, finish and quantity help us price the work.'},
 {question:'What should I include in an RFQ?',answer:'Include the drawing and revision, a 3D model where available, material grade and condition, finish, quantity, critical features, inspection records and delivery destination. Identify any requirements that are still undecided.'},
 {question:'How long does production take?',answer:'Production takes 7–14 business days after drawing and order confirmation, including surface finishing. Shipping time is additional. The quotation sets the schedule for your quantity and requirements; sample reconstruction and drawing approval are separate stages.'},
 {question:'How are inspection requirements agreed?',answer:'The drawing identifies critical dimensions and their limits. We settle the measurement methods, sampling and records with you before production; achievable tolerances vary by feature and part.'},
 {question:'Can you work from a physical sample?',answer:'Yes. A sample can be the starting point. Wear, hidden features, material and function may need investigation before you approve the model and drawing. Reconstruction and drawing approval are separate from production.'},
];
---
<div class="lp-home">
 <section class="lp-hero" aria-labelledby="home-title" data-home-module="hero">
  <div class="lp-container"><div class="lp-hero-copy">
   <h1 id="home-title">Precision CNC Machining<br class="lp-desktop-break"/> for Complex Custom Parts</h1>
   <p class="lp-hero-lead">3-Axis, 4-Axis &amp; 5-Axis Machining<span>Prototypes &amp; Low-Volume Production</span></p>
   <div class="lp-actions"><a class="lp-button" href={'/quote/?'+new URLSearchParams({source:Astro.url.pathname}).toString()}>Upload Drawings &amp; Request a Quote</a><a class="lp-button lp-button-outline" href="/machined-parts/machining-examples/">View Machining Examples</a></div>
   <p class="lp-hero-credentials"><span>ISO 9001 certified</span><span>From 1 Piece</span><span class="lp-hero-leadtime">Production: 7–14 business days</span></p>
  </div></div>
  <figure class="lp-hero-photo"><EditorialImage image={siteImage('home-immersive-cnc')} eager sizes={heroImageSizes(siteImage('home-immersive-cnc'))}/></figure>
 </section>
 <aside class="lp-facts lp-container" aria-label="LZZ machining and factory facts" data-home-module="facts">
  <dl>
   <div><dt>Alongside 3- &amp; 4-axis machining</dt><dd>5-axis</dd></div>
   <div><dt>Machining &amp; supporting units</dt><dd>40+</dd></div>
   <div><dt>Production facility in Hangzhou</dt><dd>1,500 m²</dd></div>
   <div><dt>Dimensional inspection</dt><dd>CMM</dd></div>
   <div><dt>Tolerance reference</dt><dd>±0.01 mm</dd></div>
  </dl>
 </aside>
 <nav class="lp-quick lp-container" aria-label="Quick links" data-home-module="quick-links"><ul>{quickLinks.map(({label,href,Icon})=><li><a href={href}><Icon size={22} strokeWidth={1.6} aria-hidden="true"/><span>{label}</span><ArrowRight className="lp-quick-arrow" size={16} aria-hidden="true"/></a></li>)}</ul></nav>
 <div class="lp-content">
  <section class="lp-container lp-part-section" id="selected-parts" aria-labelledby="home-parts-title" data-home-module="parts"><header class="lp-section-head"><h2 id="home-parts-title">Precision parts for<br/>equipment manufacturers</h2><a class="lp-button lp-button-light" href="/machined-parts/gallery/">View all 35 references</a></header><div class="lp-rail-wrap"><div class="lp-part-rail" id="home-part-rail" data-home-rail>{forms.map(item=><a class="lp-part-tile" href={'/machined-parts/gallery/'+item.slug+'/'}><img src={item.src} srcset={item.srcset} sizes="(max-width:767px) 245px, 260px" width={item.width} height={item.height} alt={item.alt} data-image-origin={item.origin} loading="lazy" decoding="async"/><h3>{item.title}</h3></a>)}</div><button class="lp-rail-next" type="button" aria-label="Next part references" aria-controls="home-part-rail" data-rail-next="home-part-rail"><ArrowRight size={22} aria-hidden="true"/></button></div></section>
  <section class="lp-highlight lp-wide" aria-labelledby="home-inspection-title" data-home-module="inspection"><div class="lp-inspection-head"><div><h2 id="home-inspection-title">CMM &amp; dimensional<br/><span>inspection</span></h2><a class="lp-button" href="/factory/#quality">Explore inspection &amp; quality</a></div><figure class="lp-inspection-photo"><EditorialImage image={siteImage('inspection-room')} sizes="(max-width:767px) calc(100vw - 88px), (max-width:1099px) 40vw, 600px"/></figure></div><div class="lp-support-grid">{support.map(({name,text,Icon})=><article><Icon size={34} strokeWidth={1.35} aria-hidden="true"/><h3>{name}</h3><p>{text}</p></article>)}</div></section>
  <section class="lp-container" aria-labelledby="home-studies-title" data-home-module="studies"><header class="lp-section-head"><h2 id="home-studies-title">See the machining behind the part</h2><a class="lp-button lp-button-light" href="/machined-parts/machining-examples/">View machining examples</a></header><div class="lp-study-grid">{studies.map(study=><a class="lp-study-card" href={study.href}><EvidenceImage id={study.image} sizes="(max-width:767px) calc(100vw - 40px), 365px"/><div><h3>{study.title}</h3><p>{study.text}</p></div></a>)}</div></section>
  <section class="lp-container lp-services" id="capabilities" aria-labelledby="home-services-title" data-home-module="services"><header class="lp-section-head"><h2 id="home-services-title">Machining routes<br/>for your drawing</h2><a class="lp-button lp-button-light" href="/capabilities/">View all capabilities</a></header><div class="lp-service-grid">{services.map(({name,href,text,Icon})=><a class="lp-service-card" href={href}><div class="lp-card-icons"><Icon size={40} strokeWidth={1.35} aria-hidden="true"/><span class="lp-round-arrow"><ArrowRight size={19} aria-hidden="true"/></span></div><h3>{name}</h3><p>{text}</p></a>)}</div></section>
  <section class="lp-container" aria-labelledby="home-materials-title" data-home-module="materials"><header class="lp-section-head"><h2 id="home-materials-title">Materials we machine</h2><a class="lp-button lp-button-light" href="/capabilities/#materials">Explore materials</a></header><div class="lp-material-grid">{materialLinks.map(item=><a href={item.href}><img src={item.image.src} srcset={item.image.srcset} sizes="(max-width:767px) 45vw, 270px" width={item.image.width} height={item.image.height} alt={item.image.alt} data-image-origin={item.image.origin} loading="lazy" decoding="async"/><h3>{item.title}</h3><span class="lp-round-arrow"><ArrowRight size={18} aria-hidden="true"/></span></a>)}</div></section>
  <section class="lp-process lp-container" aria-labelledby="home-process-title" data-home-module="process"><div><h2 id="home-process-title">From the drawing<br/>to <span>your next order</span></h2><ol>{stages.map(stage=><li>{stage}</li>)}</ol><a class="lp-button lp-button-light" href="/about/how-we-work/">See the full process</a></div><figure><EditorialImage image={siteImage('home-drawing-review')} sizes="(max-width:767px) calc(100vw - 80px), 440px"/></figure></section>
  <section class="lp-contact lp-wide" id="home-rfq" aria-labelledby="home-rfq-title" data-home-module="contact"><div class="lp-contact-inner"><div><h2 id="home-rfq-title">Ready to discuss<br/><span>your next part?</span></h2><div class="lp-actions"><a class="lp-button" href={'/quote/?'+new URLSearchParams({source:Astro.url.pathname}).toString()}>Upload Drawings &amp; Request a Quote</a><a class="lp-button lp-button-outline" href="/about/contact/">Contact LZZ</a></div><p class="lp-contact-note">We send a first reply within 12 hours.</p></div><figure><EditorialImage image={siteImage('home-project-support')} sizes="(max-width:767px) calc(100vw - 80px), 480px"/></figure></div></section>
  <section class="lp-container" aria-labelledby="home-resources-title" data-home-module="resources"><header class="lp-section-head"><h2 id="home-resources-title">Manufacturing resources</h2><a class="lp-button lp-button-light" href="/resources/">View all resources</a></header><ul class="lp-resource-links">{resources.map(({guide})=><li><a href={guide.href}><h3>{guide.title}</h3><ArrowRight size={20} aria-hidden="true"/></a></li>)}</ul></section>
  <section class="lp-faq lp-container" aria-labelledby="home-faq-title" data-home-module="faq"><h2 id="home-faq-title">Frequently asked questions</h2><div>{faq.map(({question,answer})=><details><summary>{question}<span aria-hidden="true"></span></summary><p>{answer}</p></details>)}</div><a href="/resources/faq/">View all purchasing questions <ArrowRight size={16} aria-hidden="true"/></a></section>
 </div>
</div>
<script>
 document.querySelectorAll<HTMLButtonElement>('[data-rail-next]').forEach(button=>{
  const rail=document.getElementById(button.dataset.railNext||'');
  if(!rail)return;
  const update=()=>{button.hidden=rail.scrollWidth<=rail.clientWidth+3;const atEnd=rail.scrollLeft+rail.clientWidth>=rail.scrollWidth-3;button.dataset.direction=atEnd?'previous':'next';button.setAttribute('aria-label',atEnd?'Previous part references':'Next part references');};
  button.addEventListener('click',()=>{const back=button.dataset.direction==='previous';rail.scrollBy({left:(back?-1:1)*rail.clientWidth*.75,behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth'});});
  rail.addEventListener('scroll',update,{passive:true});new ResizeObserver(update).observe(rail);update();
 });
</script>
