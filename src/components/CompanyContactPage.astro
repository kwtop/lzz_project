---
import ContactIcon from './ContactIcon.astro';
import RfqPanel from './RfqPanel.astro';
import '../styles/company-resource-gallery.css';
import '../styles/content-editorial.css';
import ContentFigure from './ContentFigure.astro';
import Layout from '../layouts/Layout.astro';
const qualificationHref='mailto:roger@lzz-cnc.com?subject='+encodeURIComponent('Supplier qualification documents')+'&body='+encodeURIComponent('Please send the current ISO 9001 certificate and scope for Hangzhou Lizhizao Precision Machinery Co., Ltd.\n\nProject / part reference:\nOther documents required:');
const visitHref='mailto:roger@lzz-cnc.com?subject='+encodeURIComponent('Workshop visit enquiry')+'&body='+encodeURIComponent('I would like to arrange a visit to your Hangzhou workshop.\n\nCompany:\nPreferred dates:\nParts or processes to discuss:');
---
<Layout title="Contact LZZ Precision" description="Contact LZZ Precision in Hangzhou by email or WhatsApp. Find our factory address and prepare a quote request with your drawing, material and quantity." cta={false}>
 <div class="container contact-page">
  
  <header class="contact-hero"><div><h1>Contact LZZ</h1></div><ContentFigure visual="drawing" eager/></header>
  <div class="contact-grid">
   <section aria-labelledby="contact-details-title"><h2 id="contact-details-title">Contact details</h2><dl><div><dt>Email</dt><dd><a href="mailto:roger@lzz-cnc.com"><ContactIcon kind="email"/>roger@lzz-cnc.com</a></dd></div><div><dt>WhatsApp</dt><dd><a href="https://wa.me/8613858102479"><ContactIcon kind="phone"/>+86 138 5810 2479</a></dd></div><div><dt>Location &amp; time zone</dt><dd>Hangzhou, China · UTC+8</dd></div></dl></section>
   <RfqPanel title="Request a machining quote" titleId="contact-rfq-title" description="Tell us the material and quantity you need." note="Attach your drawing in your email application so we can review the machining requirements." contained compact/>
  </div>
  <section class="contact-qualification" aria-labelledby="contact-qualification-title"><div><h2 id="contact-qualification-title">Supplier documents</h2><p>Request the current ISO certificate and scope. For part-specific inspection records, tell us which documents your purchasing team needs.</p></div><nav aria-label="Supplier review"><a class="text-link" href={qualificationHref}>Request ISO certificate and scope </a></nav></section>
  <section class="contact-address" aria-labelledby="contact-address-title"><div><h2 id="contact-address-title">Find us in Hangzhou</h2><p>Hangzhou Lizhizao Precision Machinery Co., Ltd.</p></div><div><address>No. 4 Fengcheng Road<br/>Pingyao, Yuhang District<br/>Hangzhou, Zhejiang, China</address><p>Arrange your visit with us before travelling.</p><div class="info-actions"><a class="text-link" href={visitHref}>Arrange a workshop visit </a></div></div></section>
 </div>
</Layout>
<style>
 .contact-page{--page-heading-family:var(--font-contact);--content-title-size:var(--type-contact-title-size);--page-heading-leading:1.08;--page-heading-tracking:-.02em}
 .contact-page :global(.ce-figure img){display:block;width:100%;height:auto;object-fit:contain}.contact-page :global(.ce-figure figcaption){font-size:14px;line-height:1.5;color:var(--muted);margin-top:10px}
 .contact-qualification{display:grid;grid-template-columns:1.2fr 1fr;gap:80px;margin-top:48px;border-top:1px solid var(--border);padding-top:36px}.contact-qualification nav{display:grid;align-content:start;gap:16px}.contact-qualification a{display:inline-flex;align-items:center;gap:12px;min-height:44px;line-height:1.5}
 @media(max-width:760px){.contact-qualification{grid-template-columns:1fr;gap:24px;margin-top:36px;padding-top:28px}}
 .contact-page{padding-block:32px 72px}.contact-page .breadcrumbs{padding:0 0 36px}.contact-page header{max-width:760px;margin-bottom:56px}.contact-page .contact-label{font-size:13px;font-weight:650;color:var(--red);text-transform:uppercase;margin-bottom:18px}:global(body.brand-site) .contact-page h1{font-size:clamp(32px,4vw,52px);line-height:1.07;letter-spacing:-.045em;font-weight:600}.contact-page p{font-size:17px;line-height:1.7;color:var(--muted);max-width:56ch;margin-top:20px}:global(body.brand-site) .contact-page h2{font-size:30px;line-height:1.2;letter-spacing:-.025em;font-weight:550}.contact-grid{display:grid;grid-template-columns:1.2fr 1fr;gap:80px;align-items:start}.contact-grid dl{margin:22px 0 0}.contact-grid dl>div{padding-block:22px;border-top:1px solid var(--border)}.contact-grid dt{font-size:14px;color:var(--muted);margin-bottom:10px}.contact-grid dd{font-size:clamp(18px,2vw,26px);margin:0;line-height:1.4}.contact-grid dd a{display:inline-flex;gap:18px;align-items:center;min-height:44px}.contact-rfq{padding:36px;background:#f0f1f2}.contact-rfq .button{margin-top:24px;gap:18px;border-radius:0}.contact-rfq .contact-note{font-size:14px;line-height:1.7;margin-top:18px}.contact-rfq .text-link{margin-top:22px}.contact-address{display:grid;grid-template-columns:1.2fr 1fr;gap:80px;margin-top:56px;border-top:1px solid var(--border);padding-top:40px}.contact-address address{font-size:21px;line-height:1.7;font-style:normal}.contact-address p{font-size:15px}.contact-address .text-link{margin-top:20px}.contact-page a:focus-visible{outline:2px solid var(--red);outline-offset:5px}@media(max-width:760px){.contact-page{padding-block:24px 44px}.contact-page .breadcrumbs{padding-bottom:28px}.contact-page header{margin-bottom:36px}.contact-grid,.contact-address{grid-template-columns:1fr;gap:28px}.contact-rfq{padding:26px}.contact-address{margin-top:36px;padding-top:32px}}
</style>

