---
import {photo} from '../data/evidence';
import {photoFrame} from '../lib/photoFrame';
import type {InteriorImage} from '../data/pentaInteriors';
import {processDisplay} from '../data/processImageDisplays';
interface Props {id:string;caption?:string;class?:string;eager?:boolean;sizes?:string;frameClass?:string;image?:InteriorImage}
const {id,class:className,eager=false,sizes='(max-width:767px) calc(100vw - 44px), 560px',frameClass,image}=Astro.props;
const original=photo(id),replacement=image||processDisplay(original.src),source=replacement||original;
const displaySizes=replacement?'(max-width:767px) calc(100vw - 40px), (max-width:1200px) 48vw, 560px':sizes;
const frame=await photoFrame(source.src,source.width,source.height);
---
<figure class:list={['cx-evidence',className]} data-photo-id={id} data-image-origin={replacement?.origin||'original-photo'} style={'--cx-photo-ratio:'+frame.width/frame.height}>
 {frameClass?<div class={frameClass}><img src={source.src} srcset={source.srcset} width={frame.width} height={frame.height} sizes={displaySizes} alt={source.alt} loading={eager?'eager':'lazy'} decoding="async"/></div>:<img src={source.src} srcset={source.srcset} width={frame.width} height={frame.height} sizes={displaySizes} alt={source.alt} loading={eager?'eager':'lazy'} decoding="async"/>}
</figure>
