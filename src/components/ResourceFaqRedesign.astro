---


import '../styles/about-approved.css';
import Layout from '../layouts/Layout.astro';
import ReadingIndex from './ReadingIndex.astro';
import {resourceFaqGroups as groups} from '../data/resourceFaq';
import '../styles/resources-approved.css';
import '../styles/resources-constitution.css';
import '../styles/content-image-led.css';
const quoteHref='/quote/?'+new URLSearchParams({part:'Custom CNC machining FAQ follow-up',source:Astro.url.pathname}).toString();
const schema={'@context':'https://schema.org','@type':'FAQPage',mainEntity:groups.flatMap(group=>group.items.map(item=>({'@type':'Question',name:item.question,acceptedAnswer:{'@type':'Answer',text:item.answer}})))};
---
<Layout title="CNC Machining FAQ: Quotes, Tolerances and Inspection" description="CNC machining FAQ covering quote requirements, minimum order, lead time, drawing tolerances, material records, first article inspection and delivery." cta={false}>
 <article class="rs-page rs-faq rs-faq-layout rd-page"><header class="rs-directory-head"><h1>Custom CNC machining FAQs</h1><p>Ordering and engineering answers for custom parts, from the files needed for a quote to the inspection records supplied with the order.</p></header><div class="rs-reading-layout"><ReadingIndex><nav class="rs-reading-nav" aria-label="FAQ topics"><p>Find an answer</p><ol class="pn-link-index pn-link-index--sections">{groups.map(group=><li><a href={'#'+group.id}>{group.title}</a></li>)}</ol></nav></ReadingIndex><div class="rs-reading-content">
  {groups.map((group,groupIndex)=><section class="rs-faq-group" id={group.id} aria-labelledby={group.id+'-title'} data-resource-module data-core-section={group.title}><header class="rs-faq-topic"><h2 id={group.id+'-title'}>{group.title}</h2></header><div class="rs-faq-topic-body"><div class="rs-faq-answers">{group.items.map((item,index)=>{const id=groupIndex===0?(index<4?'ordering-'+(index+1):'commercial-'+(index-3)):group.id==='engineering'?'engineering-'+(index+1):'quality-delivery-'+(index+1);const aliases=groupIndex===0&&index===2?['preparing']:groupIndex===0&&index===4?['commercial-terms','commercial-title']:groupIndex===2&&index===3?['case-studies']:[];return <article class="rs-question" id={id}>{aliases.map(alias=><span class="rs-anchor" id={alias}/>)}<h3 id={groupIndex===2&&index===3?'case-title':undefined}>{item.question}</h3><div class="rs-answer"><p>{item.answer}</p></div></article>;})}</div></div></section>)}
  <section class="rs-closing rs-directory-section" id="prepare-email" data-core-section="Part question and inquiry"><div><span class="rs-anchor" id="manual-rfq-title"/><h2>Have a question about your part?</h2><p>Tell us what you need to know. You can add the current drawing revision if it helps explain the question.</p><p class="rs-note">Leave your name, destination country and preferred contact details. We reply within 12 hours.</p></div><a class="rd-button" href={quoteHref}>Request a quote</a></section>
 </div></div></article>
 <script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\\u003c')}/>
</Layout>
