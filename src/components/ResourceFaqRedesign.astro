---


import '../styles/about-approved.css';
import Layout from '../layouts/Layout.astro';
import {resourceFaqGroups as groups} from '../data/resourceFaq';
import '../styles/resources-approved.css';
import '../styles/resources-constitution.css';
import '../styles/content-image-led.css';
const topicLinks=[
 [['RFQ checklist','/resources/ordering/rfq-checklist/'],['Prototype and repeat orders','/resources/ordering/prototype-vs-small-batch-cnc/'],['Order terms, samples and after-sales','/about/how-we-work/']],
 [['Machining services','/capabilities/'],['Material and finish guide','/resources/technical-guides/material-and-finish-checklist/'],['Tolerance review','/factory/#quality']],
 [['Inspection and delivery records','/factory/#order-documentation'],['ISO 9001 certificate request','/about/company-profile/#quality-system'],['Shipment planning','/resources/ordering/custom-cnc-parts-shipping-checklist/'],['Machining examples','/machined-parts/machining-examples/']],
];
const quoteHref='/quote/?'+new URLSearchParams({part:'Custom CNC machining FAQ follow-up'}).toString();
const schema={'@context':'https://schema.org','@type':'FAQPage',mainEntity:groups.flatMap(group=>group.items.map(item=>({'@type':'Question',name:item.question,acceptedAnswer:{'@type':'Answer',text:item.answer}})))};
---
<Layout title="CNC machining FAQ" description="Quick answers about CNC machining quotes, minimum order, timing, specifications, inspection and delivery, with links to the detailed requirements." cta={false}>
 <article class="rs-page rs-faq rs-faq-layout rd-page"><header class="rs-directory-head"><h1>Custom CNC machining FAQs</h1><p>Answers to common questions about quantities, drawings, inspection and delivery.</p></header><div class="rs-reading-layout"><nav class="rs-reading-nav" aria-label="FAQ topics"><p>Find an answer</p><ol class="pn-link-index pn-link-index--sections">{groups.map(group=><li><a href={'#'+group.id}>{group.title}</a></li>)}</ol></nav><div class="rs-reading-content">
  {groups.map((group,groupIndex)=><section class="rs-faq-group" id={group.id} aria-labelledby={group.id+'-title'} data-resource-module data-core-section={group.title}><header class="rs-faq-topic"><h2 id={group.id+'-title'}>{group.title}</h2></header><div class="rs-faq-topic-body"><div class="rs-faq-answers">{group.items.map((item,index)=>{const id=groupIndex===0?(index<4?'ordering-'+(index+1):'commercial-'+(index-3)):group.id==='engineering'?'engineering-'+(index+1):'quality-delivery-'+(index+1);const aliases=groupIndex===0&&index===2?['preparing']:groupIndex===0&&index===4?['commercial-terms','commercial-title']:groupIndex===2&&index===3?['case-studies']:[];return <article class="rs-question" id={id}>{aliases.map(alias=><span class="rs-anchor" id={alias}/>)}<h3 id={groupIndex===2&&index===3?'case-title':undefined}>{item.question}</h3><div class="rs-answer"><p>{item.answer}</p></div></article>;})}</div></div><nav class="rs-topic-links rs-links pn-link-index" aria-label={group.title+' detailed guides'}>{topicLinks[groupIndex].map(([label,href])=><a href={href}>{label}</a>)}</nav></section>)}
  <section class="rs-closing rs-directory-section" id="prepare-email" data-core-section="Question and RFQ draft"><div><span class="rs-anchor" id="manual-rfq-title"/><h2>Have a question about your part?</h2><p>Send the current drawing revision and the question you would like us to review.</p><p class="rs-note">Review the email draft, attach drawings and send it from your email app.</p></div><a class="rd-button" href={quoteHref}>Request a quote</a></section>
 </div></div></article>
 <script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\\u003c')}/>
</Layout>
