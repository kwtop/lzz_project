---
const {title='Discuss your drawing with LZZ',text='Share the drawing revision, material and quantity if available, with any features or records needed for acceptance.',qualification=false,core=undefined}=Astro.props;
import {qualificationEmail} from '../data/aboutEditorial';
---
<section class="ar-closing rd-section" aria-label="Next step" data-core-section={core}>
 <div><h2>{title}</h2><p>{text}</p><p class="ar-note">Tell us your name, destination country and how to reach you. We reply within 12 hours.</p></div>
 <div class="ar-closing-actions"><a class="rd-button" href={'/quote/?'+new URLSearchParams({source:Astro.url.pathname}).toString()}>Request a quote</a>{qualification&&<a href={qualificationEmail}>Request supplier documents</a>}</div>
</section>
