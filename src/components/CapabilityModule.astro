---
import type {CapabilityPageData,CapabilityModuleKind} from '../data/capabilityDesign';
import CapabilityParts from './CapabilityParts.astro';
import CapabilityMaterials from './CapabilityMaterials.astro';
import CapabilityRequirements from './CapabilityRequirements.astro';
import CapabilityWorkflow from './CapabilityWorkflow.astro';
import RfqPanel from './RfqPanel.astro';
interface Props {page:CapabilityPageData;kind:CapabilityModuleKind;quoteHref:string}
const {page,kind,quoteHref}=Astro.props;
const {slug,plan,sample,turning}=page;
const ids:Partial<Record<CapabilityModuleKind,string>>={parts:'part-examples',materials:'materials-finishes','sample-review':'sample-review'};
---
{kind==='inquiry'?<RfqPanel id="enquiry" title={plan.rfqTitle} description={sample?'Describe the sample, mating parts and the changes you need.':'Send your drawing, material and quantity.'} href={quoteHref} contained><div slot="details" class="cd-rfq-details" id={sample?'sample-inputs':undefined}><div><h3>Include with your inquiry</h3><ul>{page.inputs.map(item=><li>{item}</li>)}</ul></div><div>{page.content.rfq.map(text=><p>{text}</p>)}<p>{page.timing}</p></div></div></RfqPanel>:<section class:list={['cd-section','cd-section--'+kind]} data-module={kind} id={ids[kind]}>
 {kind==='parts'&&<CapabilityParts page={page}/>}
 {kind==='materials'&&<CapabilityMaterials page={page}/>}
 {(kind==='geometry'||kind==='requirements')&&<><CapabilityRequirements page={page} title={page.reading?'Drawing & inspection requirements':undefined}/>{slug==='stainless-steel-cnc-parts'&&!page.reading&&<div class="cd-secondary-workflow"><CapabilityWorkflow page={page} embedded/></div>}</>}
 {kind==='workshop'&&<CapabilityWorkflow page={page}/>}
 {kind==='workflow'&&<CapabilityWorkflow page={page}/>}
 {kind==='route-choice'&&<><header class="cd-heading"><h2>Indexed access or a continuous contour?</h2><p>The feature directions and available clearance determine the machining route. A complex-looking part does not establish the required machine motion.</p></header><div class="cd-route-comparison"><article><h3>Indexed positioning</h3><p>Hold the part at a selected orientation while cutting a feature. Review access to angled faces and the relationships between them.</p></article><article><h3>Simultaneous motion</h3><p>Change orientation during a continuous tool path. Review the contour, tool reach and clearance around the fixture.</p></article></div><CapabilityRequirements page={page} headingLevel="h3" showGeometry={false}/></>}
 {kind==='applications'&&<><header class="cd-heading"><h2>Specify the function before the alloy</h2><p>Electrical contacts, thermal interfaces and fluid fittings need different acceptance requirements.</p></header><dl class="cd-function-list"><div><dt>Electrical contact</dt><dd>Define contact area, conductivity criteria, plating and material restrictions.</dd></div><div><dt>Heat transfer</dt><dd>State operating conditions and the dimensions of mating interfaces.</dd></div><div><dt>Fluid sealing</dt><dd>Specify threads, seal faces and the method and limits for any pressure test.</dd></div></dl><p class="cd-note">Functional qualification and the availability of required declarations are confirmed separately for the application.</p></>}
 {kind==='purpose'&&<><header class="cd-heading"><h2>Decide what the prototype must demonstrate</h2><p>Identify fit, assembly, appearance or a defined functional test. Record the current revision and what remains open for the next design decision.</p></header><div class="cd-purpose-points"><div><h3>Keep the interfaces fixed</h3><p>Mark mating parts, mounting datums, clearances and the dimensions that must be retained.</p></div><div><h3>Agree how the result is evaluated</h3><p>Define measurements, fixtures, test procedures and approval responsibility. Vehicle, pressure and other functional performance need separate validation.</p></div></div><CapabilityWorkflow page={page} embedded/><CapabilityRequirements page={page} headingLevel="h3" showGeometry={false}/></>}
 {kind==='sample-review'&&<><span id="part-examples" class="cd-anchor"/><header class="cd-heading"><h2 id="service-parts-title">Record the sample and the intended part</h2><p>{plan.exampleIntro}</p></header><div class="cd-sample-review"><div><dl class="cd-function-list"><div><dt>Retain</dt><dd>Overall dimensions, working faces, mating parts and the features to keep.</dd></div><div><dt>Resolve</dt><dd>Wear, damage, hidden geometry, unknown material and requested changes.</dd></div><div><dt>Approve</dt><dd>The intended fit, material, finish and acceptance requirements for the new part.</dd></div></dl><p>Photographs support an initial review. Hidden features and fitted dimensions need measurements or additional information.</p></div><article class="cd-sample-example"><figure><a href={page.parts[0].href}><img src={page.parts[0].src} srcset={page.parts[0].srcset} width="1536" height="1024" loading="lazy" alt={page.parts[0].alt}/></a><figcaption>{page.parts[0].caption}</figcaption></figure><h3>{page.parts[0].title}</h3><p>A housing form for discussing replacement interfaces.</p><a class="cd-link" href={page.parts[0].href}>View part requirements</a></article></div></>}
 {kind==='faq'&&<div class="cd-faq"><header><h2 id={turning?'turning-faq-title':'service-faq-title'}>Questions before ordering</h2><p>Resolve the drawing and order conditions before production.</p></header><div>{page.questions.map(q=><section><h3>{q.question}</h3><p>{q.answer}</p></section>)}</div></div>}
</section>}
