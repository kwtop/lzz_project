---
import ContactIcon from './ContactIcon.astro';
import '../styles/company-resource-gallery.css';
import ReadingHeader from './ReadingHeader.astro';
import {guideImages} from '../data/refinedImages';
import ResourcePageFooter from '../components/ResourcePageFooter.astro';
import '../styles/factory-family.css';
import '../styles/resources-family.css';
const drawingVisual=guideImages['rfq-checklist'];
const essentials=[{title:'Drawing revision',text:'3D model and 2D drawing when needed, part number, units and revision.',href:'#drawing-package'},{title:'Material & finish',text:'Exact material or functional requirement, finish details and applicable standards.',href:'#material-finish'},{title:'Acceptance criteria',text:'Critical dimensions, datums, tolerances and inspection requirements.',href:'#acceptance'},{title:'Quantity',text:'Initial quantity and expected repeat pattern.',href:'#commercial-brief'},{title:'Delivery',text:'Arrival date, packaging, shipping basis and relevant customs requirements.',href:'#commercial-brief'}];
const delivery=[['Initial quantity','Quantity per part number.'],['Repeat pattern','Expected repeat orders, if known.'],['Delivery details','Required arrival date and postcode.'],['Packaging','Any special packaging requirements.'],['Shipping basis','Incoterm and customs, duties or taxes responsibilities.'],['Response deadline','Your decision or response deadline, if applicable.']];
---
<article class="rfq-editorial reading-page ff-page rs-page">
 <ReadingHeader title="CNC machining RFQ checklist" description="Prepare the technical files and order details we need to quote your part." breadcrumbs={[{label:'Resources',href:'/resources/'},{label:'RFQ checklist'}]}/>
 <section class="rq-wrap rq-hero rq-illustrated rq-visual-sequence reading-section" aria-labelledby="rq-essentials-title"><div class="rq-essentials"><h2 id="rq-essentials-title">Details needed for a quotation</h2><div class="rq-essential-list">{essentials.map(e=><section><h3>{e.title}</h3><p>{e.text}</p></section>)}</div><a class="rq-download" href="/downloads/order-acceptance-checklist.txt" download>Download order acceptance checklist </a></div><figure class="rq-drawing-visual"><img data-image-origin="AI-generated" src={drawingVisual.image} srcset={drawingVisual.srcset} sizes="(max-width:760px) 90vw, 530px" width="1440" height="960" alt="Machined housing beside outline drawings" loading="lazy"/></figure></section>
 <section class="rq-wrap rq-section reading-section" aria-labelledby="rq-accepted-title"><h2 id="rq-accepted-title">Drawing and acceptance requirements</h2><div class="rq-columns"><section id="drawing-package"><h3>Send a consistent drawing package</h3><p>Send a STEP model and controlled 2D drawing with part number, units and revision. Identify the controlling file if they disagree.</p><p>For multi-axis parts, include part and stock dimensions and weight.</p><aside class="rq-sample"><h4>Working from a sample</h4><p>Agree the measurement and drawing work needed. A sample does not establish hidden material or treatment requirements.</p></aside></section><section id="acceptance"><h3>Mark the dimensions used for acceptance</h3><p>Mark critical fits, datums, tolerances, threads and sealing faces. State whether dimensions apply before or after finishing.</p><p>Include the report format you need. Confirm measurement methods, instrument range, calibration evidence and available records before ordering.</p><a class="rq-link" href="/factory/#quality">Inspection &amp; documentation requirements </a></section></div></section>
 <section class="rq-band reading-section" id="material-finish"><div class="rq-wrap rq-section"><h2>Specify the material and final surface</h2><div class="rq-columns"><div><h3>Material requirements</h3><p>Specify the grade or functional requirement, material records and permitted substitutes.</p></div><div><h3>Finish and surface requirements</h3><p>Specify treatment, appearance, masked areas and edge conditions. Include applicable standards, revisions, scope and required certificates.</p></div></div><a class="rq-link" href="/resources/technical-guides/material-and-finish-checklist/">Material &amp; finish checklist</a></div></section>

 <section class="rq-wrap rq-section rq-commercial reading-section" id="commercial-brief"><h2>Quantity and delivery details</h2><span id="drawing-review"></span><div class="rq-commercial-grid"><div class="rq-terms"><dl><dt>Minimum order</dt><dd>1 piece</dd></dl><div><dl><dt>Production lead time</dt><dd>7-14 business days</dd></dl><p>After drawing and order confirmation, including surface finishing.<br/>Transit time is additional.</p></div></div><div class="rq-delivery"><dl>{delivery.map(([label,value])=><div><dt>{label}</dt><dd>{value}</dd></div>)}</dl></div></div></section>
 <section class="rq-wrap rq-related reading-related"><div><h2>Related part examples</h2></div><div><a class="rq-link" href="/machined-parts/gallery/custom-oem-cnc-turned-fittings-connectors-and-flanges-manufacturer/">Turned fittings, connectors &amp; flanges </a><a class="rq-link" href="/machined-parts/gallery/small-batch-cnc-machining-manufacturer-complex-aluminum-housings/">Complex aluminum housings </a></div></section>
 <ResourcePageFooter current="/resources/ordering/rfq-checklist/" showClosing={false}/>
 <section class="rq-band reading-closing" id="prepare-email"><div class="rq-wrap rq-send"><div><h2>Prepare and send your inquiry</h2></div><div><ol><li>Prepare the draft on the inquiry page.</li><li>Attach drawings in your email application.</li><li>Review the recipients and send when ready.</li></ol><a class="rq-button" href="/quote/">Prepare RFQ email </a><a class="rq-mail" href="mailto:roger@lzz-cnc.com"><ContactIcon kind="email"/>roger@lzz-cnc.com</a></div></div></section>
</article>
<style>
 .rq-inline-review{margin-block:18px 24px;max-width:760px}.rq-related h2{font-size:24px!important}

.rfq-editorial{background:white;color:#232a2f;--rq-muted:#57636a;--rq-line:#dce1e5;--rq-blue:#225f8a;font-size:16px;line-height:1.65}.rq-wrap{width:calc(100% - 96px);max-width:1160px;margin-inline:auto}.rfq-editorial h1,.rfq-editorial h2,.rfq-editorial h3,.rfq-editorial h4,.rfq-editorial p,.rfq-editorial figure,.rfq-editorial dl,.rfq-editorial dd{margin:0}.rfq-editorial h1,.rfq-editorial h2,.rfq-editorial h3{font-weight:550;letter-spacing:-.035em;line-height:1.2}.rfq-editorial h1{font-size:clamp(36px,4vw,58px);line-height:1.1}.rfq-editorial h2{font-size:36px}.rfq-editorial h3{font-size:22px;letter-spacing:-.02em}.rfq-editorial h4{font-size:17px;font-weight:600}.rfq-editorial p{font-size:16px;line-height:1.65;color:var(--rq-muted)}.rfq-editorial a{color:var(--rq-blue);text-decoration:none;box-shadow:none;border-radius:0}.rfq-editorial a:hover{text-decoration:underline;text-underline-offset:4px}.rfq-editorial a:focus-visible{outline:2px solid var(--rq-blue);outline-offset:5px}.rfq-editorial [id]{scroll-margin-top:110px}.rq-intro{padding-block:38px 38px}.rq-crumb{display:flex;gap:14px;color:var(--rq-muted);font-size:13px;margin-bottom:28px}.rq-crumb a{color:inherit}.rq-intro p{margin-top:22px;max-width:1020px}.rq-hero{display:grid;grid-template-columns:1.5fr 1fr;gap:42px;padding-right:max(48px,calc((100% - 1160px)/2));padding-bottom:34px;align-items:start}.rq-hero figure{min-width:0}.rq-hero img{width:100%;height:580px;object-fit:cover;object-position:35% center;display:block;border-radius:0}.rq-hero figcaption{padding-left:max(48px,calc((100vw - 1160px)/2));margin-top:10px;font-size:12px;line-height:1.6;color:var(--rq-muted)}.rq-essentials h2{font-size:31px;margin-bottom:12px}.rq-essentials .rq-essential-list>section{display:block;padding-block:11px;border-bottom:1px solid var(--rq-line);color:inherit}.rq-essentials .rq-essential-list>section:first-child{padding-top:0}.rq-essentials .rq-essential-list>section:last-child{border:0}.rq-essentials h3{font-size:21px}.rq-essentials .rq-essential-list p{font-size:15px;line-height:1.5;margin-top:3px}.rq-download{display:inline-flex;align-items:center;justify-content:space-between;gap:18px;border:1px solid #85a7bf;padding:12px 17px;min-height:48px;font-size:15px;font-weight:550;margin-top:7px}.rq-essentials .rq-note{font-size:13px;line-height:1.5;margin-top:12px;max-width:420px}.rq-section{padding-block:45px}.rq-lead{margin-top:15px!important;margin-bottom:28px!important}.rq-columns{display:grid;grid-template-columns:1fr 1fr;gap:36px}.rq-columns> :last-child{border-left:1px solid var(--rq-line);padding-left:36px}.rq-columns h3+p{margin-top:15px}.rq-columns p+p{margin-top:19px}.rq-sample{background:#edf3f7;padding:20px 23px;margin-top:20px}.rq-sample h4{color:var(--rq-blue)}.rq-sample p{margin-top:9px;font-size:15px}.rq-link{display:inline-flex;align-items:center;gap:14px;font-size:15px;font-weight:550;min-height:44px;border-bottom:1px solid #c9d7e1;margin-top:15px}.rq-link :global(svg),.rq-download :global(svg),.rq-button :global(svg),.rq-mail :global(svg){flex-shrink:0}.rq-band{background:#f0f3f5}.rq-compliance{margin-top:25px!important;font-size:15px!important}.rq-compliance a,.rq-review a{text-decoration:underline;text-underline-offset:3px}.rq-review{border-bottom:1px solid var(--rq-line);padding-bottom:32px}.rq-review p{margin-top:18px;max-width:1100px}.rq-commercial{padding-top:33px}.rq-commercial-grid{display:grid;grid-template-columns:1.1fr 1fr;gap:36px;align-items:center}.rq-terms{display:grid;grid-template-columns:.65fr 1.4fr;gap:24px}.rq-terms>div{border-left:1px solid var(--rq-line);padding-left:24px}.rq-terms dt{font-size:14px;color:var(--rq-muted)}.rq-terms dd{font-size:32px;line-height:1.15;letter-spacing:-.04em;font-weight:550;margin-top:10px}.rq-terms p{font-size:14px;line-height:1.5;margin-top:12px}.rq-delivery{border-left:1px solid var(--rq-line);padding-left:28px}.rq-delivery dl>div{display:grid;grid-template-columns:128px 1fr;gap:15px;margin-bottom:9px;font-size:14px;line-height:1.5}.rq-delivery dt{font-weight:550}.rq-delivery dd{color:var(--rq-muted)}.rq-delivery p{font-size:13px;margin-top:13px}.rq-send{display:grid;grid-template-columns:1.1fr 1fr;gap:44px;padding-block:35px}.rq-send h2{font-size:32px}.rq-send p{margin-top:18px}.rq-send>div:last-child{padding-left:35px;border-left:1px solid var(--rq-line)}.rq-send ol{list-style:none;padding:0;margin:0;font-size:16px;line-height:1.6}.rq-send ol+p{font-size:14px;margin-top:10px}.rfq-editorial .rq-button{display:inline-flex;gap:24px;align-items:center;justify-content:center;background:#c7222f;color:white;padding:13px 23px;font-size:15px;font-weight:600;min-height:50px;margin-top:17px}.rfq-editorial .rq-button:hover{background:#a91b26;text-decoration:none}.rq-mail{display:flex;align-items:center;gap:12px;width:fit-content;font-size:14px;min-height:40px;margin-top:5px}.rq-related{display:grid;grid-template-columns:1.2fr 1fr;gap:55px;padding-block:29px 36px}.rq-related h2{font-size:28px}.rq-related p{font-size:15px;margin-top:12px}.rq-related>div:last-child{border-left:1px solid var(--rq-line);padding-left:30px;display:flex;flex-direction:column;align-items:flex-start}.rq-related .rq-link{margin-top:0}
@media(max-width:1100px){.rq-wrap{width:calc(100% - 64px)}.rq-hero{padding-right:32px;gap:28px}.rq-hero img{height:535px}.rq-hero figcaption{padding-left:32px}.rq-essentials h2{font-size:27px}.rq-commercial-grid{grid-template-columns:1fr;gap:25px}.rq-terms{grid-template-columns:.7fr 1.3fr}.rq-delivery{padding-left:0;border:0}.rq-delivery dl{display:grid;grid-template-columns:1fr 1fr;gap:10px 24px}.rq-delivery dl>div{grid-template-columns:1fr;gap:4px}.rq-send{gap:30px}.rq-send>div:last-child{padding-left:25px}.rq-send h2{font-size:29px}}
@media(max-width:760px){.rq-wrap{width:calc(100% - 40px)}.rq-intro{padding-block:25px 28px}.rq-crumb{font-size:12px;margin-bottom:25px}.rfq-editorial h1{font-size:36px}.rfq-editorial h1 br{display:none}.rq-desktop{display:none}.rq-intro p{margin-top:20px}.rq-hero{grid-template-columns:1fr;gap:24px;padding:0 0 30px}.rq-hero img{height:auto;aspect-ratio:1.25}.rq-hero figcaption{padding-inline:20px;font-size:12px}.rq-essentials{padding-inline:20px}.rq-essentials h2{font-size:28px}.rq-essentials .rq-essential-list p{font-size:16px}.rq-download{font-size:14px;padding:12px;gap:12px}.rq-section{padding-block:32px}.rfq-editorial h2{font-size:29px}.rfq-editorial h3{font-size:21px}.rq-lead{margin-bottom:23px!important}.rq-columns{grid-template-columns:1fr;gap:28px}.rq-columns>:last-child{border-left:0;padding-left:0}.rq-sample{padding:18px}.rq-sample p{font-size:16px}.rq-compliance{font-size:16px!important}.rq-review p{margin-top:16px}.rq-terms{grid-template-columns:1fr;gap:22px}.rq-terms>div{padding-left:0;border-left:0;border-top:1px solid var(--rq-line);padding-top:20px}.rq-terms dd{font-size:33px}.rq-terms p{font-size:16px}.rq-delivery dl{grid-template-columns:1fr;gap:13px}.rq-delivery dl>div{font-size:16px}.rq-delivery p{font-size:14px}.rq-send{grid-template-columns:1fr;gap:25px;padding-block:30px}.rq-send>div:last-child{padding-left:0;border-left:0;border-top:1px solid var(--rq-line);padding-top:22px}.rq-send ol+p{font-size:15px}.rq-send h2{font-size:29px}.rq-related{grid-template-columns:1fr;gap:20px;padding-block:28px}.rq-related>div:last-child{border:0;padding-left:0}.rq-related p{font-size:16px}.rq-related .rq-link{font-size:15px}}
/* The checklist is the introduction; the shared reading shell owns page spacing. */
.rq-hero{display:block;padding-inline:0}
.rq-essentials{min-width:0;padding-inline:0}
.rq-band.reading-section>.rq-section,.rq-band.reading-closing>.rq-send{padding-block:0}
@media(max-width:760px){.rq-essentials{padding-inline:0}}
</style>

