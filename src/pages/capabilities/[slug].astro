---
import CapabilityDetail from '../../components/CapabilityDetail.astro';
import CapabilityRedesign from '../../components/CapabilityRedesign.astro';
import PentaMillingPage from '../../components/PentaMillingPage.astro';
import {revisedCapability} from '../../data/capabilityRedesign';
import {isRedesigned} from '../../data/redesignRollout';
import Layout from '../../layouts/Layout.astro';
import catalog from '../../data/catalog.json';
import {categoryDetails} from '../../data/presentation';
import {capabilityContent} from '../../data/capabilityContent';
import {capabilityPage} from '../../data/capabilityDesign';
import {capabilityHeroPart} from '../../data/capabilityRebuild';
import {inquiryHref} from '../../lib/inquiryContext';
import {capabilityDecisions} from '../../data/capabilityDecisions';
import {photo} from '../../data/evidence';
export function getStaticPaths(){return catalog.categories.map(category=>({params:{slug:category.slug},props:{category}}));}
const {category}=Astro.props;
const slug=category.slug;
const detail=categoryDetails[slug];
const content=capabilityContent[slug];
const description=capabilityDecisions[slug]?.description||content.description;
const page=capabilityPage(slug);
const pageTitle=page.plan.title;
const heroImage=slug==='5-axis-cnc-machining'?photo('five-axis-operation').src:slug==='prototype-machining'?page.parts[0].src:capabilityHeroPart(slug).src;
const quoteHref=inquiryHref({id:slug,title:detail.title,path:'/capabilities/'+slug+'/',kind:'capability'});
---
<Layout pentaSample={slug==='cnc-milling-service'} title={pageTitle} description={description} articleImage={heroImage} cta={false} headerQuoteHref={quoteHref} structuredEntity={{type:'Service',name:pageTitle,description,image:heroImage}}>
 {slug==='cnc-milling-service'?<PentaMillingPage page={revisedCapability(slug)} quoteHref={quoteHref}/>:isRedesigned(Astro.url.pathname)?<CapabilityRedesign slug={slug} quoteHref={quoteHref}/>:<CapabilityDetail slug={slug} quoteHref={quoteHref}/>}
</Layout>



