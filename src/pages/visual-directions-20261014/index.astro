---
import '@fontsource-variable/inter';
const options=[
 {id:'a',name:'简约精修',en:'Quiet refinement',description:'保留原有结构。暖灰产品区、浅灰绿能力区与深色询价区，让同一套内容有清晰的轻重变化。',features:'原有深色摄影首屏 / 四列产品 / 温暖背景层次'},
 {id:'b',name:'高端品牌',en:'Material & craft',description:'石墨色首屏与叶轮大特写，配合宽幅工厂照片、错落研究模块和克制的衬线大标题。',features:'深色棚拍主视觉 / 双列产品陈列 / 品牌式图文节奏'},
 {id:'c',name:'图片主导',en:'Parts in focus',description:'将价值主张与图片分开，大幅横向加工画面和不等比例产品图，缩短视觉理解路径。',features:'宽幅加工图片 / 非等距产品网格 / 简洁无衬线标题'},
];
---
<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><meta name="description" content="LZZ 首页三个独立视觉方向：简约精修、高端品牌与图片主导，包含桌面与手机预览。"/><title>LZZ 首页视觉方向对比</title></head><body>
 <header><a href="/" class="logo"><img src="/media/lzz-logo.png" width="108" height="60" alt="LZZ"/></a><a href="/">查看当前正式首页</a></header>
 <main><div class="intro"><p>首页视觉方向 · 独立本地预览</p><h1>同样的业务，<br/>三种视觉表达。</h1><div><p>三版保留相同的产品、能力、材料、工厂与质量信息、加工研究、采购指南及询价条件。</p><p>选择方向后再统一其他页面。正式首页、导航和业务 URL 未改动。</p></div></div>
 <div class="options">{options.map(item=><article><a href={'/visual-directions-20261014/'+item.id+'/'} class="preview"><img src={'/visual-directions-20261014/screens/'+item.id+'-desktop.jpg'} alt={item.name+'完整首页截图'} width="1440" height="5000"/></a><div class="copy"><span class="letter">{item.id.toUpperCase()}</span><h2>{item.name}</h2><p class="english">{item.en}</p><p>{item.description}</p><p class="features">{item.features}</p><a class="button" href={'/visual-directions-20261014/'+item.id+'/'}>打开完整首页</a><div class="downloads"><a href={'/visual-directions-20261014/screens/'+item.id+'-desktop.jpg'} target="_blank">桌面全页截图</a><a href={'/visual-directions-20261014/screens/'+item.id+'-mobile.jpg'} target="_blank">手机全页截图</a></div></div></article>)}</div>
 <section class="notes"><h2>本次设计调整</h2><p>保留当前 Inter / Georgia 字体、品牌红和 LZZ 标识。区别来自图片尺度、背景明度、版式与标题表现，而非更换业务定位。</p><p>B 版叶轮主视觉基于现有图片通过 ImageGen 调整背景和光线，仅用于版式展示；工厂、检验设备和加工研究沿用现有素材。没有新造企业、认证或客户事实。</p><p>页面内的产品、指南和询价链接进入现有页面，本次只改独立 Demo。询价仍为准备邮件草稿，不会由 Demo 自动发送。</p></section></main>
</body></html>
<style>
 :global(*){box-sizing:border-box} :global(body){margin:0;background:#efeee8;color:#242923;font-family:'Inter Variable','Microsoft YaHei',sans-serif;line-height:1.65} :global(a){color:inherit;text-underline-offset:5px} :global(img){display:block;max-width:100%} :global(a:focus-visible){outline:2px solid #c50917;outline-offset:5px} header{display:flex;justify-content:space-between;align-items:center;padding:22px 5%;border-bottom:1px solid #cfcfc4;font-size:14px}header .logo img{width:92px;height:auto}main{max-width:1500px;margin:auto;padding:70px 5%}.intro{display:grid;grid-template-columns:1.2fr 1fr;gap:20px 70px;margin-bottom:70px}.intro>p{grid-column:1/-1;font-size:14px;color:#646c60}.intro h1{font-size:54px;font-weight:500;letter-spacing:-.05em;line-height:1.2;margin:0}.intro>div{align-self:end}.intro>div p{font-size:16px;color:#5c6558;max-width:49ch;margin:0 0 15px}.options{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:30px}.options article{min-width:0}.preview{display:block;height:510px;overflow:hidden;background:#dedfd5;border:1px solid #d1d2c7}.preview img{width:100%;height:auto;transition:transform 4s ease}.preview:hover img{transform:translateY(-12%)}.copy{padding:26px 0}.letter{float:right;font-family:Georgia,serif;font-size:40px;color:#7d8476}h2{font-size:26px;line-height:1.3;font-weight:500;margin:0}.english{color:#6c7366;font-size:14px;margin:8px 0 22px}.copy>p:not(.english){font-size:15px;color:#535e4e}.features{font-size:12px!important;line-height:1.9;border-top:1px solid #c6c9bd;padding-top:18px}.button{display:inline-block;background:#222a23;color:#fff;padding:12px 20px;text-decoration:none;font-size:14px;margin-top:12px}.downloads{display:flex;gap:18px;font-size:12px;margin-top:20px}.notes{margin-top:65px;padding-top:35px;border-top:1px solid #c6c9bd;max-width:900px}.notes h2{font-size:22px}.notes p{font-size:14px;color:#5c6558}@media(max-width:800px){main{padding:40px 20px}.intro{display:block;margin-bottom:36px}.intro h1{font-size:38px;margin-bottom:24px}.options{grid-template-columns:1fr;gap:40px}.preview{height:480px}.notes{margin-top:30px}}
</style>
