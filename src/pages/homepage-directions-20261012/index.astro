---
import '@fontsource-variable/inter';
const base='/homepage-directions-20261012/';
const directions=[
 {key:'a',name:'精密产品目录',ref:14,features:'白底产品特写 / 克制字重 / 清晰目录网格',fit:'先看零件，再进入加工能力和材料。适合快速选型、比较与询价。',assets:'叶轮采用工作室背景；产品列表保留现有主体图。',limit:'主视觉存在重绘细节差异，不作为型号或规格依据。'},
 {key:'b',name:'深色材质展陈',ref:2,features:'深色材质首屏 / 不对称图组 / 明暗章节切换',fit:'用铸件结构形成视觉记忆，产品之后前置车间与检测证据。',assets:'壳体采用左侧融合背景；车间、检测与加工图沿用原资料。',limit:'主视觉的孔口与纹理有重绘差异；目录图仍使用原有素材。'},
 {key:'c',name:'开阔工程画册',ref:6,features:'横向产品组合 / 冷蓝灰空间 / 错落图片与列表',fit:'能力入口前置，以工艺目录引导选型，应用研究采用大图与说明并列。',assets:'三件产品采用摄影棚背景与等比例构图；另做手机构图。',limit:'组合图不是同场实拍，不代表产品相对尺寸。'},
];
const references=['19654eaf27e673970f9af6f982315dc5','1a0c9e38c1887dc93b9c44f23226a01c','25e4d72829c7e58266e17471112ceb46','36d253fc7d026739d9c579e0593259a3','44c204cd93595d9709e4648e222ffd25','55d66aef156f9cea08c5d5f15b0170ea','5e5caf3b8ec3bc2fb11b69527a583bee','7f7f4618bdcb631a088dedcac462dfa9','99c50ae2bdf58a23f954b75deb28b6e3','9f8630211fdbd619430dd45515d57831','a5b783aeaf264ac7c18d92cab7c6778c','c5644b7860a9b908ba40715f517e85b2','c998d0104e83d5968f7a45c22610530e','e70a7ae069eff086411b78a9ed979f77','e934b9bd712209dae1fdd69407883e5b','fdf4791cfcc08095f453710553b8c5d3'];
---
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>LZZ · 三版首页方向对比</title><meta name="description" content="LZZ 三版首页独立本地预览、参考图与桌面手机截图。"/></head><body>
<header><a href="/">返回当前网站</a><span>LZZ / 首页设计探索 / 2026.10.12</span></header>
<main><section class="intro"><p>独立本地预览 · 正式首页未覆盖</p><h1>相同的业务内容，<br/>三种阅读体验。</h1><div class="intro-bottom"><p>用产品、加工能力和真实资料建立采购路径。三版沿用 Inter 字体与现有业务 URL，差异来自构图、图片组织、字重和页面节奏。</p><a href={base+'HANDOFF.md'}>内容基线与素材交接说明</a></div></section>
<div class="directions">{directions.map(d=><article><a class="cover" href={base+d.key+'/'}><img src={base+'screenshots/'+d.key+'-hero-desktop.jpg'} alt={d.name+'实际桌面首屏截图'} width="1440" height="900"/></a><div class="title"><span>{d.key.toUpperCase()}</span><h2>{d.name}</h2></div><p class="ref">主参考 {d.ref} 号</p><p><strong>{d.features}</strong></p><p>{d.fit}</p><a class="open" href={base+d.key+'/'}>打开完整首页</a><details><summary>图片处理与已知限制</summary><p>{d.assets}</p><p>{d.limit}</p></details><nav aria-label={d.name+'截图'}><a href={base+'screenshots/'+d.key+'-desktop.jpg'} target="_blank">1440px 桌面全页</a><a href={base+'screenshots/'+d.key+'-mobile.jpg'} target="_blank">390px 手机全页</a><a href={base+'screenshots/'+d.key+'-hero-mobile.jpg'} target="_blank">手机首屏</a><a href={base+'screenshots/'+d.key+'-products.jpg'} target="_blank">产品区细节</a><a href={base+'screenshots/'+d.key+'-quality.jpg'} target="_blank">质量区细节</a><a href={base+'screenshots/'+d.key+'-inquiry.jpg'} target="_blank">询价区细节</a></nav></article>)}</div>
<section class="baseline"><h2>三版保持相同的信息覆盖</h2><p>按图定制与原型/小批量定位 · 原首页三个产品入口及塑料零件补充入口 · 五类加工能力 · 四类材料 · 起订量与生产时间及其条件 · 车间、检测与企业资料 · 三个加工研究 · 合作流程 · NDA 提示与询价准备。</p><p>询价演示仅在当前页面生成摘要，不发送邮件、不保存数据、不连接 CRM。普通内容链接会进入现有网站。</p><p>参考图中无法辨认的字体、交互和手机排版没有假定为已知；本轮使用现有 Inter，响应式布局独立设计。ISO 证书有效期、检测校准与最新供货条件仍需企业确认。</p></section>
<details class="references"><summary>查看 1–16 号参考图对照</summary><p>原文件为哈希名，没有可确认的编号。以下按文件名升序编号，本轮所有参考编号均以此为准。</p><div>{references.map((r,i)=><figure><a href={base+'references/'+(i+1)+'.jpg'} target="_blank"><img src={base+'references/'+(i+1)+'.jpg'} width="270" height="360" loading="lazy" alt={'参考 '+(i+1)}/></a><figcaption><strong>{i+1}</strong><span>{r}.jpg</span></figcaption></figure>)}</div></details>
</main><footer>仅供选择方向。未部署，未加入正式导航或 Sitemap。</footer></body></html>
<style>
*{box-sizing:border-box}body{margin:0;background:#f6f6f3;color:#262826;font:15px/1.75 'Inter Variable',Arial,sans-serif}a{color:inherit;text-underline-offset:4px}header,main,footer{max-width:1440px;margin:auto;padding-inline:48px}header{display:flex;justify-content:space-between;gap:20px;padding-block:24px;border-bottom:1px solid #ddd;font-size:12px}header span{color:#6d726d}.intro{padding:62px 0 48px}.intro>p{color:#6b706b;font-size:13px}h1{font-size:52px;line-height:1.25;font-weight:500;letter-spacing:-.055em;margin:22px 0 30px}.intro-bottom{display:flex;justify-content:space-between;gap:50px;align-items:center}.intro-bottom p{max-width:700px;margin:0;color:#5c625c}.intro-bottom a{white-space:nowrap;font-size:13px}.directions{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:26px}article{min-width:0}.cover{display:block;background:#e4e5e0;border:1px solid #ddd}.cover img{display:block;width:100%;height:auto}.title{display:flex;gap:14px;align-items:center;margin-top:24px}.title>span{font-size:28px;font-weight:450}.title h2{font-size:24px;font-weight:500;margin:0;letter-spacing:-.04em}article p{font-size:13px;color:#60665f;line-height:1.8}article p strong{font-weight:550;color:#30362e}.ref{font-size:12px!important;color:#7a7e77!important}.open{display:block;background:#222722;color:white;text-decoration:none;padding:12px 18px;text-align:center;margin:22px 0}.open:hover{background:#414b3e}details{border-top:1px solid #d1d4cc;padding-top:15px}summary{cursor:pointer;font-size:13px}article nav{display:flex;flex-wrap:wrap;gap:4px 16px;margin-top:18px}article nav a{font-size:12px;line-height:2.4}.baseline{border-top:1px solid #ccc;margin-top:60px;padding-top:35px;max-width:1050px}.baseline h2{font-size:24px;font-weight:500}.baseline p{font-size:13px;color:#60665f}.references{margin-top:40px}.references>p{font-size:13px}.references>div{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;margin-top:25px}figure{margin:0;min-width:0}figure img{width:100%;height:auto;display:block}figcaption{display:flex;gap:12px;margin-top:10px}figcaption span{font-size:9px;word-break:break-all}footer{padding-block:40px;font-size:12px;color:#757b72}a:focus-visible,summary:focus-visible{outline:3px solid #b5121b;outline-offset:4px}@media(max-width:900px){.directions{grid-template-columns:1fr}.cover{max-width:700px}.intro-bottom{display:block}.intro-bottom a{display:inline-block;margin-top:20px}article{border-bottom:1px solid #ddd;padding-bottom:35px}.references>div{grid-template-columns:1fr 1fr}}@media(max-width:600px){header,main,footer{padding-inline:20px}header{font-size:10px}header span{max-width:180px;text-align:right}.intro{padding-block:35px}h1{font-size:36px}.intro-bottom p{font-size:14px}.title h2{font-size:24px}.baseline{margin-top:35px}.references>div{gap:14px}}
</style>
