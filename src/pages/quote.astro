---
import Layout from '../layouts/Layout.astro';
import '../styles/quote-approved.css';
import QuoteForm from '../components/QuoteForm';
import catalog from '../data/catalog.json';
import {categoryDetails} from '../data/presentation';
import {partDisplayTitle} from '../data/productsEditorial';
import type {InquiryReference} from '../lib/inquiryContext';
import {sampleToPart} from '../data/sampleToPart';
import {partBrowseGroups} from '../data/productBrowse';
import {inquiryPartTypes} from '../lib/inquiryForm';
import type {InquiryPartType,InquiryProcess} from '../lib/inquiryForm';
const processCategories:Record<string,InquiryProcess>={'CNC-Milling-Service':'milling','CNC-Turning-Service':'turning','5-Axis-CNC-Machining':'multi-axis','Plastic-Machined-Parts':'plastic','Casting-Machining':'castings'};
const processCapabilities:Record<string,InquiryProcess>={'cnc-milling-service':'milling','cnc-turning-service':'turning','5-axis-cnc-machining':'multi-axis','plastic-machined-parts':'plastic','casting-machining':'castings'};
const references:InquiryReference[]=[
 ...catalog.products.map(product=>{
  const form=partBrowseGroups.find(group=>group.slugs.includes(product.slug))?.key;
  const partType=inquiryPartTypes.some(option=>option.value===form)?form as InquiryPartType:undefined;
  const processes=[...new Set(product.categories.map(category=>processCategories[category]).filter(Boolean))];
  return {id:product.slug,title:partDisplayTitle(product),path:'/machined-parts/gallery/'+product.slug+'/',kind:'product' as const,partType,processes};
 }),
 ...catalog.categories.map(category=>({id:category.slug,title:categoryDetails[category.slug]?.title||category.name,path:'/capabilities/'+category.slug+'/',kind:'capability' as const,processes:processCapabilities[category.slug]?[processCapabilities[category.slug]]:[]})),
 sampleToPart,
];
---
<Layout title="Request a CNC machining quote" cta={false}>
 <section class="qt-page rd-wrap rd-page">
  <QuoteForm client:load references={references}/>
 </section>
</Layout>

